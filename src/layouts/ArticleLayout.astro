---
/**
 * ArticleLayout.astro
 * Layout for educational guides and blog posts.
 * Implements full E-E-A-T signals per the Seniors Audit Master Spec:
 * - Direct Answer / Quick Answer directly after H1 above the fold
 * - Author Bio and Educational Disclaimer at the end of the page
 * - Sources and Related Tools at bottom of content
 * - Breadcrumbs, Table of Contents, Legal Disclaimer
 */

import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import TableOfContents from '@components/content/TableOfContents.astro';
import AuthorBio from '@components/content/AuthorBio.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import RelatedArticles from '@components/content/RelatedArticles.astro';
import ProductCTA from '@components/ctas/ProductCTA.astro';
import VideoPlayerCard from '@components/content/VideoPlayerCard.astro';
import {
  getVideo,
  EDUCATIONAL_VIDEOS,
  getYouTubeThumbnailUrl,
  getYouTubeEmbedUrl,
  getYouTubeWatchUrl,
  formatDurationIso
} from '@data/educationalVideos';

interface Source {
  label: string;
  url: string;
}

interface RelatedTool {
  title: string;
  href: string;
}

interface RelatedArticleItem {
  title: string;
  href: string;
  description?: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface ActionStep {
  name: string;
  text: string;
  url?: string;
}

interface Props {
  frontmatter: {
    title: string;
    description: string;
    category: string;
    publishDate: Date;
    updatedDate?: Date;
    author?: 'emmanuel';   // defaults to 'emmanuel'
    wordCount?: number;              // optional override for reading time
    tags?: string[];
    sources?: Source[];
    relatedTools?: RelatedTool[];
    faqs?: FAQ[];                    // FAQ pairs for FAQPage schema + People Also Ask
    pitfallFaqs?: FAQ[];             // Pitfall Q&As merged into FAQPage schema for AEO
    actionSteps?: ActionStep[];      // Step-by-step actions → HowTo schema
    videoId?: string;                // YouTube video ID or slug
    videoTitle?: string;             // Optional video title override
  };
  headings: any[];
  relatedArticles?: RelatedArticleItem[];
  body?: string;                     // Raw markdown body for dynamic parsing
}

const { frontmatter, headings, relatedArticles = [], body = '' } = Astro.props;

const currentNormPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const matchedVideoByUrl = EDUCATIONAL_VIDEOS.find(v => {
  const vNorm = v.relatedPageUrl.endsWith('/') ? v.relatedPageUrl : `${v.relatedPageUrl}/`;
  return vNorm === currentNormPath;
});

const articleVideoId = frontmatter.videoId || matchedVideoByUrl?.youtubeId;
const articleVideo = articleVideoId ? getVideo(articleVideoId) : matchedVideoByUrl;

// Function to automatically extract FAQs from the markdown body
function extractFaqsFromMarkdown(mdBody: string): FAQ[] {
  const extracted: FAQ[] = [];
  if (!mdBody) return extracted;

  const lines = mdBody.split(/\r?\n/);
  // Find where the FAQ section starts
  const faqStartIndex = lines.findIndex(l => {
    const trimmed = l.trim().toLowerCase();
    return trimmed.startsWith('## ') && (trimmed.includes('questions') || trimmed.includes('faq'));
  });

  if (faqStartIndex === -1) return extracted;

  for (let i = faqStartIndex + 1; i < lines.length; i++) {
    const line = lines[i].trim();
    // If we hit another H2, stop parsing
    if (line.startsWith('## ')) {
      break;
    }
    if (line.startsWith('### ')) {
      const question = line.replace(/^###\s+/, '').trim();
      let j = i + 1;
      let answer = '';
      while (j < lines.length) {
        const nextLine = lines[j].trim();
        if (nextLine) {
          // Stop if we hit another header or divider
          if (nextLine.startsWith('#') || nextLine.startsWith('---')) {
            break;
          }
          answer = nextLine;
          break;
        }
        j++;
      }
      if (question && answer) {
        extracted.push({ question, answer });
      }
    }
  }
  return extracted;
}

const authorKey = 'emmanuel';

// Author display info consistent with the Master Spec
const authorInfo = {
  emmanuel: {
    displayName: 'Emmanuel TUYISHIMIRE',
    fullName:    'TUYISHIMIRE Emmanuel',
    profileUrl:  'https://www.linkedin.com/in/emmanueltuyishimire',
  },
};
const person = authorInfo[authorKey];

const categoryUrlMap: Record<string, string> = {
  'irs':            '/irs/',
  'social-security': '/social-security/',
  'medicare':       '/medicare/',
  'medicaid':       '/medicaid/',
  'retirement':     '/retirement/',
  'taxes':          '/taxes/',
  'blog':           '/blog/',
};

const formattedDate = new Date(frontmatter.publishDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const formattedUpdatedDate = frontmatter.updatedDate
  ? new Date(frontmatter.updatedDate).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : null;

const breadcrumbItems = [
  {
    label: frontmatter.category
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c: string) => c.toUpperCase()),
    href: categoryUrlMap[frontmatter.category] || '/'
  },
  { label: frontmatter.title },
];

const siteUrl = 'https://www.seniorsaudit.com';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const categoryLabel = frontmatter.category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
const categoryHref = categoryUrlMap[frontmatter.category] || '/';

// Article JSON-LD schema — includes SpeakableSpecification for Google AI / voice assistants
const articleSchema = {
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "datePublished": frontmatter.publishDate.toISOString(),
  "dateModified": (frontmatter.updatedDate ?? frontmatter.publishDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Emmanuel TUYISHIMIRE",
    "alternateName": "TUYISHIMIRE Emmanuel",
    "url": `${siteUrl}/about/emmanuel-tuyishimire/`,
    "sameAs": [
      "https://www.linkedin.com/in/emmanueltuyishimire"
    ]
  },
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  "image": {
    "@type": "ImageObject",
    "url": `${siteUrl}/images/og-default.jpg`,
    "width": 1200,
    "height": 630,
  },
  "url": pageUrl,
  "isAccessibleForFree": true,
  "inLanguage": "en-US",
  "isPartOf": {
    "@id": `${siteUrl}/#website`
  },
  ...(frontmatter.tags && frontmatter.tags.length > 0 ? { "keywords": frontmatter.tags.join(', ') } : {}),
  ...(frontmatter.sources && frontmatter.sources.length > 0 ? {
    "citation": frontmatter.sources.map((src: Source) => ({
      "@type": "CreativeWork",
      "name": src.label,
      "url": src.url
    }))
  } : {}),
  "about": {
    "@type": "Thing",
    "name": frontmatter.category === 'medicare' ? 'Medicare' :
            frontmatter.category === 'medicaid' ? 'Medicaid' :
            frontmatter.category === 'social-security' ? 'Social Security' :
            frontmatter.category === 'irs' ? 'IRS Tax Notices' :
            frontmatter.category === 'retirement' ? 'Retirement Planning' :
            frontmatter.category === 'taxes' ? 'Retirement Taxes' :
            'Government Benefits',
    "sameAs": frontmatter.category === 'medicare' ? 'https://en.wikipedia.org/wiki/Medicare_(United_States)' :
              frontmatter.category === 'medicaid' ? 'https://en.wikipedia.org/wiki/Medicaid' :
              frontmatter.category === 'social-security' ? 'https://en.wikipedia.org/wiki/Social_Security_(United_States)' :
              frontmatter.category === 'irs' ? 'https://en.wikipedia.org/wiki/Internal_Revenue_Service' :
              frontmatter.category === 'retirement' ? 'https://en.wikipedia.org/wiki/Retirement_planning' : undefined,
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [
      ".article-title",
      ".quick-answer-box",
      ".article-body > p:first-of-type",
    ],
  },
};

// BreadcrumbList JSON-LD schema — displayed in search results
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": `${siteUrl}${categoryHref}` },
    { "@type": "ListItem", "position": 3, "name": frontmatter.title, "item": pageUrl },
  ],
};

// FAQPage JSON-LD schema — feeds People Also Ask + Google AI Overviews
const rawFaqs = frontmatter.faqs ?? [];
const pitfallFaqs = frontmatter.pitfallFaqs ?? [];
const extractedFaqs = body ? extractFaqsFromMarkdown(body) : [];
const combinedFaqs = [...rawFaqs];

pitfallFaqs.forEach(pf => {
  if (!combinedFaqs.some(rf => rf.question.toLowerCase().trim() === pf.question.toLowerCase().trim())) {
    combinedFaqs.push(pf);
  }
});

extractedFaqs.forEach(ef => {
  if (!combinedFaqs.some(rf => rf.question.toLowerCase().trim() === ef.question.toLowerCase().trim())) {
    combinedFaqs.push(ef);
  }
});

const faqSchema = combinedFaqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": combinedFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
  })),
} : null;

// HowTo schema
const howToSchema = (frontmatter.actionSteps && frontmatter.actionSteps.length > 0) ? {
  "@type": "HowTo",
  "name": `How to navigate ${frontmatter.title}`,
  "description": frontmatter.description,
  "totalTime": "PT15M",
  "step": frontmatter.actionSteps.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text,
    ...(step.url ? { "url": step.url } : {}),
  })),
} : null;

// Video schema for @graph if article has an associated video
const videoSchema = articleVideoId ? {
  "@type": "VideoObject",
  "@id": `${pageUrl}#video`,
  "name": frontmatter.videoTitle || articleVideo?.title || frontmatter.title,
  "description": articleVideo?.editorialSummary || frontmatter.description,
  "thumbnailUrl": [
    getYouTubeThumbnailUrl(articleVideoId, 'hq'),
    `https://i.ytimg.com/vi/${articleVideoId}/mqdefault.jpg`
  ],
  "uploadDate": `${articleVideo?.publishedDate || '2026-07-01'}T09:00:00-04:00`,
  "duration": articleVideo?.durationIso || formatDurationIso(articleVideo?.duration || '10:00'),
  "embedUrl": getYouTubeEmbedUrl(articleVideoId, false),
  "contentUrl": getYouTubeWatchUrl(articleVideoId),
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "isAccessibleForFree": true,
  "inLanguage": "en-US"
} : null;

if (videoSchema) {
  (articleSchema as any).video = { "@id": `${pageUrl}#video` };
}

// Combined schema
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    articleSchema,
    breadcrumbSchema,
    ...(videoSchema ? [videoSchema] : []),
    ...(faqSchema ? [faqSchema] : []),
    ...(howToSchema ? [howToSchema] : []),
  ],
};
const noindex = frontmatter.noindex || false;

// Contextual Optional Planning Resource mapping
const catLower = (frontmatter.category || '').toLowerCase();
const titleLower = (frontmatter.title || '').toLowerCase();

let articleProduct: any = null;
if (catLower.includes('social-security')) {
  articleProduct = {
    heading: "Want to Model Your Claiming Decision on Paper?",
    context: "Our educational guides explain the official statutory rules. If you want a structured workbook to compare claiming at 62 vs. Full Retirement Age vs. 70 and organize your personal strategy before filing with the SSA, explore this optional resource.",
    name: "Social Security Claiming Decision Workbook",
    price: 15,
    desc: "A step-by-step 17-page planning workbook with break-even worksheets, spousal benefit protection rules, and 2026 earnings test charts.",
    slug: "social-security-claiming-workbook",
    buttonText: "Explore the Workbook →",
    trackingEvent: "cta_article_ss_workbook_click"
  };
} else if (catLower.includes('medicare')) {
  if (titleLower.includes('penalty') || titleLower.includes('late')) {
    articleProduct = {
      heading: "Need a Structured Guide to Contest or Avoid Penalties?",
      context: "Medicare late-enrollment penalties add permanent monthly surcharges. If you need a checklist to verify your past creditable coverage and navigate formal dispute procedures, explore this optional kit.",
      name: "Medicare Part B/D Penalty Avoidance Kit",
      price: 12,
      desc: "A 19-page defense guide with penalty calculation tables, secondary evidence checklists, and formal administrative appeal templates.",
      slug: "medicare-part-b-d-penalty-kit",
      buttonText: "Explore the Penalty Kit →",
      trackingEvent: "cta_article_penalty_kit_click"
    };
  } else if (titleLower.includes('irmaa') || titleLower.includes('magi') || titleLower.includes('premium')) {
    articleProduct = {
      heading: "Facing High-Income Medicare Premium Surcharges?",
      context: "If your income pushes you into higher IRMAA brackets, or you experienced a life-changing event that dropped your income, this optional workbook provides the 2-year lookback audit worksheets and Form SSA-44 filing instructions.",
      name: "IRMAA & Medicare MAGI Planning Workbook",
      price: 19,
      desc: "A 15-page workbook with official 2026 MAGI tier tables, cliff-bracket avoidance worksheets, and step-by-step Form SSA-44 filing instructions.",
      slug: "irmaa-medicare-magi-workbook",
      buttonText: "Explore the IRMAA Workbook →",
      trackingEvent: "cta_article_irmaa_workbook_click"
    };
  } else if (!catLower.includes('medicaid')) {
    articleProduct = {
      heading: "Approaching Medicare Eligibility at Age 65?",
      context: "Navigating your 7-month Initial Enrollment Period without penalties requires careful sequencing. If you want a structured, printable action plan to organize your deadlines and compare Medigap vs. Advantage, this optional resource can help.",
      name: "Turning 65 Medicare Enrollment Action Planner",
      price: 19,
      desc: "An 18-page sequential guide covering the 7-month IEP, working-past-65 employer rules, and Medigap vs. Advantage decision frameworks.",
      slug: "turning-65-medicare-enrollment-planner",
      buttonText: "Explore the Medicare Planner →",
      trackingEvent: "cta_article_medicare_planner_click"
    };
  }
} else if (catLower.includes('retirement')) {
  articleProduct = {
    heading: "Planning Your Retirement Income and Mandatory Distributions?",
    context: "Managing mandatory distributions and tax sequencing is one of the most complex parts of retirement. If you want a structured workbook to calculate divisor schedules and evaluate QCD tax offsets, explore this optional resource.",
    name: "RMD Tax & Withdrawal Planning Workbook",
    price: 15,
    desc: "A practical 14-page guide with official IRS Uniform Lifetime divisor schedules, QCD tax-offset instructions, and withholding worksheets.",
    slug: "rmd-tax-withdrawal-workbook",
    buttonText: "Explore the RMD Workbook →",
    trackingEvent: "cta_article_rmd_workbook_click"
  };
} else if (catLower.includes('taxes') || catLower.includes('irs')) {
  articleProduct = {
    heading: "Want to Model Your Overall Retirement Tax Strategy?",
    context: "In retirement, withdrawals interact directly with Social Security taxation and future Medicare premiums. If you want an integrated 17-page framework to model multiple withdrawal scenarios side by side, explore our flagship planner.",
    name: "Retirement Withdrawal & Medicare Cost Planner",
    price: 24,
    desc: "Our 17-page flagship planner connecting retirement withdrawals, Social Security taxation, tax brackets, and future Medicare IRMAA tiers.",
    slug: "retirement-withdrawal-medicare-planner",
    buttonText: "Explore the Flagship Planner →",
    trackingEvent: "cta_article_flagship_planner_click",
    variant: "gold"
  };
}
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
  articleAuthor={person.displayName}
  articlePublishedTime={frontmatter.publishDate.toISOString()}
  articleModifiedTime={(frontmatter.updatedDate ?? frontmatter.publishDate).toISOString()}
  articleSection={categoryLabel}
  schema={pageSchema}
  noindex={noindex}
>
  <article class="article-layout-container">
    <div class="container">

      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} />

      <div class="article-grid">

        <!-- Main Column -->
        <div class="article-main">
          <header class="article-header">
            <span class="article-category-badge">{frontmatter.category.replace('-', ' ')}</span>
            <h1 class="article-title">{frontmatter.title}</h1>
          </header>

          <!-- Featured Educational Video (Placed directly after H1 & Quick Answer) -->
          {articleVideoId && (
            <div id="article-featured-video" class="article-featured-video-wrap" style="margin-block: 1.5rem 2rem;">
              <VideoPlayerCard
                videoId={articleVideoId}
                title={frontmatter.videoTitle || articleVideo?.title}
                duration={articleVideo?.duration}
                category={articleVideo?.category}
                publishedDate={articleVideo?.publishedDate}
                relatedToolUrl={articleVideo?.relatedToolUrl}
                relatedToolTitle={articleVideo?.relatedToolTitle}
                showDetails={false}
                showSubscribeCTA={true}
                includeSchema={true}
                variant="featured"
              />
            </div>
          )}

          <!-- Article body (Quick Answer renders directly below H1) -->
          <div class="article-body">
            <slot />
          </div>

          <!-- Position video right after Quick Answer inside the article flow -->
          {articleVideoId && (
            <script is:inline>
              (function() {
                var vid = document.getElementById('article-featured-video');
                var body = document.querySelector('.article-body');
                if (!vid || !body) return;
                var quickAnswer = body.querySelector('.quick-answer-box, .aeo-direct-answer, .rmd-aeo-callout') ||
                  Array.from(body.children).find(function(el) {
                    var txt = el.textContent || '';
                    return txt.includes('Quick Answer') || (el.style && el.style.borderLeft);
                  });
                if (quickAnswer && quickAnswer.parentNode === body) {
                  quickAnswer.insertAdjacentElement('afterend', vid);
                } else {
                  body.insertAdjacentElement('afterbegin', vid);
                }
              })();
            </script>
          )}

          <!-- Table of Contents for Mobile (Inline in article flow) -->
          <div class="toc-mobile no-print">
            <TableOfContents headings={headings} />
          </div>

          <!-- Priority: Automated target="_blank" and rel="noopener noreferrer" for government links -->
          <script is:inline>
            (function() {
              document.addEventListener('DOMContentLoaded', function() {
                var articleBody = document.querySelector('.article-body');
                if (articleBody) {
                  var links = articleBody.querySelectorAll('a');
                  var govPattern = /^(https?:\/\/)?([a-z0-9-]+\.)*(gov|ssa\.gov|cms\.gov|irs\.gov|medicare\.gov|medicaid\.gov|va\.gov|ftc\.gov|consumerfinance\.gov)/i;
                  links.forEach(function(link) {
                    var href = link.getAttribute('href');
                    if (href && (href.includes('.gov') || govPattern.test(href))) {
                      link.setAttribute('target', '_blank');
                      link.setAttribute('rel', 'noopener noreferrer');
                    }
                  });
                }
              });
            })();
          </script>

          <!-- Official Sources (At end of article content) -->
          {frontmatter.sources && frontmatter.sources.length > 0 && (
            <section class="article-sources" aria-labelledby="sources-heading">
              <h2 id="sources-heading" class="sources-title">Official Sources</h2>
              <ul class="sources-list" role="list">
                {frontmatter.sources.map((src: Source) => (
                  <li>
                    <a
                      href={src.url}
                      class="source-link"
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                      {src.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Related Tools -->
          {frontmatter.relatedTools && frontmatter.relatedTools.length > 0 && (
            <section class="article-related-tools" aria-labelledby="related-tools-heading">
              <h2 id="related-tools-heading" class="related-tools-title">Related Calculators &amp; Tools</h2>
              <ul class="related-tools-list" role="list">
                {frontmatter.relatedTools.map((tool: RelatedTool) => (
                  <li>
                    <a href={tool.href} class="related-tool-link">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                      {tool.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Optional Planning Resource (Category-Aware) -->
          {articleProduct && (
            <ProductCTA
              heading={articleProduct.heading}
              context={articleProduct.context}
              productName={articleProduct.name}
              price={articleProduct.price}
              productDesc={articleProduct.desc}
              slug={articleProduct.slug}
              buttonText={articleProduct.buttonText}
              trackingEvent={articleProduct.trackingEvent}
              variant={articleProduct.variant}
            />
          )}

          <!-- Bottom: Educational Disclaimer + Author Bio card -->
          <footer class="article-footer">
            <DisclaimerBlock type="article" lastReviewed={formattedUpdatedDate || formattedDate} />
            <AuthorBio author={authorKey} />
          </footer>
        </div>

        <!-- Sidebar (Desktop only) -->
        <aside class="article-sidebar no-print" aria-label="Article Outline">
          <div class="sticky-sidebar">
            <TableOfContents headings={headings} />
          </div>
        </aside>

      </div>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <RelatedArticles articles={relatedArticles} />
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .article-layout-container {
    padding-block: var(--space-8);
  }

  .article-header {
    margin-bottom: var(--space-4);
  }

  .article-category-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  .article-title {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  /* Grid */
  .article-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 960px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      display: none;
    }
  }

  @media (min-width: 961px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile {
    margin-top: var(--space-8);
  }

  /* Body */
  .article-body {
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-5);
  }

  .article-body :global(h2) {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .article-body :global(h3) {
    font-size: var(--text-xl);
    color: var(--color-primary-light);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
  }

  /* Sources */
  .article-sources {
    margin-top: var(--space-10);
    padding: var(--space-5) var(--space-6);
    background-color: hsl(210, 20%, 97%);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .sources-title {
    font-size: var(--text-lg);
    color: var(--color-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .sources-list {
