---
/**
 * ProductLayout.astro
 * Master layout wrapper for digital product pages on seniorsaudit.com (/resources/[slug]/).
 * Strictly complies with Seniors Audit Master Prompt & AGENTS.md requirements:
 * - AEO / GEO / E-E-A-T optimization
 * - 3-Tier Natural Pathway Choice Architecture (Master Prompt conversion psychology)
 * - Required Free-Service Disclosure
 * - Author attribution with link to /about/emmanuel-t/
 * - Senior accessibility (WCAG 2.2 AA)
 */

import BaseLayout from './BaseLayout.astro';

interface FAQ {
  question: string;
  answer: string;
}

interface BundleInfo {
  name: string;
  price: number;
  standaloneValue: number;
  savings: number;
  discountPercent: number;
  permalink: string;
  description: string;
  includes: string[];
}

interface FreeTool {
  name: string;
  url: string;
  description: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  price: number;
  gumroadPermalink: string;
  thumbnailImage: string;
  backgroundImage: string;
  slug: string;
  pageCount: string;
  version?: string;
  lastReviewed: string;
  nextReview: string;
  quickAnswer?: string;
  sources: { title: string; url?: string }[];
  faqs: FAQ[];
  bundle: BundleInfo;
  coreProblem: string;      // e.g. "deciding when to claim Social Security?"
  bundleProblem: string;    // e.g. "finding senior discounts and unclaimed utility benefits?"
  freeServiceDisclosure: string; // The mandatory brand disclosure
  relatedFreeTools: FreeTool[];
}

const {
  title,
  subtitle,
  description,
  price,
  gumroadPermalink,
  thumbnailImage,
  backgroundImage,
  slug,
  pageCount,
  version = '2026.1',
  lastReviewed,
  nextReview,
  quickAnswer,
  sources,
  faqs,
  bundle,
  coreProblem,
  bundleProblem,
  freeServiceDisclosure,
  relatedFreeTools,
} = Astro.props;

const siteUrl = 'https://www.seniorsaudit.com';
const canonicalUrl = `${siteUrl}/resources/${slug}/`;
const productGumroadUrl = `https://resources.seniorsaudit.com/l/${gumroadPermalink}`;
const bundleGumroadUrl = `https://resources.seniorsaudit.com/l/${bundle.permalink}`;
const libraryGumroadUrl = `https://resources.seniorsaudit.com/l/TheCompleteSeniorsAuditLibrary`;

// Structured Data (JSON-LD) optimized for Rich Snippets, AEO, and GEO
const productSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${canonicalUrl}#product`,
      "name": title,
      "description": description,
      "disambiguatingDescription": `${description} Formatted as an interactive, printable ${pageCount} PDF and ePub decision workbook with step-by-step arithmetic and verified 2026 federal figures.`,
      "image": `${siteUrl}${thumbnailImage}`,
      "category": "Educational Workbook",
      "sku": `SA-${slug.toUpperCase().replace(/-/g, '_')}`,
      "mpn": `SA-2026-${slug.toUpperCase().replace(/-/g, '_')}`,
      "inLanguage": "en-US",
      "isAccessibleForFree": false,
      "educationalLevel": "Plain-English Educational Decision Support (Ages 60+)",
      "learningResourceType": "Planning Workbook & Action Guide",
      "material": "Printable PDF and ePub Digital Download",
      "audience": {
        "@type": "Audience",
        "audienceType": "American Seniors (60+), Retirees, Near-Retirees, and Family Caregivers"
      },
      "brand": {
        "@type": "Brand",
        "name": "Seniors Audit",
        "url": siteUrl
      },
      "author": {
        "@type": "Person",
        "name": "T. Emmanuel",
        "jobTitle": "Lead Researcher & Author",
        "url": `${siteUrl}/about/emmanuel-t/`
      },
      "publisher": {
        "@type": "Organization",
        "name": "Seniors Audit",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.png`,
          "width": 512,
          "height": 512
        }
      },
      "offers": {
        "@type": "Offer",
        "url": productGumroadUrl,
        "price": price.toFixed(2),
        "priceCurrency": "USD",
        "priceValidUntil": "2026-12-31",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": "Seniors Audit",
          "url": siteUrl
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "US",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0.00",
            "currency": "USD"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "US"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 0,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 0,
              "unitCode": "DAY"
            }
          }
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Resources & Workbooks",
          "item": `${siteUrl}/resources/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": `${title} | Seniors Audit`,
      "description": description,
      "breadcrumb": { "@id": `${canonicalUrl}#breadcrumb` }
    },
    ...(faqs && faqs.length > 0 ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }] : [])
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={thumbnailImage}
  ogImageAlt={title}
  schema={productSchema}
>
  <!-- Trust Bar -->
  <div class="product-trust-bar" role="region" aria-label="Trust highlights">
    <div class="product-trust-bar-inner">
      <span class="product-trust-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        Printable PDF + ePub Editions
      </span>
      <span class="product-trust-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Current 2026 Federal Figures
      </span>
      <span class="product-trust-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Direct Official .gov Citations
      </span>
      <span class="product-trust-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
        One-Time Purchase (No Recurring Fees)
      </span>
    </div>
  </div>

  <div class="product-page-wrapper">
    <!-- Breadcrumb Navigation -->
    <nav class="product-breadcrumbs" aria-label="Breadcrumb">
      <div class="product-container">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/resources/">Resources</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero Showcase Section -->
    <header class="product-hero">
      <div class="product-container">
        <!-- 1. Top Section: Badges, H1, Subtitle -->
        <div class="hero-header-top">
          <div class="badge-row">
            <span class="product-type-badge">{pageCount} Workbook</span>
            <span class="product-year-badge">Version {version}</span>
          </div>
          <h1 class="hero-title">{title}</h1>
          <p class="hero-subtitle">{subtitle}</p>
        </div>

        <!-- 2. Direct-Answer Opening (AEO Quick Answer Block) Below H1 -->
        {quickAnswer && (
          <section class="quick-answer-block" aria-label="Direct Answer Summary">
            <div class="quick-answer-tag">Quick Answer</div>
            <p class="quick-answer-text">{quickAnswer}</p>
          </section>
        )}

        <!-- 3. ALL IMAGES & PURCHASE BOX: PLACED BELOW H1 AND QUICK ANSWER -->
        <div class="hero-showcase-section">
          <div class="hero-grid">
            <div class="hero-media-col">
              <div class="media-card">
                <img
                  src={thumbnailImage}
                  alt={`${title} cover`}
                  class="product-main-cover"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>

            <div class="hero-cta-col">
              <div class="hero-cta-box">
                <div class="price-display">
                  <span class="price-currency">$</span>
                  <span class="price-amount">{price}</span>
                  <span class="price-note">One-time payment • Immediate digital download</span>
                </div>
                <div class="cta-actions">
                  <a
                    href={productGumroadUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary-cta"
                  >
                    <span>Get the Workbook — ${price}</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                  <p class="cta-guarantee">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    Encrypted checkout via Gumroad. Instant PDF and ePub download link sent to your email.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Canva 3-Screenshot Combined Showcase Banner -->
          {backgroundImage && (
            <div class="hero-showcase-banner">
              <p class="showcase-label">Preview: Look Inside the Actual Workbook Pages</p>
              <div class="showcase-image-wrap">
                <img
                  src={backgroundImage}
                  alt={`${title} interior pages showcase preview`}
                  class="showcase-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="product-main-content">
      <div class="product-container product-content-container">
        <!-- Slot for sections 1 to 5 (Direct answer, What's inside, Worked example, Who it's for, Outcomes) -->
        <slot />

        <!-- 7. Sources & Credibility Section -->
        <section class="sources-review-section">
          <div class="sources-card">
            <div class="sources-header">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A3D3A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <h2>Primary Sources &amp; Editorial Credibility</h2>
            </div>
            <p class="sources-intro">
              This publication was researched and written by <a href="/about/emmanuel-t/"><strong>T. Emmanuel</strong></a> and the Seniors Audit team. All calculations, thresholds, and statutory procedures are drawn directly from primary government sources:
            </p>
            <ul class="sources-list">
              {sources.map((src) => (
                <li>
                  {src.url ? (
                    <a href={src.url} target="_blank" rel="noopener noreferrer">
                      {src.title}
                    </a>
                  ) : (
                    <span>{src.title}</span>
                  )}
                </li>
              ))}
            </ul>
            <div class="review-date-bar">
              <span><strong>Last reviewed:</strong> {lastReviewed}</span>
              <span>•</span>
              <span><strong>Next scheduled review:</strong> {nextReview}</span>
              <span>•</span>
              <a href="/about/emmanuel-t/">About Lead Author T. Emmanuel &rarr;</a>
            </div>
          </div>
        </section>

        <!-- 8. FAQ Section (AEO) -->
        {faqs && faqs.length > 0 && (
          <section class="product-faq-section">
            <h2 class="section-title">Frequently Asked Questions</h2>
            <div class="faq-list">
              {faqs.map((faq) => (
                <details class="faq-item">
                  <summary class="faq-summary">
                    <span>{faq.question}</span>
                    <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <div class="faq-content">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- 9. Tier Presentation — Helpful Choice Architecture (Master Prompt Spec) -->
        <section class="tier-section" id="choose-resource">
          <div class="tier-header">
            <span class="tier-eyebrow">Natural Next Steps</span>
            <h2 class="tier-heading">Choose the Resource That Fits Your Situation</h2>
            <p class="tier-subheading">
              Select the option that matches your current scope. No upsell pressure — every resource is complete on its own.
            </p>
          </div>

          <div class="tier-grid">
            <!-- Choice 1: Specific core problem -->
            <div class="tier-card tier-card--solo">
              <div class="tier-problem-prompt">
                <span class="prompt-prefix">Option 1</span>
                <h3>Just need help with {coreProblem.replace(/\?+$/, '')}?</h3>
              </div>
              <div class="tier-product-title">{title} — ${price}</div>
              <p class="tier-card-desc">
                Focuses specifically on this decision with your own numbers, formula divisors, and fillable worksheets.
              </p>
              <div class="tier-price-box">
                <span class="tier-dollar">$</span>
                <span class="tier-amount">{price}</span>
                <span class="tier-frequency">one-time payment</span>
              </div>
              <ul class="tier-feature-list">
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Complete {pageCount} printable PDF + ePub</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Step-by-step worked math examples</span>
                </li>
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Fillable decision worksheet &amp; action steps</span>
                </li>
              </ul>
              <a
                href={productGumroadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tier btn-tier--solo"
              >
                Get {title} — ${price}
              </a>
            </div>

            <!-- Choice 2: Context-aware related problem (Highlighted) -->
            <div class="tier-card tier-card--bundle tier-card--featured">
              <div class="tier-badge-featured">Natural Next Step</div>
              <div class="tier-problem-prompt">
                <span class="prompt-prefix">Option 2</span>
                <h3>Also dealing with {bundleProblem.replace(/\?+$/, '')}?</h3>
              </div>
              <div class="tier-product-title">{bundle.name} — ${bundle.price}</div>
              <p class="tier-card-desc">{bundle.description}</p>
              <div class="tier-price-box">
                <span class="tier-dollar">$</span>
                <span class="tier-amount">{bundle.price}</span>
                <span class="tier-frequency">one-time payment</span>
                <div class="tier-savings-note">
                  <span class="tier-val-strike">${bundle.standaloneValue} value</span>
                  <span class="tier-save-badge">Save ${bundle.savings} ({bundle.discountPercent}%)</span>
                </div>
              </div>
              <ul class="tier-feature-list">
                {bundle.includes.map((item) => (
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span><strong>Includes:</strong> {item}</span>
                  </li>
                ))}
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Complete cross-topic decision system</span>
                </li>
              </ul>
              <a
                href={bundleGumroadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tier btn-tier--bundle"
              >
                Get {bundle.name} — ${bundle.price}
              </a>
            </div>

            <!-- Choice 3: Complete Library -->
            <div class="tier-card tier-card--library">
              <div class="tier-problem-prompt">
                <span class="prompt-prefix">Option 3</span>
                <h3>Want the complete Seniors Audit library?</h3>
              </div>
              <div class="tier-product-title">All 7 Planning Resources — $79</div>
              <p class="tier-card-desc">
                All 7 planning and decision resources in one collection. Best for: anyone who wants a broader retirement decision toolkit rather than solving just one issue right now.
              </p>
              <div class="tier-price-box">
                <span class="tier-dollar">$</span>
                <span class="tier-amount">79</span>
                <span class="tier-frequency">one-time payment</span>
                <div class="tier-savings-note">
                  <span class="tier-val-strike">$116 standalone value</span>
                  <span class="tier-save-badge">Save $37 (32% off)</span>
                </div>
              </div>
              <ul class="tier-feature-list tier-feature-list--compact">
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Social Security Claiming Decision Workbook</strong> ($15)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Turning 65 Medicare Enrollment Action Planner</strong> ($19)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Medicare Part B &amp; D Penalty Avoidance Kit</strong> ($12)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Senior Discounts &amp; Hidden Benefits Finder</strong> ($12)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>RMD Tax &amp; Withdrawal Planning Workbook</strong> ($15)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>IRMAA &amp; Medicare MAGI Planning Workbook</strong> ($19)</span>
                </li>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span><strong>Retirement Withdrawal &amp; Medicare Cost Planner</strong> ($24)</span>
                </li>
              </ul>
              <a
                href={libraryGumroadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tier btn-tier--library"
              >
                Get Complete Library — $79
              </a>
            </div>
          </div>

          <!-- 10. Free-Service Disclosure (Mandatory Brand Rule) -->
          <div class="free-service-disclosure-callout" role="note" aria-label="Free public information disclosure">
            <div class="disclosure-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A3D3A" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <span>Public Government Resource Disclosure</span>
            </div>
            <p class="disclosure-statement-text">
              {freeServiceDisclosure}
            </p>
          </div>
        </section>

        <!-- Free Calculators Cross-Reference -->
        {relatedFreeTools && relatedFreeTools.length > 0 && (
          <section class="free-tools-bridge">
            <div class="tools-bridge-inner">
              <div class="bridge-tag">Free Instant Online Calculators</div>
              <h2 class="bridge-title">Looking for an Immediate Estimate?</h2>
              <p class="bridge-desc">
                Seniors Audit provides free, ad-free instant web calculators. Use the free tools to check a specific number in seconds. Use this workbook to organize your records, model scenarios, and prepare your written filing decisions.
              </p>
              <div class="bridge-grid">
                {relatedFreeTools.map((tool) => (
                  <a href={tool.url} class="bridge-card">
                    <span class="bridge-card-name">{tool.name}</span>
                    <span class="bridge-card-desc">{tool.description}</span>
                    <span class="bridge-card-link">Use Free Calculator &rarr;</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- Educational Disclaimer Box (Midnight Navy #08111F) -->
        <section class="educational-disclaimer-box" role="note" aria-label="Educational Disclaimer">
          <div class="disclaimer-inner">
            <div class="disclaimer-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C9933A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <h3>Educational Disclosure &amp; Independence Statement</h3>
