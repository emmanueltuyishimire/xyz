---
/**
 * BaseLayout.astro
 * The root HTML shell used by all pages on seniorsaudit.com.
 * Contains: <head>, Header, Footer, SkipLink, and global scripts.
 * 
 * Props:
 *   title          - Page title (required, max 60 chars)
 *   description    - Meta description (required, max 160 chars)
 *   canonical      - Canonical URL override (optional)
 *   ogImage        - Open Graph image URL (optional)
 *   ogType         - 'website' | 'article' (default: 'website')
 *   noindex        - Prevent indexing (default: false)
 *   schema         - Page-specific JSON-LD schema (optional)
 *   keywords       - Meta keywords (optional)
 */

import SkipLink from '@components/layout/SkipLink.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '@styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articleAuthor?: string;
  articleModifiedTime?: string;
  articlePublishedTime?: string;
  articleSection?: string;
  noindex?: boolean;
  schema?: object | object[];
  keywords?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.jpg',
  ogImageAlt = 'Seniors Audit — Plain-English Government Benefits Education',
  ogType = 'website',
  articleAuthor,
  articleModifiedTime,
  articlePublishedTime,
  articleSection,
  noindex = false,
  schema,
  keywords,
} = Astro.props;

const siteUrl = 'https://www.seniorsaudit.com';
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const pageTitle = title.includes('Seniors Audit') ? title : `${title} | Seniors Audit`;
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Seniors Audit",
      "alternateName": [
        "SeniorsAudit",
        "Seniors Audit dot com",
        "Retirement Benefits Decoded"
      ],
      "url": `${siteUrl}`,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}/logo.png`,
        "contentUrl": `${siteUrl}/logo.png`,
        "width": 512,
        "height": 512,
        "caption": "Seniors Audit Logo"
      },
      "image": `${siteUrl}/logo.png`,
      "description": "Independent educational platform providing free Medicare calculators, Social Security tools, and retirement benefits guides for American seniors. No account required. No data sold. Verified against official government sources.",
      "email": "support@seniorsaudit.com",
      "foundingDate": "2026",
      "areaServed": { "@type": "Country", "name": "United States" },
      "knowsAbout": [
        "Medicare",
        "Medicaid",
        "Social Security",
        "IRMAA surcharge",
        "Medicare Advantage",
        "Medigap",
        "Medicare Part D",
        "Full retirement age",
        "IRS notices",
        "Retirement benefits",
        "Senior benefits",
        "Elder care planning"
      ],
      "founder": [
        {
          "@type": "Person",
          "name": "T. Emmanuel",
          "alternateName": "TUYISHIMIRE Emmanuel",
          "url": `${siteUrl}/about/emmanuel-t/`,
          "sameAs": [
            "https://www.linkedin.com/in/emmanueltuyishimire",
            "https://web.facebook.com/profile.php?id=61590667687592",
            "https://www.reddit.com/user/Emmanuel_Tuyishimire/"
          ]
        }
      ],
      "sameAs": [
        "https://www.youtube.com/@SeniorsAudit",
        "https://web.facebook.com/SeniorsAudit"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Seniors Audit",
      "inLanguage": "en-US",
      "description": "Independent educational platform providing plain-English guides, free calculators, and official-source verified information on Medicare, Social Security, IRS notices, and retirement benefits.",
      "publisher": { "@id": `${siteUrl}/#organization` }
    }
  ]
};

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
let breadcrumbSchema = null;

// Comprehensive slug → human-readable label map
// Covers all tools, hubs, and known URL segments
const SLUG_LABELS: Record<string, string> = {
  // Site sections
  'tools':          'Tools',
  'medicare':       'Medicare',
  'medicaid':       'Medicaid',
  'irs':            'IRS',
  'retirement':     'Retirement',
  'social-security':'Social Security',
  'taxes':          'Taxes',
  'blog':           'Blog',
  'about':          'About',
  'contact':        'Contact',
  'privacy-policy': 'Privacy Policy',
  'disclaimer':     'Disclaimer',
  'terms-of-use':   'Terms of Use',
  'emmanuel-t':     'T. Emmanuel',
  // Medicare sub-hubs
  'basics':                 'Medicare Basics',
  'enrollment':             'Medicare Enrollment',
  'plan-comparison':        'Plan Comparison',
  'medicare-advantage':     'Medicare Advantage',
  'costs-and-penalties':    'Costs & Penalties',
  'part-d':                 'Part D',
  'at-65':                  'Medicare at 65',
  'costs':                  'Costs',
  'problems':               'Common Problems',
  // Social Security tools
  'social-security-full-retirement-age-calculator':  'Full Retirement Age Calculator',
  'social-security-benefits-estimator':              'Benefits Estimator',
  'social-security-break-even-calculator':           'Break-Even Calculator',
  'ssa-earnings-test-calculator':                    'Earnings Test Calculator',
  'social-security-spousal-benefit-calculator':      'Spousal Benefit Calculator',
  'social-security-survivor-benefit-calculator':     'Survivor Benefit Calculator',
  'should-i-delay-social-security':                  'Should I Delay Social Security?',
  'social-security-cola-estimator':                  'COLA Estimator',
  'ssdi-estimate-calculator':                        'SSDI Estimate Calculator',
  // Medicare premium & enrollment tools
  'magi-for-medicare-calculator':                    'MAGI for Medicare Calculator',
  'medicare-irmaa-calculator':                       'IRMAA Calculator',
  'medicare-premium-calculator':                     'Premium Calculator',
  'medicare-late-enrollment-penalty-calculator':     'Late Enrollment Penalty Calculator',
  'medicare-part-d-late-enrollment-penalty-calculator': 'Part D Late Penalty Calculator',
  'medicare-enrollment-deadline-calculator':         'Enrollment Deadline Calculator',
  'medicare-effective-date-calculator':              'Effective Date Calculator',
  'should-i-appeal-my-irmaa':                        'Should I Appeal My IRMAA?',
  'irmaa-appeal-letter-generator':                   'IRMAA Appeal Letter Generator',
  // Medicare plan comparison tools
  'medicare-advantage-comparison-tool':                       'Medicare Advantage Comparison',
  'medicare-advantage-total-cost-estimator':                  'Total Cost Estimator',
  'medicare-advantage-vs-original-medicare-cost-checker':     'MA vs. Original Medicare Cost Checker',
  'medicare-advantage-vs-original-medicare-decision-helper':  'MA vs. Original Medicare Decision Helper',
  'medicare-at-65-decision-checklist':               'Medicare at 65 Decision Checklist',
  'medigap-comparison-tool':                         'Medigap Comparison Tool',
  'medigap-plan-g-vs-plan-n-calculator':             'Medigap Plan G vs. Plan N Calculator',
  'original-medicare-medigap-part-d-cost-estimator': 'Original Medicare + Medigap + Part D Estimator',
  'medicare-donut-hole-calculator':                  'Donut Hole Calculator',
  'medicare-savings-estimator':                      'Savings Estimator',
  'medicare-worst-case-exposure-calculator':         'Worst-Case Exposure Calculator',
  'medicare-prescription-drug-cost-estimator':       'Prescription Drug Cost Estimator',
  'extra-help-eligibility-calculator':               'Extra Help Eligibility Calculator',
  // IRS tools
  'irs-cp14-notice-decoder':   'CP14 Notice Decoder',
  'irs-cp504-notice-decoder':  'CP504 Notice Decoder',
  'irs-lt11-notice-decoder':   'LT11 Notice Decoder',
  'irs-cp90-notice-decoder':   'CP90 Notice Decoder',
  'irs-cp2000-response-guide': 'CP2000 Response Guide',
  // Retirement tools
  'rmd-calculator':                     'RMD Calculator',
  'roth-conversion-calculator':         'Roth Conversion Calculator',
  'ira-401k-withdrawal-planner':        'IRA / 401(k) Withdrawal Planner',
  'retirement-tax-estimator':           'Retirement Tax Estimator',
  'retirement-tax-withholding-calculator': 'Tax Withholding Calculator',
  // Scam & Fraud tools
  'scam-message-call-decoder':               'Scam Message & Call Decoder',
  'is-this-real-letter-checker':             'Is This a Real Letter?',
  'robocall-caller-id-guide':                'Robocall Caller ID Guide',
  'gift-card-wire-transfer-scam-checklist':  'Gift Card & Wire Scam Checklist',
  'romance-scam-red-flag-checklist':         'Romance Scam Red Flags Checklist',
  'ai-voice-clone-grandkid-scam-verification': 'AI Voice Clone Scam Verifier',
  'family-trusted-contact-setup-guide':      'Trusted Contact Setup Guide',
  // Benefits & assistance tools
  'universal-senior-benefits-screener':       'Benefits Screener',
  'snap-eligibility-calculator-for-seniors':  'SNAP Eligibility Calculator',
  'liheap-eligibility-checker':               'LIHEAP Eligibility Checker',
  'property-tax-relief-checker':              'Property Tax Relief Checker',
  'senior-discount-finder':                   'Senior Discount Finder',
  // Medical bills tools
  'hospital-bill-line-item-checker':   'Hospital Bill Line-Item Checker',
  'how-to-dispute-a-medical-bill':     'How to Dispute a Medical Bill',
  'prescription-price-comparison-guide': 'Prescription Price Comparison',
  // Caregiver tools
  'do-i-need-care-options-wizard':     'Do I Need Care? Options Wizard',
  'family-caregiver-cost-calculator':  'Family Caregiver Cost Calculator',
  'care-facility-cost-comparison':     'Care Facility Cost Comparison',
  'advance-directive-healthcare-poa-guide': 'Advance Directive & Healthcare POA Guide',
  // Independence tools
  'local-senior-transportation-finder': 'Local Transportation Finder',
  'smartphone-video-call-setup-guide':  'Smartphone & Video Call Setup Guide',
  'telehealth-how-it-works':            'How Telehealth Works',
  'fall-risk-home-safety-checklist':    'Fall Risk & Home Safety Checklist',
  // Estate tools
  'simple-will-estate-basics-explainer': 'Will & Estate Basics',
  'funeral-cost-planning-checklist':     'Funeral Cost Planning Checklist',
  'probate-timeline-explainer':          'Probate Timeline Explainer',
};

const hasExplicitBreadcrumbs = schema && JSON.stringify(schema).includes('BreadcrumbList');

if (!isHome && !hasExplicitBreadcrumbs) {
  const parts = pathname.replace(/^\/|\/$/, '').split('/');
  const itemsList = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl }];
  let currentPath = '';
  parts.forEach((part, index) => {
    currentPath += `/${part}`;
    const currentHref = `${siteUrl}${currentPath}/`;
    const isLast = index === parts.length - 1;
    // Use lookup table first, then fall back to auto-title-casing
    const label = isLast
      ? title.split('|')[0].trim()
      : (SLUG_LABELS[part] ?? part.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()));
    itemsList.push({ "@type": "ListItem", "position": index + 2, "name": label, "item": currentHref });
  });
  breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": itemsList };
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Analytics: Ahrefs Analytics only — no cookies, no personal identifiers, privacy-first.
       GA4 removed 2026-08 to match privacy policy (Section 4B) and eliminate CCPA ad-tech risk. -->

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary SEO Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Seniors Audit Research Team" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="en-US" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  <!-- Language and Region Signals -->
  <meta name="language" content="en-US" />
  <meta http-equiv="content-language" content="en-us" />

  <!-- Search Engine Verification — replace placeholders with your actual codes -->
  <!-- <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" /> -->
  <!-- <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" /> -->

  <!-- Indexing Control -->
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

  <!-- Open Graph (Facebook, LinkedIn) -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:secure_url" content={ogImageURL} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:site_name" content="Seniors Audit" />
  <meta property="og:locale" content="en_US" />
  {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  {ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
  {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@SeniorsAudit" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Favicon — standard ico for browsers -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0A3D3A" /> <!-- Brand Deep Teal #0A3D3A -->

  <!-- Entity / Brand Verification Network (Cryptographic rel="me" links) -->
  <link rel="me" href="https://www.wikidata.org/wiki/Q140329700" />
  <link rel="me" href="https://www.youtube.com/@SeniorsAudit" />
  <link rel="me" href="https://web.facebook.com/SeniorsAudit" />


  <!-- Self-Hosted High-Performance Fonts (Zero Render-Blocking Network Requests) -->
  <link rel="preload" href="/fonts/atkinson-hyperlegible-v12-normal-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/atkinson-hyperlegible-v12-normal-700.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Netlify Identity — only loaded on admin page -->
  <!-- (Injected per-page, not globally, to keep performance optimal) -->

  <!-- Site-wide Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  
  <!-- Page-specific Structured Data (single schema or array of schemas) -->
  {schema && Array.isArray(schema)
    ? schema.map((s: object) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
    : schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  }

  <!-- Dynamic BreadcrumbList Structured Data -->
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

  <!-- Ahrefs Analytics: Deferred to idle callback after full interaction to eliminate main-thread blocking -->
  <script is:inline>
    (function() {
      function loadAhrefs() {
        var s = document.createElement('script');
        s.src = 'https://analytics.ahrefs.com/analytics.js';
        s.setAttribute('data-key', 'avEb2OAExRLzJAi5UojSBA');
        s.async = true;
        document.head.appendChild(s);
      }
      if ('requestIdleCallback' in window) {
        window.addEventListener('load', function() { requestIdleCallback(loadAhrefs, { timeout: 3000 }); });
      } else {
        window.addEventListener('load', function() { setTimeout(loadAhrefs, 2500); });
      }
    })();
  </script>

  <!-- Theme Init: runs synchronously before paint to prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      try {
        var saved = localStorage.getItem('sa-theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      } catch(e) {}
    })();
  </script>

  <!-- Google tag (gtag.js) - Google Analytics 4
       Deferred to after full page load so it cannot block LCP or FCP.
       preconnect hints let the browser open the TCP+TLS connection early
       while still keeping the script off the critical render path. -->
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  <script is:inline>
    (function() {
      function loadGA4() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XVX92VDPCE';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-XVX92VDPCE', { anonymize_ip: true });
      }
      if (document.readyState === 'complete') {
        requestIdleCallback ? requestIdleCallback(loadGA4) : loadGA4();
      } else {
        window.addEventListener('load', function() {
          requestIdleCallback ? requestIdleCallback(loadGA4, { timeout: 4000 }) : setTimeout(loadGA4, 1000);
        });
      }
    })();
  </script>

  <!-- Google AdSense — Auto Ads -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3042243846300811"
       crossorigin="anonymous"></script>
</head>


<body>
  <!-- Priority 9: Announcement banner — date-triggered display logic -->
  <div class="announcement-banner" role="region" aria-label="Important announcement" id="enrollment-banner">
    <div class="announcement-inner">
      <span class="announcement-text" id="banner-text">
        <strong>Medicare Open Enrollment opens October 15, 2026.</strong>
        Our 2026 Plan Comparison Guide is updated and ready.
      </span>
      <a href="/medicare/" class="announcement-link" id="banner-link">Read the guide →</a>
    </div>
  </div>
  <script is:inline>
    // Date-triggered banner display logic
    (function() {
      var now = new Date();
      var aep_start = new Date('2026-10-15T00:00:00');
      var aep_end   = new Date('2026-12-07T23:59:59');
      var ma_end    = new Date('2027-03-31T23:59:59');
      var banner  = document.getElementById('banner-text');
      var link    = document.getElementById('banner-link');
      if (!banner || !link) return;
      if (now >= aep_start && now <= aep_end) {
        banner.innerHTML = '<strong>Medicare Open Enrollment is NOW OPEN</strong> — closes December 7, 2026. Read our free enrollment guide to understand your options.';
        link.textContent = 'Read the guide →';
        link.href = '/medicare/';
      } else if (now > aep_end && now <= ma_end) {
        banner.innerHTML = '<strong>Medicare Advantage Open Enrollment</strong> runs January 1 – March 31, 2027. Switch once during this window.';
        link.textContent = 'Learn more →';
        link.href = '/medicare/';
      }
    })();
  </script>

  <!-- Skip Navigation — WCAG 2.4.1 — visible on focus for keyboard/screen reader users -->
  <SkipLink />
  
  <!-- Site Header -->
  <Header />
  
  <!-- Main Content -->
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  
  <!-- Site Footer -->
  <Footer />
</body>
</html>
