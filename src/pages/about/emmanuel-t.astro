---
/**
 * emmanuel-t.astro
 * T. Emmanuel's Author profile page (E-E-A-T compliance).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Card from '@components/common/Card.astro';

const breadcrumbItems = [
  { label: 'About Us', href: '/about/' },
  { label: 'T. Emmanuel' }
];

// Profile Schema for JSON-LD Person representation
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.seniorsaudit.com/about/emmanuel-t/#person",
  "name": "T. Emmanuel",
  "alternateName": "TUYISHIMIRE Emmanuel",
  "url": "https://www.seniorsaudit.com/about/emmanuel-t/",
  "jobTitle": "Founder, Lead Researcher & Educational Content Author",
  "worksFor": {
    "@type": "Organization",
    "@id": "https://www.seniorsaudit.com/#organization",
    "name": "Seniors Audit",
    "url": "https://www.seniorsaudit.com"
  },
  "description": "T. Emmanuel is the founder of Seniors Audit. He researches government benefits programs including Social Security, Medicare, and IRS regulations, creating plain-language translation tools and calculators for older adults.",
  "knowsAbout": [
    "Medicare Part A and Part B",
    "Medicare Advantage",
    "IRMAA surcharges",
    "Social Security retirement benefits",
    "Social Security spousal and survivor benefits",
    "IRS tax notices",
    "Required Minimum Distributions",
    "Retirement income planning",
    "Medicaid and Medicare Savings Programs"
  ],
  "sameAs": [
    "https://www.linkedin.com/in/emmanueltuyishimire",
    "https://www.youtube.com/@SeniorsAudit",
    "https://web.facebook.com/profile.php?id=61590667687592",
    "https://www.reddit.com/user/Emmanuel_Tuyishimire/"
  ]
};
---

<BaseLayout 
  title="T. Emmanuel — Biography & Profile" 
  description="Learn about T. Emmanuel, founder and researcher at Seniors Audit. Read his background, E-E-A-T editorial standards, and commitment to benefit guidance."
  schema={personSchema}
>
  <div class="profile-page-container">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} />

      <div class="profile-layout-grid">
        
        <!-- Main profile details -->
        <main class="profile-main-content">
          <header class="profile-header-card">
            <div class="profile-avatar-row">
              <div class="avatar-large-wrapper">
                <img
                  src="/emmanuel.png"
                  alt="T. Emmanuel"
                  class="avatar-large-img"
                  width="96"
                  height="96"
                  loading="eager"
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="avatar-large-fallback" aria-hidden="true" style="display:none;">ET</div>
              </div>
              <div class="title-meta">
                <span class="profile-label">Author &amp; Founder</span>
                <h1 class="profile-name">T. Emmanuel</h1>
                <span class="profile-role">Founder &amp; Lead Benefits Researcher, Seniors Audit</span>
                <a href="https://www.linkedin.com/in/emmanueltuyishimire" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent-light); text-decoration: underline; font-size: 0.875rem; margin-top: 4px; display: inline-block;">Connect on LinkedIn →</a>
              </div>
            </div>
          </header>

          <section class="profile-bio-section">
            <h2>About T. Emmanuel</h2>
            <p>
              T. Emmanuel (TUYISHIMIRE Emmanuel) is the founder and lead benefits researcher at Seniors Audit, based in Kigali, Rwanda. He built this site after spending months watching American seniors in online communities struggle to understand the rules governing programs they paid into their entire working lives — rules written in legal language, scattered across government PDFs, and too often explained on websites that existed primarily to sell them something.
            </p>
            <p>
              His response was to go to the primary source documents — the Social Security Act, IRS Revenue Procedures, SSA Program Operations Manual System (POMS), and CMS Medicare Benefit Policy Manuals — and build plain-English translations and calculators that reflect what those documents actually say, not what a sales-oriented summary says they say.
            </p>

            <h2>What He Researches</h2>
            <p>
              At Seniors Audit, Emmanuel's work focuses on translating the mathematical formulas and legal language behind the programs that matter most to American retirees:
            </p>
            <ul>
              <li><strong>Social Security Administration (SSA) formulas</strong> — including the Primary Insurance Amount (PIA) bend points from 42 U.S.C. § 415, Full Retirement Age rules, spousal benefit limits, the Windfall Elimination Provision (WEP), and the Government Pension Offset (GPO).</li>
              <li><strong>Medicare cost rules</strong> — including IRMAA premium surcharges from SSA POMS HI 01101.020, Medicare Part B and D late enrollment penalties, and Medicare Savings Program income thresholds.</li>
              <li><strong>IRS tax rules for retirees</strong> — including the IRS Social Security taxation worksheet (Publication 915), Required Minimum Distribution tables (IRS Publication 590-B), and common IRS notice types such as CP2000 and CP501.</li>
            </ul>

            <h2>A Note on Credentials</h2>
            <p>
              T. Emmanuel is an independent educational researcher and content author. He is not a licensed CPA, Enrolled Agent, CFP, attorney, or any other type of credentialed professional advisor. Seniors Audit does not provide personalized tax, financial, or legal advice — and every page on this site says so clearly.
            </p>
            <p>
              What he brings to this work is a commitment to reading primary source documents directly, showing the math, citing the specific government publication behind every formula, and writing in plain English that a 65-year-old who has never read a CFR citation can follow. The value of this site is in the sourcing and the translation — not in the author's professional credentials.
            </p>
            <p>
              For decisions that require personalized professional judgment — filing an appeal, disputing an IRS notice, or optimizing a complex claiming strategy — this site consistently directs readers to the appropriate licensed professionals or government resources.
            </p>

            <h2>Why a Researcher in Rwanda Writes About U.S. Benefits</h2>
            <p>
              The rules governing Social Security, Medicare, and IRS notices are public law. They are documented in government publications that anyone can access, read, and explain — regardless of where they live. The POMS is online. The CFR is online. IRS publications are free to download. What most sites fail to do is read those documents carefully and explain them honestly without a financial product to sell on the back end.
            </p>
            <p>
              Emmanuel does that work from Kigali, using the same primary sources that a U.S.-based researcher would use — SSA.gov, IRS.gov, Medicare.gov, and the Cornell Law School Legal Information Institute (LII) — and is transparent about his location because transparency is the point of this site.
            </p>
          </section>

          <section class="profile-bio-section" style="margin-top: var(--space-10); padding-top: var(--space-6); border-top: 1px solid var(--color-border);">
            <h2>Connect With T. Emmanuel &amp; Seniors Audit</h2>
            <p>Follow Emmanuel's personal research updates or connect with the official Seniors Audit brand channels:</p>
            <ul class="social-links-list">
              <li>
                <strong>LinkedIn (Author):</strong> <a href="https://www.linkedin.com/in/emmanueltuyishimire" target="_blank" rel="noopener noreferrer">linkedin.com/in/emmanueltuyishimire</a>
              </li>
              <li>
                <strong>Reddit (Author):</strong> <a href="https://www.reddit.com/user/Emmanuel_Tuyishimire/" target="_blank" rel="noopener noreferrer">u/Emmanuel_Tuyishimire</a>
              </li>
              <li>
                <strong>Facebook (Author Profile):</strong> <a href="https://web.facebook.com/profile.php?id=61590667687592" target="_blank" rel="noopener noreferrer">T. Emmanuel Profile</a>
              </li>
              <li>
                <strong>Facebook (Brand Page):</strong> <a href="https://web.facebook.com/SeniorsAudit" target="_blank" rel="noopener noreferrer">facebook.com/SeniorsAudit</a>
              </li>
              <li>
                <strong>YouTube (Brand Channel):</strong> <a href="https://www.youtube.com/@SeniorsAudit" target="_blank" rel="noopener noreferrer">youtube.com/@SeniorsAudit</a>
              </li>
            </ul>
          </section>

        </main>

        <!-- Right: Contact/Trust details -->
        <aside class="profile-sidebar" aria-label="E-E-A-T details">
          <Card class="eeat-card">
            <h2 class="sidebar-card-title">Editorial Standards</h2>
            <p class="sidebar-card-desc">
              All guides and calculators created by T. Emmanuel on Seniors Audit follow strict editorial standards:
            </p>
            <ul class="sidebar-list">
              <li><strong>Official Sources Only:</strong> Every calculation or guide is referenced against official agency publications — IRS.gov, SSA.gov, Medicare.gov, and the POMS.</li>
              <li><strong>Plain Language:</strong> We target an 8th-grade reading level to ensure explanations are clean and accessible.</li>
              <li><strong>No Financial Sales:</strong> We do not sell insurance, financial products, or legal services.</li>
              <li><strong>Location Transparent:</strong> Based in Kigali, Rwanda. Content covers U.S. federal programs based entirely on publicly available government documents.</li>
              <li><strong>Not a Professional Advisor:</strong> T. Emmanuel is an independent researcher, not a licensed CPA, EA, CFP, or attorney. This site provides education — not advice.</li>
            </ul>
          </Card>
        </aside>

      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .profile-page-container {
    padding-block: var(--space-8);
  }

  .profile-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 860px) {
    .profile-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Header card style */
  .profile-header-card {
    background-color: var(--color-primary-dark);
    color: var(--color-text-inverse);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border-bottom: 4px solid var(--color-secondary);
    margin-bottom: var(--space-8);
  }

  .profile-avatar-row {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }

  @media (max-width: 600px) {
    .profile-avatar-row {
      flex-direction: column;
      text-align: center;
    }
  }

  .avatar-large-wrapper {
    flex-shrink: 0;
  }

  .avatar-large-img {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 4px solid var(--color-secondary-light);
    display: block;
  }

  .avatar-large-fallback {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-primary-dark);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4px solid var(--color-secondary-light);
  }

  .title-meta {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-1) / 2);
  }

  .profile-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-accent-light);
    font-weight: var(--font-bold);
    letter-spacing: 0.05em;
  }

  .profile-name {
    font-size: var(--text-3xl);
    margin: 0;
    color: #ffffff;
    line-height: var(--leading-tight);
  }

  .profile-role {
    font-size: var(--text-base);
    color: #cbd5e1;
  }

  /* Bio sections */
  .profile-bio-section h2 {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .profile-bio-section h2:first-child {
    margin-top: 0;
  }

  .profile-bio-section p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  .profile-bio-section ul {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .profile-bio-section li {
    margin-bottom: var(--space-3);
    line-height: var(--leading-normal);
  }

  .profile-bio-section li strong {
    color: var(--color-primary);
  }

  /* Social links list */
  .social-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-links-list li {
    margin-bottom: var(--space-3);
  }

  .social-links-list a {
    color: var(--color-secondary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-size: var(--text-base);
  }

  .social-links-list a:hover {
    color: var(--color-primary);
  }

  /* Sidebar styling */
  .eeat-card {
    border-color: var(--color-border);
  }

  .sidebar-card-title {
    font-size: var(--text-lg);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
    margin-top: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .sidebar-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-list li {
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    line-height: var(--leading-normal);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .sidebar-list strong {
    color: var(--color-primary);
    display: block;
    margin-bottom: calc(var(--space-1) / 2);
  }
</style>
