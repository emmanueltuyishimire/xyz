---
/**
 * about.astro
 * About Seniors Audit — Mission, editorial standards, founder, and follow links.
 * Schema: AboutPage + Person (per spec Section 8)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Card from '@components/common/Card.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';

const siteUrl = 'https://www.seniorsaudit.com';

const breadcrumbItems = [
  { label: 'About Seniors Audit' }
];

// ── SECTION 8: ABOUT PAGE SCHEMA ──────────────────────────────────────────
// AboutPage + Organization + Person (per implementation spec)
const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${siteUrl}/about/#webpage`,
      "url": `${siteUrl}/about/`,
      "name": "About Seniors Audit — Mission, Standards, and Founder",
      "description": "Learn about Seniors Audit, the independent educational resource for Medicare, Social Security, IRS notices, and retirement planning founded by Emmanuel TUYISHIMIRE.",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
          { "@type": "ListItem", "position": 2, "name": "About Seniors Audit", "item": `${siteUrl}/about/` }
        ]
      }
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Seniors Audit",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}/logo.png`,
        "contentUrl": `${siteUrl}/logo.png`,
        "width": 512,
        "height": 512,
        "caption": "Seniors Audit Logo"
      },
      "image": `${siteUrl}/logo.png`,
      "description": "Independent educational resource helping American seniors navigate Medicare, Social Security, IRS notices, and retirement benefits with plain-English guides and free calculators.",
      "foundingDate": "2026",
      "sameAs": [
        "https://www.youtube.com/@SeniorsAudit",
        "https://web.facebook.com/SeniorsAudit"
      ],
      "founder": {
        "@type": "Person",
        "@id": `${siteUrl}/about/emmanuel-tuyishimire/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/about/emmanuel-tuyishimire/#person`,
      "name": "Emmanuel TUYISHIMIRE",
      "alternateName": "TUYISHIMIRE Emmanuel",
      "url": `${siteUrl}/about/emmanuel-tuyishimire/`,
      "jobTitle": "Founder, Lead Researcher & Educational Content Author",
      "description": "Emmanuel TUYISHIMIRE is the founder of Seniors Audit. He researches government benefits programs including Social Security, Medicare, and IRS regulations, creating plain-language guides and free calculators for American seniors aged 60 and older.",
      "worksFor": {
        "@id": `${siteUrl}/#organization`
      },
      "knowsAbout": [
        "Medicare Part A and Part B",
        "Medicare Advantage",
        "IRMAA surcharges",
        "Social Security retirement benefits",
        "Social Security spousal and survivor benefits",
        "IRS tax notices",
        "Required Minimum Distributions",
        "Retirement income planning",
        "Medicaid and Medicare Savings Programs"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/emmanueltuyishimire",
        "https://web.facebook.com/profile.php?id=61590667687592",
        "https://www.reddit.com/user/Emmanuel_Tuyishimire/"
      ]
    }
  ]
};
---

<BaseLayout
  title="About Seniors Audit — Mission, Standards, and Founder"
  description="Learn about Seniors Audit, an independent educational resource for Medicare, Social Security, and IRS notice guides. Founded by researcher Emmanuel TUYISHIMIRE."
  schema={aboutSchema}
>
  <div class="about-page-container">
    <div class="container">

      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} />

      <!-- Hero -->
      <header class="about-hero">
        <div class="about-hero-inner">
          <span class="about-eyebrow">Our Mission</span>
          <h1 class="about-title">Plain-English answers for every American senior who deserves them.</h1>
          <p class="about-subtitle">
            Seniors Audit exists to give retirees, near-retirees, and their caregivers clear, verified, honest information about Medicare, Social Security, IRS notices, and retirement benefits — at no cost and with no strings attached.
          </p>
        </div>
      </header>

      <div class="about-layout-grid">

        <!-- Main Content -->
        <main class="about-main">

          <section class="about-section">
            <h2>Why Seniors Audit Exists</h2>
            <p>
              The rules governing Social Security, Medicare, IRS notices, and retirement benefits are genuinely complex. The people most affected by those rules — American seniors and their families — are routinely given two options: read government PDFs written for lawyers and actuaries, or rely on websites that exist primarily to sell them insurance products and financial services.
            </p>
            <p>
              Neither option serves anyone well. The result is that millions of seniors miss benefits they are entitled to, pay penalties they could have avoided, and make irreversible decisions without accurate information.
            </p>
            <p>
              Seniors Audit was built to fix that. We translate official government rules into plain English, verify every calculation against primary government sources, and publish everything for free — no account, no subscription, no referral fee.
            </p>
          </section>

          <section class="about-section">
            <h2>What We Cover</h2>
            <p>
              Every topic on this site relates directly to the financial and healthcare decisions faced by American seniors. We do not cover general personal finance, investment advice, or estate planning.
            </p>
            <div class="coverage-grid">
              <div class="coverage-card">
                <div class="coverage-icon">🏛️</div>
                <h3>Social Security</h3>
                <p>Full Retirement Age, spousal benefits, survivor benefits, SSDI, WEP/GPO rules, overpayments, and benefit suspension rules.</p>
              </div>
              <div class="coverage-card">
                <div class="coverage-icon">🏥</div>
                <h3>Medicare</h3>
                <p>Part A, B, C, and D explained in plain English. IRMAA surcharges, late enrollment penalties, Medigap supplements, and Annual Enrollment Period rules.</p>
              </div>
              <div class="coverage-card">
                <div class="coverage-icon">📄</div>
                <h3>IRS Notices</h3>
                <p>Plain-English explainers for the most common IRS letters seniors receive, including what they mean, what to do, and when to get professional help.</p>
              </div>
              <div class="coverage-card">
                <div class="coverage-icon">💼</div>
                <h3>Retirement Taxes</h3>
                <p>How Social Security is taxed, Required Minimum Distributions (RMDs), capital gains in retirement, and how to estimate your overall tax burden.</p>
              </div>
              <div class="coverage-card">
                <div class="coverage-icon">🏠</div>
                <h3>Medicaid &amp; Savings</h3>
                <p>The difference between Medicare and Medicaid, income and asset limits, spend-down rules, and benefit programs that help low-income seniors.</p>
              </div>
              <div class="coverage-card">
                <div class="coverage-icon">📊</div>
                <h3>Retirement Planning</h3>
                <p>Withdrawal strategies, the 4% rule, tax-efficient sequencing of income sources, and how to coordinate your benefits for the best long-term outcome.</p>
              </div>
            </div>
          </section>

          <section class="about-section">
            <h2>Our Editorial Standards</h2>
            <p>
              Every guide, article, and calculator on Seniors Audit is held to a strict set of editorial standards. We do not publish rumor or speculation. We do not repeat common online myths that happen to be wrong. We trace every claim and every formula back to its primary source.
            </p>
            <ul class="standards-list">
              <li>
                <strong>Primary Source Policy:</strong> Every calculator formula and regulatory fact on this site is cited to official government publications — including the Social Security Act, IRS revenue procedures and publications, Social Security Administration Program Operations Manual (POMS), and Medicare Benefit Policy Manuals.
              </li>
              <li>
                <strong>Annual Review Cycle:</strong> Government benefit rules change every year. Cost-of-living adjustments (COLAs), income brackets, and premium thresholds are reviewed and updated as the SSA, IRS, and CMS release new figures — typically in the fall of each year.
              </li>
              <li>
                <strong>Plain Language Standard:</strong> We write at approximately an 8th-grade reading level. We define every acronym. We avoid passive bureaucratic voice. We explain the "why" behind every rule, not just the rule itself.
              </li>
              <li>
                <strong>No Conflicts of Interest:</strong> We accept no affiliate commissions for recommending financial products, insurance policies, or services. We are not compensated by any government agency or private company to feature their programs.
              </li>
              <li>
                <strong>Transparent Limitations:</strong> When a topic is complex enough to warrant professional advice — such as a divorce, a specific IRS dispute, or a complex estate — we say so clearly. We do not pretend that a calculator replaces a conversation with a licensed professional.
              </li>
            </ul>
          </section>

          <section class="about-section">
            <h2>How We Use AI</h2>
            <p>
              Seniors Audit uses AI tools to help organize research, brainstorm article structures, and draft initial content. However, every fact, formula, and calculation is checked against official SSA, IRS, or CMS sources before publishing. Every page is human-reviewed and edited by our founder, Emmanuel TUYISHIMIRE, before it goes live. AI is a drafting assistant in this process — never a source of facts, and never a substitute for verification against primary government sources.
            </p>
          </section>

          <section class="about-section">
            <h2>Our Founder</h2>

            <div class="team-layout">
              <div class="team-member">
                <h3 style="font-size: var(--text-xl); margin-bottom: var(--space-1);"><a href="/about/emmanuel-tuyishimire/" style="color: var(--color-primary); text-decoration: underline;">Emmanuel TUYISHIMIRE</a></h3>
                <p style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--color-secondary-dark); margin: 0 0 var(--space-2) 0;">Founder, Independent Benefits Researcher &amp; Educational Content Author</p>
                <p>
                  Emmanuel TUYISHIMIRE (TUYISHIMIRE Emmanuel) is the founder of Seniors Audit, based in Kigali, Rwanda. He built this site to give American seniors access to plain-English explanations of the government programs they paid into — Social Security, Medicare, and IRS rules — using primary source government documents as his only reference: the SSA POMS, IRS publications, and CMS manuals.
                </p>
                <p>
                  He is an independent educational researcher, not a licensed professional advisor. Every page on this site is clear about that distinction, and consistently directs readers to licensed professionals for personalized decisions. <a href="/about/emmanuel-tuyishimire/" style="color: var(--color-secondary-dark); text-decoration: underline;">Read his full bio and research approach →</a>
                </p>
              </div>
            </div>
          </section>

          <section class="about-section">
            <h2>Follow Seniors Audit</h2>
            <p>
              We publish educational content, benefit updates, and retirement guides across our official channels. Following us is the best way to stay current when government rules change, new calculators launch, or annual figures are updated.
            </p>
            <div class="social-follow-grid">
              <a href="https://www.youtube.com/@SeniorsAudit" class="social-follow-card" target="_blank" rel="noopener noreferrer" aria-label="Seniors Audit YouTube Channel">
                <div class="sfcard-icon sfcard-yt">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </div>
                <div class="sfcard-info">
                  <span class="sfcard-name">YouTube (@SeniorsAudit)</span>
                  <span class="sfcard-desc">Video guides and benefit explainers</span>
                </div>
              </a>
              <a href="https://web.facebook.com/SeniorsAudit" class="social-follow-card" target="_blank" rel="noopener noreferrer" aria-label="Seniors Audit Facebook Page">
                <div class="sfcard-icon sfcard-fb">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </div>
                <div class="sfcard-info">
                  <span class="sfcard-name">Facebook Page (/SeniorsAudit)</span>
                  <span class="sfcard-desc">Official Seniors Audit community &amp; announcements</span>
                </div>
              </a>
            </div>
          </section>

          <section class="about-section">
            <h2>How This Site Is Funded &amp; Our Business Model</h2>
            <p>
              Seniors Audit is an independently operated educational website. All guides, calculators, and decision tools on this site are and will always remain free to access. No account, subscription, or registration is ever required to use them.
            </p>
            <p>
              <strong>Display Advertising (Pending):</strong> Once active, this site will be supported by display advertising served through a third-party advertising partner. Ads will be clearly separate from editorial content. Advertisers have no influence over our guides, calculator formulas, research, or recommendations. You can opt out of interest-based advertising at <a href="https://optout.aboutads.info/" target="_blank" rel="noopener noreferrer">optout.aboutads.info</a>.
            </p>
            <p>
              <strong>Optional Educational Digital Products (Planned):</strong> We plan to offer optional, low-cost printable resources — such as retirement planning worksheets, Medicare decision checklists, and Social Security benefit guides — as downloadable digital products. These are strictly educational supplements to the free content on this site. They will be clearly labeled and priced, and will never be required to access any free tool or guide. We will only partner with payment processors that meet standard consumer protection and data security standards.
            </p>
            <p>
              <strong>What We Do Not Do:</strong> We do not sell insurance policies, Medicare Advantage plans, annuities, investment products, or legal services. We do not accept commissions, referral fees, or lead-generation payments for directing users toward financial or insurance products. We do not sell your personal data to advertisers, brokers, or any third party. Our editorial decisions are made independently of any advertising or commercial relationship.
            </p>
            <p>
              <strong>Advertiser Compatibility Standards:</strong> We reserve the right to block ad categories that conflict with our mission. We will not knowingly allow ads from predatory financial lead-generation networks, payday lenders, or misleading Medicare marketing companies. Readers who see an ad they believe violates these standards are encouraged to report it to <a href="mailto:support@seniorsaudit.com">support@seniorsaudit.com</a>.
            </p>
          </section>

          <DisclaimerBlock type="site" />

        </main>

        <!-- Right: Sidebar -->
        <aside class="about-sidebar" aria-label="Quick Facts">
          <Card class="about-facts-card">
            <h2 class="facts-title">Quick Facts</h2>
            <ul class="facts-list">
              <li>
                <strong>Website</strong>
                <p>seniorsaudit.com</p>
              </li>
              <li>
                <strong>Founded</strong>
                <p>2026 by Emmanuel TUYISHIMIRE</p>
              </li>
              <li>
                <strong>Focus</strong>
                <p>Social Security, Medicare, IRS notices, retirement taxes, Medicaid</p>
              </li>
              <li>
                <strong>Primary Audience</strong>
                <p>Seniors, retirees, family caregivers, veterans, disabled individuals</p>
              </li>
              <li>
                <strong>Tools Offered</strong>
                <p>Free interactive calculators, plain-English guides, notice explainers, decision checklists</p>
              </li>
              <li>
                <strong>Business Model</strong>
                <p>Free educational calculators and guides. Supported by display advertising from a third-party advertising partner and optional downloadable educational planning workbooks. No insurance sales or affiliate financial product promotions.</p>
              </li>
              <li>
                <strong>Location</strong>
                <p>Researched &amp; maintained independently from Kigali, Rwanda, analyzing U.S. federal agency rules.</p>
              </li>
              <li>
                <strong>Affiliation</strong>
                <p>Fully independent. Not affiliated with the SSA, IRS, CMS, HHS, or any other government agency.</p>
              </li>
              <li>
                <strong>Content Standard</strong>
                <p>All formulas and facts cited to official government source documents</p>
              </li>
            </ul>
          </Card>

          <Card class="about-links-card">
            <h2 class="facts-title">Important Pages</h2>
            <ul class="quick-links-list">
              <li><a href="/disclaimer/">General Disclaimer</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms-of-use/">Terms of Use</a></li>
              <li><a href="/resources/">Resources &amp; Workbooks</a></li>
              <li><a href="/contact/">Contact Us</a></li>
              <li><a href="/tools/">All Calculators</a></li>
            </ul>
          </Card>
        </aside>

      </div>

    </div>
  </div>
  <section class="container" style="max-width: 900px; margin: 2rem auto; padding: 1.5rem 1rem;">
    <div style="padding: 1.5rem; background: #F8FAFC; border-radius: 8px; border: 1px solid #E2E8F0;">
      <h3 style="margin-top: 0; color: #0A3D3A;">Related Senior Resource</h3>
          <div class="related-tool-item" style="margin-top: 1rem; padding: 1rem; border: 1px solid #E2E8F0; border-radius: 8px; background: #F8FAFC;">
            <a href="/blog/welcome-to-seniorsaudit/" style="font-weight: 700; color: #0A3D3A; text-decoration: underline; font-size: 1.05rem;">Welcome to Seniors Audit</a>
            <p style="margin: 0.25rem 0 0; color: #4A5568; font-size: 0.95rem;">Read our founding mission, editorial standards, and commitment to free educational tools.</p>
          </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page-container {
    padding-block: var(--space-8);
  }

  /* Hero */
  .about-hero {
    margin-bottom: var(--space-12);
    padding: var(--space-12) var(--space-8);
    background: linear-gradient(135deg, hsl(211, 80%, 96%) 0%, hsl(186, 60%, 94%) 100%);
    border-radius: var(--radius-lg);
    border-left: 5px solid var(--color-secondary);
  }

  .about-hero-inner {
    max-width: 720px;
  }

  .about-eyebrow {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-secondary-dark);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
  }

  .about-title {
    font-size: var(--text-4xl);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .about-subtitle {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-width: 640px;
    margin-bottom: 0;
  }

  /* Layout */
  .about-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about-layout-grid {
      grid-template-columns: 1fr;
    }
    .about-sidebar {
      order: -1;
    }
  }

  /* Sections */
  .about-section {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .about-section:last-child {
    border-bottom: none;
  }

  .about-section h2 {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-top: 0;
    margin-bottom: var(--space-5);
  }

  .about-section p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  .about-section p:last-child {
    margin-bottom: 0;
  }

  /* Coverage Grid */
  .coverage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (max-width: 640px) {
    .coverage-grid {
      grid-template-columns: 1fr;
    }
  }

  .coverage-card {
    background: var(--color-bg-subtle, hsl(210, 30%, 98%));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .coverage-icon {
    font-size: 1.75rem;
    margin-bottom: var(--space-3);
    line-height: 1;
  }

  .coverage-card h3 {
    font-size: var(--text-base);
    color: var(--color-primary);
    margin-top: 0;
    margin-bottom: var(--space-2);
    font-weight: var(--font-bold);
  }

  .coverage-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
    line-height: var(--leading-normal);
  }

  /* Standards List */
  .standards-list {
    padding-left: 0;
    list-style: none;
    margin-bottom: 0;
  }

  .standards-list li {
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--color-secondary);
    margin-bottom: var(--space-4);
    background: hsl(186, 40%, 97%);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .standards-list li strong {
    display: block;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  /* Social Follow Grid */
  .social-follow-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .social-follow-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    background: var(--color-surface, #fff);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
  }

  .social-follow-card:hover {
    border-color: var(--color-secondary);
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    transform: translateX(3px);
    text-decoration: none;
  }

  .sfcard-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #fff;
  }

  .sfcard-yt   { background-color: #FF0000; }
  .sfcard-fb   { background-color: #1877F2; }
  .sfcard-li   { background-color: #0A66C2; }
  .sfcard-rd   { background-color: #FF4500; }

  .sfcard-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sfcard-name {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
  }

  .sfcard-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Sidebar Cards */
  .about-facts-card,
  .about-links-card {
    margin-bottom: var(--space-6);
  }

  .facts-title {
    font-size: var(--text-base);
    color: var(--color-secondary-dark);
    margin-bottom: var(--space-4);
    margin-top: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-2);
    font-weight: var(--font-bold);
  }

  .facts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .facts-list li {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .facts-list li:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .facts-list strong {
