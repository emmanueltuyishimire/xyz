const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://www.seniorsaudit.com/social-security/#faqpage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'At what age can I start collecting Social Security retirement benefits?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'You can begin collecting Social Security retirement benefits as early as age 62. However, claiming before your Full Retirement Age (FRA) permanently reduces your monthly benefit. Your FRA is 66 or 67 depending on your birth year — 67 for anyone born in 1960 or later. Delaying past your FRA up to age 70 permanently increases your monthly check by 8% per year through Delayed Retirement Credits. Source: SSA Retirement Planner at ssa.gov.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How much will I get from Social Security in 2026?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'In 2026, the average Social Security retirement benefit is approximately $1,976 per month after the 2.5% COLA increase. The maximum benefit depends on when you claim: $2,969 per month at age 62, $4,152 per month at Full Retirement Age, and $5,181 per month at age 70. Your actual benefit depends on your 35 highest earnings years, adjusted for inflation, using the SSA\'s Average Indexed Monthly Earnings formula. Source: SSA OACT Benefit Calculation Details.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is my Social Security Full Retirement Age?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Your Full Retirement Age (FRA) is set by law based on your birth year. If you were born between 1943 and 1954, your FRA is 66. For each birth year from 1955 to 1959, FRA increases by 2 months: 66 and 2 months (1955), 66 and 4 months (1956), 66 and 6 months (1957), 66 and 8 months (1958), and 66 and 10 months (1959). Anyone born in 1960 or later has an FRA of exactly 67. Use our free FRA calculator at seniorsaudit.com/tools/social-security-full-retirement-age-calculator/ for your exact date.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What happens to my Social Security if I keep working?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'If you claim Social Security before your Full Retirement Age and continue to work, the SSA applies the Retirement Earnings Test. In 2026, for every $2 you earn above $24,480 per year, SSA withholds $1 in benefits. In the calendar year you reach your FRA, the threshold is $65,160 and only $1 is withheld for every $3 above that. Once you reach your FRA, the earnings test disappears entirely and you can earn any amount without reduction. Withheld benefits are not permanently lost — the SSA recalculates your benefit upward at FRA.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How do Social Security spousal benefits work?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Spousal benefits allow a spouse to collect up to 50% of their partner\'s Primary Insurance Amount (PIA) if that is larger than their own earned benefit. To receive the full 50% spousal benefit, you must claim at your own Full Retirement Age. Claiming spousal benefits before your FRA reduces the amount. You cannot receive spousal benefits until your spouse has filed for their own Social Security retirement benefit. Divorced spouses may also qualify if the marriage lasted at least 10 years.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Are Social Security benefits taxable?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Up to 85% of your Social Security benefits may be subject to federal income tax, depending on your provisional income (your adjusted gross income plus tax-exempt interest plus half of your Social Security benefits). If your provisional income is below $25,000 (individual) or $32,000 (married filing jointly), none of your benefits are taxable. Between $25,000 and $34,000 (individual) or $32,000 and $44,000 (joint), up to 50% is taxable. Above those thresholds, up to 85% is taxable. Source: IRS Publication 915.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the 2026 Social Security COLA?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The 2026 Social Security Cost-of-Living Adjustment (COLA) is 2.5%. This increase applied to all Social Security and SSI benefits starting in January 2026. COLA is calculated each year by the SSA using the Consumer Price Index for Urban Wage Earners and Clerical Workers (CPI-W) from the third quarter of one year to the third quarter of the next. A 2.5% COLA on a $2,000 monthly benefit adds $50 per month — $600 per year. Source: SSA OACT 2026 COLA announcement.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the Social Security break-even age?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The Social Security break-even age is the point where cumulative lifetime benefits from waiting to claim match cumulative lifetime benefits from claiming early. For most people, the break-even age between claiming at 62 versus Full Retirement Age (67) falls around age 78 to 79. The break-even between FRA and age 70 falls around age 82 to 83. If you expect to live past your break-even age, waiting generally results in more total lifetime income. Use the Social Security Break-Even Calculator at seniorsaudit.com/tools/social-security-break-even-calculator/ to run your specific numbers.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can I collect both my own Social Security and my spouse\'s benefit?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. You cannot collect two full Social Security benefits at the same time. If you are eligible for both your own retirement benefit and a spousal benefit, SSA pays your own benefit first. If your spousal benefit is larger, SSA pays you the difference on top of your own benefit — you effectively receive the higher of the two, not both. This is called the \"deemed filing\" rule, which has applied to all beneficiaries regardless of age since 2016 under the Bipartisan Budget Act.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How many years do I need to work to get Social Security?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'You need at least 40 work credits to qualify for Social Security retirement benefits. In 2026, you earn one credit for every $1,890 in earnings, up to a maximum of four credits per year. This means you need at least 10 years of covered work to qualify. Your actual monthly benefit amount is calculated using your 35 highest-earning years, adjusted for inflation. Each year below 35 is counted as zero earnings, which permanently reduces your average and lowers your monthly check.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the difference between SSDI and SSI?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Social Security Disability Insurance (SSDI) is a work-based program that pays benefits to disabled workers who have sufficient work credits. The amount depends on your earnings history, just like retirement benefits. Supplemental Security Income (SSI) is a needs-based program for disabled, blind, or aged individuals with limited income and resources — work history is not required. In 2026, the federal SSI benefit rate is $994 per month for an individual and $1,491 per month for a couple. SSDI recipients automatically qualify for Medicare after 24 months of benefits.',
      },
    },
  ],
