  background: var(--color-background-secondary, #F6F8FA);
  border: 1.5px solid var(--color-border, #DDE3EA);
  border-radius: 16px;
  padding: 32px;
  margin: 32px 0;
}
:global([data-theme="dark"]) .medicare-decision-center {
  background: rgba(255, 255, 255, 0.02);
  border-color: var(--color-border, #243348);
}
.decision-center-header { text-align: center; margin-bottom: 24px; }
.decision-center-eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-brand-gold, #C9933A); margin-bottom: 8px; }
:global([data-theme="dark"]) .decision-center-eyebrow { color: #E8B04A; }
.decision-center-title { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 700; color: var(--color-text, #0D2137); margin-bottom: 8px; }
.decision-center-subtitle { font-size: 1rem; color: var(--color-text-secondary, #4B5A6E); max-width: 600px; margin: 0 auto; }
.decision-doors-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.decision-door-card {
  position: relative;
  background: var(--color-surface, #ffffff);
  border: 1.5px solid var(--color-border, #DDE3EA);
  border-radius: 12px;
  padding: 20px;
  text-decoration: none;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
:global([data-theme="dark"]) .decision-door-card {
  background: var(--color-surface, #111827);
  border-color: var(--color-border, #243348);
}
.decision-door-card:hover {
  border-color: var(--color-primary, #0A3D3A);
  box-shadow: var(--shadow-md, 0 4px 16px rgba(10,61,58,0.12));
  transform: translateY(-2px);
}
:global([data-theme="dark"]) .decision-door-card:hover {
  border-color: var(--color-primary, #1DB8A8);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}
.decision-door-card.highlight-door {
  border-color: var(--color-brand-gold, #C9933A);
  background: linear-gradient(135deg, rgba(201, 147, 58, 0.06) 0%, var(--color-surface, #ffffff) 100%);
}
:global([data-theme="dark"]) .decision-door-card.highlight-door {
  border-color: #E8B04A;
  background: linear-gradient(135deg, rgba(232, 176, 74, 0.08) 0%, var(--color-surface, #111827) 100%);
}
.door-badge {
  position: absolute;
  top: -10px;
  left: 16px;
  background: var(--color-brand-gold, #C9933A);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
:global([data-theme="dark"]) .door-badge {
  background: #E8B04A;
  color: #0A0F1A;
}
.door-icon-wrap { display: flex; align-items: center; color: var(--color-brand-primary, #0A3D3A); margin-bottom: 4px; }
  :global([data-theme="dark"]) .door-icon-wrap { color: var(--color-brand-gold, #E8B04A); }
  .door-icon-wrap svg { width: 28px; height: 28px; }
.door-title { font-size: 1rem; font-weight: 700; color: var(--color-text, #0D2137); margin: 0; }
.door-desc { font-size: 0.875rem; color: var(--color-text-secondary, #4B5A6E); line-height: 1.5; margin: 0; flex: 1; }
.door-action { font-size: 0.875rem; font-weight: 600; color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .door-action { color: var(--color-primary, #1DB8A8); }

/* ── COVERS BOX ─────────────────────────────────────────────────────────── */
.covers-box { background: var(--color-background-secondary, #F6F8FA); border-radius: 10px; padding: 20px 24px; margin-top: 24px; }
:global([data-theme="dark"]) .covers-box { background: var(--color-surface, #111827); border: 1px solid var(--color-border, #243348); }
.covers-label { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--color-text-secondary, #4B5A6E); margin-bottom: 12px; }
.covers-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px 24px; }
.covers-list li::before {
  content: "\2192\00a0";
  color: var(--color-primary, #0A3D3A);
  font-weight: 700;
  font-family: system-ui, -apple-system, sans-serif;
}
:global([data-theme="dark"]) .covers-list li::before {
  color: var(--color-primary, #1DB8A8);
}
.covers-list a { color: var(--color-primary, #0A3D3A); text-decoration: none; }
:global([data-theme="dark"]) .covers-list a { color: var(--color-primary, #1DB8A8); }
.covers-list a:hover { text-decoration: underline; }

/* ── TWO-COLUMN LAYOUT ──────────────────────────────────────────────────── */
.pillar-body { display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start; }
.pillar-main { min-width: 0; }

/* ── PILLAR SECTIONS ────────────────────────────────────────────────────── */
.pillar-section { margin-bottom: 56px; padding-bottom: 56px; border-bottom: 1px solid var(--color-border, #DDE3EA); }
.pillar-section:last-child { border-bottom: none; }
.pillar-h2 { font-size: clamp(1.3rem, 2vw, 1.7rem); font-weight: 700; color: var(--color-text, #0D2137); margin-bottom: 16px; line-height: 1.3; }
.pillar-h3 { font-size: 1.1rem; font-weight: 700; color: var(--color-text, #0D2137); margin: 24px 0 10px; }
.pillar-main p { font-size: 18px; line-height: 1.8; color: var(--color-text, #1F2D3D); margin-bottom: 16px; }
.pillar-main a { color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .pillar-main a { color: var(--color-primary, #1DB8A8); }
.pillar-main a:hover { text-decoration: underline; }
.internal-link { color: var(--color-primary, #0A3D3A); font-weight: 500; }
:global([data-theme="dark"]) .internal-link { color: var(--color-primary, #1DB8A8); }
.pillar-list { padding-left: 20px; margin-bottom: 16px; }
.pillar-list li { font-size: 18px; line-height: 1.8; color: var(--color-text, #1F2D3D); margin-bottom: 8px; }
.section-bridge { font-style: italic; color: var(--color-text-secondary, #4B5A6E); font-size: 17px; border-left: 3px solid var(--color-brand-gold, #C9933A); padding-left: 16px; margin-top: 24px; }
:global([data-theme="dark"]) .section-bridge { border-left-color: #E8B04A; }

/* ── DATA TABLES ────────────────────────────────────────────────────────── */
.data-table-wrapper { overflow-x: auto; margin: 24px 0; border-radius: 10px; border: 1px solid var(--color-border, #DDE3EA); }
table { width: 100%; border-collapse: collapse; font-size: 15px; }
.table-caption { caption-side: top; text-align: left; font-size: 13px; font-weight: 600; color: var(--color-text-secondary, #4B5A6E); padding: 8px 16px 4px; }
thead tr { background: #0A3D3A; }
:global([data-theme="dark"]) thead tr { background: #0D3E3A; }
thead th { color: #ffffff; padding: 12px 16px; text-align: left; font-weight: 600; font-size: 14px; }
tbody td { padding: 12px 16px; color: var(--color-text, #1F2D3D); line-height: 1.5; border-bottom: 1px solid var(--color-border, #DDE3EA); font-size: 15px; }
.row-alt td { background: var(--color-background-secondary, #F6F8FA); }
:global([data-theme="dark"]) .row-alt td { background: rgba(255, 255, 255, 0.03); }
tbody tr:last-child td { border-bottom: none; }
.table-source { font-size: 13px; color: var(--color-text-secondary, #4B5A6E); margin: 8px 16px; }
.table-source a { color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .table-source a { color: var(--color-primary, #1DB8A8); }

/* ── TOOL CALLOUT ───────────────────────────────────────────────────────── */
.tool-callout {
  background: var(--color-background-secondary, #F6F8FA);
  border: 1.5px solid var(--color-border, #DDE3EA);
  border-left: 5px solid var(--color-primary, #0A3D3A);
  border-radius: 10px;
  padding: 20px 24px;
  margin: 28px 0;
}
:global([data-theme="dark"]) .tool-callout {
  background: rgba(29, 184, 168, 0.06);
  border-color: var(--color-border, #243348);
  border-left-color: var(--color-primary, #1DB8A8);
}
.tool-callout-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-brand-gold, #C9933A); margin: 0 0 6px 0; }
:global([data-theme="dark"]) .tool-callout-label { color: #E8B04A; }
.tool-callout-title { font-size: 1.1rem; font-weight: 700; color: var(--color-text, #0D2137); margin: 0 0 8px 0; }
.tool-callout-desc { font-size: 15px; color: var(--color-text-secondary, #4B5A6E); margin: 0 0 14px 0; line-height: 1.6; }
.tool-callout-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 12px;
}
.tool-callout-btn {
  display: inline-block;
  background-color: #0A3D3A;
  color: #FFFFFF !important;
  padding: 10px 20px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  transition: background-color 0.2s ease;
}
.tool-callout-btn:hover {
  background-color: #0D4F4B;
  color: #FFFFFF !important;
}
.tool-callout-btn--secondary {
  background-color: #072E2B;
}
.tool-callout-btn--secondary:hover {
  background-color: #0A3D3A;
  color: #FFFFFF !important;
}
:global([data-theme="dark"]) .tool-callout-btn {
  background-color: #1DB8A8;
  color: #0A0F1A !important;
}
:global([data-theme="dark"]) .tool-callout-btn:hover {
  background-color: #22D4C2;
  color: #0A0F1A !important;
}
:global([data-theme="dark"]) .tool-callout-btn--secondary {
  background-color: #189E90;
  color: #0A0F1A !important;
}
:global([data-theme="dark"]) .tool-callout-btn--secondary:hover {
  background-color: #1DB8A8;
  color: #0A0F1A !important;
}

/* ── SCENARIO BLOCK ─────────────────────────────────────────────────────── */
.scenario-block {
  background: linear-gradient(135deg, rgba(10,61,58,0.04) 0%, rgba(10,61,58,0.08) 100%);
  border: 1.5px solid var(--color-primary, #0A3D3A);
  border-left: 5px solid var(--color-brand-gold, #C9933A);
  border-radius: 10px;
  padding: 24px 26px;
  margin: 32px 0;
}
:global([data-theme="dark"]) .scenario-block {
  background: rgba(255, 255, 255, 0.03);
  border-color: var(--color-border, #243348);
  border-left-color: #E8B04A;
}
.scenario-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-brand-gold, #C9933A); margin: 0 0 6px; }
:global([data-theme="dark"]) .scenario-label { color: #E8B04A; }
.scenario-title { color: var(--color-primary, #0A3D3A); font-size: 1.1rem; margin: 0 0 16px; }
:global([data-theme="dark"]) .scenario-title { color: var(--color-primary, #1DB8A8); }
.scenario-person { background: var(--color-surface, #ffffff); border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; border: 1px solid var(--color-border, #DDE3EA); }
:global([data-theme="dark"]) .scenario-person { background: var(--color-surface, #111827); border-color: var(--color-border, #243348); }
.scenario-person strong { color: var(--color-primary, #0A3D3A); display: block; margin-bottom: 2px; }
:global([data-theme="dark"]) .scenario-person strong { color: var(--color-primary, #1DB8A8); }
.scenario-person span { color: var(--color-text-secondary, #4B5A6E); font-size: 0.875rem; }
.scenario-key-numbers { background: rgba(201,147,58,0.1); border-left: 3px solid var(--color-brand-gold, #C9933A); padding: 12px 16px; border-radius: 0 6px 6px 0; margin-top: 12px; }
:global([data-theme="dark"]) .scenario-key-numbers { background: rgba(232, 176, 74, 0.08); border-left-color: #E8B04A; }
.scenario-key-numbers ul { margin: 6px 0 0; padding-left: 18px; color: var(--color-text, #333); line-height: 1.9; font-size: 15px; }
.scenario-note { background: #FFF9EC; border-left: 3px solid #E8761A; padding: 10px 14px; border-radius: 0 6px 6px 0; margin-top: 12px; font-size: 14px; color: #4B5A6E; }
:global([data-theme="dark"]) .scenario-note { background: rgba(232, 118, 26, 0.1); color: #F0F4F8; border-left-color: #F09030; }

/* ── PITFALLS BLOCK ─────────────────────────────────────────────────────── */
.pitfalls-block { border: 1.5px solid #C53030; border-radius: 10px; padding: 24px 26px; margin: 32px 0; background: #FFFBFB; }
:global([data-theme="dark"]) .pitfalls-block { border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.04); }
.pitfalls-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #C53030; margin: 0 0 20px; }
:global([data-theme="dark"]) .pitfalls-label { color: #F87171; }
.pitfall-item { margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid #FED7D7; }
:global([data-theme="dark"]) .pitfall-item { border-bottom-color: rgba(239, 68, 68, 0.2); }
.pitfall-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.pitfall-title { color: #C53030; margin: 0 0 8px; font-size: 1rem; font-weight: 700; display: flex; align-items: flex-start; gap: 6px; }
:global([data-theme="dark"]) .pitfall-title { color: #F87171; }
.pitfall-item p { margin: 0; color: var(--color-text, #333); line-height: 1.7; font-size: 15px; }
.pitfall-item a { color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .pitfall-item a { color: var(--color-primary, #1DB8A8); }

/* ── FAQ ────────────────────────────────────────────────────────────────── */
.faq-list { display: flex; flex-direction: column; gap: 4px; }
.faq-item { border: 1px solid var(--color-border, #DDE3EA); border-radius: 8px; overflow: hidden; }
:global([data-theme="dark"]) .faq-item { border-color: var(--color-border, #243348); }
.faq-question { background: var(--color-background-secondary, #F6F8FA); padding: 16px 20px; font-size: 1rem; font-weight: 600; color: var(--color-text, #0D2137); margin: 0; cursor: pointer; }
:global([data-theme="dark"]) .faq-question { background: var(--color-surface-alt, #1A2640); }
.faq-answer { padding: 16px 20px; font-size: 17px; line-height: 1.75; color: var(--color-text, #1F2D3D); margin: 0; background: var(--color-surface, #fff); border-top: 1px solid var(--color-border, #DDE3EA); }
:global([data-theme="dark"]) .faq-answer { background: var(--color-surface, #111827); border-top-color: var(--color-border, #243348); }
.faq-answer a { color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .faq-answer a { color: var(--color-primary, #1DB8A8); }

/* ── SILO DIRECTORY (TABLE FORMAT) ──────────────────────────────────────── */
.silo-directory-section {
  background: var(--color-background-secondary, #F6F8FA);
  border-radius: 12px;
  padding: 32px;
  border: 1.5px solid var(--color-border, #DDE3EA);
}
:global([data-theme="dark"]) .silo-directory-section {
  background: rgba(255, 255, 255, 0.02);
  border-color: var(--color-border, #243348);
}
.silo-table-group {
  margin-bottom: 32px;
}
.silo-table-group:last-child {
  margin-bottom: 0;
}
.silo-cluster-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-primary, #0A3D3A);
  margin-bottom: 12px;
  padding-bottom: 6px;
  border-bottom: 2px solid rgba(10,61,58,0.15);
}
:global([data-theme="dark"]) .silo-cluster-title {
  color: var(--color-primary, #1DB8A8);
  border-bottom-color: rgba(29, 184, 168, 0.2);
}
.resource-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 3px 8px;
  border-radius: 4px;
}
.badge-guide {
  background: rgba(10, 61, 58, 0.1);
  color: #0A3D3A;
  border: 1px solid rgba(10, 61, 58, 0.25);
}
:global([data-theme="dark"]) .badge-guide {
  background: rgba(29, 184, 168, 0.15);
  color: #1DB8A8;
  border-color: rgba(29, 184, 168, 0.35);
}
.badge-tool {
  background: rgba(201, 147, 58, 0.12);
  color: #8A5E16;
  border: 1px solid rgba(201, 147, 58, 0.3);
}
:global([data-theme="dark"]) .badge-tool {
  background: rgba(232, 176, 74, 0.15);
  color: #E8B04A;
  border-color: rgba(232, 176, 74, 0.35);
}
.badge-wizard {
  background: rgba(34, 197, 94, 0.1);
  color: #15803D;
  border: 1px solid rgba(34, 197, 94, 0.25);
}
:global([data-theme="dark"]) .badge-wizard {
  background: rgba(34, 197, 94, 0.15);
  color: #4ADE80;
  border-color: rgba(34, 197, 94, 0.3);
}
.table-action-link {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary, #0A3D3A);
  white-space: nowrap;
  text-decoration: none;
}
.table-action-link:hover {
  text-decoration: underline;
  color: var(--color-primary-light, #0D4F4B);
}
:global([data-theme="dark"]) .table-action-link {
  color: var(--color-primary, #1DB8A8);
}
:global([data-theme="dark"]) .table-action-link:hover {
  color: var(--color-brand-gold, #E8B04A);
}

/* ── ACTION CHECKLIST (Matches /medicare/ design) ───────────────────────── */
.action-checklist {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-left: 0;
  list-style: none;
  counter-reset: checklist-counter;
  margin: 24px 0 0;
}
.action-checklist li {
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-text, #1F2D3D);
  padding: 18px 22px;
  background: var(--color-background-secondary, #F6F8FA);
  border-radius: 10px;
  border-left: 4px solid var(--color-brand-gold, #C9933A);
}
:global([data-theme="dark"]) .action-checklist li {
  background: var(--color-surface, #111827);
  border-color: var(--color-border, #243348);
  border-left-color: #E8B04A;
  color: #CBD5E1;
}
.action-checklist li strong {
  display: block;
  margin-bottom: 6px;
  color: var(--color-text, #0D2137);
  font-size: 17px;
}
:global([data-theme="dark"]) .action-checklist li strong {
  color: #F0F4F8;
}
.action-checklist a {
  color: var(--color-primary, #0A3D3A);
  text-decoration: underline;
  font-weight: 600;
}
:global([data-theme="dark"]) .action-checklist a {
  color: var(--color-primary, #1DB8A8);
}
.checklist-save-note {
  font-size: 14px;
  color: var(--color-text-secondary, #4B5A6E);
  font-style: italic;
  margin: 20px 0 0;
  padding: 14px 18px;
  background: var(--color-background-secondary, #F6F8FA);
  border-radius: 8px;
  border-left: 4px solid var(--color-border, #DDE3EA);
}
:global([data-theme="dark"]) .checklist-save-note {
  background: rgba(255, 255, 255, 0.02);
  border-left-color: var(--color-border, #243348);
  color: #94A3B8;
}

/* ── SOURCES & DISCLAIMER ───────────────────────────────────────────────── */
.sources-disclaimer { font-size: 14px; color: var(--color-text-secondary, #4B5A6E); line-height: 1.7; margin-top: 16px; }
.sources-disclaimer a { color: var(--color-primary, #0A3D3A); }
:global([data-theme="dark"]) .sources-disclaimer a { color: var(--color-primary, #1DB8A8); }

/* ── EDUCATIONAL DISCLAIMER (Matches /medicare/ design) ─────────────────── */
.pillar-disclaimer {
  border-left: 4px solid #E8761A;
  background: #F6F8FA;
  border-radius: 10px;
  padding: 20px 24px;
  margin: 32px 0;
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text-secondary, #4B5A6E);
}
:global([data-theme="dark"]) .pillar-disclaimer {
  background: rgba(232, 118, 26, 0.08);
  color: #CBD5E1;
}
.pillar-disclaimer a {
  color: var(--color-primary, #0A3D3A);
  text-decoration: underline;
}
:global([data-theme="dark"]) .pillar-disclaimer a {
  color: #E8B04A;
}
.pillar-disclaimer strong {
  color: var(--color-text, #0D2137);
}
:global([data-theme="dark"]) .pillar-disclaimer strong {
  color: #F0F4F8;
}

/* ── RELATED ARTICLES ───────────────────────────────────────────────────── */
.related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 16px; }
.related-card { background: var(--color-background-secondary, #F6F8FA); border: 1.5px solid var(--color-border, #DDE3EA); border-radius: 10px; padding: 18px 20px; text-decoration: none; transition: all 0.2s ease; }
:global([data-theme="dark"]) .related-card { background: var(--color-surface, #111827); border-color: var(--color-border, #243348); }
.related-card:hover { border-color: var(--color-primary, #0A3D3A); background: rgba(10,61,58,0.04); }
:global([data-theme="dark"]) .related-card:hover { border-color: var(--color-primary, #1DB8A8); background: rgba(29, 184, 168, 0.08); }
.related-title { font-size: 0.95rem; font-weight: 700; color: var(--color-text, #0D2137); margin: 0 0 8px; line-height: 1.35; }
.related-desc { font-size: 14px; color: var(--color-text-secondary, #4B5A6E); line-height: 1.5; margin: 0; }

/* ── SIDEBAR ────────────────────────────────────────────────────────────── */
.pillar-sidebar { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 20px; }
