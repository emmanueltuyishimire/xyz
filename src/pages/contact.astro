---
/**
 * contact.astro
 * Contact & Editorial Inquiries page for Seniors Audit.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Card from '@components/common/Card.astro';
import Alert from '@components/common/Alert.astro';

const breadcrumbItems = [
  { label: 'Contact Us' }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://www.seniorsaudit.com/contact/#webpage",
      "url": "https://www.seniorsaudit.com/contact/",
      "name": "Contact Us — Ask Questions or Send Feedback | Seniors Audit",
      "description": "Get in touch with Seniors Audit for site feedback, calculator suggestions, or reporting rule updates. Find official contacts for individual benefit help.",
      "isPartOf": { "@id": "https://www.seniorsaudit.com/#website" },
      "publisher": { "@id": "https://www.seniorsaudit.com/#organization" },
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.seniorsaudit.com" },
          { "@type": "ListItem", "position": 2, "name": "Contact Us", "item": "https://www.seniorsaudit.com/contact/" }
        ]
      },
      "mainEntity": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "support@seniorsaudit.com",
        "availableLanguage": {
          "@type": "Language",
          "name": "English"
        },
        "areaServed": {
          "@type": "Country",
          "name": "United States"
        }
      }
    }
  ]
};
---

<BaseLayout 
  title="Contact Us — Ask Questions or Send Feedback | Seniors Audit" 
  description="Contact the Seniors Audit team for technical feedback, bug reports, and research inquiries. Review official agency resources for personal benefit casework."
  schema={contactSchema}
>
  <div class="contact-page-container">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} />

      <div class="contact-layout-grid">
        
        <!-- Left: Main Content Column -->
        <main class="contact-main">
          <header class="contact-header">
            <h1 class="contact-title">Contact Seniors Audit</h1>
            <p class="contact-desc">
              We build free, independent calculators and educational guides to help older Americans understand Medicare, Social Security, and retirement taxes. If you have questions about our site, spotted a rule change we need to update, or want to suggest a new tool, we welcome your feedback.
            </p>
          </header>

          <!-- Educational Support Only Alert -->
          <Alert type="info" title="Educational Support Only">
            Seniors Audit is an independent educational publisher. We do not provide legal, financial, or tax advice, and we cannot review individual cases. For official case questions, please consult the government agencies and certified counseling services listed below.
          </Alert>

          <!-- Section 1 & Section 2: Scope of Support Comparison -->
          <section class="scope-comparison-grid" aria-label="Scope of Assistance">
            
            <!-- What We Can Help With -->
            <div class="scope-card scope-card--can">
              <div class="scope-card-header">
                <span class="scope-badge scope-badge--can" aria-hidden="true">&#10003;</span>
                <h2 class="scope-title">What We Can Help With</h2>
              </div>
              <ul class="scope-list">
                <li>Reporting a bug, broken link, broken calculator, or technical issue on the site</li>
                <li>Suggesting a new tool, calculator, or feature</li>
                <li>General feedback on our guides, calculators, or content</li>
                <li>Flagging outdated figures or incorrect government rule citations</li>
                <li>Media, partnership, or press inquiries</li>
              </ul>
            </div>

            <!-- What We Can't Help With -->
            <div class="scope-card scope-card--cant">
              <div class="scope-card-header">
                <span class="scope-badge scope-badge--cant" aria-hidden="true">&#10005;</span>
                <h2 class="scope-title">What We Can't Help With</h2>
              </div>
              <p class="scope-notice">
                Seniors Audit does not provide personal advice on individual Medicare, Social Security, IRS, or Medicaid situations. We are an educational publisher, not a benefits counselor, tax preparer, or legal/financial advisor.
              </p>
              <p class="scope-subhead">Specifically, we cannot:</p>
              <ul class="scope-list scope-list--cant">
                <li>Review your specific notice, bill, or denial letter</li>
                <li>File an appeal, application, or tax return on your behalf</li>
                <li>Calculate your personal benefit amount from your private wage records</li>
                <li>Give guidance tied to your individual account, SSN, or case file</li>
              </ul>
            </div>

          </section>

          <!-- Section 3: Where to Get Personal Help -->
          <section class="personal-help-section" aria-labelledby="personal-help-heading">
            <h2 id="personal-help-heading" class="section-title">Where to Get Personal Help</h2>
            <p class="personal-help-intro">
              These official and nonprofit resources can review your specific situation directly — something we're not able to do as an educational publisher.
            </p>

            <div class="agency-cards-list">
              
              <!-- Social Security Administration -->
              <div class="agency-card">
                <div class="agency-card-top">
                  <h3 class="agency-name">Social Security Administration (SSA)</h3>
                  <span class="agency-tag">Federal Benefits</span>
                </div>
                <div class="agency-details">
                  <p class="agency-contact-line">
                    <strong>Phone:</strong> 
                    <a href="tel:18007721213" class="contact-link">1-800-772-1213</a> 
                    <span class="tty-note">(TTY <a href="tel:18003250778">1-800-325-0778</a>)</span>
                  </p>
                  <p class="agency-contact-line">
                    <strong>Website:</strong> 
                    <a href="https://www.ssa.gov" target="_blank" rel="noopener noreferrer" class="contact-link">ssa.gov &rarr;</a>
                  </p>
                  <p class="agency-for-line">
                    <strong>For:</strong> Benefit applications, personal earnings records, overpayment notices, or formal benefit appeal cases.
                  </p>
                </div>
              </div>

              <!-- Medicare -->
              <div class="agency-card">
                <div class="agency-card-top">
                  <h3 class="agency-name">Medicare</h3>
                  <span class="agency-tag">Healthcare Coverage</span>
                </div>
                <div class="agency-details">
                  <p class="agency-contact-line">
                    <strong>Phone:</strong> 
                    <a href="tel:18006334227" class="contact-link">1-800-MEDICARE (1-800-633-4227)</a> 
                    <span class="tty-note">(TTY <a href="tel:18774862048">1-877-486-2048</a>)</span>
                  </p>
                  <p class="agency-contact-line">
                    <strong>Website:</strong> 
                    <a href="https://www.medicare.gov" target="_blank" rel="noopener noreferrer" class="contact-link">medicare.gov &rarr;</a>
                  </p>
                  <p class="agency-for-line">
                    <strong>For:</strong> Coverage questions, claims tracking, official Medicare Plan Finder assistance, and enrollment questions.
                  </p>
                </div>
              </div>

              <!-- SHIP -->
              <div class="agency-card agency-card--highlight">
                <div class="agency-card-top">
                  <h3 class="agency-name">State Health Insurance Assistance Program (SHIP)</h3>
                  <span class="agency-tag agency-tag--gold">Free 1-on-1 Counseling</span>
                </div>
                <div class="agency-details">
                  <p class="agency-contact-line">
                    <strong>Phone:</strong> 
                    <a href="tel:18778392675" class="contact-link">1-877-839-2675</a>
                  </p>
                  <p class="agency-contact-line">
                    <strong>Website:</strong> 
                    <a href="https://www.shiphelp.org" target="_blank" rel="noopener noreferrer" class="contact-link">shiphelp.org &rarr;</a>
                  </p>
                  <p class="agency-for-line">
                    <strong>For:</strong> Free, unbiased, one-on-one Medicare counseling organized by state. Local certified counselors help with Medigap vs. Advantage comparisons, billing disputes, appeal filings, and enrollment choices.
                  </p>
                </div>
              </div>

              <!-- IRS -->
              <div class="agency-card">
                <div class="agency-card-top">
                  <h3 class="agency-name">Internal Revenue Service (IRS)</h3>
                  <span class="agency-tag">Federal Taxes</span>
                </div>
                <div class="agency-details">
                  <p class="agency-contact-line">
                    <strong>Phone:</strong> 
                    <a href="tel:18008291040" class="contact-link">1-800-829-1040</a> 
                    <span class="tty-note">(Individuals)</span>
                  </p>
                  <p class="agency-contact-line">
                    <strong>Website:</strong> 
                    <a href="https://www.irs.gov" target="_blank" rel="noopener noreferrer" class="contact-link">irs.gov &rarr;</a>
                  </p>
                  <p class="agency-for-line">
                    <strong>For:</strong> IRS notice questions (such as CP2000 or CP14), installment payment plans, and individual tax account records.
                  </p>
                  <div class="agency-subresources">
                    <p class="subresource-item">
                      <strong>Taxpayer Advocate Service:</strong> Call <a href="tel:18777774778">1-877-777-4778</a> for unresolved IRS problems causing financial hardship.
                    </p>
                    <p class="subresource-item">
                      <strong>Low Income Taxpayer Clinics:</strong> Visit <a href="https://www.irs.gov/advocate/low-income-taxpayer-clinics" target="_blank" rel="noopener noreferrer">irs.gov/litc</a> for free or low-cost representation in IRS disputes if income-eligible.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Medicaid -->
              <div class="agency-card">
                <div class="agency-card-top">
                  <h3 class="agency-name">Medicaid</h3>
                  <span class="agency-tag">State-Administered</span>
                </div>
                <div class="agency-details">
                  <p class="agency-contact-line">
                    <strong>Website:</strong> 
                    <a href="https://www.medicaid.gov" target="_blank" rel="noopener noreferrer" class="contact-link">medicaid.gov &rarr;</a>
                  </p>
                  <p class="agency-for-line">
                    <strong>For:</strong> State-specific eligibility rules, income limits, and application filing. Because Medicaid is administered at the state level, contact your state agency directly via the <a href="https://www.medicaid.gov/state-overviews/index.html" target="_blank" rel="noopener noreferrer" class="state-dir-link">Medicaid.gov State-by-State Directory &rarr;</a>.
                  </p>
                </div>
              </div>

            </div>
          </section>

          <!-- Section 4: JotForm Embed -->
          <section class="jotform-section" aria-labelledby="form-heading">
            <div class="jotform-section-header">
              <h2 id="form-heading" class="section-title">Send Our Editorial Team a Message</h2>
              <p class="jotform-section-desc">
                Use the form below to report site issues, suggest new calculator features, flag rule updates, or share feedback on our articles.
              </p>
            </div>

            <!-- Jotform Embed Form -->
            <div class="jotform-wrapper" id="contact-form-container">
              <iframe
                id="JotFormIFrame-262683535230052"
                title="Contact Seniors Audit"
                onload="handleJotformLoad()"
                allowtransparency="true"
                allow="geolocation; microphone; camera; fullscreen"
                src="https://form.jotform.com/262683535230052"
                frameborder="0"
                style="min-width:100%;max-width:100%;width:100%;min-height:750px;height:800px;border:none;"
                scrolling="auto"
              >
              </iframe>
              <script is:inline type="text/javascript" src="https://form.jotform.com/jsform/262683535230052"></script>
              <script is:inline type="text/javascript">
                var jotformLoadCount = 0;
                function handleJotformLoad() {
                  jotformLoadCount++;
                  // On initial load (1), user is browsing normally.
                  // On subsequent loads (> 1), form has been submitted and thank you page loaded.
                  if (jotformLoadCount > 1) {
                    var target = document.getElementById("contact-form-container") || document.getElementById("JotFormIFrame-262683535230052");
                    if (target) {
                      setTimeout(function() {
                        target.scrollIntoView({ behavior: "smooth", block: "center" });
                      }, 100);
                    }
                  }
                }

                window.handleIFrameMessage = function(e) {
                  if (typeof e.data !== 'string') return;
                  var args = e.data.split(":");
                  var iframe = document.getElementById("JotFormIFrame-262683535230052");
                  if (!iframe) return;
                  switch (args[0]) {
                    case "setHeight":
                      var parsedHeight = parseInt(args[1], 10);
                      if (!isNaN(parsedHeight) && parsedHeight > 0) {
                        iframe.style.height = Math.max(parsedHeight, 750) + "px";
                      }
                      if (jotformLoadCount > 1) {
                        iframe.scrollIntoView({ behavior: "smooth", block: "center" });
                      }
                      break;
                    case "setMinHeight":
                      var parsedMin = parseInt(args[1], 10);
                      if (!isNaN(parsedMin) && parsedMin > 0) {
                        iframe.style.minHeight = Math.max(parsedMin, 750) + "px";
                      }
                      break;
                    case "scrollIntoView":
                      iframe.scrollIntoView({ behavior: "smooth", block: "center" });
                      break;
                  }
                };
                if (window.addEventListener) {
                  window.addEventListener("message", handleIFrameMessage, false);
                } else if (window.attachEvent) {
                  window.attachEvent("onmessage", handleIFrameMessage);
                }
              </script>
            </div>
            
            <!-- Direct email fallback option for users whose browsers block external frames/scripts -->
            <div class="form-fallback-note">
              <p>Having trouble submitting the form? You can also email our editorial desk directly at <a href="mailto:support@seniorsaudit.com" class="fallback-email-link">support@seniorsaudit.com</a>.</p>
            </div>
          </section>
        </main>

        <!-- Right: Sidebar -->
        <aside class="contact-sidebar" aria-label="Support info">
          
          <Card class="support-card">
            <h2 class="sidebar-title">Ways to Reach Us</h2>
            <ul class="support-list">
              <li>
                <strong>Email Support:</strong>
                <p><a href="mailto:support@seniorsaudit.com">support@seniorsaudit.com</a></p>
              </li>
              <li>
                <strong>Founding Team:</strong>
                <p>Emmanuel Tuyishimire</p>
                <p class="sub-text">Founder &amp; Lead Researcher</p>
                <p><a href="mailto:emmmanueltuyishimire766@gmail.com">emmmanueltuyishimire766@gmail.com</a></p>
              </li>
              <li>
                <strong>Response Time:</strong>
                <p>We typically respond within 1–2 business days.</p>
              </li>
            </ul>
          </Card>

          <Card class="quick-help-card">
            <h3 class="quick-help-title">Quick Casework Directory</h3>
            <p class="quick-help-note">Need one-on-one help with your actual benefits?</p>
            <ul class="quick-helpline-list">
              <li>
                <span class="helpline-label">Social Security:</span>
                <a href="tel:18007721213">1-800-772-1213</a>
              </li>
              <li>
                <span class="helpline-label">Medicare:</span>
                <a href="tel:18006334227">1-800-633-4227</a>
              </li>
              <li>
                <span class="helpline-label">Local SHIP:</span>
                <a href="tel:18778392675">1-877-839-2675</a>
              </li>
              <li>
                <span class="helpline-label">IRS Line:</span>
                <a href="tel:18008291040">1-800-829-1040</a>
              </li>
            </ul>
          </Card>

        </aside>

      </div>

    </div>
  </div>

  <!-- Related Senior Resource -->
  <section class="container" style="max-width: 900px; margin: 2rem auto; padding: 1.5rem 1rem;">
    <div style="padding: 1.5rem; background: #F8FAFC; border-radius: 8px; border: 1px solid #E2E8F0;">
      <h3 style="margin-top: 0; color: #0A3D3A;">Related Senior Resource</h3>
      <div class="related-tool-item" style="margin-top: 1rem; padding: 1rem; border: 1px solid #E2E8F0; border-radius: 8px; background: #FFFFFF;">
        <a href="/blog/welcome-to-seniorsaudit/" style="font-weight: 700; color: #0A3D3A; text-decoration: underline; font-size: 1.05rem;">Welcome to Seniors Audit</a>
        <p style="margin: 0.25rem 0 0; color: #4A5568; font-size: 0.95rem;">Learn more about how Seniors Audit audits federal benefit programs for older Americans.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page-container {
    padding-block: var(--space-8);
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 920px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .contact-header {
    margin-bottom: var(--space-6);
  }

  .contact-title {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .contact-desc {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  /* Section Title */
  .section-title {
    font-size: var(--text-2xl);
    color: #0A3D3A;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    border-bottom: 2px solid #E2E8F0;
    padding-bottom: var(--space-2);
  }

  /* Scope of Support Cards */
  .scope-comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .scope-card {
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    border: 2px solid transparent;
  }

  .scope-card--can {
    background-color: #F0FDF4;
    border-color: #86EFAC;
  }

  .scope-card--cant {
    background-color: #FFFBEB;
    border-color: #FCD34D;
  }

  .scope-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .scope-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .scope-badge--can {
    background-color: #15803D;
    color: #FFFFFF;
  }

  .scope-badge--cant {
    background-color: #B45309;
    color: #FFFFFF;
  }

  .scope-title {
    font-size: var(--text-xl);
    margin: 0;
    color: #0F172A;
  }

  .scope-notice {
    font-size: var(--text-base);
    line-height: 1.55;
    color: #1E293B;
    margin-bottom: var(--space-3);
  }

  .scope-subhead {
    font-weight: 700;
    color: #0F172A;
    margin-bottom: var(--space-2);
    font-size: 0.95rem;
  }

  .scope-list {
    margin: 0;
    padding-left: 1.25rem;
    color: #1E293B;
    line-height: 1.6;
    font-size: var(--text-base);
  }

  .scope-list li {
    margin-bottom: 0.35rem;
  }

  .scope-list li:last-child {
    margin-bottom: 0;
  }

  /* Personal Help Directory */
  .personal-help-section {
    margin-top: var(--space-8);
  }

  .personal-help-intro {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: #1E293B;
    margin-bottom: var(--space-6);
  }

  .agency-cards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .agency-card {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast);
  }

  .agency-card:hover {
    border-color: #CBD5E1;
  }

  .agency-card--highlight {
    border-color: #0A3D3A;
    background-color: #F8FAF9;
  }

  .agency-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid #F1F5F9;
    padding-bottom: var(--space-2);
  }

  .agency-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0A3D3A;
    margin: 0;
  }

  .agency-tag {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background-color: #E2E8F0;
    color: #334155;
  }

  .agency-tag--gold {
    background-color: #FEF3C7;
    color: #92400E;
    border: 1px solid #FCD34D;
  }

  .agency-details {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #1E293B;
  }

  .agency-contact-line {
    margin-bottom: 0.4rem;
    font-size: 1rem;
  }

  .agency-contact-line strong,
  .agency-for-line strong {
    color: #0F172A;
  }

  .contact-link {
    font-weight: 700;
    color: #0A3D3A;
    text-decoration: underline;
  }

  .contact-link:hover {
    color: #C9933A;
  }

  .tty-note {
    font-size: 0.85rem;
    color: #64748B;
    margin-left: 0.35rem;
  }

  .agency-for-line {
    margin-top: 0.5rem;
    margin-bottom: 0;
    color: #334155;
  }

  .agency-subresources {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: #F8FAFC;
    border-left: 3px solid #0A3D3A;
    border-radius: 0 4px 4px 0;
  }

  .subresource-item {
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .subresource-item:last-child {
    margin-bottom: 0;
  }

  .subresource-item a {
    color: #0A3D3A;
    font-weight: 700;
    text-decoration: underline;
  }

  .state-dir-link {
    font-weight: 700;
    color: #0A3D3A;
    text-decoration: underline;
  }

  /* JotForm Section */
  .jotform-section {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 2px solid #E2E8F0;
  }

  .jotform-section-header {
    margin-bottom: var(--space-4);
  }

  .jotform-section-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  /* JotForm Wrapper - responsive safety */
  .jotform-wrapper {
    width: 100%;
    max-width: 100%;
    min-height: 750px;
    overflow-x: hidden;
    margin-top: var(--space-4);
    box-sizing: border-box;
  }

  .jotform-wrapper :global(iframe) {
    max-width: 100% !important;
    width: 100% !important;
    min-width: 0 !important;
    min-height: 750px;
  }

  .form-fallback-note {
    margin-top: 1rem;
    padding: 0.85rem 1.25rem;
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #475569;
  }

  .form-fallback-note p {
    margin: 0;
  }

  .fallback-email-link {
    color: #0A3D3A;
    font-weight: 700;
    text-decoration: underline;
  }

  .fallback-email-link:hover {
    color: #C9933A;
  }

  /* Sidebar info card */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .support-card,
  .quick-help-card {
    border-color: var(--color-border);
