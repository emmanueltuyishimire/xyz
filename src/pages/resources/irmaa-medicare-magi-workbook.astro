---
import ProductLayout from '@layouts/ProductLayout.astro';

const productData = {
  title: "IRMAA & Medicare MAGI Planning Workbook",
  subtitle: "Audit your 2-year lookback MAGI, check Medicare's strict cliff-edge brackets, and file Form SSA-44 successfully using the 8 official qualifying life events.",
  description: "Calculate your Medicare IRMAA surcharges, avoid cliff-edge bracket penalties, and appeal using Form SSA-44 with this 15-page printable planning workbook.",
  quickAnswer: "The Income-Related Monthly Adjustment Amount (IRMAA) imposes steep monthly surcharges on Medicare Part B and Part D premiums for retirees whose Modified Adjusted Gross Income (MAGI) crosses federal tiers. Because IRMAA uses a 2-year lookback and operates on strict cliff brackets, a single dollar over a threshold triggers an extra $1,100 to $6,000 in annual healthcare costs per couple. This 15-page workbook provides the bracket math, MAGI audit worksheets, and Form SSA-44 life-changing event filing instructions.",
  price: 19,
  gumroadPermalink: "cvrnlv",
  thumbnailImage: "/PRODUCTS/IRMAA & Medicare MAGI Planning Workbook.jpeg",
  backgroundImage: "/PRODUCTS/IRMAA & Medicare MAGI Planning Workbook  Seniors Audit.png",
  slug: "irmaa-medicare-magi-workbook",
  pageCount: "15-Page",
  version: "2026.1",
  lastReviewed: "September 2026",
  nextReview: "January 2027",
  coreProblem: "auditing your Medicare MAGI or appealing an IRMAA surcharge",
  bundleProblem: "managing your RMDs and taxable withdrawal sequencing",
  freeServiceDisclosure: "Every free tool and government resource referenced on this page — including our IRMAA Calculator, MAGI for Medicare Calculator, and official SSA Form SSA-44 — is available directly and free from ssa.gov and cms.gov. This is a paid, independent organizational resource built around that free public information, not a replacement for it.",
  sources: [
    { title: "Centers for Medicare & Medicaid Services (CMS) — 2026 Medicare Part B & Part D Premium & IRMAA Tiers", url: "https://www.cms.gov" },
    { title: "Social Security Administration — Form SSA-44 (Medicare Income-Related Monthly Adjustment Amount - Life-Changing Event)", url: "https://www.ssa.gov" },
    { title: "Social Security Administration — POMS HI 01101.000 (Income-Related Monthly Adjustment Amount)", url: "https://www.ssa.gov" },
    { title: "Internal Revenue Code § 1395r(i) — Statutory Determination of Modified Adjusted Gross Income (MAGI) for Medicare", url: "https://www.irs.gov" },
  ],
  bundle: {
    name: "Retirement Income & Tax Bundle",
    price: 45,
    standaloneValue: 58,
    savings: 13,
    discountPercent: 22,
    permalink: "RetirementIncomeTaxBundle",
    description: "Pairs the IRMAA & Medicare MAGI Workbook with the RMD Planning Workbook and the Flagship Retirement Withdrawal Planner to orchestrate every tax and healthcare interaction simultaneously.",
    includes: [
      "RMD Tax & Withdrawal Planning Workbook ($15 value)",
      "IRMAA & Medicare MAGI Planning Workbook ($19 value)",
      "Retirement Withdrawal & Medicare Cost Planner ($24 value)",
    ],
  },
  relatedFreeTools: [
    {
      name: "IRMAA Calculator",
      url: "/tools/medicare-irmaa-calculator/",
      description: "Check which IRMAA bracket applies to your tax filing status and estimate your total annual Medicare surcharge."
    },
    {
      name: "MAGI for Medicare Calculator",
      url: "/tools/magi-for-medicare-calculator/",
      description: "Convert your Adjusted Gross Income (AGI) and municipal bond interest into exact Medicare MAGI."
    },
    {
      name: "Medicare Part B Premium Calculator",
      url: "/tools/medicare-premium-calculator/",
      description: "Calculate your complete monthly Part B costs including standard base premiums and IRMAA tiers."
    }
  ],
  faqs: [
    {
      question: "What tax year determines my 2026 IRMAA surcharge?",
      answer: "IRMAA uses a strict two-year lookback rule. Your 2026 Medicare Part B and Part D premiums are determined entirely by the Modified Adjusted Gross Income (MAGI) reported on your 2024 federal tax return (filed in early 2025). If your income has dropped since then, you can file Form SSA-44."
    },
    {
      question: "Why is IRMAA called a cliff-edge surcharge?",
      answer: "Unlike progressive federal income tax brackets where only dollars above the threshold are taxed at higher rates, IRMAA has zero phase-in. If your MAGI exceeds an IRMAA threshold by just $1.00, you are pushed into the higher bracket for the entire year across both Part B and Part D, costing an individual $1,100+ and a married couple over $2,200 in added surcharges."
    },
    {
      question: "What are the 8 Qualifying Life Events accepted on Form SSA-44?",
      answer: "Social Security only accepts 8 specific statutory events: (1) Marriage, (2) Divorce or Annulment, (3) Death of a Spouse, (4) Work Stoppage, (5) Work Reduction, (6) Loss of Income-Producing Property due to disaster, (7) Loss of Employer Pension, or (8) Receipt of a Settlement from an employer's bankruptcy."
    },
    {
      question: "Can I appeal IRMAA if my high income was caused by a one-time capital gain?",
      answer: "Generally no. Selling a home (above the $250k/$500k exclusion), selling stocks, or executing a one-time Roth conversion are NOT recognized as life-changing events under federal law. However, if you also experienced work reduction or retirement in the same period, you can use the work stoppage to request relief."
    },
    {
      question: "Does municipal bond interest count toward Medicare MAGI?",
      answer: "Yes. For Medicare purposes, Modified Adjusted Gross Income is calculated as regular Adjusted Gross Income (Line 11 of Form 1040) plus tax-exempt municipal interest (Line 2a of Form 1040). Municipal bonds are free from federal income tax, but they count 100% toward triggering IRMAA surcharges."
    }
  ]
};
---

<ProductLayout {...productData}>
  <!-- 2. What's Inside -->
  <section class="content-section">
    <h2>What's Inside: The 6-Step IRMAA Strategy Blueprint</h2>
    <p>
      This is a 15-page specialized working guide engineered to audit your 2-year lookback tax data and appeal erroneous surcharges:
    </p>
    <div class="steps-stack">
      <div class="step-card">
        <div class="step-number">Step 1</div>
        <div class="step-body">
          <h3>The Complete 2026 IRMAA Bracket Tables</h3>
          <p>Official CMS dollar thresholds for Single, Married Filing Jointly, and Married Filing Separately. Breaks down the exact monthly Part B surcharge and Part D surcharge for each of the 5 tiers.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 2</div>
        <div class="step-body">
          <h3>The Medicare MAGI Audit Worksheet</h3>
          <p>How Medicare MAGI is defined under statutory law. Step-by-step audit of IRS Form 1040 lines, highlighting blindspots including municipal bond tax-exempt interest (Line 2a) and foreign earned income.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 3</div>
        <div class="step-body">
          <h3>The Cliff-Edge Math &amp; The Two-Spouse Multiplier</h3>
          <p>Worked mathematical models demonstrating how a $1.00 overrun costs a single person $1,138.80/yr and a couple $2,277.60/yr. Explains buffer zones and how to evaluate year-end capital gains realizations.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 4</div>
        <div class="step-body">
          <h3>The 8 Official Qualifying Life Events Checklist</h3>
          <p>Rigorous breakdown of the 8 statutory life-changing events recognized by Social Security. Explains why investment losses and house sales are rejected, but retirement and reduced consulting hours qualify.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 5</div>
        <div class="step-body">
          <h3>Line-by-Line Guide to Filing Form SSA-44</h3>
          <p>Detailed walkthrough of the official SSA-44 document. Covers Part I event selection, Part II income estimation tables, and Part III required evidentiary attachments (W-2s, termination letters, signed tax returns).</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 6</div>
        <div class="step-body">
          <h3>The Multi-Year IRMAA Strategy Matrix</h3>
          <p>Forward-looking planning calendar mapping how income in ages 63, 64, and 65 dictates premiums at ages 65, 66, and 67. Shows how to time Roth conversions and major asset liquidations cleanly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. See It in Action — Worked Example Preview -->
  <section class="content-section">
    <h2>See It in Action: Tier 1 IRMAA Surcharges &amp; The $1 Cliff Edge</h2>
    <p>
      Here is the actual worked example from Step 1 and Step 3 of the workbook demonstrating the financial impact of crossing an IRMAA threshold:
    </p>

    <div class="worked-example-card">
      <div class="example-badge">Workbook Case Study: Single Retiree in Tier 1 ($109,000–$137,000 MAGI)</div>
      <p class="example-intro">
        A single retiree reports $110,000 in Modified Adjusted Gross Income on their 2024 tax return (used for 2026 Medicare premiums). Because their income crossed the $109,000 baseline by $1,000, they trigger mandatory Tier 1 surcharges on both Part B and Part D:
      </p>

      <div class="example-table-wrap">
        <table class="example-table">
          <thead>
            <tr>
              <th scope="col">Coverage Component</th>
              <th scope="col">Standard Base Premium</th>
              <th scope="col">Tier 1 IRMAA Surcharge</th>
              <th scope="col">Total Monthly Cost</th>
              <th scope="col">Annual Extra Surcharge</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Medicare Part B</strong></td>
              <td>$202.90 / mo</td>
              <td>+$81.20 / mo</td>
              <td><strong>$284.10 / mo</strong></td>
              <td><strong>+$974.40 / year</strong></td>
            </tr>
            <tr>
              <td><strong>Medicare Part D</strong></td>
              <td>Plan Base</td>
              <td>+$14.50 / mo</td>
              <td>Plan Base + $14.50</td>
              <td><strong>+$174.00 / year</strong></td>
            </tr>
            <tr>
              <td><strong>Combined Total Impact</strong></td>
              <td>Standard</td>
              <td>+$95.70 / mo</td>
              <td>Base + $95.70</td>
              <td><strong>+$1,148.40 / year</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="example-analysis">
        <h4>The Cliff-Edge Threat for Married Couples:</h4>
        <p>
          For a married couple filing jointly, the Tier 1 threshold is $218,000. If their joint MAGI is $218,001, <strong>both spouses are assessed the surcharge</strong>, resulting in an immediate <strong>$2,296.80 annual loss</strong> for exceeding the bracket by just one dollar.
        </p>
        <p class="example-takeaway">
          <strong>The Form SSA-44 Solution:</strong> If this income was caused by a final year of full-time work before retiring, Step 5 walks you through filing Form SSA-44 under the "Work Stoppage" event to roll your premiums back to standard base rates immediately.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Who This Is For / Who Should Also See a Professional -->
  <section class="content-section">
    <h2>Who This Is For / Who Should Also See a Professional</h2>
    <div class="fit-grid">
      <div class="fit-card fit-card--good">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A7A4E" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          This Workbook Is Built For You If:
        </h3>
        <ul>
          <li>You received an Initial IRMAA Determination letter from Social Security.</li>
          <li>Your income dropped due to retirement or work reduction within the last two years.</li>
          <li>Your income is hovering within $10,000 of an IRMAA bracket cliff.</li>
          <li>You are planning Roth conversions or capital sales and want to avoid surprise surcharges.</li>
          <li>You want line-by-line instructions to complete and file Form SSA-44 without rejection.</li>
        </ul>
      </div>

      <div class="fit-card fit-card--pro">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A8792B" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Who Should Also Consult a CPA:
        </h3>
        <ul>
          <li>You have multi-tier K-1 partnership distributions with retroactive income adjustments.</li>
          <li>You are appealing an amended tax return (Form 1040-X) currently pending IRS review.</li>
          <li>You are subject to complex foreign pension tax treaties or international earned income exclusions.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. What You'll Walk Away With -->
  <section class="content-section">
    <h2>What You'll Walk Away With</h2>
    <div class="deliverables-box">
      <p>
        Working through this 15-page guide takes the guesswork out of Medicare surcharges:
      </p>
      <ol class="numbered-outcomes">
        <li><strong>An exact audit of your 2-year lookback MAGI</strong> verifying whether Social Security's assessment matches your actual tax return.</li>
        <li><strong>A fully prepared Form SSA-44 package</strong> with the exact evidence attachments required for swift approval.</li>
        <li><strong>A mapped buffer plan</strong> ensuring future IRA withdrawals, dividends, and Roth conversions stay safely below cliff tiers.</li>
        <li><strong>Direct dollar savings</strong> potentially recovering $1,100 to $4,500+ per year in unwarranted premium withholdings.</li>
      </ol>
    </div>
  </section>
</ProductLayout>

<style>
  .quick-answer-block {
    background-color: #0A3D3A;
    color: #FFFFFF;
    border-left: 5px solid #C9933A;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.75rem;
  }
  .quick-answer-tag {
    color: #C9933A;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .quick-answer-text {
    font-size: 1.15rem;
    line-height: 1.65;
    margin: 0;
    color: #FFFFFF;
  }
  .content-section {
    margin-bottom: 3.5rem;
  }
  .content-section h2 {
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    color: #0D2137;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .content-section p {
    font-size: 1.12rem;
    line-height: 1.7;
    color: #3E4E60;
    margin-bottom: 1.25rem;
  }
  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .step-card {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 1.4rem 1.6rem;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .step-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .step-number {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0A3D3A;
    background: #EBF2F1;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    text-align: center;
  }
  .step-body h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0D2137;
    margin: 0 0 0.4rem 0;
  }
  .step-body p {
    font-size: 1rem;
    color: #4F5E72;
    margin: 0;
    line-height: 1.55;
  }
  .worked-example-card {
    background: #F8FAF9;
    border: 2px solid #0A3D3A;
    border-radius: 10px;
    padding: 1.75rem;
    margin-top: 1.5rem;
  }
  .example-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0A3D3A;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .example-intro {
    font-size: 1.08rem;
    color: #0D2137;
    margin-bottom: 1.25rem;
  }
  .example-table-wrap {
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .example-table {
    width: 100%;
    border-collapse: collapse;
    background: #FFFFFF;
    font-size: 0.98rem;
  }
  .example-table th {
    background-color: #0A3D3A;
    color: #FFFFFF;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
  }
  .example-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #DDE3EA;
    color: #0D2137;
  }
  .example-analysis h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0A3D3A;
    margin: 0 0 0.5rem 0;
  }
  .example-analysis p {
    font-size: 1.02rem;
    color: #3E4E60;
    margin-bottom: 0.75rem;
  }
  .example-takeaway {
    background: #FFFFFF;
    border-left: 4px solid #C9933A;
    padding: 0.85rem 1rem;
    border-radius: 4px;
  }
  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
  .fit-card {
    border-radius: 10px;
    padding: 1.6rem;
  }
  .fit-card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .fit-card--good {
    background: #F4FAF6;
    border: 2px solid #1A7A4E;
  }
  .fit-card--good h3 {
    color: #1A7A4E;
  }
  .fit-card--pro {
    background: #FFFDF8;
    border: 2px solid #C9933A;
  }
  .fit-card--pro h3 {
    color: #7A5210;
  }
  .fit-card ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #0D2137;
  }
  .deliverables-box {
    background: #F6F8FA;
    border-radius: 10px;
    border: 1px solid #DDE3EA;
    padding: 1.75rem;
  }
  .deliverables-box p {
    font-size: 1.08rem;
    color: #0D2137;
    margin-top: 0;
  }
  .numbered-outcomes {
    margin: 1.25rem 0 0 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 1.05rem;
    color: #3E4E60;
  }
  .numbered-outcomes strong {
    color: #0D2137;
  }
</style>
