---
import ProductLayout from '@layouts/ProductLayout.astro';

const productData = {
  title: "Social Security Claiming Decision Workbook",
  subtitle: "A step-by-step workbook for deciding when to claim Social Security — using your own benefit numbers, your own break-even math, and your own household situation.",
  description: "Calculate your exact Social Security break-even age, spousal rules, earnings test limits, and 2025 WEP/GPO repeal impacts with this 17-page printable workbook.",
  quickAnswer: "The age you claim Social Security permanently alters your monthly benefit check for the rest of your life. Claiming at 62 means an irreversible reduction of up to 30%, while delaying until 70 adds guaranteed delayed retirement credits of 8% per year past your Full Retirement Age. This workbook provides the step-by-step arithmetic, spousal protection rules, and break-even worksheets to test your actual numbers before filing with the SSA.",
  price: 15,
  gumroadPermalink: "tmnwc",
  thumbnailImage: "/PRODUCTS/Social Security Claiming Decision Workbook.jpeg",
  backgroundImage: "/PRODUCTS/Social Security Claiming Decision Workbook  Seniors Audit.png",
  slug: "social-security-claiming-workbook",
  pageCount: "17-Page",
  version: "2026.3",
  lastReviewed: "September 2026",
  nextReview: "January 2027",
  coreProblem: "deciding when to claim Social Security",
  bundleProblem: "finding senior discounts and unclaimed utility/food benefits",
  freeServiceDisclosure: "Every free tool and government resource referenced on this page — including our Full Retirement Age Calculator, Social Security Break-Even Calculator, and official SSA benefit estimates — is available directly and free from ssa.gov. This is a paid, independent organizational resource built around that free public information, not a replacement for it.",
  sources: [
    { title: "Social Security Administration (SSA) — Full Retirement Age (FRA) Regulations (20 CFR § 404.409)", url: "https://www.ssa.gov" },
    { title: "Bipartisan Budget Act of 2015 — Deemed Filing & Voluntary Suspension Rules", url: "https://www.congress.gov" },
    { title: "Social Security Fairness Act — Official Repeal of WEP and GPO Provisions", url: "https://www.ssa.gov" },
    { title: "SSA 2026 COLA & Retirement Earnings Test Limits (POMS RS 02501.021)", url: "https://www.ssa.gov" },
  ],
  bundle: {
    name: "Social Security & Benefits Bundle",
    price: 22,
    standaloneValue: 27,
    savings: 5,
    discountPercent: 19,
    permalink: "SocialSecurityBenefitsBundle",
    description: "Combines your Social Security Claiming Decision Workbook with the Senior Discounts & Hidden Benefits Finder to maximize your monthly retirement income and trim household overhead.",
    includes: [
      "Social Security Claiming Decision Workbook ($15 value)",
      "Senior Discounts & Hidden Benefits Finder ($12 value)",
    ],
  },
  relatedFreeTools: [
    {
      name: "Social Security Break-Even Calculator",
      url: "/tools/social-security-break-even-calculator/",
      description: "Compare any two claiming ages to find the exact month where total cumulative dollars break even."
    },
    {
      name: "Full Retirement Age Calculator",
      url: "/tools/social-security-full-retirement-age-calculator/",
      description: "Look up your exact FRA and early claiming benefit reduction percentages based on your birth year."
    },
    {
      name: "Social Security Tax Withholding Calculator",
      url: "/tools/social-security-tax-withholding-calculator/",
      description: "Estimate provisional income and find out whether your benefits will be taxed at the federal level."
    }
  ],
  faqs: [
    {
      question: "Can I use this workbook if I am already 62 or older?",
      answer: "Yes. The workbook is specifically engineered for anyone between ages 60 and 70. If you are already eligible to claim, it helps you calculate whether filing now or waiting another 12 to 36 months produces a higher lifetime total based on your personal health and family longevity."
    },
    {
      question: "Does this workbook reflect the 2025 WEP and GPO repeal?",
      answer: "Yes. Version 2026.3 fully incorporates the legislative updates enacted under the Social Security Fairness Act, which eliminated the Windfall Elimination Provision (WEP) and Government Pension Offset (GPO) for public employees, teachers, and civil servants."
    },
    {
      question: "Is this an interactive spreadsheet or a printable document?",
      answer: "It is a high-resolution, print-ready 17-page PDF (plus ePub). It features dedicated fill-in lines, calculation worksheets, and decision checklists designed to be completed by hand or annotated on a tablet, keeping your sensitive financial records completely offline."
    },
    {
      question: "How does the break-even math work in this workbook?",
      answer: "The workbook walks you through exact formula calculations comparing early claiming (e.g., 62), Full Retirement Age (66–67), and age 70. You plug in your actual estimated monthly benefit from ssa.gov to identify your personal crossover age down to the month."
    },
    {
      question: "Can this workbook tell me what my spouse will receive?",
      answer: "Yes. Step 3 covers spousal and survivor benefit rules, explaining deemed filing requirements under the Bipartisan Budget Act and how the higher-earning spouse's claiming age permanently caps or preserves survivor protection."
    }
  ]
};
---

<ProductLayout {...productData}>
  <!-- 2. What's Inside -->
  <section class="content-section">
    <h2>What's Inside: The 6-Step Decision Architecture</h2>
    <p>
      This is not a generic advice book. It is a 17-page structured working manual organized into six chronological steps:
    </p>
    <div class="steps-stack">
      <div class="step-card">
        <div class="step-number">Step 1</div>
        <div class="step-body">
          <h3>Your Full Retirement Age Baseline</h3>
          <p>Look up your exact birth year on the statutory FRA chart. See your exact monthly reduction percentage at age 62 (up to 30% permanent cut) versus waiting until age 70 (+24% to +32% delayed retirement credits).</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 2</div>
        <div class="step-body">
          <h3>The Break-Even Math &amp; Crossover Age</h3>
          <p>Step 2 walks through the exact break-even math using SSA's own reduction formula. Calculate cumulative lifetime payouts across candidate claiming ages to identify your personal crossover milestone down to the month.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 3</div>
        <div class="step-body">
          <h3>Spousal Benefits &amp; Deemed Filing Rules</h3>
          <p>How the 50% spousal maximum is calculated, how deemed filing rules under the Bipartisan Budget Act prevent dual-filing gaming, and how early claiming penalties apply to spousal benefits.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 4</div>
        <div class="step-body">
          <h3>Survivor Benefits &amp; Household Longevity Protection</h3>
          <p>Explains why the higher-earning spouse's claiming date is the single most important decision for protecting a surviving spouse's permanent monthly floor.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 5</div>
        <div class="step-body">
          <h3>The 2026 Earnings Test &amp; WEP/GPO Updates</h3>
          <p>Official 2026 earnings test exempt amounts ($23,400 under FRA; $62,160 in year of FRA). Fully integrates the 2025 Social Security Fairness Act repeal of WEP and GPO for public service pensions.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 6</div>
        <div class="step-body">
          <h3>Your Final Claiming Decision Worksheet</h3>
          <p>A structured, one-page worksheet to record your numbers, test your health and household factors, and document a written working decision to take to your local SSA office or financial planner.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. See It in Action — Worked Example Preview (Master Prompt Spec) -->
  <section class="content-section">
    <h2>See It in Action: Maria's Real Numbers</h2>
    <p>
      The workbook does not deal in theoretical abstractions. Here is a condensed look at the actual worked example from Step 2 and Step 6 of the workbook:
    </p>

    <div class="worked-example-card">
      <div class="example-badge">Workbook Case Study: Maria (Born 1962, FRA Age 67)</div>
      <p class="example-intro">
        Maria looks up her Social Security statement at ssa.gov. Her estimated Primary Insurance Amount (PIA) at Full Retirement Age (67) is <strong>$2,000/month</strong> ($24,000/year).
      </p>

      <div class="example-table-wrap">
        <table class="example-table">
          <thead>
            <tr>
              <th scope="col">Claiming Age</th>
              <th scope="col">Reduction / Credit Factor</th>
              <th scope="col">Monthly Check</th>
              <th scope="col">Annual Total</th>
              <th scope="col">Break-Even vs. Age 62</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Age 62</strong> (Early)</td>
              <td>70% of FRA (-30% cut)</td>
              <td><strong>$1,400</strong></td>
              <td>$16,800</td>
              <td>Baseline</td>
            </tr>
            <tr>
              <td><strong>Age 67</strong> (Full Retirement Age)</td>
              <td>100% of FRA</td>
              <td><strong>$2,000</strong></td>
              <td>$24,000</td>
              <td><strong>Age 78.7</strong> (~11.7 years)</td>
            </tr>
            <tr>
              <td><strong>Age 70</strong> (Delayed)</td>
              <td>124% of FRA (+24% boost)</td>
              <td><strong>$2,480</strong></td>
              <td>$29,760</td>
              <td><strong>Age 80.4</strong> (~10.4 years)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="example-analysis">
        <h4>Maria's Decision Analysis:</h4>
        <p>
          The difference between claiming at 62 ($1,400/mo) and waiting until 70 ($2,480/mo) is <strong>$1,080 every single month for life</strong>.
        </p>
        <p>
          On Step 6's Decision Worksheet, Maria checked three specific criteria: <em>"I have other retirement savings to bridge early living costs,"</em> <em>"Good current health with family history of longevity past age 80,"</em> and <em>"Want guaranteed inflation-adjusted income for as long as possible."</em>
        </p>
        <p class="example-takeaway">
          <strong>Maria's working conclusion:</strong> <em>"Based on my numbers, I am choosing to claim at 67 (FRA) rather than 62 or 70. This gives me a $600/month boost over age 62 without forcing me to wait until age 70."</em>
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Who This Is For / Who Should Also See a Professional -->
  <section class="content-section">
    <h2>Who This Is For / Who Should Also See a Professional</h2>
    <div class="fit-grid">
      <div class="fit-card fit-card--good">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A7A4E" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          This Workbook Is Built For You If:
        </h3>
        <ul>
          <li>You are between ages 59 and 70 and evaluating when to file.</li>
          <li>You want to see your real monthly dollars, not generic rule-of-thumb generalizations.</li>
          <li>You are married and need to balance spousal top-ups and surviving spouse protection.</li>
          <li>You plan to continue working part-time after claiming and need to check the 2026 earnings test.</li>
          <li>You have a state or local government pension and want to verify your status after the WEP/GPO repeal.</li>
        </ul>
      </div>

      <div class="fit-card fit-card--pro">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A8792B" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Who Should Also Consult a Professional:
        </h3>
        <ul>
          <li>You are navigating an active divorce proceeding involving complex judicial division of future retirement assets.</li>
          <li>You have a diagnosed terminal medical condition where immediate liquidity supersedes break-even math.</li>
          <li>You are pursuing a formal administrative dispute or appeal regarding disability benefit qualifications.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. What You'll Walk Away With -->
  <section class="content-section">
    <h2>What You'll Walk Away With</h2>
    <div class="deliverables-box">
      <p>
        After 45 minutes working through these 17 pages, you will not have vague ideas — you will hold a completed physical decision record:
      </p>
      <ol class="numbered-outcomes">
        <li><strong>A filled-in comparison table</strong> showing your exact benefit amount at 62, FRA, and 70 calculated from your real SSA numbers.</li>
        <li><strong>Your personal break-even crossover age</strong> calculated down to the month, showing exactly how long you need to live for delaying to pay off.</li>
        <li><strong>A documented spousal and survivor plan</strong> ensuring the lower-earning partner is never left financially vulnerable.</li>
        <li><strong>A completed 1-page Decision Summary</strong> ready to take to your appointment at the local Social Security office.</li>
      </ol>
    </div>
  </section>
</ProductLayout>

<style>
  /* ── Quick Answer Callout ──────────────────────────────── */
  .quick-answer-block {
    background-color: #0A3D3A;
    color: #FFFFFF;
    border-left: 5px solid #C9933A;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.75rem;
  }
  .quick-answer-tag {
    color: #C9933A;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .quick-answer-text {
    font-size: 1.15rem;
    line-height: 1.65;
    margin: 0;
    color: #FFFFFF;
  }

  /* ── Content Sections ─────────────────────────────────── */
  .content-section {
    margin-bottom: 3.5rem;
  }
  .content-section h2 {
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    color: #0D2137;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .content-section p {
    font-size: 1.12rem;
    line-height: 1.7;
    color: #3E4E60;
    margin-bottom: 1.25rem;
  }

  /* ── Steps Stack ──────────────────────────────────────── */
  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .step-card {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 1.4rem 1.6rem;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .step-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .step-number {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0A3D3A;
    background: #EBF2F1;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    text-align: center;
  }
  .step-body h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0D2137;
    margin: 0 0 0.4rem 0;
  }
  .step-body p {
    font-size: 1rem;
    color: #4F5E72;
    margin: 0;
    line-height: 1.55;
  }

  /* ── Worked Example Card ──────────────────────────────── */
  .worked-example-card {
    background: #F8FAF9;
    border: 2px solid #0A3D3A;
    border-radius: 10px;
    padding: 1.75rem;
    margin-top: 1.5rem;
  }
  .example-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0A3D3A;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .example-intro {
    font-size: 1.08rem;
    color: #0D2137;
    margin-bottom: 1.25rem;
  }
  .example-table-wrap {
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .example-table {
    width: 100%;
    border-collapse: collapse;
    background: #FFFFFF;
    font-size: 0.98rem;
  }
  .example-table th {
    background-color: #0A3D3A;
    color: #FFFFFF;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
  }
  .example-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #DDE3EA;
    color: #0D2137;
  }
  .example-analysis h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0A3D3A;
    margin: 0 0 0.5rem 0;
  }
  .example-analysis p {
    font-size: 1.02rem;
    color: #3E4E60;
    margin-bottom: 0.75rem;
  }
  .example-takeaway {
    background: #FFFFFF;
    border-left: 4px solid #C9933A;
    padding: 0.85rem 1rem;
    border-radius: 4px;
  }

  /* ── Fit Grid (Two-Column) ────────────────────────────── */
  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
  .fit-card {
    border-radius: 10px;
    padding: 1.6rem;
  }
  .fit-card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .fit-card--good {
    background: #F4FAF6;
    border: 2px solid #1A7A4E;
  }
  .fit-card--good h3 {
    color: #1A7A4E;
  }
  .fit-card--pro {
    background: #FFFDF8;
    border: 2px solid #C9933A;
  }
  .fit-card--pro h3 {
    color: #7A5210;
  }
  .fit-card ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #0D2137;
  }

  /* ── Deliverables Box ─────────────────────────────────── */
  .deliverables-box {
    background: #F6F8FA;
    border-radius: 10px;
    border: 1px solid #DDE3EA;
    padding: 1.75rem;
  }
  .deliverables-box p {
    font-size: 1.08rem;
    color: #0D2137;
    margin-top: 0;
  }
  .numbered-outcomes {
    margin: 1.25rem 0 0 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 1.05rem;
    color: #3E4E60;
  }
  .numbered-outcomes strong {
    color: #0D2137;
  }
</style>
