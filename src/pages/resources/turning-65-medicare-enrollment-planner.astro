---
import ProductLayout from '@layouts/ProductLayout.astro';

const productData = {
  title: "Turning 65 Medicare Enrollment Action Planner",
  subtitle: "A clear, sequential 7-month roadmap to enroll in Medicare without lifetime penalties, coverage gaps, or conflicting insurance traps.",
  description: "Navigate your 7-month Initial Enrollment Period, test the 20+ employee still-working rule, avoid the 6-month HSA tax trap, and choose between Medigap and Medicare Advantage with this 18-page action planner.",
  quickAnswer: "Medicare enrollment is governed by an unforgiving 7-month Initial Enrollment Period (IEP) centered on your 65th birthday. Missing your window can trigger permanent lifetime premium surcharges of 10% for every 12-month delay on Part B and 1% per month on Part D. This action planner provides the sequential timeline, employer exemption verification tests, and decision matrices to navigate turning 65 cleanly.",
  price: 19,
  gumroadPermalink: "neyemp",
  thumbnailImage: "/PRODUCTS/Turning 65 Medicare Enrollment Action Planner.jpeg",
  backgroundImage: "/PRODUCTS/Turning 65 Medicare Enrollment Action Planner  Seniors Audit.png",
  slug: "turning-65-medicare-enrollment-planner",
  pageCount: "18-Page",
  version: "2026.1",
  lastReviewed: "September 2026",
  nextReview: "January 2027",
  coreProblem: "navigating your 7-month Medicare Initial Enrollment Period",
  bundleProblem: "avoiding or appealing late enrollment penalty surcharges",
  freeServiceDisclosure: "Every free tool and government resource referenced on this page — including our Medicare Late Enrollment Penalty Calculator and official Medicare enrollment portals — is available directly and free from medicare.gov and ssa.gov. This is a paid, independent organizational resource built around that free public information, not a replacement for it.",
  sources: [
    { title: "Centers for Medicare & Medicaid Services (CMS) — Medicare Enrollment Periods & Rules (CMS Pub. No. 11036)", url: "https://www.medicare.gov" },
    { title: "Social Security Administration (SSA) — Apply for Medicare Part A and Part B (Form CMS-40B & CMS-L564)", url: "https://www.ssa.gov" },
    { title: "Internal Revenue Code § 223(b)(7) — Health Savings Account (HSA) 6-Month Retroactive Part A Rule", url: "https://www.irs.gov" },
    { title: "Medicare Secondary Payer (MSP) Manual — 20+ Employee Active Employment Exemption Rules", url: "https://www.cms.gov" },
  ],
  bundle: {
    name: "Turning 65 Medicare Bundle",
    price: 25,
    standaloneValue: 31,
    savings: 6,
    discountPercent: 19,
    permalink: "Turning65MedicareBundle",
    description: "Pairs your 7-Month Initial Enrollment Planner with the Medicare Part B & D Penalty Avoidance Kit so you execute your initial setup cleanly and safeguard against permanent premium surcharges.",
    includes: [
      "Turning 65 Medicare Enrollment Action Planner ($19 value)",
      "Medicare Part B & D Penalty Avoidance Kit ($12 value)",
    ],
  },
  relatedFreeTools: [
    {
      name: "Medicare Late Enrollment Penalty Calculator",
      url: "/tools/medicare-late-enrollment-penalty-calculator/",
      description: "Calculate your estimated lifetime monthly surcharge if Part B enrollment is delayed past your deadline."
    },
    {
      name: "Part D Late Enrollment Penalty Calculator",
      url: "/tools/part-d-late-enrollment-penalty-calculator/",
      description: "Estimate 1% national base beneficiary premium penalties for uncovered drug months."
    },
    {
      name: "Medicare Part B Premium Calculator",
      url: "/tools/medicare-part-b-premium-calculator/",
      description: "Determine your base Part B monthly cost and check if high-income IRMAA brackets apply to you."
    }
  ],
  faqs: [
    {
      question: "Do I have to enroll at 65 if I am still working and have employer insurance?",
      answer: "It depends strictly on your employer size. If your employer has 20 or more employees and you have active group health coverage, you can safely delay Part B without penalty until retirement. If your employer has fewer than 20 employees, Medicare is primary at 65, and delaying Part B can leave you without valid primary coverage."
    },
    {
      question: "What is the 6-month HSA retroactive enrollment trap?",
      answer: "If you enroll in Medicare Part A after age 65, your coverage is made retroactive up to 6 months (but not earlier than your 65th birthday). Because IRS rules prohibit HSA contributions while covered by Medicare, you must stop contributing to your HSA 6 months before applying to prevent severe excise tax penalties."
    },
    {
      question: "Does COBRA count as creditable coverage for delaying Part B?",
      answer: "No. COBRA and retiree health plans do NOT count as active employment coverage. If you rely on COBRA past your Initial Enrollment Period, you do not receive a Special Enrollment Period and will face lifetime Part B penalties."
    },
    {
      question: "How does this planner help me choose between Medigap and Medicare Advantage?",
      answer: "The planner includes a side-by-side comparison matrix evaluating doctor network restrictions, prior authorization requirements, out-of-pocket maximum caps, and foreign travel coverage. It also explains your one-time 6-month Medigap Open Enrollment Period where underwriting is prohibited by federal law."
    },
    {
      question: "Can I print this planner or fill it out digitally?",
      answer: "Yes. You receive both a print-ready 18-page PDF and an ePub edition. The PDF includes fill-in timelines, milestone checklist boxes, and phone log tables formatted for standard 8.5x11 printing."
    }
  ]
};
---

<ProductLayout {...productData}>
  <!-- 2. What's Inside -->
  <section class="content-section">
    <h2>What's Inside: The 7-Step Initial Enrollment Roadmap</h2>
    <p>
      An 18-page structured operational blueprint organized into 7 sequential steps:
    </p>
    <div class="steps-stack">
      <div class="step-card">
        <div class="step-number">Step 1</div>
        <div class="step-body">
          <h3>Find Your Initial Enrollment Period (IEP)</h3>
          <p>Step 1 builds your 7-month calendar: 3 months before your 65th birth month, your birthday month, and 3 months after. Explains why signing up in the first 3 months guarantees day-one coverage on the 1st of your birth month.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 2</div>
        <div class="step-body">
          <h3>Still Working? The 20-Employee Rule That Actually Matters</h3>
          <p>The exact legal test distinguishing qualifying employer group health plans (20+ employees) from non-qualifying small business plans (under 20 employees). Explains why COBRA and retiree plans do not qualify.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 3</div>
        <div class="step-body">
          <h3>What Waiting Actually Costs (2026 Real Figures)</h3>
          <p>Exact calculations for Part A, Part B, and Part D late enrollment surcharges. Shows how a single missed enrollment period permanently inflates your monthly premium deductions forever.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 4</div>
        <div class="step-body">
          <h3>Choosing Your Coverage Path: Medigap vs. Medicare Advantage</h3>
          <p>Objective comparison of Path 1 (Original Medicare + Medigap Plan G + Part D) versus Path 2 (Medicare Advantage Part C HMO/PPO). Covers provider network freedom, prior authorizations, and out-of-pocket maximums.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 5</div>
        <div class="step-body">
          <h3>Part D Creditable Coverage &amp; Formulary Verification</h3>
          <p>How to verify that your existing prescription coverage is officially certified as creditable under CMS standards, and how to pick a low-cost standalone Part D plan even if you currently take zero medications.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 6</div>
        <div class="step-body">
          <h3>The Medigap Guaranteed-Issue Window</h3>
          <p>Your one-time 6-month federal open enrollment window starting the month you turn 65 and enroll in Part B. Explains why private insurance companies can never deny coverage or charge you higher rates for pre-existing conditions during this window.</p>
        </div>
      </div>

      <div class="step-card">
        <div class="step-number">Step 7</div>
        <div class="step-body">
          <h3>Build Your Personal Action Checklist &amp; Timeline</h3>
          <p>A structured single-page fill-in milestone calendar with direct contact numbers for SSA, CMS, and local State Health Insurance Assistance Program (SHIP) offices.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. See It in Action — Worked Example Preview -->
  <section class="content-section">
    <h2>See It in Action: James's Numbers (The Cost of Missing Enrollment)</h2>
    <p>
      Here is the actual worked example from Step 3 of the planner demonstrating what happens when enrollment rules are misunderstood:
    </p>

    <div class="worked-example-card">
      <div class="example-badge">Planner Case Study: James (Turned 65 in 2024, No Employer Coverage)</div>
      <p class="example-intro">
        James turned 65 in 2024. He was healthy, took no prescription medications, and had no active employer health insurance. Assuming Medicare was optional until he needed care, James delayed enrollment until 2026 — exactly <strong>two full years (24 months) late</strong>.
      </p>

      <div class="example-table-wrap">
        <table class="example-table">
          <thead>
            <tr>
              <th scope="col">Cost Element</th>
              <th scope="col">Official Statutory Formula</th>
              <th scope="col">James's Real 2026 Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Standard Part B Base Premium</td>
              <td>CMS 2026 Standard Rate</td>
              <td><strong>$202.90 / month</strong></td>
            </tr>
            <tr>
              <td>Late Enrollment Penalty Percentage</td>
              <td>10% per full 12-month period delayed (2 years)</td>
              <td><strong>+20% permanent penalty</strong></td>
            </tr>
            <tr>
              <td>Monthly Surcharge Added to Check</td>
              <td>$202.90 × 20%</td>
              <td><strong>+$40.58 / month</strong></td>
            </tr>
            <tr>
              <td>Total Monthly Part B Check Deduction</td>
              <td>Base ($202.90) + Penalty ($40.58)</td>
              <td><strong>$243.48 / month for life</strong></td>
            </tr>
            <tr>
              <td>Annual Out-of-Pocket Loss</td>
              <td>$40.58 × 12 months</td>
              <td><strong>$486.96 extra every year, forever</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="example-analysis">
        <h4>The Financial Consequence:</h4>
        <p>
          Over a typical 20-year retirement, James will pay over <strong>$9,700 in unnecessary surcharges</strong> simply because he missed his 7-month Initial Enrollment Period window.
        </p>
        <p class="example-takeaway">
          <strong>The Planner's Remedy:</strong> Step 2 provides the exact Employer Verification Form (CMS-L564) and Step 7 builds your personalized milestone calendar so you never trigger permanent penalty deductions.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Who This Is For / Who Should Also See a Professional -->
  <section class="content-section">
    <h2>Who This Is For / Who Should Also See a Professional</h2>
    <div class="fit-grid">
      <div class="fit-card fit-card--good">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A7A4E" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          This Planner Is Built For You If:
        </h3>
        <ul>
          <li>You are turning 65 within the next 12 months.</li>
          <li>You are overwhelmed by insurance marketing mail and want an unbiased, non-sales roadmap.</li>
          <li>You or your spouse are still employed and need to verify whether delaying Part B is penalty-free.</li>
          <li>You contribute to a Health Savings Account (HSA) and need to disarm the 6-month retroactive tax trap.</li>
          <li>You want to preserve your guaranteed-issue Medigap rights before private medical underwriting applies.</li>
        </ul>
      </div>

      <div class="fit-card fit-card--pro">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A8792B" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Who Should Also Consult a Professional:
        </h3>
        <ul>
          <li>You are dual-eligible for both Medicare and full state Medicaid (requiring specialized coordination).</li>
          <li>You are qualifying for Medicare under age 65 due to ESRD (End-Stage Renal Disease) or ALS.</li>
          <li>You are coordinating complex union retiree health trusts that mandate specific Medicare Advantage enrollment.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. What You'll Walk Away With -->
  <section class="content-section">
    <h2>What You'll Walk Away With</h2>
    <div class="deliverables-box">
      <p>
        Following this 18-page action planner turns a chaotic process into an organized, stress-free execution file:
      </p>
      <ol class="numbered-outcomes">
        <li><strong>A personalized 7-month calendar</strong> marked with your exact filing dates to guarantee day-one coverage.</li>
        <li><strong>A verified employer exemption audit</strong> proving whether your workplace insurance shields you from Part B penalties.</li>
        <li><strong>A calculated HSA contribution cut-off date</strong> ensuring zero IRS excise tax penalties.</li>
        <li><strong>A completed Medigap vs. Advantage decision matrix</strong> based on your health needs and financial preferences.</li>
      </ol>
    </div>
  </section>
</ProductLayout>

<style>
  .quick-answer-block {
    background-color: #0A3D3A;
    color: #FFFFFF;
    border-left: 5px solid #C9933A;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.75rem;
  }
  .quick-answer-tag {
    color: #C9933A;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .quick-answer-text {
    font-size: 1.15rem;
    line-height: 1.65;
    margin: 0;
    color: #FFFFFF;
  }
  .content-section {
    margin-bottom: 3.5rem;
  }
  .content-section h2 {
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    color: #0D2137;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .content-section p {
    font-size: 1.12rem;
    line-height: 1.7;
    color: #3E4E60;
    margin-bottom: 1.25rem;
  }
  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .step-card {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 1.4rem 1.6rem;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .step-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .step-number {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0A3D3A;
    background: #EBF2F1;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    text-align: center;
  }
  .step-body h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0D2137;
    margin: 0 0 0.4rem 0;
  }
  .step-body p {
    font-size: 1rem;
    color: #4F5E72;
    margin: 0;
    line-height: 1.55;
  }
  .worked-example-card {
    background: #F8FAF9;
    border: 2px solid #0A3D3A;
    border-radius: 10px;
    padding: 1.75rem;
    margin-top: 1.5rem;
  }
  .example-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0A3D3A;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .example-intro {
    font-size: 1.08rem;
    color: #0D2137;
    margin-bottom: 1.25rem;
  }
  .example-table-wrap {
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .example-table {
    width: 100%;
    border-collapse: collapse;
    background: #FFFFFF;
    font-size: 0.98rem;
  }
  .example-table th {
    background-color: #0A3D3A;
    color: #FFFFFF;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
  }
  .example-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #DDE3EA;
    color: #0D2137;
  }
  .example-analysis h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0A3D3A;
    margin: 0 0 0.5rem 0;
  }
  .example-analysis p {
    font-size: 1.02rem;
    color: #3E4E60;
    margin-bottom: 0.75rem;
  }
  .example-takeaway {
    background: #FFFFFF;
    border-left: 4px solid #C9933A;
    padding: 0.85rem 1rem;
    border-radius: 4px;
  }
  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
  .fit-card {
    border-radius: 10px;
    padding: 1.6rem;
  }
  .fit-card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .fit-card--good {
    background: #F4FAF6;
    border: 2px solid #1A7A4E;
  }
  .fit-card--good h3 {
    color: #1A7A4E;
  }
  .fit-card--pro {
    background: #FFFDF8;
    border: 2px solid #C9933A;
  }
  .fit-card--pro h3 {
    color: #7A5210;
  }
  .fit-card ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: #0D2137;
  }
  .deliverables-box {
    background: #F6F8FA;
    border-radius: 10px;
    border: 1px solid #DDE3EA;
    padding: 1.75rem;
  }
  .deliverables-box p {
    font-size: 1.08rem;
    color: #0D2137;
    margin-top: 0;
  }
  .numbered-outcomes {
    margin: 1.25rem 0 0 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 1.05rem;
    color: #3E4E60;
  }
  .numbered-outcomes strong {
    color: #0D2137;
  }
</style>
