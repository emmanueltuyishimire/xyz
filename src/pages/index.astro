  .hero-heading {
    font-size: 1.6rem;
  }

  .hero-search-bar {
    flex-direction: column;
    border-radius: var(--radius-md);
  }

  .hero-search-input {
    width: 100%;
    border-bottom: 2px solid var(--color-border);
  }

  .hero-search-btn {
    width: 100%;
    min-height: 52px;
  }

  .hero-trust-container {
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }
}


/* -----------------------------------------------
   BENCHMARKS STRIP (AEO DATA STRIP)
   ----------------------------------------------- */
.benchmarks-section {
  background-color: #08111F;
  color: #FFFFFF;
  padding-block: var(--space-8);
  border-bottom: 2px solid #C9933A;
}

.benchmarks-eyebrow {
  font-size: var(--text-sm);
  color: #C9933A;
  font-weight: var(--font-bold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-4);
  display: flex;
  align-items: center;
}

.benchmarks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: var(--space-4);
  list-style: none;
  padding: 0;
  margin: 0;
}

.benchmark-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.benchmark-card:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #C9933A;
}

/* 2027 newly announced cards — same dark style as neighbours, gold left accent */
.benchmark-card--new2027 {
  border-left: 3px solid #C9933A;
}

.benchmark-label {
  font-size: var(--text-xs);
  color: #F1F5F9;
  line-height: 1.35;
  margin-bottom: var(--space-2);
}

.benchmark-value {
  font-size: 1.45rem;
  font-weight: var(--font-bold);
  color: #C9933A;
  text-decoration: none;
  line-height: 1.2;
  margin-bottom: var(--space-2);
  display: inline-block;
}

.benchmark-value--small {
  font-size: 1.15rem;
}

.benchmark-value:hover {
  text-decoration: underline;
  color: #e5ad4e;
}

.benchmark-unit {
  font-size: var(--text-sm);
  font-weight: var(--font-normal);
  color: rgba(255, 255, 255, 0.85);
}

.benchmark-source {
  font-size: 0.7rem;
  color: #CBD5E1;
}

.benchmark-gov-link {
  color: #F1F5F9;
  text-decoration: underline;
}

.benchmark-gov-link:hover {
  color: #FFFFFF;
}

/* -----------------------------------------------
   PATHWAYS SECTION (CTR URGENT PATHWAYS)
   ----------------------------------------------- */
.pathways-section {
  background-color: var(--color-background);
  padding-block: var(--space-16);
  border-bottom: 1px solid var(--color-border);
}

.pathways-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
  list-style: none;
  padding: 0;
  margin: var(--space-8) 0 0;
}

.pathway-card {
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.pathway-card:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.pathway-icon {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: hsla(186, 80%, 35%, 0.1);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pathway-icon--alert {
  background: hsla(24, 90%, 50%, 0.12);
  color: #C9933A;
}

.pathway-body {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pathway-trigger {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  color: var(--color-primary-dark);
  margin-bottom: var(--space-2);
  line-height: 1.35;
}

.pathway-context {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-4);
}

.pathway-cta {
  display: inline-flex;
  align-items: center;
  font-size: var(--text-sm);
  font-weight: var(--font-bold);
  color: var(--color-primary);
  text-decoration: none;
  margin-top: auto;
}

.pathway-cta:hover {
  text-decoration: underline;
  color: var(--color-primary-dark);
}

/* -----------------------------------------------
   COMMON QUESTIONS FAQ SECTION (AEO)
   ----------------------------------------------- */
.faq-section {
  background-color: var(--color-background-secondary);
  padding-block: var(--space-20);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.faq-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-6);
  margin-top: var(--space-10);
}

.faq-card {
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
}

.faq-question {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  color: var(--color-primary-dark);
  margin-bottom: var(--space-3);
  line-height: 1.35;
}

.faq-answer {
  font-size: var(--text-base);
  color: var(--color-text);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-4);
  flex-grow: 1;
}

.faq-link {
  font-size: var(--text-sm);
  font-weight: var(--font-bold);
  color: var(--color-primary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.faq-link:hover {
  text-decoration: underline;
  color: var(--color-primary-dark);
}

/* -----------------------------------------------
   LLM DISCOVERY & GEO RESEARCH BLOCK
   ----------------------------------------------- */
.llm-discovery-block {
  margin-top: var(--space-8);
  padding: var(--space-5) var(--space-6);
  background: #08111F;
  border-left: 4px solid #C9933A;
  border-radius: var(--radius-md);
  color: #FFFFFF;
}

.llm-discovery-badge {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: var(--font-bold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #C9933A;
  margin-bottom: var(--space-2);
}

.llm-discovery-text {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.88);
  line-height: var(--leading-normal);
  margin: 0;
}

.llm-file-link {
  color: #C9933A;
  text-decoration: underline;
}

.llm-file-link:hover {
  color: #FFFFFF;
}

.llm-file-link code {
  font-family: monospace;
  background: rgba(255, 255, 255, 0.12);
  padding: 1px 4px;
  border-radius: 3px;
  color: #C9933A;
}


/* -----------------------------------------------
   RECOGNITION SECTION
   ----------------------------------------------- */
.recognition-section {
  background-color: var(--color-background-secondary);
  padding-block: var(--space-20);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.section-eyebrow {
  font-size: var(--text-sm);
  color: var(--color-text-primary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: var(--font-bold);
  margin-bottom: var(--space-3);
  display: block;
}

.recognition-heading {
  font-size: var(--text-2xl);
  color: var(--color-primary-dark);
  margin-top: 0;
  margin-bottom: var(--space-10);
}

.recognition-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-5);
}

@media (max-width: 900px) {
  .recognition-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .recognition-grid {
    grid-template-columns: 1fr;
  }
}

.recog-card {
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.recog-card:hover {
  border-color: var(--color-secondary);
  box-shadow: var(--shadow-md);
}

.recog-icon {
  color: var(--color-secondary);
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: hsl(186, 50%, 93%);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.recog-trigger {
  font-size: var(--text-base);
  color: var(--color-primary);
  margin: 0;
  font-weight: var(--font-bold);
  line-height: var(--leading-snug);
}

.recog-context {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin: 0;
  flex-grow: 1;
}

.recog-link {
  font-size: var(--text-sm);
  color: var(--color-secondary-dark);
  font-weight: var(--font-bold);
  text-decoration: underline;
  text-underline-offset: 2px;
  margin-top: auto;
}

.recog-link:hover {
  color: var(--color-primary);
}


/* -----------------------------------------------
   SECTION HEADER (shared utility)
   ----------------------------------------------- */
.section-header-center {
  text-align: center;
  margin-bottom: var(--space-12);
  max-width: 680px;
  margin-inline: auto;
}

.section-heading {
  font-size: var(--text-2xl);
  color: var(--color-primary-dark);
  margin-top: var(--space-2);
  margin-bottom: var(--space-3);
}

.section-subtext {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin-bottom: 0;
  max-width: 560px;
  margin-inline: auto;
}


/* -----------------------------------------------
   HUBS SECTION
   ----------------------------------------------- */
.hubs-section {
  background: var(--color-surface);
  padding-block: var(--space-20);
}

.hubs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-5);
}

@media (max-width: 900px) {
  .hubs-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .hubs-grid {
    grid-template-columns: 1fr;
  }
}

.hub-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-6);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  text-decoration: none;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  border-top-width: 4px;
}

.hub-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-2px);
  text-decoration: none;
}

.hub-card--ss       { border-top-color: var(--color-primary); }
.hub-card--med      { border-top-color: var(--color-secondary); }
.hub-card--irs      { border-top-color: var(--color-accent); }
.hub-card--benefits { border-top-color: var(--color-success); }
.hub-card--retirement { border-top-color: hsl(260, 60%, 50%); }
.hub-card--taxes    { border-top-color: hsl(0, 65%, 45%); }

.hub-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: hsl(210, 30%, 95%);
  color: var(--color-primary);
  flex-shrink: 0;
}

.hub-card--ss .hub-icon       { background: hsl(216, 60%, 93%); color: var(--color-primary); }
.hub-card--med .hub-icon      { background: hsl(186, 50%, 92%); color: var(--color-secondary-dark); }
.hub-card--irs .hub-icon      { background: hsl(38, 80%, 93%);  color: var(--color-accent-dark); }
.hub-card--benefits .hub-icon { background: hsl(145, 50%, 92%); color: var(--color-success); }
.hub-card--retirement .hub-icon { background: hsl(260, 50%, 93%); color: hsl(260, 60%, 40%); }
.hub-card--taxes .hub-icon    { background: hsl(0, 60%, 93%);   color: hsl(0, 65%, 40%); }

.hub-body {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.hub-title {
  font-size: var(--text-lg);
  color: var(--color-primary);
  margin: 0 0 var(--space-2) 0;
  font-weight: var(--font-bold);
}

.hub-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-4);
  flex-grow: 1;
}

.hub-cta {
  font-size: var(--text-sm);
  font-weight: var(--font-bold);
  color: var(--color-secondary);
  margin-top: auto;
}

.hub-card:hover .hub-cta {
  color: var(--color-primary);
  text-decoration: underline;
}


/* -----------------------------------------------
   TOOLS SECTION
   ----------------------------------------------- */
.tools-section {
  background: var(--color-background-secondary);
  padding-block: var(--space-20);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-5);
  margin-bottom: var(--space-8);
}

@media (max-width: 1024px) {
  .tools-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .tools-grid {
    grid-template-columns: 1fr;
  }
}

.tool-card {
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-4);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.tool-card:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
}

.tool-card-top {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.tool-badge-row {
  display: flex;
  gap: var(--space-2);
}

.tool-badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--font-bold);
  padding: 2px var(--space-3);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.tool-badge--updated {
  background: hsl(145, 50%, 90%);
  color: hsl(145, 55%, 25%);
  border: 1px solid hsl(145, 45%, 75%);
}

.tool-title {
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  color: var(--color-primary);
  margin: 0;
  line-height: var(--leading-snug);
}

.tool-desc {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin: 0;
}

.tool-link {
  display: inline-block;
  font-size: var(--text-sm);
  font-weight: var(--font-bold);
  color: var(--color-secondary-dark);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color var(--transition-fast);
  padding: var(--space-2) 0;
  min-height: 44px;
  display: flex;
  align-items: center;
}

.tool-link:hover {
  color: var(--color-primary);
}

.tools-all-link {
  text-align: center;
}

.tools-all-btn {
  display: inline-block;
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  color: var(--color-secondary-dark);
  text-decoration: underline;
  text-underline-offset: 3px;
  padding: var(--space-3) var(--space-6);
  border: 2px solid var(--color-secondary);
  border-radius: var(--radius-md);
  transition: background-color var(--transition-fast), color var(--transition-fast);
  text-decoration: none;
}

.tools-all-btn:hover {
  background-color: var(--color-secondary);
  color: var(--color-text-inverse);
  text-decoration: none;
}


/* -----------------------------------------------
   HOW IT WORKS SECTION
   ----------------------------------------------- */
.how-section {
  background: var(--color-surface);
  padding-block: var(--space-20);
}

.steps-row {
  display: flex;
  align-items: flex-start;
  gap: 0;
  position: relative;
}

@media (max-width: 768px) {
  .steps-row {
    flex-direction: column;
    gap: var(--space-8);
  }

  .step-connector {
    display: none;
  }
}

.step-item {
  flex: 1;
  padding: 0 var(--space-8);
  text-align: center;
}

@media (max-width: 768px) {
  .step-item {
    padding: 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
}

.step-connector {
  flex-shrink: 0;
  width: 2px;
  height: 80px;
  background: linear-gradient(to bottom, var(--color-border) 0%, var(--color-secondary) 50%, var(--color-border) 100%);
  margin-top: 28px;
  opacity: 0.5;
}

.step-number {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--space-5);
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .step-number {
    margin: 0 0 var(--space-4) 0;
  }
}

.step-title {
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  color: var(--color-primary);
  margin: 0 0 var(--space-3) 0;
}

.step-body {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  margin: 0;
  max-width: 100%;
}


/* -----------------------------------------------
   TRUST & AUTHORITY SECTION
   ----------------------------------------------- */
.trust-section {
  background: var(--color-background-secondary);
  padding-block: var(--space-20);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.trust-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}

@media (max-width: 860px) {
  .trust-grid {
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }
}

/* Left: About */
.trust-about .section-eyebrow {
  margin-bottom: var(--space-3);
}

.trust-heading {
  font-size: var(--text-2xl);
  color: var(--color-primary-dark);
  margin-top: 0;
  margin-bottom: var(--space-6);
  line-height: 1.3;
}

.trust-about p {
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-5);
  color: var(--color-text);
  max-width: 100%;
}

.trust-independence {
  color: var(--color-primary) !important;
  font-weight: var(--font-bold);
  border-left: 3px solid var(--color-secondary);
  padding-left: var(--space-4);
}

/* Our Promise box */
.trust-promise-box {
  margin-top: var(--space-6);
  background: var(--color-surface);
  border: 2px solid var(--color-secondary);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}

.trust-promise-heading {
  font-size: 1.1rem;
  font-weight: var(--font-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-4);
  letter-spacing: -0.01em;
}

.trust-promise-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.trust-promise-list li {
  display: grid;
  grid-template-columns: 1.5rem 1fr;
  gap: var(--space-2);
  font-size: 0.95rem;
  line-height: var(--leading-normal);
  color: var(--color-text);
  align-items: baseline;
}

.trust-promise-list li > span:first-child {
  color: var(--color-secondary);
  font-weight: var(--font-bold);
  font-size: 1rem;
}

.trust-promise-list li strong {
  color: var(--color-primary);
}

/* Author signal */
.author-signal {
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin-top: var(--space-6);
  margin-bottom: var(--space-5);
}

.author-avatar-wrapper {
  flex-shrink: 0;
}

.author-avatar-img {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  object-fit: cover;
  border: 2px solid var(--color-secondary);
  display: block;
}

.author-avatar {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: var(--text-base);
  font-weight: var(--font-bold);
  letter-spacing: 0.05em;
}

.author-info {
