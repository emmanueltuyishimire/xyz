// ── FAQ schema for Common Questions section (AEO — Featured Snippet & AI Overview targeting)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://www.seniorsaudit.com/#faqpage",
  "isPartOf": { "@id": "https://www.seniorsaudit.com/#website" },
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Social Security COLA for 2027?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Social Security Cost-of-Living Adjustment (COLA) for 2027 is 3.6%, officially announced by the Social Security Administration on October 14, 2026. The increase takes effect with January 2027 payments (SSI on December 31, 2026). The maximum taxable earnings wage base rises to $192,300. Use our Social Security COLA 2027 Calculator or read our Social Security COLA 2027 Guide for full details."
      }
    },
    {
      "@type": "Question",
      "name": "What is my Social Security Full Retirement Age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your Full Retirement Age (FRA) depends on your birth year. For anyone born in 1960 or later, the FRA is age 67. For those born between 1943 and 1954, the FRA is age 66. For birth years 1955–1959, the FRA increases in two-month increments from 66 to 67. Use the SSA.gov chart or our Full Retirement Age Calculator to find your exact FRA."
      }
    },
    {
      "@type": "Question",
      "name": "How much is the Medicare Part B late enrollment penalty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Medicare Part B late enrollment penalty is 10% of the standard Part B premium ($202.90 in 2026) for each full 12-month period you went without Part B coverage after your Initial Enrollment Period ended. The penalty is permanent and added to your monthly premium for as long as you have Part B. Source: CMS.gov."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if I receive an IRS CP2000 notice?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A CP2000 notice proposes changes to your tax return based on income the IRS received from third parties. Do not automatically pay the proposed amount. Review the proposed changes carefully, gather your records, and respond in writing using the Response form included with your CP2000 notice, by the due date printed on it (usually 30 days). Our CP2000 Response Letter Tool generates a written dispute response."
      }
    },
    {
      "@type": "Question",
      "name": "When do I have to start taking Required Minimum Distributions (RMDs)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under the SECURE 2.0 Act (P.L. 117-328), the RMD starting age is 73 if you were born between 1951 and 1959, and age 75 if you were born in 1960 or later. RMDs apply to traditional IRAs, 401(k)s, 403(b)s, and most other tax-deferred retirement accounts. Roth IRAs are not subject to RMDs during the owner's lifetime. Source: IRS Publication 590-B."
      }
    }
  ]
};

