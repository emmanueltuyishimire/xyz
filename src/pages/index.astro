---

<BaseLayout
  title="Seniors Audit — Medicare, Social Security & Tax Tools"
  description="Free decision-support tools, calculators, and plain-English guides for Medicare, Social Security, IRS notices, and senior benefits. Verified official data."
  schema={[websiteSchema, organizationSchema, homepageSchema, faqSchema, toolsItemListSchema]}
>

  <!-- =============================================
       SECTION 1: HERO — POSITIONING + UTILITY
       ============================================= -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-content">

        <!-- Positioning eyebrow -->
        <p class="hero-eyebrow">
          Independent Decision Support for American Seniors &amp; Retirees
        </p>

        <!-- H1 — Clear Value Proposition -->
        <h1 id="hero-title" class="hero-heading">
          Make Confident Decisions About Medicare, Social Security, Retirement &amp; Taxes
        </h1>

        <p class="hero-subheading">
          Seniors Audit provides plain-English explanations, official-formula calculators, and practical decision guides to help older adults and family caregivers understand complex federal programs without sales pressure.
        </p>

        <!-- Freshness signal -->
        <p class="hero-last-reviewed" aria-label="Content verification date">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="display:inline;vertical-align:-2px;margin-right:4px;"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5v4l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          Verified against official sources: 2026 figures, plus the 2027 COLA announced October 14, 2026.
        </p>

        <!-- Search bar — primary interactive element -->
        <div class="hero-search-wrapper" role="search">
          <form class="hero-search-form" action="/search/" method="get" aria-label="Search Seniors Audit">
            <label for="hero-search-input" class="sr-only">Search for answers</label>
            <div class="hero-search-bar">
              <input
                id="hero-search-input"
                class="hero-search-input"
                type="search"
                name="q"
                placeholder="Search guides or calculators (e.g., 'Full Retirement Age', 'Part B Penalty', 'CP2000')..."
                autocomplete="off"
                spellcheck="false"
                aria-label="Search for your question"
              />
              <button type="submit" class="hero-search-btn" aria-label="Search">
                Search
              </button>
            </div>
          </form>

          <!-- Popular quick-links -->
          <nav class="hero-quick-links" aria-label="Popular decision tools">
            <span class="hero-quick-label">Popular decision tools:</span>
            <ul class="hero-quick-list" role="list">
              <li><a href="/tools/social-security-cola-calculator/" class="hero-quick-chip">Social Security COLA 2027 Calculator</a></li>
              <li><a href="/tools/social-security-benefits-calculator/" class="hero-quick-chip">SS Benefits Calculator</a></li>
              <li><a href="/tools/social-security-full-retirement-age-calculator/" class="hero-quick-chip">Full Retirement Age</a></li>
              <li><a href="/tools/medicare-late-enrollment-penalty-calculator/" class="hero-quick-chip">Part B Penalty</a></li>
              <li><a href="/tools/rmd-calculator/" class="hero-quick-chip">RMD Calculator</a></li>
              <li><a href="/tools/medicare-irmaa-calculator/" class="hero-quick-chip">IRMAA Calculator</a></li>
              <li><a href="/tools/gift-card-wire-transfer-scam-checklist/" class="hero-quick-chip">Scam Checker</a></li>
            </ul>
          </nav>
        </div>

        <!-- Trust indicators -->
        <div class="hero-trust-container" role="note">
          <span class="trust-item">
            <span class="trust-dot" aria-hidden="true">●</span>
            Verified against official guidelines from SSA.gov, IRS.gov, and Medicare.gov
          </span>
          <span class="trust-item">
            <span class="trust-dot" aria-hidden="true">●</span>
            Founded by Emmanuel Tuyishimire
          </span>
          <span class="trust-item">
            <span class="trust-dot" aria-hidden="true">●</span>
            Independent — not affiliated with any government agency
          </span>
          <span class="trust-item trust-item--highlight">
            <span class="trust-dot" aria-hidden="true">🔒</span>
            100% Client-side privacy — your numbers are never stored
          </span>
          <span class="trust-item trust-item--highlight">
            <span class="trust-dot" aria-hidden="true">🆓</span>
            Free tools &amp; guides — no registration or account required
          </span>
        </div>

      </div>
    </div>
  </section>


  <!-- =============================================
       SECTION 2: 2026 FEDERAL BENCHMARKS STRIP
