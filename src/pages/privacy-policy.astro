---
/**
 * privacy-policy.astro
 * Full, publication-ready Privacy Policy for seniorsaudit.com.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Privacy Policy' }
];

const lastUpdated = 'September 2026';
---

<BaseLayout 
  title="Privacy Policy — Seniors Audit" 
  description="Read the privacy policy for seniorsaudit.com. We protect your personal data, never sell information, and require no account registration for calculators."
>
  <div class="legal-page-container">
    <div class="container">

      <Breadcrumb items={breadcrumbItems} />

      <div class="legal-layout">
        <main class="legal-main">
          <header class="legal-header">
            <h1 class="legal-title">Privacy Policy</h1>
            <p class="legal-meta">Last Updated: {lastUpdated} &bull; seniorsaudit.com</p>
            <div class="legal-summary-box">
              <strong>Plain-English Summary:</strong> We do not sell your data. We do not require you to sign up. All numbers you enter into our calculators stay entirely in your browser and are never sent to our servers. We use minimal, privacy-respecting analytics to understand which pages are helpful.
            </div>
          </header>

          <nav class="legal-toc" aria-label="Table of contents">
            <p class="toc-label">Contents</p>
            <ol class="toc-list">
              <li><a href="#who-we-are">Who We Are</a></li>
              <li><a href="#information-we-collect">Information We Collect</a></li>
              <li><a href="#calculator-privacy">Calculator Privacy</a></li>
              <li><a href="#cookies-analytics">Cookies and Analytics</a></li>
              <li><a href="#advertising">Advertising</a></li>
              <li><a href="#contact-form">Contact Form Data</a></li>
              <li><a href="#third-party-links">Third-Party Links</a></li>
              <li><a href="#social-media">Social Media Platforms</a></li>
              <li><a href="#data-security">Data Security</a></li>
              <li><a href="#childrens-privacy">Children's Privacy</a></li>
              <li><a href="#your-rights">Your Rights</a></li>
              <li><a href="#policy-changes">Policy Changes</a></li>
              <li><a href="#contact-us">Contact Us</a></li>
            </ol>
          </nav>

          <section class="legal-body" id="who-we-are">
            <h2>1. Who We Are</h2>
            <p>
              seniorsaudit.com ("Seniors Audit," "we," "us," or "our") is an independent educational website founded and operated by Emmanuel TUYISHIMIRE We are not affiliated with, endorsed by, or connected to any government agency, including but not limited to the Social Security Administration (SSA), the Internal Revenue Service (IRS), the Centers for Medicare &amp; Medicaid Services (CMS), or the Department of Health and Human Services (HHS).
            </p>
            <p>
              Our website address is: <strong>https://www.seniorsaudit.com</strong>
            </p>
            <p>
              This Privacy Policy describes how we handle information when you visit our website, use our calculators, or contact us. By using our website, you acknowledge that you have read and understood this policy.
            </p>
          </section>

          <section class="legal-body" id="information-we-collect">
            <h2>2. Information We Collect</h2>
            <p>
              We collect the minimum amount of information necessary to operate and improve this website. We categorize information as follows:
            </p>
            <h3>A. Information You Voluntarily Provide</h3>
            <p>
              If you choose to contact us using our contact form or by email, you may provide your name, email address, and the contents of your message. This information is used solely to respond to your inquiry. We do not add you to any mailing list without your explicit consent, and we do not share this information with third parties.
            </p>
            <h3>B. Automatically Collected Technical Information</h3>
            <p>
              When you visit our website, our web server and analytics tools may automatically collect standard technical data that web browsers routinely send, including:
            </p>
            <ul>
              <li>Your Internet Protocol (IP) address (anonymized or truncated where technically possible)</li>
              <li>Browser type and version</li>
              <li>Operating system type</li>
              <li>The page URL you visited</li>
              <li>The date and time of your visit</li>
              <li>The referring page (the page that linked you to ours), if any</li>
            </ul>
            <p>
              This technical data is used only for site performance monitoring, troubleshooting, and understanding general traffic patterns. It is not linked to any personal identity.
            </p>
            <h3>C. Calculator Input Data</h3>
            <p>
              See Section 3 (Calculator Privacy) for a complete explanation of how we handle numbers you enter into our calculators. In short: we do not collect or transmit them.
            </p>
          </section>

          <section class="legal-body" id="calculator-privacy">
            <h2>3. Calculator Privacy</h2>
            <p>
              Our interactive calculators — including tools for Social Security benefits, Medicare IRMAA surcharges, Required Minimum Distributions (RMDs), and other retirement calculations — are designed with a core privacy principle:
            </p>
            <div class="policy-highlight-box">
              <strong>All calculator computations occur entirely within your web browser.</strong> The numbers you enter — your income, your age, your account balances, your benefit estimates — are processed using JavaScript running on your own device. This data is never transmitted to our web servers. We do not store, log, or have access to anything you enter into a calculator.
            </div>
            <p>
              When you close the browser tab or refresh the page, your calculator inputs are cleared. We do not use local storage or session storage to persist your calculator data between visits unless a specific calculator tool explicitly states otherwise and offers you a clear choice.
            </p>
            <p>
              You can verify this behavior by using your browser's developer tools (Network tab) to confirm that no data is being sent to a server when you enter calculator values.
            </p>
          </section>

          <section class="legal-body" id="cookies-analytics">
            <h2>4. Cookies and Analytics</h2>
            <h3>A. What Are Cookies</h3>
            <p>
              Cookies are small text files that websites store on your device to remember preferences or track behavior across visits. There are many types of cookies, ranging from essential functional cookies (needed for the site to work) to targeted advertising cookies (used to build user profiles and serve ads).
            </p>
            <h3>B. Our Cookie Policy</h3>
            <p>
              Seniors Audit does not use targeted advertising cookies. We do not use cookies to build user profiles, retarget you with ads, or track you across other websites. We do not sell your browsing data to advertising networks.
            </p>
            <p>
              We may use the following minimal, privacy-respecting tools:
            </p>
            <ul>
              <li>
                <strong>Google Analytics 4:</strong> We use Google Analytics 4 (Measurement ID: <code>G-XVX92VDPCE</code>) to measure user interactions across our website, such as pages viewed, calculators used, and engagement metrics. Google Analytics uses first-party cookies to collect standard internet log information and visitor behavior in an aggregate, anonymized manner. We have IP anonymization enabled. You can opt out of Google Analytics tracking across all websites by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
              </li>
              <li>
                <strong>Ahrefs Analytics:</strong> We use Ahrefs Analytics to understand aggregate, anonymous information — such as how many visitors viewed a page, which guides are most helpful, and how traffic changes over time. Ahrefs Analytics does not use cookies for individual tracking, does not create personal user profiles, and does not share data with advertising networks. The only data collected is standard pageview data (page URL, referrer, device type, country). No personal identifying information is collected or stored. You can review Ahrefs' privacy practices at <a href="https://ahrefs.com/big-data" target="_blank" rel="noopener noreferrer">ahrefs.com/big-data</a>.
              </li>
              <li>
                <strong>Essential functional cookies:</strong> Some basic cookies may be used by our hosting infrastructure for security (e.g., bot protection, rate limiting). These are not used for tracking purposes.
              </li>
            </ul>
            <h3>C. How to Control Cookies</h3>
            <p>
              You can configure your browser to reject all cookies, accept only certain types, or notify you before cookies are stored. Instructions for managing cookies are available in your browser's help documentation. Note that disabling cookies will not affect the functionality of our calculators or guides, as they do not require cookies to operate.
            </p>
          </section>

          <section class="legal-body" id="advertising">
            <h2>5. Advertising &amp; Digital Products</h2>

            <h3>A. Display Advertising</h3>
            <p>
              This site may display advertising from a third-party advertising partner to help keep our free tools and guides available at no cost to visitors. When display advertising is active, our advertising partner may use cookies and similar tracking technologies to serve ads based on your prior visits to this and other websites on the internet.
            </p>
            <ul>
              <li>Any ads displayed on this site will be clearly separate from editorial content. No advertiser influences our guides, calculator formulas, or editorial recommendations.</li>
              <li>We do not sell advertising space directly to insurance companies, Medicare Advantage plan marketers, or financial product sellers in a way that would create a conflict of interest with our educational mission.</li>
              <li>Third-party advertising vendors may collect and use data about your visits to this and other websites in order to provide relevant advertising. This data collection is governed by the privacy policy of our advertising partner.</li>
              <li>You may opt out of interest-based advertising by visiting <a href="https://optout.aboutads.info/" target="_blank" rel="noopener noreferrer">optout.aboutads.info</a> (DAA opt-out) or <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer">optout.networkadvertising.org</a> (NAI opt-out).</li>
              <li>EU/UK visitors may manage advertising consent preferences through the consent interface displayed when visiting our site.</li>
            </ul>
            <p>
              Our <code>ads.txt</code> file is publicly accessible at <a href="https://www.seniorsaudit.com/ads.txt" target="_blank" rel="noopener noreferrer">seniorsaudit.com/ads.txt</a> and lists all authorized digital sellers for this domain in accordance with advertising network standards.
            </p>

            <h3>B. Optional Educational Digital Products &amp; Gumroad Processing</h3>
            <p>
              We offer optional, downloadable educational digital products — such as retirement planning workbooks, Medicare decision planners, penalty avoidance kits, and Social Security claiming guides — through our dedicated store at <a href="https://resources.seniorsaudit.com/" target="_blank" rel="noopener noreferrer">resources.seniorsaudit.com</a>. These products are supplementary decision-support tools. They are never required to access any free interactive calculator, guide, or article on seniorsaudit.com.
            </p>
            <p>
              For all digital product transactions, the following privacy practices apply:
            </p>
            <ul>
              <li><strong>Secure Third-Party Processing:</strong> All orders and payments are hosted and processed securely by <strong>Gumroad</strong> (Gumroad, Inc.). Seniors Audit does not collect, process, or store credit card numbers, debit card numbers, or bank account details on our servers. All financial transactions occur within Gumroad's secure payment infrastructure. For information on how Gumroad handles your payment data, please review the <a href="https://gumroad.com/privacy" target="_blank" rel="noopener noreferrer">Gumroad Privacy Policy</a>.</li>
              <li><strong>Order Fulfillment Information:</strong> When you purchase a digital workbook or bundle through Gumroad, we receive transaction notification data including your email address, purchase amount, product name, and date of order. This information is used strictly to deliver your digital download, verify your access, and provide customer support if you request assistance.</li>
              <li><strong>No Marketing Lists Without Consent:</strong> Your purchase email address will never be sold, rented, or shared with third-party advertisers or insurance brokers. We do not enroll purchasers into promotional email marketing without explicit opt-in consent.</li>
              <li><strong>Customer Support &amp; Delivery:</strong> Digital products are delivered electronically immediately upon completed checkout. If you encounter any technical delivery issue, contact us at <a href="mailto:support@seniorsaudit.com">support@seniorsaudit.com</a> and our team will resolve it promptly.</li>
              <li><strong>Non-Advisory Nature:</strong> Digital planning workbooks contain educational information and step-by-step arithmetic based on federal government sources current at publication. They do not constitute legal, tax, financial, or medical advice. See our <a href="/disclaimer/">General Disclaimer</a>.</li>
            </ul>

            <h3>C. AI-Assisted Content</h3>
            <p>
              Some content on this site is drafted with the help of AI tools. All factual claims, calculations, and figures are independently verified against official government sources (SSA, IRS, CMS) and reviewed by a human editor before publication. See our <a href="/about/">About page</a> for more detail on our editorial process.
            </p>

            <h3>D. What We Do Not Do</h3>
            <p>
              We do not sell advertising space in a way that compromises editorial independence. We do not accept commissions, referral fees, or lead-generation payments for directing users toward any insurance plan, Medicare Advantage plan, financial product, or investment service. We do not sell your personal data to any advertiser, broker, or data aggregator.
            </p>
          </section>

          <section class="legal-body" id="contact-form">
            <h2>6. Contact Form Data</h2>
            <p>
              If you contact us via our website's contact form or a published email address, we receive your name, email address, and your message. We use this information for the sole purpose of reading and responding to your question.
            </p>
            <p>
              We do not:
            </p>
            <ul>
              <li>Sell your email address or contact details to any third party.</li>
              <li>Share your inquiry with any affiliate, advertiser, or partner.</li>
              <li>Add you to any marketing or newsletter mailing list without your explicit opt-in consent.</li>
            </ul>
            <p>
              Contact messages are retained only as long as reasonably necessary to manage correspondence and are not kept beyond what is operationally needed.
            </p>
          </section>

          <section class="legal-body" id="third-party-links">
            <h2>7. Third-Party Links</h2>
            <p>
              Our website contains links to official government websites (such as SSA.gov, IRS.gov, Medicare.gov, and HHS.gov) and, where relevant, to reputable third-party educational or informational resources. We also link to our social media profiles on YouTube, Facebook, LinkedIn, and Reddit.
            </p>
            <p>
              These third-party websites have their own independent privacy policies. We have no control over their content or data practices. We strongly encourage you to review the privacy policy of any website you visit through a link from ours.
            </p>
            <p>
              A link from Seniors Audit to a third-party website does not constitute an endorsement of that site's privacy practices, products, or services.
            </p>
          </section>

          <section class="legal-body" id="social-media">
            <h2>8. Social Media Platforms</h2>
            <p>
              Seniors Audit maintains official, publicly accessible profiles on the following social media platforms:
            </p>
            <ul>
              <li><strong>YouTube (Brand Channel):</strong> <a href="https://www.youtube.com/@SeniorsAudit" target="_blank" rel="noopener noreferrer">youtube.com/@SeniorsAudit</a></li>
              <li><strong>Facebook (Brand Page):</strong> <a href="https://web.facebook.com/SeniorsAudit" target="_blank" rel="noopener noreferrer">facebook.com/SeniorsAudit</a></li>
              <li><strong>Facebook (Founder Profile):</strong> <a href="https://web.facebook.com/profile.php?id=61590667687592" target="_blank" rel="noopener noreferrer">facebook.com (Emmanuel TUYISHIMIRE)</a></li>
              <li><strong>LinkedIn (Founder Profile):</strong> <a href="https://www.linkedin.com/in/emmanueltuyishimire" target="_blank" rel="noopener noreferrer">linkedin.com/in/emmanueltuyishimire</a></li>
              <li><strong>Reddit (Founder Profile):</strong> <a href="https://www.reddit.com/user/Emmanuel_Tuyishimire/" target="_blank" rel="noopener noreferrer">reddit.com/user/Emmanuel_Tuyishimire</a></li>
            </ul>
            <p>
              When you interact with our content on these platforms (such as liking a video, leaving a comment, or sending a direct message), that interaction is subject to the privacy policy of the respective platform — not this Privacy Policy. We encourage you to review the privacy policies of YouTube, Facebook, LinkedIn, and Reddit independently.
            </p>
            <p>
              We do not embed social media trackers or tracking pixels from these platforms on our website pages.
            </p>
          </section>

          <section class="legal-body" id="data-security">
            <h2>9. Data Security</h2>
            <p>
              We take reasonable and appropriate technical and organizational measures to protect the limited information we do hold (primarily, contact form correspondence) from unauthorized access, disclosure, or loss. Our website uses HTTPS encryption for all connections.
            </p>
            <p>
              However, no system of security is perfect or impenetrable. While we do our best to protect your information, we cannot guarantee the absolute security of any data transmitted over the internet. We encourage you to take steps to protect your own information, such as avoiding the sharing of sensitive personal financial details in contact form messages.
            </p>
          </section>

          <section class="legal-body" id="childrens-privacy">
            <h2>10. Children's Privacy</h2>
            <p>
              Seniors Audit is intended for adult audiences — specifically seniors, retirees, and their caregivers. Our content is not directed toward children under the age of 13. We do not knowingly collect personal information from children under 13. If we learn that we have inadvertently collected personal information from a child under 13, we will promptly delete that information.
            </p>
            <p>
              If you are a parent or guardian and believe your child has provided us with personal information, please contact us at the address listed in Section 13 so we can take appropriate action.
            </p>
          </section>

          <section class="legal-body" id="your-rights">
            <h2>11. Your Rights</h2>
            <p>
              Because we collect very little personal information and do not engage in data sales or profiling, many typical data rights concerns do not apply. Nevertheless, we respect your rights under applicable laws:
            </p>
            <ul>
              <li>
                <strong>Access:</strong> You may request a summary of any personal data we hold about you (which, for most visitors, is nothing beyond any contact form messages you have sent).
              </li>
              <li>
                <strong>Deletion:</strong> You may request that we delete any correspondence or personal information you have shared with us via contact form or email.
              </li>
              <li>
                <strong>Correction:</strong> If you believe any information we hold is inaccurate, you may request that it be corrected.
              </li>
            </ul>
            <p>
              To exercise any of these rights, contact us using the information in Section 13. We will respond within a reasonable timeframe.
            </p>
            <p>
              If you are a resident of California, the European Union, the United Kingdom, or another jurisdiction with specific data protection laws (such as the CCPA/CPRA or GDPR), the above rights apply to you. We do not sell personal information as defined under the CCPA. We use privacy-first analytics (Ahrefs Analytics) that does not use cookies for individual tracking. When display advertising is active on this site, our third-party advertising partner may engage in interest-based advertising activities that may constitute "sharing" under California law or require consent under GDPR/UK GDPR — opt-out mechanisms are described in Section 5 (Advertising) of this policy. California residents also have the right to opt out of such "sharing" of personal information for cross-context behavioral advertising by using the opt-out links provided in Section 5.
            </p>
          </section>

          <section class="legal-body" id="policy-changes">
            <h2>12. Changes to This Privacy Policy</h2>
            <p>
              We may update this Privacy Policy from time to time to reflect changes in our practices, technology, or legal requirements. When we make material changes, we will update the "Last Updated" date at the top of this page.
            </p>
            <p>
              We encourage you to review this page periodically. Your continued use of Seniors Audit after any changes become effective constitutes your acceptance of the updated Privacy Policy.
            </p>
          </section>

          <section class="legal-body" id="contact-us">
            <h2>13. Contact Us</h2>
            <p>
              If you have questions, concerns, or requests regarding this Privacy Policy, or if you wish to exercise any of your data rights, please contact us:
            </p>
            <div class="contact-info-box">
              <p><strong>Seniors Audit</strong></p>
              <p>Website: <a href="https://www.seniorsaudit.com">seniorsaudit.com</a></p>
              <p>Contact Page: <a href="/contact/">seniorsaudit.com/contact/</a></p>
            </div>
          </section>

        </main>

        <!-- Sidebar navigation -->
        <aside class="legal-sidebar" aria-label="Related legal pages">
          <div class="sidebar-nav-card">
            <h2 class="sidebar-nav-title">Legal Pages</h2>
            <ul class="sidebar-nav-list">
              <li><a href="/privacy-policy/" class="sidebar-nav-link current" aria-current="page">Privacy Policy</a></li>
              <li><a href="/disclaimer/" class="sidebar-nav-link">General Disclaimer</a></li>
              <li><a href="/terms-of-use/" class="sidebar-nav-link">Terms of Use</a></li>
              <li><a href="/about/" class="sidebar-nav-link">About Seniors Audit</a></li>
              <li><a href="/contact/" class="sidebar-nav-link">Contact Us</a></li>
            </ul>
          </div>
          <div class="sidebar-trust-box">
            <p class="sidebar-trust-headline">Your Privacy Matters</p>
            <ul class="trust-checklist">
              <li>✅ No calculator data sent to servers</li>
              <li>✅ No user accounts required</li>
              <li>✅ No ad-tracking cookies</li>
              <li>✅ No personal data sold</li>
              <li>✅ HTTPS encrypted connections</li>
            </ul>
          </div>
        </aside>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .legal-page-container {
    padding-block: var(--space-8);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
    }
    .legal-sidebar {
      order: -1;
    }
  }

  .legal-header {
    margin-bottom: var(--space-8);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-6);
  }

  .legal-title {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .legal-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .legal-summary-box {
    background: hsl(186, 50%, 95%);
    border-left: 4px solid var(--color-secondary);
    padding: var(--space-4) var(--space-5);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  /* Table of Contents */
  .legal-toc {
    background: var(--color-bg-subtle, hsl(210, 25%, 98%));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-10);
  }

  .toc-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: var(--space-3);
  }

  .toc-list {
    padding-left: var(--space-5);
    margin: 0;
    column-count: 2;
    column-gap: var(--space-6);
  }

  @media (max-width: 600px) {
    .toc-list {
      column-count: 1;
    }
  }

  .toc-list li {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .toc-list a {
    color: var(--color-secondary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .toc-list a:hover {
    color: var(--color-primary);
  }

  /* Legal body sections */
  .legal-body {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-body:last-child {
    border-bottom: none;
  }

  .legal-body h2 {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-top: 0;
    margin-bottom: var(--space-4);
    padding-top: var(--space-2);
  }

  .legal-body h3 {
    font-size: var(--text-base);
    color: var(--color-primary-dark);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    font-weight: var(--font-semibold);
  }

  .legal-body p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .legal-body ul {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .legal-body li {
    margin-bottom: var(--space-3);
    line-height: var(--leading-normal);
    font-size: var(--text-base);
  }

  /* Special boxes */
  .policy-highlight-box {
    background: hsl(211, 80%, 96%);
    border: 1px solid hsl(211, 60%, 85%);
    border-left: 4px solid var(--color-primary);
    padding: var(--space-5) var(--space-6);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-5) 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-primary-dark);
  }

  .contact-info-box {
    background: var(--color-bg-subtle, hsl(210, 25%, 98%));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-base);
  }

  .contact-info-box p {
    margin-bottom: var(--space-2);
  }

  .contact-info-box p:last-child {
    margin-bottom: 0;
  }

  /* Sidebar */
  .sidebar-nav-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
    background: var(--color-surface, #fff);
  }

  .sidebar-nav-title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-top: 0;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-nav-link {
