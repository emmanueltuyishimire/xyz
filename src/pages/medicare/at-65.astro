    color: #FFFFFF;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .sidebar-tool-btn:hover { background: #B07D2A; color: #FFFFFF; text-decoration: none; }

  /* ── Sidebar Trust ── */
  .sidebar-trust {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    background: var(--color-background-secondary);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
  .sidebar-trust svg { flex-shrink: 0; color: var(--color-success); margin-top: 2px; }

  /* ── Sidebar SHIP ── */
  .sidebar-ship {
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .sidebar-ship-label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2);
  }
  .sidebar-ship-text {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0 0 var(--space-3);
  }
  .sidebar-ship-link {
    font-size: var(--text-xs);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: underline;
  }

  /* ── Decision Grid (Start Here) ── */
  .decision-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-8);
  }
  @media (min-width: 640px) {
    .decision-grid { grid-template-columns: 1fr 1fr; }
  }
  .decision-card {
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-top: 4px solid #0A3D3A;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .decision-card:hover {
    border-color: #0A3D3A;
    transform: translateY(-2px);
  }
  .decision-card--urgent {
    border-top-color: #C0392B;
    background: #FFF9F9;
  }
  :global([data-theme="dark"]) .decision-card--urgent {
    background: rgba(192, 57, 43, 0.08);
  }
  .decision-card-label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C9933A;
    margin: 0;
  }
  .decision-card-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: var(--leading-snug);
  }
  .decision-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
    flex-grow: 1;
  }
  .decision-card-action {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: #0A3D3A;
    margin: var(--space-1) 0 0;
    line-height: var(--leading-snug);
  }
  :global([data-theme="dark"]) .decision-card-action { color: #1DB8A8; }
  .decision-card-link {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    margin-top: var(--space-2);
    display: inline-block;
  }
  .decision-card-link:hover { color: var(--color-primary-light); }

  /* ── Visual Timeline ── */
  .timeline-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-6);
  }
  .timeline-node {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    align-items: start;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-sizing: border-box;
  }
  @media (min-width: 540px) {
    .timeline-node {
      grid-template-columns: 85px 1fr;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
    }
  }
  .timeline-node--birthday {
    border: 2px solid #C9933A;
    background: #FCF9F2;
  }
  :global([data-theme="dark"]) .timeline-node--birthday {
    background: rgba(201, 147, 58, 0.08);
    border-color: #C9933A;
  }
  .timeline-marker {
    background: #0A3D3A;
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-align: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    letter-spacing: 0.04em;
    display: inline-block;
    width: fit-content;
  }
  .timeline-node--birthday .timeline-marker {
    background: #C9933A;
    color: #FFFFFF;
  }
  .timeline-title {
    display: block;
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ═══════════════════════════════════════════════════
     INTERACTIVE DECISION TOOL — Enhanced Styles
  ═══════════════════════════════════════════════════ */

  /* Tool container */
  .t65-tool-container {
    background: var(--color-background-secondary);
    border: 2px solid #0A3D3A;
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    margin: var(--space-6) 0 var(--space-8);
    box-shadow: 0 6px 28px rgba(10, 61, 58, 0.10);
    scroll-margin-top: 80px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  @media (min-width: 600px) {
    .t65-tool-container { padding: var(--space-6); margin: var(--space-8) 0 var(--space-10); }
  }
  @media (min-width: 768px) {
    .t65-tool-container { padding: var(--space-8); }
  }

  /* ── Header ── */
  .t65-tool-header { margin-bottom: var(--space-6); }

  .t65-tool-badge {
    display: inline-block;
    background: #0A3D3A;
    color: #C9933A;
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 12px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  .t65-tool-title {
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    line-height: var(--leading-tight);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-tool-intro {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5);
    line-height: var(--leading-relaxed);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Features Box ── */
  .t65-features-box {
    background: #F2F7F6;
    border-left: 4px solid #0A3D3A;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-6);
    box-sizing: border-box;
  }
  :global([data-theme="dark"]) .t65-features-box {
    background: rgba(10, 61, 58, 0.18);
    border-left-color: #1DB8A8;
  }

  .t65-features-label {
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #0A3D3A;
    margin: 0 0 var(--space-2);
  }
  :global([data-theme="dark"]) .t65-features-label { color: #C9933A; }

  .t65-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  @media (min-width: 600px) {
    .t65-features-list { grid-template-columns: 1fr 1fr; }
  }

  .t65-check {
    color: #0A3D3A;
    font-weight: var(--font-bold);
    margin-right: 5px;
  }
  :global([data-theme="dark"]) .t65-check { color: #1DB8A8; }

  /* ── Progress bar ── */
  .t65-progress-wrap {
    margin-top: var(--space-5);
  }

  .t65-progress-steps {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .t65-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background 0.25s, transform 0.25s;
    flex-shrink: 0;
  }
  .t65-dot.active {
    background: #0A3D3A;
    transform: scale(1.25);
  }
  .t65-dot.done {
    background: #C9933A;
  }
  :global([data-theme="dark"]) .t65-dot.active { background: #1DB8A8; }

  .t65-progress-bar-track {
    height: 6px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .t65-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #0A3D3A 0%, #C9933A 100%);
    border-radius: var(--radius-full);
    transition: width 0.35s ease;
  }

  .t65-progress-labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-secondary);
  }

  .t65-step-counter { color: #0A3D3A; font-weight: var(--font-bold); }
  :global([data-theme="dark"]) .t65-step-counter { color: #1DB8A8; }
  .t65-step-name { color: var(--color-text-muted); }

  /* ── Step Panels ── */
  .t65-wizard-body { margin-top: var(--space-6); min-width: 0; }

  .t65-step-panel {
    animation: t65FadeIn 0.25s ease;
    min-width: 0;
  }
  @keyframes t65FadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Step context header (number + question) */
  .t65-step-context {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-step-context { gap: var(--space-4); }
  }

  .t65-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 50%;
    background: #0A3D3A;
    color: #FFFFFF;
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }
  @media (min-width: 600px) {
    .t65-step-num { width: 44px; height: 44px; min-width: 44px; font-size: var(--text-lg); }
  }
  :global([data-theme="dark"]) .t65-step-num { background: #1DB8A8; color: #08111F; }

  .t65-question {
    font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-1);
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-step-why {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Option cards (radio) ── */
  .t65-options-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .t65-option-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    position: relative;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    box-sizing: border-box;
  }
  @media (min-width: 600px) {
    .t65-option-card { padding: var(--space-4); }
  }
  .t65-option-card:hover {
    border-color: #0A3D3A;
    box-shadow: 0 2px 8px rgba(10, 61, 58, 0.1);
  }
  .t65-option-card:has(input:checked),
  .t65-option-card.selected {
    border-color: #0A3D3A;
    background: #F0F7F6;
    box-shadow: 0 2px 10px rgba(10, 61, 58, 0.12);
  }
  :global([data-theme="dark"]) .t65-option-card:has(input:checked),
  :global([data-theme="dark"]) .t65-option-card.selected {
    background: rgba(10, 61, 58, 0.2);
    border-color: #1DB8A8;
  }

  .t65-radio {
    margin-top: 3px;
    accent-color: #0A3D3A;
    width: 20px;
    height: 20px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .t65-option-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  .t65-option-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-option-sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Goal Card Checkboxes ── */
  .t65-goals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    min-width: 0;
  }
  @media (min-width: 540px) {
    .t65-goals-grid { grid-template-columns: 1fr 1fr; }
  }

  .t65-goal-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    min-height: 52px;
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .t65-goal-card:hover {
    border-color: #0A3D3A;
  }
  .t65-goal-card:has(input:checked),
  .t65-goal-card.selected {
    border-color: #0A3D3A;
    background: #F0F7F6;
  }
  :global([data-theme="dark"]) .t65-goal-card:has(input:checked),
  :global([data-theme="dark"]) .t65-goal-card.selected {
    background: rgba(10, 61, 58, 0.2);
    border-color: #1DB8A8;
  }

  .t65-checkbox {
    accent-color: #0A3D3A;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .t65-goal-icon { font-size: 1.25rem; flex-shrink: 0; }
  .t65-goal-text { line-height: var(--leading-snug); flex: 1; min-width: 0; overflow-wrap: break-word; }

  /* ── Date Input Grid ── */
  .t65-date-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-date-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .t65-form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .t65-input-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .t65-input-hint {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .t65-select {
    padding: 12px var(--space-3);
    font-size: var(--text-base);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-background);
    color: var(--color-text);
    font-family: inherit;
    width: 100%;
    max-width: 100%;
    appearance: auto;
    cursor: pointer;
    box-sizing: border-box;
  }
  .t65-select:focus {
    outline: none;
    border-color: #0A3D3A;
    box-shadow: 0 0 0 3px rgba(10, 61, 58, 0.15);
  }

  /* ── Error message ── */
  .t65-error-msg {
    background: #FEF2F2;
    border-left: 4px solid #DC2626;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: #B91C1C;
    margin-bottom: var(--space-3);
    font-weight: var(--font-semibold);
  }
  :global([data-theme="dark"]) .t65-error-msg {
    background: rgba(220, 38, 38, 0.1);
    color: #FCA5A5;
  }

  /* ── Review Box (Step 7) ── */
  .t65-review-box {
    background: var(--color-background);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    box-sizing: border-box;
  }
  @media (min-width: 600px) {
    .t65-review-box { padding: var(--space-5); }
  }

  .t65-review-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: var(--text-sm);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-review-row {
      flex-direction: row;
      gap: var(--space-4);
      align-items: baseline;
    }
  }

  .t65-review-label {
    font-weight: var(--font-bold);
    color: var(--color-text-secondary);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  @media (min-width: 600px) {
    .t65-review-label { min-width: 170px; max-width: 220px; }
  }

  .t65-review-value {
    color: var(--color-text);
    font-weight: var(--font-semibold);
    line-height: var(--leading-normal);
    overflow-wrap: break-word;
    word-break: break-word;
    flex: 1;
    min-width: 0;
  }

  .t65-review-separator {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ── Buttons ── */
  .t65-btn-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .t65-btn-row--right { justify-content: flex-end; }

  .t65-btn-primary {
    background: #0A3D3A;
    color: #FFFFFF;
    border: none;
    padding: 14px var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    white-space: normal;
    text-align: center;
    line-height: var(--leading-snug);
    word-break: normal;
    box-sizing: border-box;
  }
  .t65-btn-primary:hover {
    background: #0D4F4B;
    transform: translateY(-1px);
  }
  .t65-btn-primary:focus-visible {
    outline: 3px solid #C9933A;
    outline-offset: 2px;
  }

  .t65-btn-primary--generate {
    background: #C9933A;
    padding: 14px var(--space-7);
    font-size: 1.05rem;
  }
  .t65-btn-primary--generate:hover { background: #B07D2A; }

  .t65-btn-secondary {
    background: transparent;
    color: var(--color-text-secondary);
    border: 2px solid var(--color-border);
    padding: 12px var(--space-5);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    cursor: pointer;
    transition: all 0.15s;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: normal;
    text-align: center;
    line-height: var(--leading-snug);
    word-break: normal;
    box-sizing: border-box;
  }
  .t65-btn-secondary:hover {
    background: var(--color-background);
    color: var(--color-text);
    border-color: var(--color-text-secondary);
  }
  .t65-btn-secondary:focus-visible {
    outline: 3px solid #0A3D3A;
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .t65-btn-row {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .t65-btn-row--right { flex-direction: column; }
    .t65-btn-primary, .t65-btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
  /* ════════════════════════════════════════════════
     RESULTS DASHBOARD
  ════════════════════════════════════════════════ */
  .t65-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    animation: t65FadeIn 0.4s ease;
    min-width: 0;
    width: 100%;
  }

  /* ── Section 1: Hero Answer ── */
  .t65-result-hero {
    background: #0A3D3A;
    color: #FFFFFF;
    border-left: 6px solid #C9933A;
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5);
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-result-hero { padding: var(--space-7) var(--space-8); }
  }

  .t65-result-badge {
    font-size: 10px;
    font-weight: var(--font-bold);
    letter-spacing: 0.1em;
    color: #C9933A;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .t65-res-headline {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: var(--font-bold);
    color: #FFFFFF;
    margin: 0 0 var(--space-3);
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-res-summary {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.92);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-res-next-step-box {
    background: rgba(201,147,58,0.18);
    border: 1.5px solid rgba(201,147,58,0.5);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-2);
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-res-next-step-label {
    font-size: 10px;
    font-weight: var(--font-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C9933A;
    margin: 0 0 var(--space-1);
  }

  .t65-res-next-step {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: #FFFFFF;
    margin: 0;
    line-height: var(--leading-normal);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Action Toolbar (Download & Share) ── */
  .t65-action-bar {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin: 0;
    min-width: 0;
  }
  .t65-btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--color-background);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 10px var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s ease;
    box-sizing: border-box;
    min-height: 42px;
  }
  .t65-btn-action:hover {
    border-color: #0A3D3A;
    background: #F0F7F6;
    color: #0A3D3A;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(10, 61, 58, 0.1);
  }
  :global([data-theme="dark"]) .t65-btn-action:hover {
    background: rgba(10, 61, 58, 0.25);
    border-color: #1DB8A8;
    color: #1DB8A8;
  }
  .t65-action-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .t65-share-toast {
    background: #0A3D3A;
    color: #FFFFFF;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    padding: 8px var(--space-4);
    border-radius: var(--radius-md);
    display: inline-block;
    animation: t65FadeIn 0.2s ease;
    border-left: 3px solid #C9933A;
  }
  :global([data-theme="dark"]) .t65-share-toast {
    background: #0D4F4B;
  }

  /* ── Result Cards ── */
  .t65-res-card {
    background: var(--color-background);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-sizing: border-box;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  @media (min-width: 600px) {
    .t65-res-card { padding: var(--space-6); }
  }

  .t65-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1.5px solid var(--color-border);
  }

  .t65-card-icon { font-size: 1.3rem; flex-shrink: 0; }

  .t65-card-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: var(--leading-snug);
  }

  /* ── Section 1: Dates Metric Grid ── */
  .t65-dates-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    min-width: 0;
    margin-bottom: var(--space-2);
  }
  @media (min-width: 520px) {
    .t65-dates-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 860px) {
    .t65-dates-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .t65-date-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--color-background-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .t65-date-item--highlight {
    background: #F0F7F6;
    border-color: #0A3D3A;
    border-left: 4px solid #0A3D3A;
  }
  :global([data-theme="dark"]) .t65-date-item--highlight {
    background: rgba(10, 61, 58, 0.2);
    border-color: #1DB8A8;
  }
  .t65-date-label {
    font-size: 11px;
    font-weight: var(--font-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .t65-date-val {
    font-size: 1.05rem;
    font-weight: var(--font-bold);
    color: #0A3D3A;
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
  }
  :global([data-theme="dark"]) .t65-date-val { color: #1DB8A8; }
  .t65-date-note {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* ── Section 2: Dates Timeline ── */
  .t65-dates-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .t65-tl-item {
    display: flex;
    gap: var(--space-3);
    position: relative;
    padding-bottom: var(--space-5);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-tl-item { gap: var(--space-4); }
  }
  .t65-tl-item:last-child { padding-bottom: 0; }

  .t65-tl-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .t65-tl-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #0A3D3A;
    border: 3px solid var(--color-background);
    box-shadow: 0 0 0 2px #0A3D3A;
    z-index: 1;
    flex-shrink: 0;
  }
  .t65-tl-dot--gold {
    background: #C9933A;
    box-shadow: 0 0 0 2px #C9933A;
  }
  .t65-tl-dot--warning {
    background: #D97706;
    box-shadow: 0 0 0 2px #D97706;
  }

  .t65-tl-line {
    width: 2px;
    flex-grow: 1;
    background: var(--color-border);
    margin: 4px 0;
  }

  .t65-tl-content {
    flex: 1;
    padding-bottom: var(--space-1);
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-tl-date {
    font-size: 11px;
    font-weight: var(--font-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0A3D3A;
    margin-bottom: 2px;
  }
  :global([data-theme="dark"]) .t65-tl-date { color: #1DB8A8; }

  .t65-tl-event {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: 3px;
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-tl-action {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-tl-highlight {
    background: #FFF9F0;
    border: 1.5px solid #C9933A;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-sizing: border-box;
  }
  :global([data-theme="dark"]) .t65-tl-highlight {
    background: rgba(201,147,58,0.08);
  }

  /* ── Section 3: Action Checklist ── */
  /* ── Section 3: Action Checklist (Strict Vertical One-by-One) ── */
  .t65-res-card--checklist { border-top: 4px solid #0A3D3A; }

  .t65-checklist-intro {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .t65-checklist-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 100%;
    min-width: 0;
  }

  .t65-checklist-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
  }

  .t65-checklist-group-label {
    font-size: 12px;
    font-weight: var(--font-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0A3D3A;
    padding: var(--space-1) 0;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-2);
    width: 100%;
  }
  :global([data-theme="dark"]) .t65-checklist-group-label { color: #1DB8A8; }

  .t65-checklist-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
  }

  .t65-check-item {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-background-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text);
    transition: all 0.15s ease;
    line-height: var(--leading-relaxed, 1.6);
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }
  .t65-check-item:hover {
    background: rgba(10, 61, 58, 0.05);
    border-color: #0A3D3A;
  }
  :global([data-theme="dark"]) .t65-check-item:hover {
    background: rgba(10, 61, 58, 0.2);
    border-color: #1DB8A8;
  }

  .t65-check-input {
    margin-top: 3px;
    accent-color: #0A3D3A;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .t65-check-text {
    flex: 1;
    min-width: 0;
    line-height: 1.55;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-check-item.completed {
    background: rgba(10, 61, 58, 0.03);
    border-color: var(--color-border);
    opacity: 0.75;
  }

  .t65-check-item.completed .t65-check-text {
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  /* ── Section 4: Warnings ── */
  .t65-res-card--warning {
    border: 1.5px solid #D97706;
    background: #FFFBEB;
    border-top: 4px solid #D97706;
  }
  :global([data-theme="dark"]) .t65-res-card--warning {
    background: rgba(217,119,6,0.08);
    border-color: #D97706;
  }

  .t65-warning-intro {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .t65-warnings-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .t65-warning-item {
    display: flex;
    gap: var(--space-3);
    background: rgba(217,119,6,0.08);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: #92400E;
    line-height: var(--leading-normal);
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  :global([data-theme="dark"]) .t65-warning-item { color: #FCD34D; }
  .t65-warning-icon { flex-shrink: 0; font-size: 1rem; margin-top: 1px; }

  /* ── Section 5: Coverage Paths ── */
  .t65-paths-intro {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .t65-paths-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-paths-container { grid-template-columns: 1fr 1fr; }
  }

  .t65-path-card {
    background: var(--color-background-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  @media (min-width: 600px) {
    .t65-path-card { padding: var(--space-5); }
  }

  .t65-path-card--recommended {
    border-color: #0A3D3A;
    border-top: 4px solid #0A3D3A;
    background: #F2F7F6;
  }
  :global([data-theme="dark"]) .t65-path-card--recommended {
    background: rgba(10,61,58,0.15);
    border-color: #1DB8A8;
  }

  .t65-path-badge {
    font-size: 10px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C9933A;
  }

  .t65-path-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0;
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-path-components {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .t65-path-components li {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    line-height: var(--leading-normal);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-path-components li::before {
    content: '•';
    color: #0A3D3A;
    font-weight: bold;
    flex-shrink: 0;
  }
  :global([data-theme="dark"]) .t65-path-components li::before { color: #1DB8A8; }

  .t65-path-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex-grow: 1;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-path-link {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: #0A3D3A;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-top: auto;
    overflow-wrap: break-word;
  }
  :global([data-theme="dark"]) .t65-path-link { color: #1DB8A8; }

  /* ── Section 6: Costs ── */
  .t65-costs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    min-width: 0;
  }
  @media (min-width: 540px) {
    .t65-costs-grid { grid-template-columns: 1fr 1fr; }
  }

  .t65-cost-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-cost-label {
    font-size: 11px;
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .t65-cost-value {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: #0A3D3A;
    overflow-wrap: break-word;
  }
  :global([data-theme="dark"]) .t65-cost-value { color: #1DB8A8; }

  .t65-cost-note {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-top: 2px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── Section 7: Tool Links ── */
  .t65-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-tools-grid { grid-template-columns: 1fr 1fr; }
  }

  .t65-tool-link-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-background-secondary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .t65-tool-link-card:hover {
    border-color: #0A3D3A;
    box-shadow: 0 2px 8px rgba(10,61,58,0.1);
    text-decoration: none;
  }

  .t65-tool-arrow {
    font-size: 1.1rem;
    color: #0A3D3A;
    flex-shrink: 0;
    margin-top: 2px;
  }
  :global([data-theme="dark"]) .t65-tool-arrow { color: #1DB8A8; }

  .t65-tool-link-title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: #0A3D3A;
    margin: 0 0 2px;
    line-height: var(--leading-snug);
    overflow-wrap: break-word;
    word-break: break-word;
  }
  :global([data-theme="dark"]) .t65-tool-link-title { color: #1DB8A8; }

  .t65-tool-link-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .t65-res-card--tools { border-top: 4px solid #C9933A; }

  /* ── Section 8: Why Details ── */
  .t65-why-details {
    border: 1.5px solid var(--color-border);
    min-width: 0;
    box-sizing: border-box;
  }

  .t65-why-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: var(--space-4);
    list-style: none;
    border-radius: var(--radius-lg);
    user-select: none;
    min-width: 0;
  }
  .t65-why-summary::-webkit-details-marker { display: none; }
  .t65-why-summary::before {
    content: '▶';
    font-size: 10px;
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  details[open] .t65-why-summary::before {
    transform: rotate(90deg);
  }

  .t65-why-content {
    padding: 0 var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .t65-why-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: var(--text-sm);
    min-width: 0;
  }
  @media (min-width: 600px) {
    .t65-why-row {
      flex-direction: row;
      gap: var(--space-4);
      align-items: baseline;
