---
/**
 * Turning 65 and Medicare — seniorsaudit.com/medicare/at-65/
 * Decision-journey pillar page: every step a senior faces when they first become Medicare-eligible.
 *
 * Schema: Article + FAQPage + BreadcrumbList + HowTo + Speakable
 * AEO: Inverted-pyramid H2 structure, exact official terminology, inline government citations.
 * Internal links: 20+ descriptive anchor-text links to tools, articles, and hubs.
 * Last reviewed: August 2026
 */

import BaseLayout from '@layouts/BaseLayout.astro';

// ── PAGE META ──────────────────────────────────────────────────────────────
const pageTitle = 'Turning 65 Medicare Checklist 2026 | Seniors Audit';
const metaDescription = 'Turning 65? Calculate your 7-month enrollment window, compare Medicare Advantage vs. Medigap, avoid late penalties, and get your 2026 checklist.';
const canonicalUrl    = 'https://www.seniorsaudit.com/medicare/at-65/';
const lastUpdated     = '2026-08-17';
const displayDate     = 'August 2026';
const ogImage         = 'https://www.seniorsaudit.com/images/og/medicare-at-65-decision-guide.jpg';

// ── SCHEMA: Article ────────────────────────────────────────────────────────
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': 'https://www.seniorsaudit.com/medicare/at-65/#article',
  'headline': 'Turning 65 and Medicare: Your Complete Decision Roadmap',
  'description': metaDescription,
  'image': {
    '@type': 'ImageObject',
    'url': ogImage,
    'width': 1200,
    'height': 630,
    'caption': 'Step-by-step Medicare decision guide for seniors turning 65 — covering enrollment, coverage path, Medigap, Part D, and 2026 costs.',
  },
  'datePublished': '2026-08-15T00:00:00Z',
  'dateModified': `${lastUpdated}T00:00:00Z`,
  'author': {
    '@type': 'Person',
    'name': 'Emmanuel TUYISHIMIRE',
    '@id': 'https://www.seniorsaudit.com/about/emmanuel-tuyishimire/',
    'url': 'https://www.seniorsaudit.com/about/emmanuel-tuyishimire/'
  },
  'publisher': { '@id': 'https://www.seniorsaudit.com/#organization' },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  'about': {
    '@type': 'Thing',
    'name': 'Medicare enrollment at 65',
    'description': 'The process and decisions a person turning 65 faces when becoming eligible for Medicare for the first time.',
    'sameAs': 'https://en.wikipedia.org/wiki/Medicare_(United_States)',
  },
  'citation': [
    { '@type': 'CreativeWork', 'name': 'Medicare.gov — When can I sign up for Medicare?', 'url': 'https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-can-i-sign-up-for-medicare' },
    { '@type': 'CreativeWork', 'name': 'CMS Medicare and You 2026 Handbook', 'url': 'https://www.medicare.gov/medicare-and-you' },
    { '@type': 'CreativeWork', 'name': 'SSA Publication 10043 — Medicare', 'url': 'https://www.ssa.gov/pubs/EN-05-10043.pdf' },
    { '@type': 'CreativeWork', 'name': 'IRS Publication 969 — HSAs and Other Tax-Favored Health Plans', 'url': 'https://www.irs.gov/publications/p969' },
    { '@type': 'CreativeWork', 'name': 'Medicare.gov — Avoid Late Enrollment Penalties', 'url': 'https://www.medicare.gov/basics/costs/medicare-costs/avoid-penalties' },
  ],
  'keywords': 'turning 65 medicare, medicare at 65, when to sign up for medicare at 65, medicare enrollment at 65, medicare first enrollment, initial enrollment period medicare',
  'wordCount': '8500',
  'inLanguage': 'en-US',
  'isAccessibleForFree': true,
  'isPartOf': { '@id': 'https://www.seniorsaudit.com/#website' },
};

// ── SCHEMA: FAQPage ────────────────────────────────────────────────────────
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://www.seniorsaudit.com/medicare/at-65/#faq',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'When exactly do I need to sign up for Medicare when I turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Your Initial Enrollment Period (IEP) is 7 months long — it starts 3 months before the month you turn 65 and ends 3 months after your birthday month. Enrolling in the first 3 months gives you the earliest possible coverage start date. Missing this window without qualifying employer coverage triggers permanent lifetime penalties.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can I delay Medicare at 65 if I have employer health insurance?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes — if you or your spouse are actively employed at a company with 20 or more employees, and your health coverage is based on that active employment, you may delay Medicare without penalty. You then have an 8-month Special Enrollment Period (SEP) after employment or coverage ends. COBRA and retiree coverage do not qualify as active employer coverage.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What happens if I miss my Medicare enrollment deadline at 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'If you miss your IEP without qualifying coverage, you face permanent late enrollment penalties. For Part B, the penalty is 10% added to your monthly premium for every 12-month period you went without coverage. For Part D, it is 1% of $38.99 per uncovered month. Both penalties are permanent — you pay them for as long as you have Medicare.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Is Medicare free when you turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Part A (hospital coverage) is premium-free for most people who worked at least 10 years (40 quarters) in Medicare-covered employment. Part B has a $202.90 monthly premium in 2026. Higher-income enrollees pay more through IRMAA surcharges. Part D drug plans and Medigap supplements carry additional monthly premiums.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Should I choose Original Medicare or Medicare Advantage when I turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'This is the biggest decision you face at 65. Original Medicare works nationwide with any Medicare-accepting provider, and pairs with Medigap to eliminate most out-of-pocket costs. Medicare Advantage is often lower in monthly premiums but restricts you to a network and can have higher out-of-pocket costs when you need care. Our plan comparison hub walks through both paths with 2026 cost scenarios.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can I contribute to my HSA after I turn 65 and sign up for Medicare?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. You cannot contribute to a Health Savings Account (HSA) once you are enrolled in any part of Medicare. Contributions after your Medicare start date are subject to income tax and a 6% excise tax. Plan to stop contributions at least 6 months before enrolling to avoid retroactive issues from Social Security\'s automatic 6-month Part A back-dating rule.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the Medigap Guaranteed Issue Period and why does it matter at 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Your Medigap Open Enrollment Period — the 6-month window starting the month you are both 65 and enrolled in Part B — is the single best opportunity you will ever have to buy a Medigap supplement. During this period, insurers cannot reject you or charge more due to health conditions. After it closes, most states allow medical underwriting, meaning a pre-existing condition can make Medigap unaffordable.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Do I automatically get Medicare when I turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'You are automatically enrolled in Medicare Parts A and B if you are already receiving Social Security or Railroad Retirement Board benefits when you turn 65. You will receive your Medicare card about 3 months before your 65th birthday. If you are not yet collecting Social Security, you must actively sign up through SSA.gov or your local Social Security office.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the difference between the Initial Enrollment Period and the General Enrollment Period?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The Initial Enrollment Period (IEP) is your personal 7-month window centered on your 65th birthday month — this is your primary signup window. The General Enrollment Period (GEP) runs every year from January 1 through March 31 and is a fallback for people who missed their IEP without qualifying coverage. Coverage from the GEP starts July 1, and late enrollment penalties still apply.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How do I actually sign up for Medicare at 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Apply online at SSA.gov, by phone at 1-800-772-1213 (TTY: 1-800-325-0778), or in person at your local Social Security office. If you are keeping employer coverage and need a Special Enrollment Period later, submit Form CMS-40B along with Form CMS-L564 (completed by your employer) when you are ready to enroll.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What do I need to do when I turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'When you turn 65, decide whether to enroll in Medicare now or delay because of active employer coverage. If enrolling, apply during your 7-month Initial Enrollment Period — it opens 3 months before your birthday month. Choose between Original Medicare plus Medigap plus Part D, or Medicare Advantage. Enroll in Part D drug coverage even if healthy to avoid a lifetime penalty. If you contribute to an HSA, stop contributions at least 6 months before Medicare starts.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What if my spouse still has employer insurance — can I delay Medicare?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, if your coverage comes from your spouse\'s active employment at an employer with 20 or more employees. That protection extends to spouses of active employees. If the employer has fewer than 20 employees, Medicare becomes your primary insurer at 65, and failing to enroll in Part B will trigger a permanent late penalty.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Do I need Part D prescription drug coverage?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, in nearly all cases — even if you currently take no medications. The Part D late enrollment penalty applies based on how long you went without creditable drug coverage, not whether you needed it. A gap of 63 days or more after your IEP ends triggers a permanent monthly penalty of 1% of the national base beneficiary premium per uncovered month. Enroll in the lowest-cost Part D plan to avoid the penalty accumulating.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What are Medicare Savings Programs?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Medicare Savings Programs (MSPs) are state-administered programs that help people with limited income pay Medicare costs — including the $202.90 Part B monthly premium in 2026, deductibles, and copayments. The four tiers are QMB, SLMB, QI, and QDWI. Eligibility depends on income and resources and varies by state. You can qualify even if you do not qualify for full Medicaid.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Should I claim Social Security at 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Claiming Social Security at 65 is a completely separate decision from Medicare enrollment. If your Full Retirement Age is 67, claiming at 65 permanently reduces your monthly benefit by about 13.3%. Waiting until 70 increases it by 8% per year beyond FRA. The best decision depends on your health, life expectancy, financial needs, and spousal benefit considerations.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Is Medicare the same as Social Security?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. Medicare is health insurance for people 65 and older (and certain younger people with disabilities). Social Security is a monthly income benefit based on your earnings history. Both are federal programs but are entirely separate with independent eligibility rules and enrollment processes. You can enroll in Medicare without claiming Social Security, and vice versa.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can I have Medicare and private insurance at the same time?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. If your private insurance is from an active employer with 20 or more employees, it is primary and Medicare is secondary. If you are no longer actively employed, COBRA or marketplace coverage can technically coexist with Medicare, but Medicare generally becomes primary — making the other coverage redundant and expensive in most cases.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What happens if I do nothing when I turn 65?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'It depends on whether you already receive Social Security. If yes: you were automatically enrolled in Parts A and B, and your card arrived ~3 months before your birthday. If no: nothing happens automatically. You will not receive Medicare until you apply. If you miss your Initial Enrollment Period without qualifying employer coverage, you face permanent late penalties for Part B and Part D that grow every month you wait.',
      },
    },
  ],
};

// ── SCHEMA: BreadcrumbList ─────────────────────────────────────────────────
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': 'https://www.seniorsaudit.com/medicare/at-65/#breadcrumb',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://www.seniorsaudit.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Medicare', 'item': 'https://www.seniorsaudit.com/medicare/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'Turning 65 — Medicare Decision Guide', 'item': canonicalUrl },
  ],
};

// ── SCHEMA: HowTo ──────────────────────────────────────────────────────────
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': 'https://www.seniorsaudit.com/medicare/at-65/#howto',
  'name': 'How to Set Up Medicare When You Turn 65',
  'description': 'A step-by-step guide to enrolling in Medicare and making the right coverage decisions when you turn 65.',
  'totalTime': 'PT30M',
  'step': [
    { '@type': 'HowToStep', 'position': 1, 'name': 'Find your 7-month enrollment window', 'text': 'Identify your Initial Enrollment Period (IEP) — it runs from 3 months before your birthday month to 3 months after.' },
    { '@type': 'HowToStep', 'position': 2, 'name': 'Decide whether to delay based on employer coverage', 'text': 'If you or your spouse have active employer coverage from a company with 20+ employees, you may delay Medicare without penalty.' },
    { '@type': 'HowToStep', 'position': 3, 'name': 'Choose your coverage path', 'text': 'Decide between Original Medicare (Parts A + B + optional Medigap + Part D) or Medicare Advantage (Part C).' },
    { '@type': 'HowToStep', 'position': 4, 'name': 'Lock in Medigap during your guaranteed issue window', 'text': 'If choosing Original Medicare, buy a Medigap supplement during your 6-month Open Enrollment Period when insurers cannot deny you.' },
    { '@type': 'HowToStep', 'position': 5, 'name': 'Add Part D drug coverage', 'text': 'Enroll in a standalone Part D plan or choose a Medicare Advantage plan that includes drug coverage to avoid the Part D late penalty.' },
    { '@type': 'HowToStep', 'position': 6, 'name': 'Stop HSA contributions before Medicare starts', 'text': 'Stop contributing to your Health Savings Account at least 6 months before enrolling in Medicare to avoid IRS penalties.' },
    { '@type': 'HowToStep', 'position': 7, 'name': 'Sign up through SSA.gov or by phone', 'text': 'Apply online at SSA.gov, call 1-800-772-1213, or visit your local Social Security office to complete enrollment.' },
    { '@type': 'HowToStep', 'position': 8, 'name': 'Check Medicare Savings Programs eligibility', 'text': 'If your income is limited, check whether you qualify for a Medicare Savings Program (QMB, SLMB, or QI) that can pay your Part B premium and reduce other costs. Apply through your state Medicaid agency.' },
    { '@type': 'HowToStep', 'position': 9, 'name': 'Decide on Social Security separately', 'text': 'Social Security retirement claiming age is a separate decision from Medicare. Consider your Full Retirement Age, financial needs, and break-even age before deciding when to claim. Both programs are fully independent.' },
  ],
};

// ── SCHEMA: Speakable ──────────────────────────────────────────────────────
const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': pageTitle,
  'speakable': {
    '@type': 'SpeakableSpecification',
    'cssSelector': ['.aeo-direct-answer', '.article-introduction', 'h2', '.faq-answer'],
  },
  'url': canonicalUrl,
};

const allSchemas = [articleSchema, faqSchema, breadcrumbSchema, howToSchema, speakableSchema];

// ── BIRTH YEARS DATA (1900 to 2026) ───────────────────────────────────────────
const currentYear = 2026;
const birthYears = Array.from({ length: currentYear - 1900 + 1 }, (_, i) => {
  const y = currentYear - i; // 2026 down to 1900
  const ageIn2026 = currentYear - y;
  let label = `${y}`;
  if (ageIn2026 === 65) {
    label = `${y} (Turning 65 in 2026 — Peak Enrollment)`;
  } else if (ageIn2026 === 64) {
    label = `${y} (Turning 65 in 2027 — Planning Window)`;
  } else if (ageIn2026 > 65 && ageIn2026 <= 99) {
    label = `${y} (Age ${ageIn2026} in 2026)`;
  } else if (ageIn2026 >= 100) {
    label = `${y} (Centenarian / Age ${ageIn2026}+)`;
  } else if (ageIn2026 >= 50 && ageIn2026 < 64) {
    label = `${y} (Age ${ageIn2026} — Turning 65 in ${y + 65})`;
  } else {
    label = `${y} (Age ${ageIn2026} in 2026)`;
  }
  return { year: y, label };
});
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  schema={allSchemas}
>

<!-- ══ BREADCRUMB ════════════════════════════════════════════ -->
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a href="/" class="breadcrumb-link"><span>Home</span></a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
    </li>
    <li class="breadcrumb-item">
      <a href="/medicare/" class="breadcrumb-link"><span>Medicare</span></a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
    </li>
    <li class="breadcrumb-item">
      <span class="breadcrumb-current" aria-current="page">Turning 65</span>
    </li>
  </ol>
</nav>

<!-- ══ PAGE WRAPPER ══════════════════════════════════════════ -->
<div class="pillar-wrapper">

  <!-- ══ ARTICLE HEADER ════════════════════════════════════════ -->
  <header class="pillar-header" id="hub-intro">
    <p class="pillar-meta">
      Last reviewed by the Seniors Audit research team on
      <time datetime={lastUpdated}>{displayDate}</time>
      <span class="pillar-meta-sep">·</span>
      By <a href="/about/emmanuel-tuyishimire/" style="color: inherit; text-decoration: underline;">Emmanuel TUYISHIMIRE</a>
      <span class="pillar-meta-sep">·</span>
      <span>~22 min read</span>
    </p>

    <h1 class="pillar-h1">Turning 65 and Medicare: Your Complete Decision Roadmap</h1>

    <!-- AEO Direct Answer Block -->
    <aside class="aeo-direct-answer" aria-label="Quick Answer" id="quick-answer">
      <p class="aeo-label">Quick Answer</p>
      <p class="aeo-text">
        When you turn 65, you have a 7-month window — called the Initial Enrollment Period (IEP) — to sign up for Medicare. It opens 3 months before your birthday month. Missing it without qualifying employer coverage triggers permanent lifetime premium penalties for both Part B and Part D. The biggest decision you face is whether to pair Original Medicare with a Medigap supplement, or enroll in Medicare Advantage. Your Medigap rights are strongest during the 6-month Guaranteed Issue window that begins when you first have Part B.
      </p>
    </aside>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- INTERACTIVE TURNING 65 MEDICARE DECISION TOOL -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <section class="t65-tool-container" id="t65-decision-tool" aria-labelledby="t65-tool-heading">
      
      <!-- Tool Header & Scope -->
      <div class="t65-tool-header">
        <div class="t65-tool-badge">Interactive Decision Engine</div>
        <h2 id="t65-tool-heading" class="t65-tool-title">Turning 65 Medicare Decision Helper</h2>
        <p class="t65-tool-intro">
          Answer a few questions to build your personalized Medicare roadmap — your enrollment window, your next steps, what could go wrong, and which Seniors Audit tools apply to your situation. Completely private. No signup. No personal data stored.
        </p>

        <!-- Feature Capability List -->
        <div class="t65-features-box" aria-label="What this decision helper determines">
          <p class="t65-features-label">This tool personalizes your situation by evaluating:</p>
          <ul class="t65-features-list">
            <li><span class="t65-check" aria-hidden="true">✓</span> Medicare eligibility &amp; enrollment window at 65</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Initial Enrollment Period timing &amp; exact dates</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Whether you'll be enrolled automatically or need to apply</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> How employer insurance affects your enrollment strategy</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Original Medicare vs. Medicare Advantage comparison</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Medigap guaranteed issue window and Part D timing</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Health Savings Account (HSA) tax implications</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Late-enrollment penalty risks and how to avoid them</li>
            <li><span class="t65-check" aria-hidden="true">✓</span> Personalized action checklist and relevant Seniors Audit tools</li>
          </ul>
        </div>

        <!-- Progress Indicator -->
        <div class="t65-progress-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="14" aria-label="Questionnaire progress">
          <div class="t65-progress-steps" id="t65-step-dots" aria-hidden="true">
            <!-- Dots rendered by JS -->
          </div>
          <div class="t65-progress-bar-track">
            <div id="t65-progress-fill" class="t65-progress-fill" style="width: 14%;"></div>
          </div>
          <div class="t65-progress-labels">
            <span id="t65-step-text" class="t65-step-counter">Step 1 of 7</span>
            <span id="t65-step-label" class="t65-step-name">Your birth date</span>
          </div>
        </div>
      </div>

      <!-- Questionnaire Body -->
      <div id="t65-wizard-body" class="t65-wizard-body">

        <!-- ═══ STEP 1: Birth Date ═══ -->
        <div id="t65-step-1" class="t65-step-panel" role="group" aria-labelledby="t65-q1-legend">
          <div class="t65-step-context">
            <span class="t65-step-num" aria-hidden="true">1</span>
            <div>
              <p id="t65-q1-legend" class="t65-question">When were you born?</p>
              <p class="t65-step-why">Your birth date determines your exact 7-month Medicare enrollment window and your earliest possible coverage start date. Nothing is stored or sent anywhere.</p>
            </div>
          </div>

          <div class="t65-date-grid">
            <div class="t65-form-group">
              <label for="t65-birth-month" class="t65-input-label">Birth Month</label>
              <select id="t65-birth-month" class="t65-select" aria-required="true">
                <option value="">-- Select month --</option>
                <option value="1">January</option>
                <option value="2">February</option>
                <option value="3">March</option>
                <option value="4">April</option>
                <option value="5">May</option>
                <option value="6">June</option>
                <option value="7">July</option>
                <option value="8">August</option>
                <option value="9">September</option>
                <option value="10">October</option>
                <option value="11">November</option>
                <option value="12">December</option>
              </select>
            </div>
            <div class="t65-form-group">
              <label for="t65-birth-day" class="t65-input-label">Born on the 1st?</label>
              <select id="t65-birth-day" class="t65-select">
                <option value="15">No — 2nd through 31st</option>
                <option value="1">Yes — the 1st of the month</option>
              </select>
              <span class="t65-input-hint">Medicare has a special rule for the 1st of the month.</span>
            </div>
            <div class="t65-form-group">
              <label for="t65-birth-year" class="t65-input-label">Birth Year</label>
              <select id="t65-birth-year" class="t65-select" aria-required="true">
                <option value="">-- Select year (1900 to 2026) --</option>
                {birthYears.map((item) => (
                  <option value={item.year}>{item.label}</option>
                ))}
              </select>
            </div>
          </div>
          <div id="t65-step1-error" class="t65-error-msg" role="alert" style="display:none;">Please select your birth month and year to continue.</div>
          <div class="t65-btn-row t65-btn-row--right">
            <button type="button" class="t65-btn-primary" id="t65-next-1" aria-label="Continue to next question">Continue &rarr;</button>
          </div>
        </div>

        <!-- ═══ STEP 2: Already have Medicare? ═══ -->
        <div id="t65-step-2" class="t65-step-panel" style="display:none;" role="group" aria-labelledby="t65-q2-legend">
          <div class="t65-step-context">
            <span class="t65-step-num" aria-hidden="true">2</span>
            <div>
              <p id="t65-q2-legend" class="t65-question">Do you already have Medicare?</p>
              <p class="t65-step-why">This determines whether we focus your roadmap on first-time enrollment or on comparing or adjusting existing coverage.</p>
            </div>
