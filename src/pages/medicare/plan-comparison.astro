            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Administration</strong></td>
              <td>Federal Government (CMS)</td>
              <td>CMS-Approved Private Insurance Carriers</td>
            </tr>
            <tr class="row-alt">
              <td><strong>Doctor &amp; Hospital Access</strong></td>
              <td>Any doctor or hospital in the U.S. accepting Medicare (~90%+ nationwide)</td>
