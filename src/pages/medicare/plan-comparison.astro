    <!-- ═══════════════════════════════════════════════════════
         BREADCRUMBS & ARTICLE HEADER
         ═══════════════════════════════════════════════════════ -->
    <header class="pillar-header">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
