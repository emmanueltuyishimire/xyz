  /* ── Action Checklist ─────────────────────────────────────── */
  .checklist-box { background: #0A3D3A; color: #FFFFFF; border-radius: 10px; padding: 1.75rem 2rem; }
  .checklist-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin-bottom: 1rem; }
  .checklist-list { padding-left: 1.5rem; margin: 0; display: flex; flex-direction: column; gap: 0.9rem; }
