  /* ── Disclaimer ───────────────────────────────────────────── */
  .disclaimer-box { background: #08111F; color: #CBD5E1; border-radius: 8px; padding: 1.25rem 1.5rem; font-size: 0.875rem; line-height: 1.7; }
  .disclaimer-box a { color: #C9933A; }
  .disclaimer-box a:hover { text-decoration: underline; }

  /* ── Sources ──────────────────────────────────────────────── */
  .sources-list { padding-left: 1.4rem; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .sources-list a { color: #0A3D3A; font-size: 0.9rem; }
  .sources-list a:hover { text-decoration: underline; }

  /* ── Sidebar ──────────────────────────────────────────────── */
  .sidebar-toc { background: #F6F8FA; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
  .sidebar-toc-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #64748B; margin-bottom: 0.75rem; }
  .sidebar-toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .sidebar-toc-list a { font-size: 0.875rem; color: #0A3D3A; text-decoration: none; display: block; padding: 0.25rem 0; border-bottom: 1px solid #F1F5F9; }
  .sidebar-toc-list a:hover { color: #C9933A; }
  .sidebar-tools { background: #F6F8FA; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
  .sidebar-tools-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #64748B; margin-bottom: 0.75rem; }
  .sidebar-tools-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .sidebar-tool-link { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: #0A3D3A; text-decoration: none; padding: 0.4rem 0; border-bottom: 1px solid #F1F5F9; }
  .sidebar-tool-link:hover { color: #C9933A; }
  .sidebar-tool-icon { font-size: 1rem; flex-shrink: 0; }
  .sidebar-back { background: #0A3D3A; border-radius: 8px; padding: 1rem 1.25rem; }
  .sidebar-back-link { color: #C9933A; font-size: 0.9rem; font-weight: 700; text-decoration: none; display: block; margin-bottom: 0.4rem; }
  .sidebar-back-link:hover { text-decoration: underline; }
  .sidebar-back-desc { font-size: 0.8rem; color: #94A3B8; margin: 0; }

  /* ── Silo Directory ───────────────────────────────────────── */
  .silo-section { margin-top: 3rem; padding-top: 2.5rem; border-top: 2px solid #E2E8F0; }
  .silo-intro { color: #475569; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .silo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .silo-card { display: block; background: #F6F8FA; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.1rem 1.25rem; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s; }
  .silo-card:hover { border-color: #0A3D3A; box-shadow: 0 2px 10px rgba(10,61,58,0.1); }
  .silo-card-title { font-size: 0.95rem; font-weight: 700; color: #0A3D3A; margin-bottom: 0.4rem; }
  .silo-card-desc { font-size: 0.83rem; color: #64748B; line-height: 1.55; margin: 0; }

  /* ── Decision Tool ────────────────────────────────────────── */
  .decision-tool-wrapper { background: #F6F8FA; border: 1px solid #E2E8F0; border-radius: 10px; padding: 1.75rem; margin: 1rem 0; }
  .dt-step { margin-bottom: 0.5rem; }
  .dt-question { font-weight: 700; color: #08111F; font-size: 1rem; margin-bottom: 1rem; line-height: 1.5; }
  .dt-options { display: flex; flex-direction: column; gap: 0.6rem; }
  .dt-btn { background: #FFFFFF; border: 2px solid #0A3D3A; border-radius: 6px; padding: 0.7rem 1rem; font-size: 0.9rem; font-weight: 600; color: #0A3D3A; cursor: pointer; text-align: left; transition: background 0.2s, color 0.2s; }
  .dt-btn:hover { background: #0A3D3A; color: #FFFFFF; }
  .dt-result { background: #0A3D3A; color: #FFFFFF; border-radius: 8px; padding: 1.5rem; line-height: 1.7; }
  .dt-result h4 { color: #C9933A; font-size: 1rem; margin-bottom: 0.75rem; }
  .dt-result a { color: #C9933A; font-weight: 600; }
  .dt-result a:hover { text-decoration: underline; }
  .dt-reset { margin-top: 1rem; background: transparent; border: 2px solid #0A3D3A; border-radius: 6px; padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; color: #0A3D3A; cursor: pointer; }
  .dt-reset:hover { background: #0A3D3A; color: #FFFFFF; }
</style>

<!-- ══ AEP SEASONAL BANNER SCRIPT ══════════════════════════════ -->
<script is:inline>
  (function () {
    var now = new Date();
    var month = now.getMonth(); // 0-indexed
    var day = now.getDate();
    var isAEP = (month === 9 && day >= 15) || (month === 10) || (month === 11 && day <= 7);
    if (isAEP) {
      var banner = document.getElementById('aep-banner');
      if (banner) banner.style.display = 'flex';
    }
  })();
</script>

<!-- ══ DECISION TOOL SCRIPT ══════════════════════════════════════ -->
<script is:inline>
  (function () {
    var dtState = { q1: null, q2: null };

    var results = {
      iep_auto: {
        title: 'Your Situation: Automatic Enrollment — Verify Your Card Arrived',
        body: 'Because you draw Social Security or SSDI, CMS automatically enrolls you in Medicare Parts A and B roughly 3 months before your 65th birthday. Your red, white, and blue Medicare card arrives by mail. No application needed. <strong>If you want to decline Part B</strong> because of qualifying active employer coverage, sign the back of the card and return it to SSA before your coverage start date. If you do nothing, Part B starts and the $202.90/month premium is deducted from your Social Security check automatically.<br/><br/><a href="/tools/medicare-enrollment-deadline-calculator/">Confirm your IEP window →</a>'
      },
      iep_active: {
        title: 'Your Situation: You Must Apply During Your IEP — Actively Enroll Now',
        body: 'You are not automatically enrolled. Go to <strong>ssa.gov</strong> and apply for Medicare Parts A and B during the first 3 months of your 7-month Initial Enrollment Period. This guarantees coverage begins on the first day of your 65th birthday month with no gap. If you are delaying Social Security to earn a higher benefit, do not wait — your Medicare IEP runs on its own calendar.<br/><br/><a href="/tools/medicare-enrollment-deadline-calculator/">Find your exact IEP dates →</a>'
      },
      iep_employer: {
        title: 'Your Situation: Active Employer Coverage — You Can Safely Delay Part B',
        body: 'You qualify to delay Medicare Part B enrollment without penalty because you have qualifying active employer group coverage (employer with 20+ employees). You may enroll in premium-free Part A now — it costs nothing and provides secondary hospital coverage. When your employment or coverage ends, you have an <strong>8-month Special Enrollment Period</strong> to sign up for Part B penalty-free. Get Form CMS-L564 signed by your HR department now so you have it ready.<br/><br/><a href="/medicare/medicare-enrollment-periods/">Learn more about your SEP →</a>'
      },
      iep_cobra: {
        title: "Your Situation: COBRA Doesn't Count — Enroll in Medicare Now",
        body: 'COBRA and retiree health coverage do NOT qualify as creditable employer coverage for delaying Medicare. If you are past your IEP and relying on COBRA, you need to enroll in Medicare Part B immediately to stop the late enrollment penalty clock. Use the General Enrollment Period (January 1 \u2013 March 31) if your IEP has passed. Check whether you also owe a Part D penalty using our calculator.<br/><br/><a href="/tools/medicare-late-enrollment-penalty-calculator/">Calculate your penalty →</a><br/><a href="/tools/medicare-part-d-late-enrollment-penalty-calculator/">Calculate your Part D penalty →</a>'
      },
      gep_needed: {
        title: 'Your Situation: You Missed Your IEP — Use the General Enrollment Period',
        body: 'If you missed your Initial Enrollment Period and do not have a qualifying SEP reason, your next window is the <strong>General Enrollment Period: January 1 through March 31</strong> each year. Coverage begins the first of the month after you enroll. You will also owe a permanent Part B late enrollment penalty of 10% for each full 12-month period you delayed. Use our calculator to see your exact penalty and lifetime cost.<br/><br/><a href="/tools/medicare-late-enrollment-penalty-calculator/">Calculate my Part B penalty →</a>'
      }
    };

    function showResult(key) {
      var r = results[key];
      var resultEl = document.getElementById('dt-result');
      resultEl.innerHTML = '<h4>' + r.title + '</h4><p>' + r.body + '</p>';
      resultEl.style.display = 'block';
      document.getElementById('dt-step-1').style.display = 'none';
      document.getElementById('dt-step-2').style.display = 'none';
      document.getElementById('dt-step-3').style.display = 'none';
      document.getElementById('dt-reset').style.display = 'inline-block';
    }

    function dtReset() {
      dtState = { q1: null, q2: null };
      document.getElementById('dt-step-1').style.display = 'block';
      document.getElementById('dt-step-2').style.display = 'none';
      document.getElementById('dt-step-3').style.display = 'none';
      document.getElementById('dt-result').style.display = 'none';
      document.getElementById('dt-reset').style.display = 'none';
    }

    // ── Event delegation on the tool wrapper ──────────────────
    function init() {
      var tool = document.getElementById('enrollment-decision-tool');
      if (!tool) return;

      tool.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-dt-answer]');
        if (!btn) return;

        var question = parseInt(btn.getAttribute('data-dt-q'), 10);
        var answer   = btn.getAttribute('data-dt-answer');

        if (question === 1) {
          dtState.q1 = answer;
          if (answer === 'no') { showResult('gep_needed'); return; }
          document.getElementById('dt-step-1').style.display = 'none';
          document.getElementById('dt-step-2').style.display = 'block';
        } else if (question === 2) {
          dtState.q2 = answer;
          if (answer === 'cobra') { showResult('iep_cobra'); return; }
          if (answer === 'yes')   { showResult('iep_employer'); return; }
          document.getElementById('dt-step-2').style.display = 'none';
          document.getElementById('dt-step-3').style.display = 'block';
        } else if (question === 3) {
          showResult(answer === 'yes' ? 'iep_auto' : 'iep_active');
        }
      });

      var resetBtn = document.getElementById('dt-reset');
      if (resetBtn) resetBtn.addEventListener('click', dtReset);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

</BaseLayout>
