---
/**
 * retirement/index.astro
 * Retirement planning hub.
 */

import SectionLayout from '@layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('retirement', ({ data }) => {
  return data.draft !== true;
});

const sortedArticles = allArticles.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const articlesList = sortedArticles.map(art => ({
  title: art.data.title,
  description: art.data.description,
  href: `/retirement/${art.id}/`,
  publishDate: art.data.publishDate
}));

const toolsList = [
  {
    title: 'Social Security Tax Calculator',
    description: 'Calculate how much of your Social Security is taxable in 2026 and estimate your federal tax based on your combined income and filing status.',
    href: '/tools/social-security-tax-calculator/'
  },
  {
    title: 'Social Security Tax Withholding Calculator',
    description: 'Estimate monthly and annual voluntary federal income tax withholding from Social Security benefits using IRS Form W-4V rates (7%, 10%, 12%, 22%).',
    href: '/tools/social-security-tax-withholding-calculator/'
  },
  {
    title: 'Retirement Tax Calculator by State',
    description: 'Compare 2026 federal and state income tax on Social Security, pensions, 401(k), and IRA withdrawals across all 50 states.',
    href: '/tools/retirement-tax-calculator-by-state/'
  },
  {
    title: 'RMD Calculator by Age (2026 Tables)',
    description: 'Calculate the exact dollar amount you must withdraw from your traditional IRA or 401(k) each year using official IRS life expectancy tables.',
    href: '/tools/rmd-calculator/'
  },
  {
    title: 'Roth Conversion Calculator',
    description: 'Model the tax impact of converting traditional IRA funds to a Roth IRA and find the optimal conversion amount to avoid bracket spikes.',
    href: '/tools/roth-conversion-calculator/'
  },
  {
    title: 'IRA Withdrawal Tax Calculator',
    description: 'Calculate the incremental federal income tax, early-distribution penalties (under 59½), and net cash remaining on traditional IRA distributions.',
    href: '/tools/ira-withdrawal-tax-calculator/'
  },
  {
    title: 'MAGI for Medicare Calculator',
    description: 'Calculate your Modified Adjusted Gross Income used by SSA to determine your Medicare IRMAA surcharge — critical before any large retirement distribution.',
    href: '/tools/magi-for-medicare-calculator/'
  },
  {
    title: 'IRA & 401(k) Withdrawal Planner',
    description: 'Plan your annual retirement account withdrawals to minimize taxes, avoid Medicare surcharges, and meet RMD requirements simultaneously.',
    href: '/tools/ira-401k-withdrawal-planner/'
  },
  {
    title: 'Retirement Tax Withholding Calculator',
    description: 'Estimate federal tax withholding on your pension, annuity, and retirement distributions to avoid tax season surprises.',
    href: '/tools/retirement-tax-withholding-calculator/'
  },
  {
    title: 'Retirement Tax Estimator',
    description: 'Estimate your total annual federal tax bill across all retirement income sources: Social Security, RMDs, pension, and investment income.',
    href: '/tools/retirement-tax-calculator/'
  },
  {
    title: 'Property Tax Relief Checker',
    description: 'Find out if your state offers senior homeowner property tax exemptions, freezes, or circuit breaker credits — and the income thresholds that apply.',
    href: '/tools/property-tax-relief-checker/'
  }
];
const retirementIntro = `
<h2>Planning Your Retirement Withdrawals: Why the Order and Amount Matter</h2>
<p>
  One of the most consequential decisions a retiree makes is not when to claim Social Security — it is how
  to manage withdrawals from multiple accounts (IRA, 401(k), Roth, taxable brokerage) in a way that minimizes
  lifetime tax liability, avoids Medicare surcharges, and satisfies IRS Required Minimum Distribution rules.
  Getting this wrong by even one large withdrawal can cost thousands in taxes and trigger IRMAA surcharges
  that follow you for two full years.
</p>

<h2>Required Minimum Distributions: The Deadline You Cannot Miss</h2>
<p>
  The IRS requires that you begin withdrawing from traditional IRAs and most employer-sponsored plans (401(k), 403(b), 457(b))
  by April 1 of the year after you turn 73. After that, you must take distributions each year by December 31.
  If you miss an RMD or withdraw less than the required amount, the IRS imposes a penalty of 25% of the
  shortfall — reduced to 10% if you correct it within two years.
</p>
<p>
  Use our <a href="/tools/rmd-calculator/">RMD Calculator</a> to find your exact required withdrawal for the
  current year based on your account balance and the official IRS Uniform Lifetime Table (Publication 590-B).
</p>

<h2>Roth Conversions: The Window Between Retirement and RMDs</h2>
<p>
  The years between retirement and age 73 (when RMDs begin) often represent a window of lower taxable income.
  Converting traditional IRA funds to a Roth IRA during this window — and paying tax on the conversion at
  today's lower rates — can reduce future RMDs, lower Medicare IRMAA exposure in later years, and provide
  tax-free income for heirs.
</p>
<p>
  The tradeoff is that conversion income in a given year raises your MAGI, which determines Medicare Part B and
  Part D premiums two years later. Use our
  <a href="/tools/roth-conversion-calculator/">Roth Conversion Calculator</a> to model the tax impact before
  you convert, and our <a href="/tools/magi-for-medicare-calculator/">MAGI for Medicare Calculator</a> to check
  whether a planned conversion would push you into a higher IRMAA bracket.
</p>

<h2>State Taxes on Retirement Income</h2>
<p>
  Federal tax is only part of the picture. Thirty-eight states tax at least some retirement income, but many
  have generous exemptions for Social Security, pensions, or retirement account withdrawals for residents
  over 65. If you are considering relocation, the differences can be substantial — some states tax none of your
  retirement income while others treat all sources the same as wage income.
</p>
<p>
  Our <a href="/tools/retirement-tax-calculator-by-state/">Retirement Tax Calculator by State</a> compares
  federal plus state tax across all 50 states for your specific income mix.
</p>
`;
---

<SectionLayout
  title="Retirement Planning & RMD Calculators"
  description="Free calculators for RMDs, 401(k) and IRA withdrawal taxes, Roth conversions, and state retirement income taxes. Updated for 2026 IRS rules."
  intro={retirementIntro}
  tools={toolsList}
  articles={articlesList}
/>
