---
/**
 * irs/index.astro
 * IRS notices and audits learning hub.
 */

import SectionLayout from '@layouts/SectionLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('irs', ({ data }) => {
  return data.draft !== true;
});

const sortedArticles = allArticles.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const articlesList = sortedArticles.map(art => ({
  title: art.data.title,
  description: art.data.description,
  href: `/irs/${art.id}/`,
  publishDate: art.data.publishDate
}));

const toolsList = [
  {
    title: 'IRS CP14 Notice Decoder',
    description: 'Received a CP14 balance-due notice? Understand every line, verify the amount owed, and get specific action steps with deadlines.',
    href: '/tools/cp14-notice/'
  },
  {
    title: 'IRS CP504 Notice Decoder',
    description: 'The CP504 is a final notice before IRS levy action. Decode what it means, whether to pay immediately or dispute, and which form to use.',
    href: '/tools/cp504-notice/'
  },
  {
    title: 'IRS LT11 Notice Decoder',
    description: 'The LT11 is the IRS\'s final warning before a levy on your wages or bank account. Understand your rights and the 30-day response window.',
    href: '/tools/irs-lt11-notice-decoder/'
  },
  {
    title: 'IRS CP90 Notice Decoder',
    description: 'The CP90 is a formal intent-to-levy notice. Read what it means, your Collection Due Process rights, and exactly how to request a hearing.',
    href: '/tools/irs-cp90-notice-decoder/'
  },
  {
    title: 'CP2000 Response Letter Sample Tool',
    description: 'Received an underreporting notice? Generate a custom dispute letter, verify tax calculations, and calculate your 30-day deadline.',
    href: '/tools/cp2000-response-letter-sample/'
  },
  {
    title: 'Retirement Tax Withholding Calculator',
    description: 'Estimate how much federal tax to withhold on your IRA distributions, pension, and Social Security to avoid IRS underpayment penalties.',
    href: '/tools/retirement-tax-withholding-calculator/'
  },
  {
    title: 'Retirement Tax Estimator',
    description: 'Estimate your total federal tax bill in retirement from all income sources: Social Security, RMDs, pension, and investment income.',
    href: '/tools/retirement-tax-calculator/'
  }
];
const irsIntro = `
<h2>How to Read an IRS Notice: What Seniors Need to Know</h2>
<p>
  Receiving a letter from the IRS is stressful for most people — and particularly for retirees on fixed incomes
  who worry about what a tax bill or audit could mean for their financial security. The first thing to understand
  is that most IRS notices sent to older Americans are not demands for immediate payment. Many are routine
  notifications that require a simple response, and several can be disputed or resolved without paying anything.
</p>
<p>
  The IRS sends several million notices to seniors each year. The most common ones relate to underreported income
  (typically from 1099-R distributions or Social Security), balance-due amounts from prior-year returns, and
  enforcement actions — levies and liens — that the IRS pursues only after earlier notices have gone unanswered.
</p>

<h2>The Five Notices Seniors Receive Most Often</h2>
<ul>
  <li><strong>CP14</strong> — A balance-due notice telling you the IRS believes you owe money. This is the first
    notice in the collection sequence. You have 21 days before interest begins accruing. Use our
    <a href="/tools/cp14-notice/">CP14 Notice Decoder</a> to verify the amount and see your options.</li>
  <li><strong>CP2000</strong> — An "underreporter inquiry" proposing additional tax because income reported on your
    return does not match what payers reported to the IRS. This is <em>not</em> a bill yet — it is a proposal
    you can accept, partially accept, or dispute within 30 to 60 days.</li>
  <li><strong>CP504</strong> — A final balance-due notice that warns the IRS intends to levy your state tax refund
    if you do not pay or respond. Unlike the CP14, the CP504 has real enforcement consequences if ignored.</li>
  <li><strong>LT11</strong> — A final notice of intent to levy your wages, bank accounts, or other assets. Receiving
    an LT11 means you have 30 days to request a Collection Due Process hearing or pay in full. After 30 days
    the IRS can proceed without further notice.</li>
  <li><strong>CP90</strong> — Similar to the LT11, the CP90 is a formal intent-to-levy notice with Collection Due
    Process rights. It is typically sent for the same collection cycle. Use our
    <a href="/tools/irs-cp90-notice-decoder/">CP90 Notice Decoder</a> to understand your exact rights and deadlines.</li>
</ul>

<h2>The Single Most Important Rule</h2>
<p>
  Never ignore an IRS notice. The collection sequence is designed so that each unanswered notice escalates to
  a more serious enforcement action. A CP14 ignored becomes a CP504, which ignored becomes an LT11 or CP90,
  which — if ignored — leads to an actual levy on your Social Security, bank account, or wages. The IRS
  can levy up to 15% of Social Security retirement benefits under the Federal Payment Levy Program.
</p>
<p>
  If you are not sure whether a notice is legitimate, use our
  <a href="/tools/is-this-real-letter-checker/">Official Government Letter Authenticator</a> before calling
  any phone number listed on the document.
</p>
`;
---

<SectionLayout
  title="IRS Notice Decoders & Senior Tax Guides"
  description="Decode IRS CP14, CP504, LT11, CP90, and CP2000 notices. Plain-English dispute steps, 30-day appeal deadline trackers, and response guides for seniors."
  intro={irsIntro}
  tools={toolsList}
  articles={articlesList}
/>
