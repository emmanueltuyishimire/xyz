const seoTitle       = 'Social Security Benefit Cap Proposal: 2026 | Seniors Audit';
const metaDesc       = 'Understand the Social Security benefit cap proposal. Model proposed payroll tax cap changes, 2032 trust fund solvency, and your monthly check with our tool.';
const ogTitle        = 'Social Security Benefit Cap Proposal: 2026';

/* JSON-LD Schemas */
const schemaWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Social Security Benefit Cap Proposal & Solvency Calculator',
  url: CANONICAL,
  description: metaDesc,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: {
    '@type': 'Organization',
    name: 'Seniors Audit',
    url: 'https://www.seniorsaudit.com',
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',                item: 'https://www.seniorsaudit.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools & Calculators', item: 'https://www.seniorsaudit.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Social Security',      item: 'https://www.seniorsaudit.com/social-security/' },
    { '@type': 'ListItem', position: 4, name: 'Social Security Benefit Cap Proposal', item: CANONICAL },
  ],
};

const schemaFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the Social Security benefit cap proposal in 2026?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Social Security benefit cap proposal refers to legislative efforts to address the 2032 trust fund depletion. Active bills like the Moreno-Warren proposal and Social Security 2100 Act focus on eliminating or raising the $184,500 payroll tax cap on high earners rather than cutting retiree checks.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there currently a cap on Social Security benefits?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, but it is mathematical rather than political. Your benefit is determined by lifetime earnings up to the annual taxable wage base ($184,500 in 2026). The maximum monthly benefit at full retirement age (67) in 2026 is $4,152, and $5,181 at age 70.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will my Social Security check be cut if the trust fund runs out in 2032?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Under current law, if the OASI trust fund is depleted in late 2032, the SSA would only be authorized to pay benefits equal to incoming payroll tax revenues — roughly 72 to 77 cents per scheduled dollar. Congress has historically passed bipartisan fixes before depletion.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is means-testing for Social Security?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Means-testing is a policy proposal to reduce or phase out Social Security checks for wealthy retirees with significant outside income or assets. As of 2026, no active means-testing legislation is pending in Congress.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does scrapping the Social Security payroll tax cap mean?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It means eliminating the $184,500 annual wage cap so that all earnings are subject to the 6.2% Social Security payroll tax. Actuaries project this would generate $3.0 to $3.4 trillion over 10 years, closing about two-thirds of the long-range funding gap.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the Social Security 2100 Act?',
