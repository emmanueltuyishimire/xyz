import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SocialSecurityBenefitCapCalculator from '@components/tools/SocialSecurityBenefitCapCalculator';

const CANONICAL = 'https://www.seniorsaudit.com/tools/social-security-benefit-cap-proposal/';

const breadcrumbItems = [
  { label: 'Tools & Calculators', href: '/tools/' },
  { label: 'Social Security', href: '/social-security/' },
  { label: 'Social Security Benefit Cap Proposal' },
