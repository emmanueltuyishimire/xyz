---
import ToolLayout from '@layouts/ToolLayout.astro';
import { SmartphoneSetupGuide } from '@components/tools/SmartphoneSetupGuide';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'Do I need to pay for FaceTime or Zoom?',
    answer: 'No. FaceTime is built into iPhones/iPads for free. Zoom offers free basic video calls for up to 40 minutes for group calls, and unlimited for 1-on-1 calls.',
  },
  {
    question: 'Do I need to download an app to use Zoom?',
    answer: 'Downloading the free Zoom app provides the smoothest experience, but you can also join Zoom meetings directly in a web browser by tapping the meeting link.',
  },
  {
    question: 'What if I cannot hear the other person during a video call?',
    answer: 'Ensure your device volume is turned up using the side volume buttons, check that your sound is not muted, and tap "Join Audio" inside the app.',
  },
  {
    question: 'What if my camera shows a black screen?',
    answer: 'Check if your hand or phone case is blocking the camera lens, and ensure you tapped "Allow" when the app asked for camera permissions.',
  },
  {
    question: 'Does FaceTime work on Android phones?',
    answer: 'Android users cannot initiate FaceTime calls, but an iPhone user can send a FaceTime link that an Android user can open in a web browser.',
  },
  {
    question: 'How do I end a video call if I get confused?',
    answer: 'Tap anywhere on your screen once to make controls appear, then tap the prominent red button (End Call or Leave Meeting).',
  },
  {
    question: 'What is the best way to practice video calling for the first time?',
    answer: 'Schedule a 5-minute practice call with a family member or friend so you can test audio, lighting, and camera positioning without pressure.',
  },
];

const howToSteps = [
  { name: 'Choose your platform', text: 'Select FaceTime for Apple devices, or Zoom/WhatsApp for all smartphones.' },
  { name: 'Prepare your device', text: 'Plug in or charge your phone and sit in a well-lit, quiet room.' },
  { name: 'Follow large-type steps', text: 'Execute the numbered step-by-step instructions for your chosen platform.' },
  { name: 'Practice with family', text: 'Conduct a test call with a family member to verify microphone and camera.' },
];
---

<ToolLayout
  title="Video Call Setup Guide — Free | Seniors Audit"
  description="Free plain-English video call guide for seniors. Step-by-step FaceTime, Zoom, and WhatsApp Video setup. Large type. No account needed. No jargon."
  faqs={faqs}
  howToSteps={howToSteps}
  datePublished="2026-07-01"
  dateModified="2026-07-29"
  agency="CMS"
  canonical="https://www.seniorsaudit.com/tools/smartphone-video-call-setup-guide/"
  keywords="senior video call guide, plain English FaceTime setup, Zoom instructions for elderly, how to make video calls on iPhone Android"
>
  <div style="margin-bottom: var(--space-8);">
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem; display:flex; flex-wrap:wrap; gap:0.25rem; align-items:center;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Smartphone & Video Call Guide</span>
    </div>

    <h1 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: #0D2137; line-height: 1.2; margin-bottom: 0.5rem;">
      Plain-English Guide: How to Make Video Calls on iPhone, Android, or Zoom — Free
    </h1>
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">Figures and guidance last verified against official sources in {lastReviewed}.</p>

    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 0.75rem 0 1rem;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        FaceTime (iPhone): open FaceTime app, tap the green camera icon, type the person's name, tap FaceTime button. Zoom: your family member sends you a link, you tap it, tap 'Join with Video.' WhatsApp Video: open WhatsApp, tap the person's name, tap the video camera icon at the top right.
      </p>
    </div>
  </div>

  <div style="background: var(--color-surface); border: 2px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); margin-bottom: var(--space-10); box-shadow: var(--shadow-md);" id="guide">
    <SmartphoneSetupGuide client:load />
  </div>

  <NoSignupStatement />

  <section style="margin-block: var(--space-10); padding-bottom: var(--space-8); border-bottom: 1px solid var(--color-border);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; font-weight: 800; margin-bottom: 1rem;">Frequently Asked Questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- RELATED TOOLS -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-tools-heading">
    <h2 id="related-tools-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Senior Tech & Health Tools
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/telehealth-how-it-works/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Telehealth Walkthrough & Medicare Coverage →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Understand how virtual doctor visits work and which Medicare plans cover telehealth.</p>
      </a>
      <a href="/tools/fall-risk-home-safety-checklist/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Fall Risk Home Safety Checklist →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Walk through your home room by room to identify and fix the most common fall hazards.</p>
      </a>
      <a href="/tools/do-i-need-care-options-wizard/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Do I Need Care? Senior Care Options Wizard →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Compare home care, assisted living, and nursing options based on daily living needs.</p>
      </a>
    </div>
  </section>

  <DisclaimerBlock
    type="calculator"
    agencyName="Federal Communications Commission (FCC)"
    agencyPhone="1-888-225-5322"
    agencyUrl="https://www.fcc.gov"
    lastReviewed={lastReviewed}
  />
</ToolLayout>
