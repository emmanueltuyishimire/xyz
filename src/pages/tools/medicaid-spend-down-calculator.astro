    var lookbackLabel = '';

    if (state === 'CA') {
      var calReviewStart = new Date(2026, 0, 1); // Jan 1, 2026
      var monthsDiff = Math.max(1, (targetDate.getFullYear() - 2026) * 12 + targetDate.getMonth() + 1);
      lookbackLabel = monthsDiff + ' Mos (Growing)';
      dateRangeStr = 'Jan 2026 to ' + targetDate.toLocaleDateString('en-US', dateOpts);
    } else {
      lookbackLabel = '60 Months';
      var reviewStartDate = new Date(targetDate);
      reviewStartDate.setMonth(reviewStartDate.getMonth() - LIMITS_2026.lookbackFederalMonths);
      dateRangeStr = reviewStartDate.toLocaleDateString('en-US', dateOpts) + ' to ' + targetDate.toLocaleDateString('en-US', dateOpts);
    }

    var applicantAllowed = 2000;
    var csraProtected = 0;
    var excessSpendDown = 0;
    var explanationHtml = '';

    if (state === 'CA') {
      // California Medi-Cal 2026 Standards
      if (household === 'individual') {
        applicantAllowed = LIMITS_2026.californiaIndividual;
        excessSpendDown = Math.max(0, assets - applicantAllowed);
        explanationHtml = '<p><strong>California Medi-Cal Rules Apply:</strong> Effective January 1, 2026, California reinstated a non-MAGI asset ceiling of <strong>$130,000</strong> for individuals (DHCS ACWDL 25-14/25-20). Only uncompensated transfers on or after January 1, 2026 are reviewed, with the review window growing month-by-month. ';
        if (excessSpendDown === 0) {
          explanationHtml += 'Your assets ($' + assets.toLocaleString() + ') are within California\'s $130,000 limit. You currently meet the asset requirement for Medi-Cal.</p>';
        } else {
          explanationHtml += 'You have approximately <strong>' + formatMoney(excessSpendDown) + '</strong> in assets above the California threshold that must be spent down on allowable medical or personal needs.</p>';
        }
      } else {
        applicantAllowed = LIMITS_2026.californiaCouple;
        excessSpendDown = Math.max(0, assets - applicantAllowed);
        explanationHtml = '<p><strong>California Medi-Cal Rules Apply:</strong> For couples, California\'s 2026 asset ceiling is <strong>$195,000</strong> ($130,000 + $65,000 per ACWDL 25-14/25-20), evaluating only transfers on or after January 1, 2026 (active review window still growing). ';
        if (excessSpendDown === 0) {
          explanationHtml += 'Your combined assets ($' + assets.toLocaleString() + ') are within California\'s married asset limit.</p>';
        } else {
          explanationHtml += 'Your household has approximately <strong>' + formatMoney(excessSpendDown) + '</strong> above the California married limit.</p>';
        }
      }
      csraBox.style.display = 'none';
      allowedNote.textContent = 'California 2026 asset cap';

    } else {
      // Federal 49-State Standard
      if (household === 'individual') {
        applicantAllowed = LIMITS_2026.individual;
        excessSpendDown = Math.max(0, assets - applicantAllowed);
        csraBox.style.display = 'none';
        allowedNote.textContent = 'Federal individual limit ($2,000)';

        if (excessSpendDown === 0) {
          explanationHtml = '<p><strong>Within Asset Limits:</strong> Your countable savings of ' + formatMoney(assets) + ' are within the federal $2,000 individual Medicaid asset limit. Assuming your monthly income meets your state\'s institutional criteria, you meet the asset requirements for long-term care Medicaid.</p>';
        } else {
          explanationHtml = '<p><strong>Excess Assets to Address:</strong> An individual applicant is permitted to keep up to $2,000 in countable reserves. You have <strong>' + formatMoney(excessSpendDown) + '</strong> in countable funds that must be spent down on legitimate medical care, personal necessities, or permissible items before Medicaid eligibility begins.</p>';
        }

      } else if (household === 'married-one') {
        // Community Spouse Resource Allowance (42 U.S.C. § 1396r-5)
        applicantAllowed = LIMITS_2026.individual; // $2,000 for spouse in care
        
        // Federal standard calculation: community spouse gets half of combined assets, min $32,532, max $162,660
        if (assets <= LIMITS_2026.csraMin) {
          csraProtected = assets; // Community spouse keeps all if total is below min
        } else {
          var half = assets / 2;
          csraProtected = Math.min(Math.max(half, LIMITS_2026.csraMin), LIMITS_2026.csraMax);
        }

        var totalProtected = csraProtected + applicantAllowed;
        excessSpendDown = Math.max(0, assets - totalProtected);

        csraBox.style.display = 'flex';
        csraNote.textContent = 'Community spouse protected allowance';
        allowedNote.textContent = 'Spouse in care limit ($2,000)';

        if (excessSpendDown === 0) {
          explanationHtml = '<p><strong>Protected by CSRA:</strong> Under 2026 federal spousal impoverishment rules, your community spouse is entitled to keep <strong>' + formatMoney(csraProtected) + '</strong>. Because your combined assets do not exceed total protected limits (' + formatMoney(totalProtected) + '), your spouse in care meets Medicaid asset criteria without further spend-down.</p>';
        } else {
          explanationHtml = '<p><strong>Spousal Protection Breakdown:</strong> Your community spouse is permitted to keep <strong>' + formatMoney(csraProtected) + '</strong> under the 2026 federal CSRA standard, while the spouse in care retains $2,000. This leaves <strong>' + formatMoney(excessSpendDown) + '</strong> in excess assets that must be addressed through permissible care spending or debt payoffs before Medicaid coverage takes effect.</p>';
        }

      } else {
        // Married both in care
        applicantAllowed = LIMITS_2026.marriedBoth;
        excessSpendDown = Math.max(0, assets - applicantAllowed);
        csraBox.style.display = 'none';
        allowedNote.textContent = 'Couples joint care limit ($3,000)';

        if (excessSpendDown === 0) {
          explanationHtml = '<p><strong>Within Married Care Limits:</strong> When both spouses require nursing care, the joint countable asset limit is $3,000. Your combined savings are currently within this threshold.</p>';
        } else {
          explanationHtml = '<p><strong>Joint Spend-Down Required:</strong> Because both spouses require care, the community spouse rules do not apply. The federal joint limit is $3,000. Your household has <strong>' + formatMoney(excessSpendDown) + '</strong> in countable reserves that must be spent down.</p>';
        }
      }
    }

    // Populate Results Display
    statTotal.textContent = formatMoney(assets);
    statCsra.textContent = formatMoney(csraProtected);
    statAllowed.textContent = formatMoney(applicantAllowed);
    statLookback.textContent = lookbackLabel;
    lookbackDates.textContent = dateRangeStr;

    if (excessSpendDown === 0) {
      mainStat.textContent = '$0 Excess';
      mainStat.style.color = '#15803D';
      mainLabel.textContent = 'Assets Appear Within Medicaid Thresholds';
    } else {
      mainStat.textContent = formatMoney(excessSpendDown);
      mainStat.style.color = '#E8761A';
      mainLabel.textContent = 'Estimated Spend-Down Required to Reach Asset Limit';
    }

    explanationText.innerHTML = explanationHtml;

    resultsPanel.hidden = false;
    resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      resultsPanel.hidden = true;
      document.getElementById('msd-assets').value = '';
      document.getElementById('msd-date').value = '';
      document.getElementById('msd-state').value = 'US';
      var radios = document.getElementsByName('msd-household');
      if (radios.length > 0) radios[0].checked = true;
      formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
})();
</script>

