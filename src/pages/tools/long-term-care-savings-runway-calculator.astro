<!-- =========================================================
     CALCULATOR LOGIC
     ========================================================= -->
<script is:inline>
(function () {
  'use strict';

  var CARE_COSTS = {
    'home':       6673,
    'alc':        6200,
    'nh-semi':    9581,
    'nh-private': 10798,
    'memory':     7400,
    'custom':     0,
  };

  // Medicaid thresholds (2026 federal SSI baseline)
  var MEDICAID_THRESHOLD = { individual: 2000, couple: 3000 };

  // DOM refs
  var savingsEl     = document.getElementById('ltc-savings');
  var incomeEl      = document.getElementById('ltc-income');
  var careTypeEl    = document.getElementById('ltc-care-type');
  var costEl        = document.getElementById('ltc-monthly-cost');
  var inflationEl   = document.getElementById('ltc-inflation');
  var inflationVal  = document.getElementById('ltc-inflation-val');
  var calcBtn       = document.getElementById('ltc-calc-btn');
  var resetBtn      = document.getElementById('ltc-reset-btn');
  var resultPanel   = document.getElementById('ltc-result-panel');
  var inputPanel    = document.querySelector('.ltc-input-panel');

  var resultNum     = document.getElementById('ltc-result-number');
  var resultSub     = document.getElementById('ltc-result-subtext');
  var bdCost        = document.getElementById('ltc-bd-cost');
  var bdIncome      = document.getElementById('ltc-bd-income');
  var bdShortfall   = document.getElementById('ltc-bd-shortfall');
  var medicaidTrig  = document.getElementById('ltc-medicaid-trigger');
  var medicaidText  = document.getElementById('ltc-medicaid-text');
  var incomeCovers  = document.getElementById('ltc-income-covers');
  var incomeCoversT = document.getElementById('ltc-income-covers-text');

  function fmt(n) {
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function getHousehold() {
    var els = document.querySelectorAll('input[name="ltc-household"]');
    for (var i = 0; i < els.length; i++) {
      if (els[i].checked) return els[i].value;
    }
    return 'individual';
  }

  // Sync care type → monthly cost field
  careTypeEl.addEventListener('change', function () {
    var cost = CARE_COSTS[careTypeEl.value] || 0;
    if (careTypeEl.value !== 'custom') {
      costEl.value = cost;
    } else {
      costEl.value = '';
      costEl.focus();
    }
  });

  // Slider label
  inflationEl.addEventListener('input', function () {
    inflationVal.textContent = inflationEl.value + '%';
    inflationEl.setAttribute('aria-valuetext', inflationEl.value + '%');
  });

  function calculateRunway(savings, shortfall, annualInflation) {
    if (annualInflation === 0) {
      return shortfall > 0 ? savings / shortfall : Infinity;
    }
    // Month-by-month iterative depletion
    var monthlyInflation = Math.pow(1 + annualInflation / 100, 1 / 12) - 1;
    var balance = savings;
    var currentShortfall = shortfall;
    var months = 0;
    while (balance > 0 && months < 1200) { // cap at 100 years
      balance -= currentShortfall;
      currentShortfall *= (1 + monthlyInflation);
      months++;
    }
    return months;
  }

  function findMedicaidMonth(savings, shortfall, annualInflation, threshold) {
    if (shortfall <= 0) return null;
    if (annualInflation === 0) {
      var mMonths = Math.ceil((savings - threshold) / shortfall);
      return mMonths > 0 ? mMonths : 1;
    }
    var monthlyInflation = Math.pow(1 + annualInflation / 100, 1 / 12) - 1;
    var balance = savings;
    var currentShortfall = shortfall;
    var m = 0;
    while (balance > threshold && m < 1200) {
      balance -= currentShortfall;
      currentShortfall *= (1 + monthlyInflation);
      m++;
    }
    return m > 0 ? m : 1;
  }

  calcBtn.addEventListener('click', function () {
    var savings   = parseFloat(savingsEl.value) || 0;
    var income    = parseFloat(incomeEl.value) || 0;
    var cost      = parseFloat(costEl.value) || 0;
    var inflation = parseFloat(inflationEl.value) || 0;
    var household = getHousehold();
    var threshold = MEDICAID_THRESHOLD[household];

    if (savings <= 0 && income <= 0) {
      alert('Please enter your savings and/or monthly income to calculate.');
      savingsEl.focus();
      return;
    }
    if (cost <= 0) {
      alert('Please enter a monthly care cost.');
      costEl.focus();
      return;
    }

    var shortfall = cost - income;

    // Populate breakdown row
    bdCost.textContent     = fmt(cost);
    bdIncome.textContent   = fmt(income);
    bdShortfall.textContent = shortfall > 0 ? fmt(shortfall) : '$0 (income covers cost)';

    // Reset conditional blocks
    medicaidTrig.hidden  = true;
    incomeCovers.hidden  = true;

    if (shortfall <= 0) {
      // Income covers the entire care cost
      resultNum.textContent = 'Income Covers Care';
      resultNum.style.fontSize = '2rem';
      resultSub.textContent = '';
      incomeCovers.hidden = false;
      var surplus = income - cost;
      incomeCoversT.innerHTML =
        'Your current monthly income (' + fmt(income) + ') appears to fully cover the selected care cost (' + fmt(cost) + '/month). ' +
        'That leaves a ' + fmt(surplus) + '/month surplus — meaning your savings would not need to be drawn on for this care expense at current prices. ' +
        'This is a strong result. <strong>What to check next:</strong> run the calculator once more with the inflation slider at 3% to confirm this picture holds if care costs rise. ' +
        'Also verify the care cost you used reflects a real local quote, not just the national median — actual local costs can run significantly higher. ' +
        'If you have Medicare, check our free <a href="/tools/medicare-savings-estimator/" class="ltc-body-link">Medicare Savings Program Estimator</a> — at this income level you may qualify for premium help.';
    } else {
      var months = calculateRunway(savings, shortfall, inflation);

      if (months >= 1200) {
        resultNum.textContent = '100+ years';
        resultNum.style.fontSize = '2rem';
        resultSub.innerHTML =
          'At the current shortfall rate, your savings appear more than sufficient to cover this level of care for the foreseeable future. ' +
          'Before treating this as a final answer, try setting the inflation slider to 3% and recalculating — long-horizon projections shift considerably with modest annual cost increases. ' +
          'Also confirm that the care type selected matches the likely level of care needed. Someone who would need memory care rather than standard assisted living has a meaningfully shorter real runway.';
      } else {
        var mo = Math.floor(months);
        var yr = (mo / 12).toFixed(1);
        resultNum.textContent = mo + ' months';
        resultNum.style.fontSize = '3rem';

        // Tier-specific plain-English interpretation
        var interpretation = '';
        if (mo < 24) {
          interpretation =
            ' <strong>What this means:</strong> A runway under 24 months means the Medicaid planning conversation is likely already relevant for your situation. ' +
            'Medicaid applications typically take 45 to 90 days to process, and many nursing facilities want an application underway before accepting a Medicaid resident. ' +
            'Starting the eligibility check now rather than waiting until savings are nearly gone avoids a gap in care coverage. ' +
            'This is not a cause for alarm — Medicaid covers over 60% of all U.S. nursing home days precisely because this is a common situation.';
        } else if (mo < 60) {
          interpretation =
            ' <strong>What this means:</strong> A 2-to-5 year runway is the most common planning window families find themselves in. ' +
            'It is enough time to make deliberate decisions without immediate pressure. ' +
            'Use this window to get an actual local cost quote (one call to two or three nearby facilities takes 20 minutes), ' +
            'run the calculator again at 3% inflation to see the realistic range, ' +
            'and begin learning how Medicaid eligibility works in your state before you need it.';
        } else {
          interpretation =
            ' <strong>What this means:</strong> A runway of 5 or more years suggests meaningful financial cushion at this care level and income. ' +
            'Two things to check: first, run the calculator again with the inflation slider at 3% — for a 10-year horizon, care cost inflation alone can reduce your runway by 15 to 20%. ' +
            'Second, confirm the care type selected matches the person\'s likely clinical needs. ' +
            'Memory care typically costs 15 to 30% more than standard assisted living, which would produce a noticeably shorter result.';
        }

        resultSub.innerHTML =
          'Approximately ' + yr + ' years — based on ' + fmt(savings) + ' in savings and a ' +
          fmt(shortfall) + '/month shortfall' +
          (inflation > 0 ? ' with ' + inflation + '% annual care cost inflation modeled' : ' at today\'s flat costs') +
          '. Cost data: ' +
          (careTypeEl.value !== 'custom' ? '2025 CareScout/Genworth national median — your actual local cost may differ.' : 'your entered local cost figure.') +
          interpretation;

        // Medicaid trigger — check if savings will drop below threshold
        if (savings > threshold) {
          var medicaidMonth = findMedicaidMonth(savings, shortfall, inflation, threshold);
          if (medicaidMonth <= months + 2) {
            medicaidTrig.hidden = false;
            var mYears = (medicaidMonth / 12).toFixed(1);
            medicaidText.innerHTML =
              'Based on this projection, savings would fall below the Medicaid asset limit (' +
              fmt(threshold) + ' for a ' + household + ') after approximately <strong>' +
              medicaidMonth + ' months (' + mYears + ' years)</strong>. ' +
              'At that point, you may become eligible for Medicaid to help cover ongoing nursing home costs. ' +
              'Federal rules require states to process standard Medicaid applications within 45 days. ' +
              'Starting the application process at least 3 to 6 months before reaching this point avoids a coverage gap. ' +
              'Use our free <a href="/tools/medicaid-eligibility-calculator/" class="ltc-body-link">Medicaid Eligibility Calculator</a> to check your state\'s exact 2026 income and asset limits. ' +
              'A free <a href="https://www.shiphelp.org" target="_blank" rel="noopener noreferrer" class="ltc-body-link">SHIP counselor</a> can help you start the application.';
          }
        }
      }
    }

    // Show results, hide calculate button
    resultPanel.hidden = false;
    inputPanel.style.display = 'none';
    resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  resetBtn.addEventListener('click', function () {
    resultPanel.hidden = true;
    inputPanel.style.display = '';
    savingsEl.value = '';
    incomeEl.value  = '';
    careTypeEl.value = 'nh-semi';
    costEl.value    = 9581;
    inflationEl.value = 0;
    inflationVal.textContent = '0%';
    resultNum.style.fontSize = '';
    inputPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

})();
</script>

