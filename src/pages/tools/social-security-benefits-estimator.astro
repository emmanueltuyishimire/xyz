<script>
  const btn = document.getElementById('benefits-calc-btn');
  const resultsDiv = document.getElementById('benefits-results');

  const BP1 = 1226;
  const BP2 = 7391;

  function calcPIA(avgAnnual: number): number {
    const aime = avgAnnual / 12;
    let pia = 0;
    if (aime <= BP1) {
      pia = aime * 0.90;
    } else if (aime <= BP2) {
      pia = BP1 * 0.90 + (aime - BP1) * 0.32;
    } else {
      pia = BP1 * 0.90 + (BP2 - BP1) * 0.32 + (aime - BP2) * 0.15;
    }
    return Math.round(pia * 10) / 10;
  }

  function adjustForClaimAge(pia: number, claimAge: number, fra: number): number {
    const monthsDiff = (claimAge - fra) * 12;
    if (monthsDiff === 0) return pia;
    if (monthsDiff < 0) {
      const earlyMonths = Math.abs(monthsDiff);
      const first36 = Math.min(earlyMonths, 36);
      const beyond36 = Math.max(0, earlyMonths - 36);
      const reduction = (first36 * 5/9/100) + (beyond36 * 5/12/100);
      return pia * (1 - reduction);
    }
    const delayMonths = Math.min(monthsDiff, (70 - fra) * 12);
    return pia * (1 + delayMonths * 2/3/100);
  }

  btn?.addEventListener('click', () => {
    const avgEarnings = parseFloat((document.getElementById('avg-earnings') as HTMLInputElement)?.value || '0');
    const claimAge = parseInt((document.getElementById('claim-age') as HTMLSelectElement)?.value || '67');
    const fraAge = parseInt((document.getElementById('fra-age-est') as HTMLSelectElement)?.value || '67');

    if (!resultsDiv) return;

    if (isNaN(avgEarnings) || avgEarnings <= 0) {
      resultsDiv.innerHTML = `
        <div class="ssb-error-box">
          <p class="ssb-error-text">Please enter a valid average annual earnings amount.</p>
        </div>`;
      resultsDiv.hidden = false;
      return;
    }

    const pia = calcPIA(avgEarnings);
    const adjustedBenefit = adjustForClaimAge(pia, claimAge, fraAge);
    const annual = adjustedBenefit * 12;
    const fmt = (v: number) => v.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    resultsDiv.innerHTML = `
      <div class="ssb-result-box" role="region" aria-label="Benefit Estimate">
        <h3 class="ssb-result-h3">Your Estimated Social Security Benefit</h3>
        <div class="ssb-result-main">
          <span class="ssb-result-label">Estimated Monthly Check at Age ${claimAge}</span>
          <div class="ssb-result-amount">${fmt(adjustedBenefit)}</div>
        </div>
        <div class="ssb-result-details">
          <p>Primary Insurance Amount (PIA at FRA Age ${fraAge}): <strong>${fmt(pia)}/month</strong></p>
          <p>Estimated Annual Income: <strong>${fmt(annual)}/year</strong></p>
