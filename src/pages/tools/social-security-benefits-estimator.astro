<script>
  const btn = document.getElementById('benefits-calc-btn');
  const resultsDiv = document.getElementById('benefits-results');

  // Official 2026 Bend Points
  const BP1 = 1286;
  const BP2 = 7749;
  const WAGE_BASE_2026 = 184500;
  const MAX_BENEFIT_70 = 5181;
  const MAX_BENEFIT_FRA = 4152;
  const MAX_BENEFIT_62 = 2969;

  function calcPIA(avgAnnual: number, yearsWorked: number): number {
    const cappedAnnual = Math.min(avgAnnual, WAGE_BASE_2026);
    // 35-year average AIME
    const aime = (cappedAnnual / 12) * Math.min(yearsWorked, 35) / 35;
    let pia = 0;
    if (aime <= BP1) {
      pia = aime * 0.90;
    } else if (aime <= BP2) {
      pia = BP1 * 0.90 + (aime - BP1) * 0.32;
    } else {
      pia = BP1 * 0.90 + (BP2 - BP1) * 0.32 + (aime - BP2) * 0.15;
    }
    return Math.round(pia * 10) / 10;
  }

  function adjustForClaimAge(pia: number, claimAge: number, fra: number): number {
    const monthsDiff = (claimAge - fra) * 12;
    if (monthsDiff === 0) return pia;
    if (monthsDiff < 0) {
      const earlyMonths = Math.abs(monthsDiff);
      const first36 = Math.min(earlyMonths, 36);
      const beyond36 = Math.max(0, earlyMonths - 36);
      const reduction = (first36 * 5/9/100) + (beyond36 * 5/12/100);
      return Math.round(pia * (1 - reduction));
    }
    const delayMonths = Math.min(monthsDiff, (70 - fra) * 12);
    return Math.round(pia * (1 + delayMonths * 2/3/100));
  }

  btn?.addEventListener('click', () => {
    const avgEarnings = parseFloat((document.getElementById('avg-earnings') as HTMLInputElement)?.value || '0');
    const yearsWorked = parseInt((document.getElementById('years-worked') as HTMLSelectElement)?.value || '35');
    const claimAge = parseInt((document.getElementById('claim-age') as HTMLSelectElement)?.value || '67');
    const fraAge = parseFloat((document.getElementById('fra-age-est') as HTMLSelectElement)?.value || '67');

    if (!resultsDiv) return;

    if (isNaN(avgEarnings) || avgEarnings <= 0) {
      resultsDiv.innerHTML = `
        <div class="ssb-error-box">
          <p class="ssb-error-text">Please enter a valid career average annual earnings amount.</p>
        </div>`;
      resultsDiv.hidden = false;
      return;
    }

    const pia = calcPIA(avgEarnings, yearsWorked);
    const adjustedBenefit = adjustForClaimAge(pia, claimAge, fraAge);
    const annual = adjustedBenefit * 12;
    const spousalMax = Math.round(pia * 0.5);
    const fmt = (v: number) => v.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

    const cappedAvg = Math.min(avgEarnings, WAGE_BASE_2026);
    const calculatedAIME = Math.round((cappedAvg / 12) * Math.min(yearsWorked, 35) / 35);

    // Build By-Age Breakdown rows
    const ageRows = [62, 63, 64, 65, 66, 67, 68, 69, 70].map(age => {
      const b = adjustForClaimAge(pia, age, fraAge);
      const isSelected = age === claimAge;
      const pctPIA = ((b / pia) * 100).toFixed(1);
      return `
        <tr style="${isSelected ? 'background: #F0FAF5; font-weight: 700;' : ''}">
          <td style="padding: 0.6rem 0.85rem; border-bottom: 1px solid #E2E8F0;">Age ${age}${isSelected ? ' <strong>(Selected)</strong>' : age === Math.floor(fraAge) ? ' (FRA)' : ''}</td>
          <td style="padding: 0.6rem 0.85rem; border-bottom: 1px solid #E2E8F0;">${pctPIA}%</td>
          <td style="padding: 0.6rem 0.85rem; border-bottom: 1px solid #E2E8F0; color: #0A3D3A; font-weight: 700;">${fmt(b)}</td>
          <td style="padding: 0.6rem 0.85rem; border-bottom: 1px solid #E2E8F0;">${fmt(b * 12)}</td>
        </tr>
      `;
    }).join('');

    resultsDiv.innerHTML = `
      <div class="ssb-result-box" role="region" aria-label="Benefit Estimate">
        <h3 class="ssb-result-h3">Your Estimated 2026 Social Security Benefit</h3>
        
        <div class="ssb-result-main">
          <span class="ssb-result-label">Estimated Monthly Check at Age ${claimAge}</span>
          <div class="ssb-result-amount">${fmt(adjustedBenefit)} <span style="font-size: 1rem; color: #4B5A6E; font-weight: 400;">/ month</span></div>
          <span style="font-size: 1.05rem; font-weight: 700; color: #0A3D3A;">${fmt(annual)} per year</span>
        </div>

        <div class="ssb-result-details">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin: 16px 0; background: #FFFFFF; padding: 16px; border-radius: 8px; border: 1px solid #DDE3EA;">
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; color: #64748B; text-transform: uppercase;">AIME (35-Yr Average)</span>
              <div style="font-size: 1.25rem; font-weight: 800; color: #08111F;">${fmt(calculatedAIME)}/mo</div>
            </div>
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Base PIA (at FRA ${fraAge})</span>
              <div style="font-size: 1.25rem; font-weight: 800; color: #08111F;">${fmt(pia)}/mo</div>
            </div>
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; color: #64748B; text-transform: uppercase;">Max Spousal Benefit</span>
              <div style="font-size: 1.25rem; font-weight: 800; color: #08111F;">${fmt(spousalMax)}/mo</div>
            </div>
          </div>

          <h4 style="color: #08111F; font-size: 1rem; margin: 18px 0 8px 0; font-weight: 700;">📊 Social Security Benefit by Age Comparison (62 to 70):</h4>
          <div style="overflow-x: auto; margin-bottom: 16px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; background: #FFFFFF; border: 1px solid #DDE3EA; border-radius: 6px;">
              <thead>
                <tr style="background: #08111F; color: #C9933A; text-align: left;">
                  <th style="padding: 0.6rem 0.85rem;">Claim Age</th>
                  <th style="padding: 0.6rem 0.85rem;">% of PIA</th>
                  <th style="padding: 0.6rem 0.85rem;">Monthly Check</th>
                  <th style="padding: 0.6rem 0.85rem;">Annual Income</th>
                </tr>
              </thead>
              <tbody>
                ${ageRows}
              </tbody>
            </table>
          </div>
          
          <div class="ssb-next-actions">
            <h4 class="ssb-next-title">Recommended Decision Helpers for Your Numbers:</h4>
            <ul class="ssb-next-list">
              <li>
                <a href="/tools/social-security-break-even-calculator/" target="_blank" rel="noopener noreferrer">
                  <strong>Social Security Break-Even Calculator ↗</strong>
                </a> — Find your exact crossover age where delaying your claim yields higher total lifetime wealth.
              </li>
              <li>
                <a href="/tools/social-security-spousal-benefit-calculator/" target="_blank" rel="noopener noreferrer">
                  <strong>Spouse Social Security Benefit Calculator ↗</strong>
                </a> — Calculate your partner's 50% spousal check (up to ${fmt(spousalMax)}/mo) under deemed filing rules.
              </li>
              <li>
                <a href="/tools/social-security-tax-calculator/" target="_blank" rel="noopener noreferrer">
                  <strong>Taxable Social Security Calculator ↗</strong>
                </a> — Calculate how much of your ${fmt(adjustedBenefit)} monthly check will be subject to federal income tax.
              </li>
              <li>
                <a href="/tools/401k-withdrawal-tax-calculator/" target="_blank" rel="noopener noreferrer">
                  <strong>401(k) Withdrawal Tax Calculator ↗</strong>
                </a> — Model how 401(k) drawdowns impact your Social Security taxability and take-home cash.
              </li>
              <li>
                <a href="/tools/social-security-benefit-cap-calculator/" target="_blank" rel="noopener noreferrer">
                  <strong>Social Security Benefit Cap Proposal Calculator ↗</strong>
                </a> — See how 2032 trust fund depletion or payroll tax cap changes affect your check.
              </li>
            </ul>
          </div>

          <p class="ssb-result-disclaimer">⚠️ This is an independent educational calculation using the official 2026 SSA Primary Insurance Amount formula ($1,286 / $7,749 bend points). For your official government estimate based on verified IRS wage transcripts, visit <a href="https://www.ssa.gov/myaccount/" target="_blank" rel="noopener noreferrer">ssa.gov/myaccount</a>.</p>
        </div>
      </div>
    `;
    resultsDiv.hidden = false;
  });
</script>

