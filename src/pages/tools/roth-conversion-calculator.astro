---
/**
 * roth-conversion-calculator.astro
 * Tool: Roth Conversion Calculator
 * Category: Retirement Planning
 * Primary keyword: roth conversion calculator
 * Supporting keywords: should i convert to roth, roth ira conversion calculator retirement, roth conversion irmaa impact
 *
 * URL: /tools/roth-conversion-calculator/
 * Title: Roth Conversion Calculator 2026 — See Tax & IRMAA Impact | Seniors Audit (70 chars ✓)
 * Description: Calculate your tax bill and Medicare IRMAA surcharge impact before converting a Traditional IRA to a Roth IRA. Free, no account, instant. (145 chars ✓)
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { RothConversionCalculator as RothTool } from '@components/tools/RothConversionCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const faqs = [
  {
    question: 'What is a Roth IRA conversion?',
    answer: 'A Roth IRA conversion is the process of moving pre-tax money from a Traditional IRA, 401(k), or 403(b) into a tax-free Roth IRA. The amount converted is treated as ordinary taxable income in the year of conversion, but all future growth and withdrawals in the Roth IRA are 100% tax-free for you and your heirs.',
  },
  {
    question: 'How does a Roth conversion affect Medicare IRMAA premiums?',
    answer: 'Because a Roth conversion increases your Adjusted Gross Income (AGI) on Form 1040 Line 11, it also increases your Medicare MAGI. Social Security uses MAGI from two years prior (e.g., a 2024 conversion affects 2026 premiums) to set your Part B and Part D IRMAA surcharges. Converting too much in a single year can trigger an extra $81.20 to $443.90/month in Medicare premiums.',
  },
  {
    question: 'When is a Roth conversion worth the upfront tax bill?',
    answer: 'A Roth conversion is typically worth it if: (1) You expect to be in a higher tax bracket in retirement than you are now; (2) You want to reduce future mandatory RMDs at age 73/75; (3) You have non-retirement cash available to pay the conversion tax bill; or (4) You want to leave tax-free inheritance to beneficiaries.',
  },
  {
    question: 'Can I pay the conversion tax out of the IRA funds being converted?',
    answer: 'While legally possible, paying the tax out of the converted IRA funds is a major tax mistake. If you are under 59½, funds withheld to pay taxes are subject to a 10% early withdrawal penalty. Furthermore, using IRA money to pay taxes reduces the amount that moves into the tax-free growth vehicle.',
  },
  {
    question: 'Is there an annual dollar limit on how much I can convert to a Roth IRA?',
    answer: 'No. Federal tax law puts zero limits on the total dollar amount or income level for Roth conversions. Unlike regular annual Roth IRA contributions (which have income limits and a $7,000–$8,000 annual cap), you can convert any amount from a Traditional IRA regardless of your income.',
  },
  {
    question: 'What is the 5-year rule for converted Roth IRA funds?',
    answer: 'Each converted amount has its own 5-year holding period. If you withdraw converted principal before 5 years AND before age 59½, you may owe a 10% early withdrawal penalty. Once you reach age 59½, converted principal can be withdrawn penalty-free at any time.',
  },
  {
    question: 'How can I convert to a Roth IRA without triggering an IRMAA surcharge?',
    answer: 'The key strategy is "bracket filling" — converting just enough each year to reach the top of your current tax bracket or the lower IRMAA threshold ($106,000 single / $212,000 joint in 2026) without crossing over the cliff.',
  },
];
---

<ToolLayout
  title="Roth Conversion Calculator 2026 | Seniors Audit"
  description="Calculate your tax bill and Medicare IRMAA surcharge impact before converting a Traditional IRA to a Roth IRA. Free, no account, instant."
  faqs={faqs}
>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 2 — HERO SECTION
       ═══════════════════════════════════════════════════════ -->
  <div class="roth-hero" style="margin-bottom: var(--space-8);">
    <!-- Breadcrumb -->
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/retirement/" style="color: #0A3D3A; text-decoration: underline;">Retirement Planning</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Roth Conversion Calculator</span>
    </div>

    <!-- H1 — Primary Keyword -->
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      Roth Conversion Calculator 2026: Tax &amp; IRMAA Impact
    </h1>

    <!-- Last Verified Date -->
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>

    <!-- AEO Quick Answer Block -->
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        Converting a Traditional IRA to a Roth IRA creates taxable ordinary income in the year of conversion. In 2026, if a conversion pushes your MAGI above <strong style="color: #C9933A;">$106,000 (single) or $212,000 (joint)</strong>, it triggers an extra Medicare IRMAA surcharge of $81.20 to $443.90 per month two years later.
      </p>
    </div>

    <!-- Problem Statement -->
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      Retirees considering a Roth conversion often calculate the income tax bill but forget about the "hidden tax" — triggering a higher Medicare IRMAA premium tier two years later. We built this calculator to give seniors a total cost picture (upfront tax + Medicare IRMAA impact + estimated break-even years) in seconds without needing an account.
    </p>

    <!-- Who This Tool Is For -->
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Retirees in their 60s looking to reduce future mandatory RMDs through strategic Roth conversions.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Medicare beneficiaries wanting to make sure an IRA conversion does not trigger a surprise IRMAA surcharge.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Adults doing tax bracket filling to optimize lifetime tax-free wealth transfer to heirs.
      </li>
    </ul>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 3 — THE INTERACTIVE TOOL
       ═══════════════════════════════════════════════════════ -->
  <div style="margin-bottom: var(--space-8);">
    <RothTool client:load />
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — NO SIGNUP COMPETITIVE POSITIONING
       ═══════════════════════════════════════════════════════ -->
  <NoSignupStatement />

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 4 — HOW TO USE THIS TOOL
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Calculator — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enter the conversion amount.</strong> Enter the dollar amount of pre-tax Traditional IRA or 401(k) funds you plan to convert to a Roth IRA this tax year.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enter your current MAGI.</strong> Enter your estimated Modified Adjusted Gross Income before the conversion (Form 1040 Line 11 plus Line 2a tax-exempt interest).
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Select your marginal tax bracket &amp; filing status.</strong> Choose your federal tax bracket (e.g. 12%, 22%, 24%) and filing status to compute the exact tax bill.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Review your total cost &amp; IRMAA alert.</strong> The calculator displays your federal tax owed, checks whether your new MAGI triggers an IRMAA surcharge, and estimates your break-even timeframe.
      </li>
    </ol>

    <!-- Pro Tip -->
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">
        Always pay conversion taxes using taxable cash (savings/checking accounts) rather than withholding from the IRA itself. Withholding from the IRA reduces your tax-free growth and incurs a 10% penalty if under age 59½. Check IRS conversion rules at <a href="https://www.irs.gov/retirement-plans/roth-comparison-chart" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A;">irs.gov/retirement-plans</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       EXPLANATION SECTION
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="explanation-heading">
    <h2 id="explanation-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Why Multi-Year Partial Roth Conversions Work Best
    </h2>
    <p style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
      Instead of converting a large Traditional IRA all at once in a single year — which pushes you into a high marginal tax bracket and triggers maximum IRMAA surcharges — financial planners recommend <strong>multi-year partial conversions</strong>.
    </p>
    <p style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
      By converting smaller amounts each year between retirement and age 73 (when mandatory RMDs begin), you fill up the lower 12% or 22% tax brackets without pushing your MAGI over the $106,000 single / $212,000 joint IRMAA cliff.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — REAL-LIFE SCENARIOS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Real-Life Examples — Roth Conversion Planning
    </h2>

    <!-- Scenario 1 -->
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">Donald, 64 — Partial Conversion Staying Under IRMAA</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin-bottom: 1rem;">
        Donald is single with a current MAGI of $85,000. He wants to convert $20,000 to a Roth IRA in 2026.
      </p>
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem; margin-bottom: 1rem;">
        <tbody>
          <tr style="background: #e8f4f1;">
            <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: #0D2137;">Metric</td>
            <td style="padding: 0.5rem 0.75rem; font-weight: 700; color: #0D2137;">Value</td>
          </tr>
          <tr>
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">Current MAGI</td>
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">$85,000</td>
          </tr>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">Conversion Amount</td>
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">$20,000</td>
          </tr>
          <tr>
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">New MAGI</td>
            <td style="padding: 0.5rem 0.75rem; color: #0D2137;">$105,000 (Below $106k IRMAA limit)</td>
          </tr>
        </tbody>
      </table>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Result:</strong> Donald pays 22% tax = <strong>$4,400</strong>. Because his new MAGI ($105,000) remains under the $106,000 single threshold, he pays <span style="color: #E8761A; font-weight: 700;">$0 in IRMAA surcharges</span>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 6 — COMMON PITFALLS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Common Roth Conversion Mistakes
    </h2>

    <h3 style="font-size: 1.15rem; color: #0A3D3A; margin-top: 1rem;">1. Converting Just Above an IRMAA Threshold by a Few Hundred Dollars</h3>
    <p style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
      IRMAA brackets are strict "cliff" thresholds. If a Roth conversion pushes your single MAGI to $106,001 (just $1 over the limit), you incur a full Tier 1 IRMAA surcharge of $81.20/month ($974.40/year) on Part B plus Part D surcharges.
    </p>
    <p style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
      <strong>The fix:</strong> Leave a $2,000 cushion below the IRMAA threshold when planning your conversion. Verify 2026 IRMAA brackets at <a href="https://www.medicare.gov/basics/costs/medicare-costs/part-b-costs" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A;">medicare.gov Part B costs</a>.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 7 — OFFICIAL SOURCES TABLE
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">IRS Publication 590-A — Contributions to IRAs</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">Roth IRA conversion rules, income inclusion rules, and 5-year holding period requirements</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.irs.gov/publications/p590a" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">IRS Pub 590-A</a></td>
          </tr>
          <tr style="background: #fff;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">CMS Medicare IRMAA Surcharge Brackets 2026</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">Official 2026 MAGI thresholds ($106k/$212k baseline) and surcharge tier amounts</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.medicare.gov/basics/costs/medicare-costs/part-b-costs" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">medicare.gov Part B Costs</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. We are not affiliated with, endorsed by, or connected to the IRS or CMS. All calculations use official tax code formulas and published IRMAA rates.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 8 — FAQ SECTION WITH SCHEMA
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions About Roth Conversions
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 9 — RELATED TOOLS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Retirement Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/rmd-calculator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">RMD Calculator &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Calculate mandatory Traditional IRA distributions under SECURE 2.0 rules.</p>
      </a>
      <a href="/tools/medicare-irmaa-calculator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">IRMAA Calculator (Multi-Year) &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Check full IRMAA surcharge tiers for Medicare Part B and Part D.</p>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 10 — EDUCATIONAL DISCLAIMER
       ═══════════════════════════════════════════════════════ -->
