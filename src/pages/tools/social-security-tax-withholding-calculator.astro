            <td>$0/mo ($0/yr)</td>
          </tr>
          <tr>
            <td><strong>7% Withholding</strong></td>
            <td>$105/mo ($1,260/yr)</td>
            <td>$140/mo ($1,680/yr)</td>
            <td>$175/mo ($2,100/yr)</td>
            <td>$245/mo ($2,940/yr)</td>
          </tr>
          <tr>
            <td><strong>10% Withholding</strong></td>
            <td>$150/mo ($1,800/yr)</td>
            <td>$200/mo ($2,400/yr)</td>
            <td>$250/mo ($3,000/yr)</td>
            <td>$350/mo ($4,200/yr)</td>
          </tr>
          <tr>
            <td><strong>12% Withholding</strong></td>
            <td>$180/mo ($2,160/yr)</td>
            <td>$240/mo ($2,880/yr)</td>
            <td>$300/mo ($3,600/yr)</td>
            <td>$420/mo ($5,040/yr)</td>
          </tr>
          <tr>
            <td><strong>22% Withholding</strong></td>
            <td>$330/mo ($3,960/yr)</td>
            <td>$440/mo ($5,280/yr)</td>
            <td>$550/mo ($6,600/yr)</td>
            <td>$770/mo ($9,240/yr)</td>
