---
/**
 * medigap-comparison-tool.astro
 * Tool: Medigap Plan Comparison Tool
 * Category: Medicare
 * Primary keyword: medigap plan comparison tool
 * Supporting keywords: medigap plan g vs n, medicare supplement plan comparison, medigap plan f vs g
 *
 * URL: /tools/medigap-comparison-tool/
 * Title: Medigap Plan Comparison Tool 2026 — Plan G vs N vs A | Seniors Audit (69 chars ✓)
 * Description: Compare Medicare Supplement (Medigap) Plans G, N, A, and F side-by-side. Calculate premiums, deductibles, and co-pays. Free, no account. (145 chars ✓)
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { MedigapComparisonTool as MedigapTool } from '@components/tools/MedigapComparisonTool';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const faqs = [
  {
    question: 'What is the most popular Medigap plan in 2026?',
    answer: 'Medigap Plan G is the most popular Medicare Supplement plan for new enrollees. It covers 100% of all Medicare-approved doctor, hospital, and outpatient costs after you pay the small annual Part B deductible ($240 in 2026).',
  },
  {
    question: 'What is the difference between Medigap Plan G and Plan N?',
    answer: 'Plan G covers 100% of doctor coinsurance and Part B excess charges (after the $240 Part B deductible). Plan N has ~25% lower monthly premiums than Plan G, but requires up to a $20 copay per doctor visit, a $50 ER copay, and does not cover rare Part B excess charges.',
  },
  {
    question: 'Why can newly eligible Medicare enrollees no longer buy Medigap Plan F?',
    answer: 'Under federal law (the MACRA Act of 2015), Medigap plans that cover the Part B deductible (Plan F and Plan C) cannot be sold to anyone who became eligible for Medicare on or after January 1, 2020. If you were eligible before 2020, you can keep or buy Plan F.',
  },
  {
    question: 'Are Medigap benefits standardized across different insurance companies?',
    answer: 'Yes. By federal law, a Medigap Plan G from Company A offers the exact same medical benefits as a Medigap Plan G from Company B. The only difference is the monthly premium price, customer service reputation, and rate increase history.',
  },
  {
    question: 'When is the best time to buy a Medigap policy?',
    answer: 'The best time to buy Medigap is during your 6-month Medigap Open Enrollment Period, which begins the first month you are age 65 or older AND enrolled in Medicare Part B. During this window, insurance companies cannot deny you coverage or charge higher premiums due to pre-existing health conditions.',
  },
];
---

<ToolLayout
  title="Medigap Plan Comparison Tool 2026 — Plan | Seniors Audit"
  description="Compare Medicare Supplement (Medigap) Plans G, N, A, and F side-by-side. Calculate premiums, deductibles, and co-pays. Free, no account."
  faqs={faqs}
>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 2 — HERO SECTION
       ═══════════════════════════════════════════════════════ -->
  <div class="medigap-hero" style="margin-bottom: var(--space-8);">
    <!-- Breadcrumb -->
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/medicare/" style="color: #0A3D3A; text-decoration: underline;">Medicare</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Medigap Plan Comparison Tool</span>
    </div>

    <!-- H1 — Primary Keyword -->
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      Medigap Plan Comparison Tool 2026: Plan G vs. Plan N
    </h1>

    <!-- Last Verified Date -->
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>

    <!-- AEO Quick Answer Block -->
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        <strong style="color: #C9933A;">Medigap Plan G</strong> is the gold standard for new enrollees, covering 100% of out-of-pocket medical costs after a $240/yr Part B deductible. <strong style="color: #C9933A;">Plan N</strong> offers 25% lower monthly premiums in exchange for $20 doctor visit copays. All Medigap plans are federally standardized — benefits are identical regardless of which insurance carrier sells them.
      </p>
    </div>

    <!-- Problem Statement -->
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      With 10 standardized Medigap plan letters (A, B, C, D, F, G, K, L, M, N), choosing the right Medicare Supplement policy can feel confusing. We built this tool to let seniors compare the top plans (G, N, A, F) side-by-side without entering their email address or dealing with aggressive insurance brokers.
    </p>

    <!-- Who This Tool Is For -->
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Seniors approaching age 65 choosing a Medicare Supplement policy during their Open Enrollment window.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Beneficiaries deciding between Plan G (full coverage after deductible) vs. Plan N (lower premium + copays).
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Existing Medicare enrollees evaluating their current supplement plan benefits.
      </li>
    </ul>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 3 — THE INTERACTIVE TOOL
       ═══════════════════════════════════════════════════════ -->
  <div style="margin-bottom: var(--space-8);">
    <MedigapTool client:load />
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — NO SIGNUP COMPETITIVE POSITIONING
       ═══════════════════════════════════════════════════════ -->
  <NoSignupStatement />

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 4 — HOW TO USE THIS TOOL
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Tool — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Select a Medigap plan.</strong> Choose Plan G, Plan N, Plan A, or Plan F from the dropdown menu.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enter your age.</strong> Input your age to generate an estimated average monthly premium figure.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Click "Inspect Plan Benefits &amp; Costs."</strong> Review the breakdown of covered deductibles, excess charges, and copay rules.
      </li>
    </ol>

    <!-- Pro Tip -->
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">
        Because Medigap Plan G benefits are 100% identical across all insurance carriers by federal law, shop primarily on monthly premium price and the insurer's annual rate increase history. Official Medigap guidelines are at <a href="https://www.medicare.gov/supplements-other-insurance/how-to-compare-medigap-policies" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A;">medicare.gov/supplements-other-insurance</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 7 — OFFICIAL SOURCES TABLE
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">CMS Choosing a Medigap Policy 2026 Guide</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">Official standardized Medigap benefit chart (Plans A–N), guaranteed issue rules, and MACRA Plan F restrictions</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.medicare.gov/publications/02110-medigap-guide-to-health-insurance.pdf" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">CMS Medigap Guide (PDF)</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. We are not affiliated with, endorsed by, or connected to CMS or any insurance company.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 8 — FAQ SECTION WITH SCHEMA
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions About Medigap Plans
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 9 — RELATED TOOLS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Medicare Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/medicare-advantage-comparison-tool/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Medicare Advantage Comparison Tool &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Compare Original Medicare + Medigap vs. Medicare Advantage side-by-side.</p>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 10 — EDUCATIONAL DISCLAIMER
       ═══════════════════════════════════════════════════════ -->
  <DisclaimerBlock type="calculator" />

</ToolLayout>
