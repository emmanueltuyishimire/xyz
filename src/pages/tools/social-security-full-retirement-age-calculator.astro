---
/**
 * social-security-full-retirement-age-calculator.astro
 * Full Retirement Age (FRA) Calculator (Dynamic Birthdate Input)
 * Category: Social Security
 * Primary keyword: full retirement age calculator
 * Supporting keywords: what is my full retirement age, ssa full retirement age calculator,
 *   full retirement age by birth year, fra calculator
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { FRACalculatorDynamic } from '@components/tools/FRACalculatorDynamic';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is a full retirement age calculator and how does it determine my FRA?',
    answer: 'A full retirement age calculator calculates the exact age in years and months when you become eligible to receive 100% of your unreduced Social Security primary insurance amount (PIA). It uses your exact date of birth and official Social Security Administration (SSA) birth-year formulas to pinpoint your exact FRA calendar date.',
  },
  {
    question: 'What is my full retirement age based on my birth year?',
    answer: 'What is my full retirement age? For people born between 1943 and 1954, full retirement age is 66. For people born between 1955 and 1959, FRA increases by 2 months for each birth year (e.g., 66 and 2 months for 1955, up to 66 and 10 months for 1959). For anyone born in 1960 or later, FRA is 67.',
  },
  {
    question: 'How does the ssa full retirement age calculator handle 1st-of-the-month birthdays?',
    answer: 'The ssa full retirement age calculator applies the official Social Security English rule: if you were born on the 1st day of any month, Social Security legally considers your effective birth date to be the last day of the previous month. This can make your FRA arrive one month earlier than expected.',
  },
  {
    question: 'What happens if I claim Social Security benefits before reaching my full retirement age by birth year?',
    answer: 'Claiming Social Security before your full retirement age by birth year results in a permanent reduction of your monthly check. Claiming at age 62 (the earliest age) reduces your benefit by 25% if your FRA is 66, or by 30% if your FRA is 67. The reduction is permanent for the rest of your life.',
  },
  {
    question: 'How much do my monthly benefits increase if I delay past my fra calculator date?',
    answer: 'For every year you delay claiming Social Security past your fra calculator date up to age 70, your benefit earns Delayed Retirement Credits of 8% per year (2/3 of 1% per month). If your FRA is 67 and you delay until age 70, your monthly check increases by 24% for life.',
  },
  {
    question: 'Does full retirement age affect the Social Security earnings test limit?',
    answer: 'Yes. If you work while receiving Social Security before reaching your full retirement age, SSA withholds $1 for every $2 you earn above the annual earnings limit ($23,400 in 2026). In the year you reach FRA, the limit is higher ($62,160 in 2026), and after you reach your exact FRA date, there is no earnings limit at all.',
  },
  {
    question: 'Is Full Retirement Age the same as Medicare eligibility age?',
    answer: 'No. Medicare eligibility age is 65 for almost everyone, regardless of your birth year. Full Retirement Age for Social Security is between 66 and 67. You can sign up for Medicare at age 65 even if you delay claiming Social Security until your FRA or age 70.',
  },
];

// FAQPage JSON-LD schema
const faqSchemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': f.answer },
  })),
});
---

<ToolLayout
