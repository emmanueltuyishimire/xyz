>

  <!-- ═══════════════════════════════════════════════════════
       1. HERO HEADER (Primary Keyword in H1)
       ═══════════════════════════════════════════════════════ -->
  <div class="fra-hero">
    <div class="fra-breadcrumb">
      <a href="/social-security/" class="fra-breadcrumb-link">Social Security</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="fra-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Full Retirement Age Calculator</span>
