---
/**
 * snap-eligibility-calculator-for-seniors.astro
 * Category: Senior Financial Assistance & Benefits Screeners
 * Primary topic: SNAP eligibility for seniors 60+ (income limits, medical and shelter deductions, work rules)
 *
 * Title (about 52 chars before the site suffix): SNAP Calculator for Seniors: Income Limits 2026–2027
 * Figures: USDA FNS FY2027 SNAP cost-of-living adjustments (effective October 1, 2026), 48 states and DC.
 * All worked examples are computed by src/lib/snapCalc.ts, the same code the calculator uses.
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import AdBanner from '@components/ads/AdBanner.astro';
import { SNAPEligibilityCalculator } from '@components/tools/SNAPEligibilityCalculator';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import RelatedToolButtons from '@components/tools/RelatedToolButtons.astro';
import { estimateSnap, snapGrossLimitFY2027 } from '../../lib/snapCalc';
import { snapNetLimitFY2027, snapStandardDeductionFY2027 } from '../../lib/engine';

const usd = (x: number) => '$' + Math.round(x).toLocaleString('en-US');
const usd2 = (x: number) => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Limits table (FY2027, 48 states and DC). Maximum benefits are USDA's published figures.
const maxBenefit: Record<number, number> = { 1: 306, 2: 562, 3: 808, 4: 1023 };
const limitRows = [1, 2, 3, 4].map((n) => ({
  n,
  net: snapNetLimitFY2027(n),
  gross: snapGrossLimitFY2027(n),
  max: maxBenefit[n],
  std: snapStandardDeductionFY2027(n),
}));

// Worked examples. Hypothetical households, Part B premium is the 2026 amount ($202.90).
const base = { senior: true, earned: 0 };
const agnesA = { ...base, size: 1, unearned: 1380, medicarePremiums: 202.9, otherMedical: 90, housing: 0, utilities: 160 };
const agnesB = { ...agnesA, housing: 750 };
const walterIn = { ...base, size: 2, unearned: 2100, medicarePremiums: 405.8, otherMedical: 85, housing: 1000, utilities: 220 };
const charlesA = { ...base, size: 1, unearned: 1800, medicarePremiums: 202.9, otherMedical: 0, housing: 0, utilities: 0 };
const charlesB = { ...charlesA, housing: 950, utilities: 180 };
const dolBefore = { ...base, size: 1, unearned: 1500, medicarePremiums: 242.9, otherMedical: 60, housing: 700, utilities: 150 };
const dolAfter = { ...dolBefore, medicarePremiums: 40 };

const rAgnesA = estimateSnap(agnesA);
const rAgnesB = estimateSnap(agnesB);
const rWalter = estimateSnap(walterIn);
const rWalterNoMed = estimateSnap({ ...walterIn, medicarePremiums: 0, otherMedical: 0 });
const rCharlesA = estimateSnap(charlesA);
const rCharlesB = estimateSnap(charlesB);
const rDolBefore = estimateSnap(dolBefore);
const rDolAfter = estimateSnap(dolAfter);
const dolNetGain = 202.9 - (rDolBefore.benefit - rDolAfter.benefit);

const faqs = [
  {
    question: 'What is the SNAP income limit for seniors in 2026–2027?',
    answer: 'For federal fiscal year 2027 (October 1, 2026 to September 30, 2027) in the 48 states and D.C., the net income limit is $1,330 a month for one person and $1,804 for two. Households with a member age 60 or older or receiving disability benefits only need to pass this net income test. Net income is what is left after deductions for the standard allowance, medical costs above $35, and rent and utilities.',
  },
  {
    question: 'How do I check my SNAP eligibility?',
    answer: 'Use the calculator on this page to get an estimate, then apply through your state SNAP office, which makes the actual decision. Before you start, gather your monthly income (Social Security, pension, wages), your Medicare and other medical costs, and your rent or mortgage and utility bills. Those are the numbers that decide whether you qualify and how much you receive.',
  },
  {
    question: 'How much SNAP will I get?',
    answer: 'Your benefit is the maximum for your household size minus 30% of your net income. The 2027 maximums are $306 for one person and $562 for two. A one-person household with $900 of net income would get about $36 ($306 minus $270). Households of one or two people who qualify receive at least $25 a month.',
  },
  {
    question: 'Do SNAP work requirements apply to seniors?',
    answer: 'Not to people 65 and older. Since the 2025 federal law change, the work rule (80 hours a month of work, training or volunteering, or SNAP ends after 3 months in 3 years) applies to adults 18 to 64 who are able to work and have no exemption. That now includes people 55 to 64. Exemptions include a medically certified disability that prevents work and caring for a child under 14. Ask your state office which exemption applies to you.',
  },
  {
    question: 'Does Social Security count as income for SNAP?',
    answer: 'Yes. Retirement, survivor and disability benefits count as income, and the figure used is the gross amount before Medicare premiums are taken out. The Medicare premiums come back as a medical deduction for households with a member 60 or older or disabled, so you do not lose that money in the calculation.',
  },
  {
    question: 'Is there an asset limit for SNAP for seniors?',
    answer: 'Federal rules include a resource limit that is higher for households with a member 60+ or disabled, but most states waive it through broad-based categorical eligibility. Some states keep a limit; Texas, for example, applies a $5,000 limit with vehicle exclusions, according to USDA. Your home is generally not counted. Ask your state office what applies where you live before assuming savings disqualify you.',
  },
  {
    question: 'What medical expenses can seniors deduct for SNAP?',
    answer: 'Medicare premiums (Part B, Part D, Medigap, Advantage), prescription and doctor copays, dental care and dentures, eyeglasses, hearing aids, medical supplies, and some costs of getting to medical care all count. Only the amount above $35 a month is deducted. USDA publishes a medical expenses guide that lists what states must allow.',
  },
  {
    question: 'Does SNAP vary by state?',
    answer: 'The income limits, deductions and maximum benefits are federal, but states set their own utility allowances, may use a standard medical deduction, decide whether to waive the asset test, and run the application process. That is why two seniors with the same income can receive different amounts in different states.',
  },
  {
    question: 'How long does a SNAP application take?',
    answer: 'States have up to 30 days to decide. Households with very little income and cash on hand may qualify for expedited SNAP, which can be issued within 7 days. Most applications include an interview, often by phone, and you will be asked for proof of income, identity, rent and medical costs.',
  },
  {
    question: 'Can I get SNAP if I have Medicare or Medicaid?',
    answer: 'Yes. SNAP, Medicare, Medicaid and Medicare Savings Programs are separate programs and you can receive them together. A Medicare Savings Program that pays your Part B premium lowers your medical deduction, but you keep the full premium in your pocket, which is nearly always worth more than the small drop in SNAP.',
  },
  {
    question: 'What is categorical eligibility for SNAP?',
    answer: 'Categorical eligibility means a household qualifies for SNAP because it already receives or qualifies for certain other assistance. Broad-based categorical eligibility is a state option that lets states raise the gross income limit and waive the asset test. It cannot make anyone ineligible, so you can still apply under the regular rules.',
  },
];

const relatedSnapTools = [
  { title: 'Universal Senior Benefits Screener', href: '/tools/universal-senior-benefits-screener/' },
  { title: 'Medicare Savings Estimator', href: '/tools/medicare-savings-estimator/' },
  { title: 'Extra Help Eligibility Calculator', href: '/tools/extra-help-eligibility-calculator/' },
  { title: 'Senior Discount Finder', href: '/tools/senior-discount-finder/' },
];
---

<ToolLayout
  title="SNAP Calculator for Seniors: Income Limits 2026–2027"
  description="Check SNAP eligibility for seniors 60+. 2026–2027 income limits ($1,330 net for one person), medical and rent deductions, and a free benefit estimate."
  faqs={faqs}
  schema="HowTo"
  howToSteps={[
    { name: 'Say whether your household includes someone 60 or older', text: 'Households with a member 60+ or on disability skip the gross income test and can deduct medical and shelter costs.' },
    { name: 'Enter your monthly income', text: 'Add Social Security, pensions and any wages as gross amounts before Medicare premiums are taken out.' },
    { name: 'Enter medical costs, rent and utilities', text: 'Medicare premiums and out-of-pocket medical costs above $35 a month are deducted, and so are rent and utilities above half of your remaining income.' },
    { name: 'Read your estimate and apply', text: 'The calculator shows each step and your estimated monthly benefit. Apply through your state SNAP office, which makes the final decision.' },
  ]}
>

  <div class="snp-hero">
    <div class="snp-breadcrumb">
      <a href="/tools/" class="snp-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>SNAP Eligibility Calculator for Seniors</span>
    </div>

    <h1 class="snp-h1">SNAP Eligibility Calculator for Seniors (2026–2027)</h1>
    <p class="snp-date">Uses USDA's federal fiscal year 2027 SNAP figures, in effect since October 1, 2026.</p>

    <div class="snp-aeo-block" role="note" aria-label="Quick Answer">
      <p class="snp-aeo-label">Quick Answer</p>
      <p class="snp-aeo-text">
        If anyone in your household is 60 or older, only the <strong class="snp-gold">net income test</strong> applies: <strong class="snp-gold">$1,330 a month for one person, $1,804 for two</strong>. Net income is your income minus a standard deduction, medical costs above $35 a month (Medicare premiums included), and rent and utilities above half of what is left. A one-person household can receive up to <strong class="snp-gold">$306 a month</strong>, a couple up to <strong class="snp-gold">$562</strong>.
      </p>
    </div>
  </div>

  <div class="snp-tool-block" id="calculator">
    <SNAPEligibilityCalculator client:load />
  </div>

  <AdBanner unit="728x90" device="desktop" />
  <AdBanner unit="320x50" device="mobile" />

  <RelatedToolButtons heading="Related Senior Benefit & Savings Tools" tools={relatedSnapTools} />

  <p class="snp-problem">
    Many people over 60 never apply for SNAP because they assume their Social Security check is too high or their savings are too large. The senior rules work differently from the ones for younger adults: there is no gross income test, and the costs that weigh on a fixed income, such as Medicare premiums, prescriptions, rent and utilities, reduce the income SNAP counts. A check that looks over the limit on paper often comes out under it after those deductions.
  </p>

  <NoSignupStatement />

  <!-- SECTION: income limits -->
  <section class="snp-section" aria-labelledby="limits-heading">
    <h2 id="limits-heading">SNAP Income Limits for Seniors, 2026–2027</h2>
    <p>These are the federal figures for the 48 states and D.C. for the year that began October 1, 2026. Alaska, Hawaii, Guam and the U.S. Virgin Islands have higher amounts.</p>
    <div class="snp-table-wrap">
      <table class="snp-ref-table">
        <caption class="snp-caption">SNAP limits and maximum benefits by household size, October 2026 to September 2027</caption>
        <thead>
          <tr><th scope="col">Household size</th><th scope="col">Net income limit (monthly)</th><th scope="col">Gross limit (only if no one is 60+ or disabled)</th><th scope="col">Maximum monthly benefit</th><th scope="col">Standard deduction</th></tr>
        </thead>
        <tbody>
          {limitRows.map((r, i) => (
            <tr class={i % 2 ? 'snp-row-alt' : ''}>
              <th scope="row">{r.n} {r.n === 1 ? 'person' : 'people'}</th>
              <td>{usd(r.net)}</td><td>{usd(r.gross)}</td><td>{usd(r.max)}</td><td>{usd(r.std)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><strong>How to read the table.</strong> The net limit is 100% of the federal poverty level. You compare it to your income <em>after</em> deductions, not to your Social Security check. The gross limit (130% of poverty) is a second test that households without a member 60+ or disabled must also pass. The minimum benefit for one- and two-person households is $25 a month.</p>
  </section>

  <!-- SECTION: how determined -->
  <section class="snp-section" aria-labelledby="determined-heading">
    <h2 id="determined-heading">How Is SNAP Eligibility Determined for Seniors?</h2>
    <p>Your state office follows the same order every time, and so does the calculator above. Knowing the order shows you where the money is.</p>
    <ol class="snp-steps">
      <li><strong>Count your gross income.</strong> Social Security before the Medicare premium comes out, pensions, wages, interest and other regular income. Everyone who buys and cooks food together is counted.</li>
      <li><strong>Apply the gross test only if it applies.</strong> A household with no member 60+ or disabled must be at or under the gross limit. A household with one skips this step.</li>
      <li><strong>Subtract deductions.</strong> The standard deduction ($217 for one to three people), 20% of any work income, and, for households with a member 60+ or disabled, your medical costs above $35 a month.</li>
      <li><strong>Subtract the excess shelter deduction.</strong> Add rent or mortgage and utilities. Whatever is more than half of your income after the deductions above comes off as well. For households with a member 60+ or disabled there is no cap on this deduction. For everyone else it is capped at $769 a month.</li>
      <li><strong>Compare net income to the limit and set the benefit.</strong> If net income is at or under the limit you qualify. The benefit is the maximum for your household size minus 30% of net income.</li>
    </ol>
    <div class="snp-pro-tip">
      <p class="snp-tip-label">Where seniors lose money</p>
      <p class="snp-tip-text">Rent and utilities are the deduction people leave out most often. In the examples below, adding $750 of rent takes the same woman from $34 to $171 a month. Enter your real housing cost, not zero, even if the number feels too high to count.</p>
    </div>
  </section>

  <!-- SECTION: who qualifies -->
  <section class="snp-section" aria-labelledby="who-heading">
    <h2 id="who-heading">Who Qualifies for SNAP at 60 and Older?</h2>
    <p>A household is treated as an "elderly or disabled household" when at least one member is 60 or older, or receives disability benefits such as SSDI, SSI or VA disability. That one person changes four rules for the whole household:</p>
    <ul class="snp-list">
      <li><strong>No gross income test.</strong> Only net income decides eligibility.</li>
      <li><strong>Medical deduction.</strong> Out-of-pocket medical costs above $35 a month come off your income.</li>
      <li><strong>Uncapped shelter deduction.</strong> Younger households stop at $769; yours does not.</li>
      <li><strong>A higher resource limit, and in most states none at all.</strong> The federal limit is higher for these households, and states that use broad-based categorical eligibility waive it. Some states keep a limit, for example Texas at $5,000 with vehicle exclusions, according to <a href="https://www.fns.usda.gov/snap/broad-based-categorical-eligibility" target="_blank" rel="noopener noreferrer">USDA</a>. Your home is generally not counted.</li>
    </ul>
    <p>If you live with adult children or other relatives, ask the state office whether you can apply as your own household. People who buy and prepare food separately from those they live with can generally do so, and in some cases a person 60 or older who cannot buy and prepare meals alone because of a permanent disability is counted separately even when the household shares a kitchen. Counting only your own income can be the difference between qualifying and not.</p>
  </section>

  <!-- SECTION: medical costs -->
  <section class="snp-section" aria-labelledby="medical-heading">
    <h2 id="medical-heading">What Medical Expenses Can Seniors Deduct for SNAP?</h2>
    <p>You can deduct what you pay yourself above $35 a month. The list is wider than most people expect, and Medicare premiums are the largest item for many households.</p>
    <div class="snp-table-wrap">
      <table class="snp-ref-table">
        <caption class="snp-caption">Common deductible medical costs and where to find the amount</caption>
        <thead><tr><th scope="col">Cost</th><th scope="col">Where to find the amount</th></tr></thead>
        <tbody>
          <tr><td>Medicare Part B premium ($202.90 a month in 2026)</td><td>Your Social Security benefit statement shows what is withheld</td></tr>
          <tr class="snp-row-alt"><td>Part D, Medigap or Medicare Advantage premiums</td><td>Plan statements or bank withdrawals</td></tr>
          <tr><td>Prescription and doctor copays, deductibles</td><td>Pharmacy printout, <em>Medicare Summary Notice</em></td></tr>
          <tr class="snp-row-alt"><td>Dentures, dental work, eyeglasses, hearing aids</td><td>Provider bills or receipts, divided across the months you pay</td></tr>
          <tr><td>Medical supplies and equipment</td><td>Receipts</td></tr>
          <tr class="snp-row-alt"><td>Travel to medical care and home health costs</td><td>Mileage log, bills</td></tr>
        </tbody>
      </table>
    </div>
    <p>Do not include costs someone else pays or insurance reimburses. USDA's <a href="https://www.fns.usda.gov/snap/medical-expenses-guide" target="_blank" rel="noopener noreferrer">medical expenses guide</a> lists what states must allow, and some states offer a standard medical deduction so you do not have to document every bill. To see your Part B and Part D costs for the year, use the <a href="/tools/medicare-premium-calculator/">Medicare premium calculator</a>.</p>
  </section>

  <!-- SECTION: work requirements -->
  <section class="snp-section" aria-labelledby="work-heading">
    <h2 id="work-heading">Do SNAP Work Requirements Apply to Seniors?</h2>
    <p>This changed recently, and it is the question that now brings many people to this topic. The time-limited work rule used to stop at age 54. A 2025 federal law raised the upper age to 64. For adults 18 to 64 who are able to work and have no exemption, SNAP is limited to 3 months in any 3-year period unless they work, train or volunteer at least 80 hours a month.</p>
    <ul class="snp-list">
      <li><strong>Age 65 and older:</strong> exempt from the work rule. You still must meet the income rules.</li>
      <li><strong>Ages 55 to 64:</strong> now covered, unless you have an exemption.</li>
      <li><strong>Exemptions include:</strong> a medically certified condition that prevents work, pregnancy, and living with a child under 14. Veterans, people experiencing homelessness and former foster youth were exempt before and are no longer exempt automatically.</li>
    </ul>
    <p>Being in a household with someone 60 or older still gives you the senior income rules, but it does not by itself exempt a 60 to 64 year old from the work rule. If you receive a letter about work hours, call the number on it before the deadline and ask about exemptions and what proof is accepted. USDA explains the changes in its <a href="https://www.fns.usda.gov/snap/obbb-abawd-exemptions-implementation" target="_blank" rel="noopener noreferrer">implementation guidance</a>, and ElderLawAnswers has a plain-language summary of <a href="https://www.elderlawanswers.com/new-snap-work-requirements-will-now-affect-more-older-adults-21428" target="_blank" rel="noopener noreferrer">how it affects older adults</a>.</p>
  </section>

  <!-- SECTION: examples -->
  <section class="snp-section" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading">Examples: How Much SNAP Would a Senior Get?</h2>
    <p class="snp-hypo">These are hypothetical households. Every figure below was produced by the same formula as the calculator, using the 2026 Part B premium of $202.90.</p>

    <div class="snp-scenario-card">
      <div class="snp-scenario-header">
        <span class="snp-tag">Example 1</span>
        <strong class="snp-scenario-name">Agnes, 74, lives alone: the same income with and without rent</strong>
      </div>
      <p class="snp-scenario-desc">Agnes receives $1,380 a month in Social Security. She pays $202.90 for Part B and about $90 for prescriptions, plus $160 for utilities. First she owns her home outright; then the same facts with $750 a month in rent.</p>
      <div class="snp-table-wrap">
        <table class="snp-scenario-table">
          <thead><tr><th scope="col">Step</th><th scope="col">Owns her home</th><th scope="col">Pays $750 rent</th></tr></thead>
          <tbody>
            <tr><td>Income counted</td><td>{usd2(rAgnesA.gross)}</td><td>{usd2(rAgnesB.gross)}</td></tr>
            <tr class="snp-row-alt"><td>Standard deduction</td><td>− {usd2(rAgnesA.standardDeduction)}</td><td>− {usd2(rAgnesB.standardDeduction)}</td></tr>
            <tr><td>Medical costs {usd2(rAgnesA.medicalCosts)} less $35</td><td>− {usd2(rAgnesA.medicalDeduction)}</td><td>− {usd2(rAgnesB.medicalDeduction)}</td></tr>
            <tr class="snp-row-alt"><td>Excess shelter (housing + utilities above half of income)</td><td>− {usd2(rAgnesA.excessShelter)}</td><td>− {usd2(rAgnesB.excessShelter)}</td></tr>
            <tr><td><strong>Net income (limit {usd(rAgnesA.netLimit)})</strong></td><td><strong>{usd2(rAgnesA.netIncome)}</strong></td><td><strong>{usd2(rAgnesB.netIncome)}</strong></td></tr>
            <tr class="snp-row-alt"><td><strong>Estimated monthly benefit</strong></td><td class="snp-yes">{usd(rAgnesA.benefit)}</td><td class="snp-yes">{usd(rAgnesB.benefit)}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="snp-result-block">
        <span class="snp-result-highlight">Rent moves her from {usd(rAgnesA.benefit)} to {usd(rAgnesB.benefit)} a month</span>
        Without rent, her $160 of utilities is below half of her remaining income, so there is no shelter deduction. With $750 of rent, the shelter deduction is {usd(rAgnesB.excessShelter)}. That is {usd((rAgnesB.benefit - rAgnesA.benefit) * 12)} more a year.
      </div>
    </div>

    <div class="snp-scenario-card">
      <div class="snp-scenario-header">
        <span class="snp-tag">Example 2</span>
        <strong class="snp-scenario-name">Walter and Edna, 70 and 68: what their medical costs are worth</strong>
      </div>
      <p class="snp-scenario-desc">Together they receive $2,100 a month. They pay two Part B premiums ($405.80) and $85 for Walter's diabetes medicine, plus $1,000 rent and $220 utilities.</p>
      <div class="snp-result-block">
        <span class="snp-result-highlight">Estimated benefit: {usd(rWalter.benefit)} a month, net income {usd2(rWalter.netIncome)}</span>
        Medical costs bring their income after deductions down to {usd2(rWalter.incomeAfterDeductions)}, and the shelter deduction of {usd2(rWalter.excessShelter)} takes net income to {usd2(rWalter.netIncome)}, well under the {usd(rWalter.netLimit)} couple limit. If they had left out their medical costs, the estimate would be only {usd(rWalterNoMed.benefit)}. The medical deduction is worth about {usd(rWalter.medicalDeductionValue)} a month to them, so they should bring every premium statement and receipt to the interview.
      </div>
    </div>

    <div class="snp-scenario-card">
      <div class="snp-scenario-header">
        <span class="snp-tag">Example 3</span>
        <strong class="snp-scenario-name">Charles, 66: denied at first, approved after counting rent</strong>
      </div>
      <p class="snp-scenario-desc">Charles receives $1,800 a month and pays $202.90 for Part B. His first estimate left out housing.</p>
      <div class="snp-table-wrap">
        <table class="snp-scenario-table">
          <thead><tr><th scope="col">Step</th><th scope="col">Housing left out</th><th scope="col">$950 rent + $180 utilities</th></tr></thead>
          <tbody>
            <tr><td>Income after standard and medical deductions</td><td>{usd2(rCharlesA.incomeAfterDeductions)}</td><td>{usd2(rCharlesB.incomeAfterDeductions)}</td></tr>
            <tr class="snp-row-alt"><td>Shelter deduction</td><td>− {usd2(rCharlesA.excessShelter)}</td><td>− {usd2(rCharlesB.excessShelter)}</td></tr>
            <tr><td><strong>Net income (limit {usd(rCharlesA.netLimit)})</strong></td><td><strong>{usd2(rCharlesA.netIncome)}</strong></td><td><strong>{usd2(rCharlesB.netIncome)}</strong></td></tr>
            <tr class="snp-row-alt"><td><strong>Result</strong></td><td class="snp-no">Over the limit</td><td class="snp-yes">Qualifies, {usd(rCharlesB.benefit)} a month</td></tr>
          </tbody>
        </table>
      </div>
      <div class="snp-result-block">
        <span class="snp-result-highlight">A $25 benefit is small, but it can matter</span>
        Receiving SNAP can also qualify you for other help, such as the federal Lifeline phone and internet discount and some state and local programs. Ask your state office what a minimum benefit opens up. The <a href="/tools/universal-senior-benefits-screener/">Universal Senior Benefits Screener</a> checks several programs together.
      </div>
    </div>

    <div class="snp-scenario-card">
      <div class="snp-scenario-header">
        <span class="snp-tag">Example 4</span>
        <strong class="snp-scenario-name">Dolores, 72: what happens to SNAP when a Medicare Savings Program pays Part B</strong>
      </div>
      <p class="snp-scenario-desc">Dolores receives $1,500 a month, pays $700 rent and $150 utilities, and has $242.90 in monthly Medicare premiums ($202.90 Part B and $40 Part D) plus $60 in other medical costs. If she is approved for a <a href="/medicare/medicare-savings-programs/">Medicare Savings Program</a>, the state pays her Part B premium.</p>
      <div class="snp-result-block">
        <span class="snp-result-highlight">SNAP drops from {usd(rDolBefore.benefit)} to {usd(rDolAfter.benefit)}, but she is still about {usd(dolNetGain)} a month better off</span>
        She keeps the $202.90 that used to come out of her Social Security and loses {usd(rDolBefore.benefit - rDolAfter.benefit)} of SNAP, because a smaller premium means a smaller medical deduction. Applying for a savings program is nearly always worth it even when it lowers SNAP. Check yours with the <a href="/tools/medicare-savings-estimator/">Medicare Savings Estimator</a>.
      </div>
    </div>

    <p class="snp-disclaimer">Examples use the 48-state figures. Your state's utility allowance, standard medical deduction and other options change the result, and only your state office can determine eligibility.</p>
  </section>

  <!-- SECTION: by state -->
  <section class="snp-section" aria-labelledby="state-heading">
    <h2 id="state-heading">SNAP Eligibility by State: What Changes Where You Live</h2>
    <p>Whether you are in Texas, Florida, New York, California or Pennsylvania, the income limits, deductions and benefit formula above come from federal law. States control the following, which is why neighbors can see different results:</p>
    <ul class="snp-list">
      <li><strong>Utility allowance.</strong> Most states give a standard amount instead of counting your actual bills, often higher than what a low-use household really pays. It can raise your shelter deduction.</li>
      <li><strong>Medical deduction method.</strong> Some states let you claim a fixed amount instead of documenting each bill.</li>
      <li><strong>Asset test.</strong> Many states waive it through broad-based categorical eligibility. Some keep one, as USDA lists for <a href="https://www.fns.usda.gov/snap/broad-based-categorical-eligibility" target="_blank" rel="noopener noreferrer">states such as Texas</a>.</li>
      <li><strong>How to apply, the program name, and the agency.</strong> SNAP goes by other names in some states, such as CalFresh in California. Use USDA's <a href="https://www.fns.usda.gov/snap/state-directory" target="_blank" rel="noopener noreferrer">state directory</a> to reach your office, or call 211.</li>
    </ul>
    <p>The calculator takes your state because the final application and amounts are state decisions, and it points you to the right office.</p>
  </section>

  <!-- SECTION: immigration -->
  <section class="snp-section" aria-labelledby="immigration-heading">
    <h2 id="immigration-heading">SNAP Eligibility and Immigration Status: What Changed</h2>
    <p>The 2025 law narrowed which noncitizens can receive SNAP. According to a <a href="https://www.nycfoodpolicy.org/snap-new-rules-2025/" target="_blank" rel="noopener noreferrer">summary from the NYC Food Policy Center</a>, refugees and asylum seekers lost eligibility, along with some humanitarian parolees and Temporary Protected Status holders, while lawful permanent residents generally keep it, usually after a five-year wait unless they are disabled, blind, under 18 or have a military connection.</p>
    <p>Rules differ by immigration category and by household member, and a family can include members with different status. Citizens in a mixed household can still apply for themselves. Your SNAP office or a legal aid organization can tell you what applies to your situation. Household members who are not applying for benefits generally do not have to give their immigration status.</p>
  </section>

  <!-- SECTION: apply -->
  <section class="snp-section" aria-labelledby="apply-heading">
    <h2 id="apply-heading">How to Apply for SNAP: What to Bring and How Long It Takes</h2>
    <p>The calculator tells you whether it is worth applying. The application itself is with your state, online, by mail or in person. You can file with only your name, address and signature to start the clock, then finish the rest at your interview.</p>
    <div class="snp-docs">
      <p class="snp-docs-title">Have these ready for the interview</p>
      <ul class="snp-list">
        <li>Photo ID and Social Security numbers for everyone applying</li>
        <li>Your Social Security award letter and pension statements</li>
        <li>Your lease or mortgage statement, property tax and insurance bills</li>
        <li>Recent utility bills (heating, cooling, electric, water, phone)</li>
        <li>Medicare card, premium statements, pharmacy printouts and medical receipts</li>
        <li>Bank statements, if your state asks about savings</li>
      </ul>
    </div>
    <p>States have up to 30 days to decide. If your household has almost no income and cash, ask for expedited processing, which can bring benefits within 7 days. If you are denied, you can ask for a fair hearing, and many senior legal aid programs help with that at no cost. Approval usually comes with a recertification date, so mark it to avoid a gap.</p>
  </section>

  <!-- SECTION: mistakes -->
  <section class="snp-section" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading">Common SNAP Mistakes for Seniors</h2>

    <h3>Comparing Your Social Security Check to the Limit</h3>
    <p>The $1,330 limit applies to income <em>after</em> deductions. A check of $1,700 or more can still qualify once the standard deduction, medical costs and housing come off. Compare the result of the calculation, not the check.</p>

    <h3>Leaving Out Rent, Utilities or Medicare Premiums</h3>
    <p>These are the three deductions that change results most, and a caseworker will not add them unless you report them with proof. Bring your premium statement and your lease or mortgage bill.</p>

    <h3>Assuming Savings Disqualify You</h3>
    <p>In most states there is no asset test for households that qualify through broad-based categorical eligibility, and the federal limit is higher for households with a member 60+ or disabled. Check your state before you rule yourself out.</p>

    <h3>Not Applying Because the Benefit Seems Small</h3>
    <p>A small benefit can still be worth the application. It is real money on an EBT card, and in many states even a minimum benefit keeps you connected to other help. You can also reapply when your costs change, for example after a rent increase or a new prescription.</p>

    <h3>Missing the New Work Rule at 60 to 64</h3>
    <p>If you are 60 to 64 and not disabled, read the work requirement section above before you apply or renew, and ask about exemptions so you do not lose benefits to a missed form.</p>
  </section>

  <!-- SECTION: medicare link -->
  <section class="snp-section" aria-labelledby="medicare-heading">
    <h2 id="medicare-heading">How Medicare Costs and SNAP Work Together</h2>
    <p>For people on Medicare, health costs are the lever that moves a SNAP estimate. Three things to know:</p>
    <ul class="snp-list">
      <li><strong>Your premiums count.</strong> What is withheld from your Social Security for Part B, plus Part D and supplement premiums, is a medical deduction for 60+ households. See the <a href="/tools/medicare-premium-calculator/">Medicare premium calculator</a> for your total.</li>
      <li><strong>Help that lowers costs is still a win.</strong> <a href="/tools/extra-help-eligibility-calculator/">Extra Help</a> lowers drug copays and the <a href="/medicare/medicare-savings-programs/">Medicare Savings Programs</a> pay premiums. Each shrinks your medical deduction a little, but you keep far more cash than SNAP takes back, as Dolores' example shows. Once you are on Part D, the <a href="/tools/medicare-donut-hole-calculator/">Part D out-of-pocket cap calculator</a> shows when your drug spending stops for the year.</li>
      <li><strong>Medicaid can change the picture.</strong> If you are weighing the two programs, the <a href="/tools/medicare-vs-medicaid-calculator/">Medicare vs Medicaid calculator</a> compares what each covers and costs.</li>
    </ul>
    <p>Energy help matters too. The <a href="/tools/liheap-eligibility-checker/">LIHEAP checker</a> shows whether you may get help with heating or cooling bills. Households with a member 60+ or disabled may keep an automatic heating and cooling utility allowance when they receive LIHEAP, which can lift the shelter deduction, so mention it to your caseworker. Internet bills, however, no longer count as a utility cost for SNAP.</p>
  </section>

  <!-- SECTION: sources -->
  <section class="snp-section" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Official Sources for These Figures and Rules</h2>
    <div class="snp-table-wrap">
      <table class="snp-sources-table">
        <thead><tr><th scope="col">Source</th><th scope="col">What it supports on this page</th></tr></thead>
