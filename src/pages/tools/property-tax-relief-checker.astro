  .ptc-date { font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem; }
  .ptc-aeo-block { background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0; }
