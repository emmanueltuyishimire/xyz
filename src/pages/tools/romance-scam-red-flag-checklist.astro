  .rsc-tip-label { font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0; }
  .rsc-tip-text { font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6; }
  .rsc-table-section { margin-top: var(--space-8); }
  .rsc-table-wrap { overflow-x: auto; margin-top: var(--space-4); }
  .rsc-ref-table, .rsc-scenario-table, .rsc-sources-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .rsc-ref-table th, .rsc-scenario-table th, .rsc-sources-table th { background: #0A3D3A; color: #fff; padding: 0.6rem 0.75rem; text-align: left; font-weight: 700; }
  .rsc-ref-table td, .rsc-scenario-table td, .rsc-sources-table td { padding: 0.6rem 0.75rem; color: #0D2137; border-bottom: 1px solid #DDE3EA; line-height: 1.5; vertical-align: top; }
  .rsc-sources-table a { color: #0A3D3A; text-decoration: underline; }
  .rsc-row-alt { background: #f6f8fa; }
  .rsc-yes { color: #0A6B3A; font-weight: 700; }
  .rsc-scenario-card { background: #fff; border: 1px solid #DDE3EA; border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-6); }
  .rsc-scenario-header { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); flex-wrap: wrap; }
  .rsc-tag { background: #0A3D3A; color: #fff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.2rem 0.6rem; border-radius: 9999px; }
  .rsc-scenario-name { font-size: 1.05rem; color: #0D2137; }
  .rsc-scenario-desc { font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: var(--space-4); }
