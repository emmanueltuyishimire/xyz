---
import ToolLayout from '@layouts/ToolLayout.astro';
import { RomanceScamChecklist } from '@components/tools/RomanceScamChecklist';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const faqs = [
  { question: 'How do romance scams typically start?', answer: 'Romance scams usually begin on dating sites, social media platforms like Facebook or Instagram, or even through unexpected text messages or word games. The person may seem incredibly interested in you very quickly and share detailed, compelling stories about their life to build trust.' },
  { question: 'Is it true that romance scammers target older adults more often?', answer: 'Yes. The FTC reports that older adults lose more money to romance scams than any other age group. Scammers specifically target older adults who are widowed, divorced, or isolated because they know they may have savings and may be looking for companionship.' },
  { question: 'The person I met online always has a reason they can\'t video call. Is that a red flag?', answer: 'Yes, this is one of the most common warning signs. Scammers will use excuses like bad internet connections, broken cameras, or being in a location where video calls aren\'t allowed. This is because they are not the person in the photos they shared.' },
  { question: 'The person says they love me but we\'ve never met. Is that normal?', answer: 'Professing love very quickly before meeting in person is a major red flag in romance scams. Scammers use "love bombing" — overwhelming you with affection, compliments, and promises for the future — to manipulate your emotions and make you more willing to help them later.' },
  { question: 'What should I do if I\'ve already sent money to someone I met online?', answer: 'Stop communicating with the person immediately. Do not send any more money. Contact your bank or the company you used to send the funds right away to see if it can be stopped. Then report the scam to the FTC at reportfraud.ftc.gov and to the FBI at ic3.gov.' },
  { question: 'Why do romance scammers claim to be on oil rigs, in the military, or overseas?', answer: 'Scammers use these professions because they provide a built-in excuse for why they cannot meet you in person or video call. These fabricated roles also create natural situations where they might suddenly need emergency money for medical bills, travel, or equipment.' },
  { question: 'Can I check if someone\'s photo is stolen from another person online?', answer: 'Yes, you can do a reverse image search. Save the photo to your device, then go to images.google.com and upload the photo to search for it. If the image appears in other places under different names, or belongs to a model or military official, it is a scam.' },
  { question: 'How do I report a romance scam?', answer: 'Report romance scams to the Federal Trade Commission at reportfraud.ftc.gov and the FBI\'s Internet Crime Complaint Center at ic3.gov. You should also report the fake profile to the website or app where you met them.' }
];
---

<ToolLayout
  title="Romance Scam Red-Flag Checklist — Free, P | Seniors Audit"
  description="Free romance scam red-flag checklist. Private, judgment-free, instant results. Check 8 warning signs before sharing personal or financial information. No account needed."
  faqs={faqs}
>
  <!-- HERO SECTION -->
  <div style="margin-bottom: var(--space-8);">
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools & Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Romance Scam Red-Flag Checklist</span>
    </div>
    
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      Romance Scam Red-Flag Checklist — Free, Private, No Judgment
    </h1>
    
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>
    
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        Common romance scam warning signs include: the person professes love very quickly, claims to be overseas or on an oil rig, always has a reason they cannot video call, and eventually asks for money, gift cards, or help with a wire transfer. The FTC reports that older adults lose more money to romance scams than any other age group. You are right to check.
      </p>
    </div>
    
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      Online romance and social-media scams target older adults disproportionately, particularly those who are widowed or recently divorced. The emotional investment involved makes it harder to see warning signs clearly, and the shame attached to being targeted by this specific scam often stops people from seeking help or reporting what happened. This checklist is private, judgment-free, and takes about two minutes to complete.
    </p>
    
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Seniors who met someone online or through social media and want a private, honest check of the situation.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Adults who have been messaging with someone they have never met in person, especially if money has come up in the conversation.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Family members who are concerned about a loved one's online relationship.
      </li>
    </ul>
  </div>

  <!-- THE INTERACTIVE TOOL -->
  <div style="margin-bottom: var(--space-8);">
    <RomanceScamChecklist client:load />
  </div>

  <NoSignupStatement />

  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Tool — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li id="step-1" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Reflect honestly.</strong> Read each question carefully and answer based on what has actually happened — not what you hope or expect.</li>
      <li id="step-2" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Complete the checklist.</strong> Check the box next to each item that applies to your situation.</li>
      <li id="step-3" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Review the results.</strong> Review your results and the plain-language explanation of each flagged item.</li>
      <li id="step-4" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Take action if needed.</strong> If money has already changed hands, follow the action steps shown.</li>
    </ol>
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">Romance scammers often try to quickly move the conversation off the dating site or social media platform to private messaging apps like WhatsApp. This helps them avoid detection by the platform's security.</p>
    </div>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Real-Life Examples — How This Works in Practice
    </h2>
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">Carol, 68 — Met Someone on Facebook</h3>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
        Carol, who was recently widowed, connected with "David" after he liked her profile picture on Facebook. David claimed to be a civil engineer working overseas. After a month of intense daily messaging, he asked Carol to send him a $500 gift card so he could buy internet access to keep talking to her.
      </p>
      <p style="font-size: 1rem; color: #0A3D3A; font-weight: 700; margin-bottom: 0.5rem;">Action Taken:</p>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0;">
        Carol noticed several red flags: the overseas job, the refusal to video chat, and the request for a gift card. She stopped communicating and reported the profile to Facebook, protecting her savings.
      </p>
    </div>
    
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">Walter, 72 — Connected on a Senior App</h3>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
        Walter, a retired teacher, met "Sofia" on a community app for seniors. She lived in a different state and sent beautiful photos. When they were supposed to meet, she had a sudden medical emergency and asked Walter for a $2,000 wire transfer to cover hospital bills.
      </p>
      <p style="font-size: 1rem; color: #0A3D3A; font-weight: 700; margin-bottom: 0.5rem;">Action Taken:</p>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0;">
        Walter used this checklist and realized that sudden emergencies and wire transfer requests are textbook warning signs. He spoke with a SHIP counselor who confirmed his suspicions, and Walter did not send the money.
      </p>
    </div>
    <p style="font-size: 0.825rem; color: #4B5A6E; margin-top: 0.75rem; line-height: 1.6;">
      These are representative examples. Individual results vary. Always verify with official agencies before making decisions.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Common Mistakes and How to Avoid Them
    </h2>
    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Waiting to Tell Family</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      It makes sense to want to keep a new relationship private, but isolation makes it harder to see warning signs. The fix is to mention the relationship to a trusted family member early on, and let them know if the person asks for money.
    </p>
    
    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Believing the Excuses About Video Calls</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      When someone you care about has a plausible excuse for why they cannot meet or video call, it is natural to believe them. The fix is to insist on a live video call. If they consistently refuse or have technical issues, it is a significant warning sign.
    </p>

    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Sending a "Small" Amount for an Emergency</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      Sending a small amount of money to help someone in an emergency can feel like an act of love. However, in scams, this is often a test to see if you will pay. The fix is to never send money, gift cards, or crypto to someone you have only met online, no matter the reason.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FTC Romance Scam Guidance</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #4B5A6E;">Official FTC data and warning signs</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://consumer.ftc.gov/articles/romance-scams" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">consumer.ftc.gov</a></td>
          </tr>
          <tr style="background: #ffffff;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FBI Internet Crime Complaint Center</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #4B5A6E;">Reporting online fraud including romance scams</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://www.ic3.gov" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">ic3.gov</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. Not affiliated with any government agency, insurance company, or financial services firm. We do not receive payment for referrals.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/gift-card-wire-transfer-scam-checklist/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Gift Card & Wire Transfer Scam Checklist →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Find out instantly if a payment request is a known scam method.</p>
      </a>
      <a href="/tools/scam-message-call-decoder/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Scam Message/Call Decoder →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Analyze texts, emails, and calls to see if they match known scam patterns.</p>
      </a>
    </div>
  </section>

  <DisclaimerBlock type="calculator" />
</ToolLayout>
