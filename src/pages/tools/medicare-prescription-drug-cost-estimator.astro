  .pde-disclaimer p { margin: 0 0 8px; }
  .pde-disclaimer p:last-child { margin: 0; }
  .pde-disclaimer a { color: var(--gold); }
</style>

<script is:inline>
  var PART_D_BASE_PREM = 38.99;
  var PART_D_ANNUAL_PREM = Math.round(PART_D_BASE_PREM * 12); // $468/yr
  var PART_D_CAP = 2100; // 2026 statutory cap

  var TIER_PROXIES = {
    none:     { min: 0,   max: 0 },
    low:      { min: 200, max: 500 },
    moderate: { min: 800, max: 1500 },
    high:     { min: 2100, max: 2100 }
  };

  function $id(id) { return document.getElementById(id); }
  function getRadioVal(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }
  function clearErrors() {
    document.querySelectorAll('.pde-err').forEach(function(e) {
      e.textContent = ''; e.style.display = 'none';
    });
  }
  function showError(id, msg) {
    var el = $id(id);
    if (el) { el.textContent = msg; el.style.display = 'block'; }
  }
  function fmtDollar(n) { return '$' + Math.round(n).toLocaleString('en-US'); }

  function calculateDrugEstimate() {
    clearErrors();
    var countVal = getRadioVal('pde-count');
    var specialtyVal = getRadioVal('pde-specialty');
    var pharmacyVal = getRadioVal('pde-pharmacy');

    var valid = true;
    if (!countVal) {
      showError('pde-count-err', 'Please select how many regular prescriptions you take.');
      valid = false;
    }
    if (!specialtyVal) {
      showError('pde-specialty-err', 'Please indicate whether you take brand-name or specialty medications.');
      valid = false;
    }
    if (!pharmacyVal) {
      showError('pde-pharmacy-err', 'Please select your preferred pharmacy channel.');
      valid = false;
    }
    if (!valid) return;

    var proxy = TIER_PROXIES[countVal] || TIER_PROXIES.low;
    var copayMin = proxy.min;
    var copayMax = proxy.max;

    // If specialty is yes, automatically push to $2,100 cap if they take regular drugs
    if (specialtyVal === 'yes' && countVal !== 'none') {
      copayMin = Math.max(copayMin, 1800);
      copayMax = PART_D_CAP;
    }

    // Pharmacy adjustments
    if (pharmacyVal === 'standard' && copayMax < PART_D_CAP && countVal !== 'none') {
      copayMin = Math.round(copayMin * 1.25);
      copayMax = Math.min(PART_D_CAP, Math.round(copayMax * 1.25));
    } else if (pharmacyVal === 'mail' && countVal !== 'none') {
      copayMin = Math.round(copayMin * 0.85);
      copayMax = Math.round(copayMax * 0.85);
    }

    var copayDisplay = (copayMin === copayMax) ? fmtDollar(copayMin) : fmtDollar(copayMin) + ' – ' + fmtDollar(copayMax);
    var totalMin = copayMin + PART_D_ANNUAL_PREM;
    var totalMax = copayMax + PART_D_ANNUAL_PREM;
    var totalDisplay = (totalMin === totalMax) ? fmtDollar(totalMin) : fmtDollar(totalMin) + ' – ' + fmtDollar(totalMax);

    $id('pde-res-copay').textContent = copayDisplay;
    $id('pde-res-prem').textContent = '~' + fmtDollar(PART_D_BASE_PREM) + '/mo';
    $id('pde-res-total').textContent = totalDisplay;

    var resEl = $id('pde-results');
    if (resEl) {
      resEl.style.display = 'block';
      resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function resetDrugTool() {
    var form = $id('pde-form');
    if (form) form.reset();
    var res = $id('pde-results');
    if (res) res.style.display = 'none';
    clearErrors();
    var tool = $id('pde-tool');
    if (tool) tool.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var calcBtn = $id('pde-calc-btn');
    var resetBtn = $id('pde-reset-btn');
    if (calcBtn)  calcBtn.addEventListener('click', calculateDrugEstimate);
    if (resetBtn) resetBtn.addEventListener('click', resetDrugTool);
  });
</script>
