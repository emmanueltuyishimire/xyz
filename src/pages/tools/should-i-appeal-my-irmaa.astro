    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Medicare Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/medicare-irmaa-calculator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">IRMAA Calculator (Multi-Year) &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Calculate your exact Part B and Part D IRMAA surcharges across all income tiers.</p>
      </a>
      <a href="/tools/magi-for-medicare-calculator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">MAGI for Medicare Calculator &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Calculate your Modified Adjusted Gross Income to see where your tax return falls relative to IRMAA thresholds.</p>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 10 — EDUCATIONAL DISCLAIMER
       ═══════════════════════════════════════════════════════ -->
  <DisclaimerBlock type="calculator" />

</ToolLayout>
