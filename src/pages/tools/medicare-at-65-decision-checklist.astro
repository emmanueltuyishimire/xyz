<script is:inline>
  var MONTH_NAMES = [
    'January','February','March','April','May','June',
    'July','August','September','October','November','December'
  ];

  function $id(id) { return document.getElementById(id); }
  function getRadio(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }
  function clearErrors() {
    document.querySelectorAll('.m65-err').forEach(function(e) {
      e.textContent = '';
      e.style.display = 'none';
    });
  }
  function showError(id, msg) {
    var el = $id(id);
    if (el) { el.textContent = msg; el.style.display = 'block'; }
  }

  function formatMonthYear(m, y) {
    while (m < 0) { m += 12; y--; }
    while (m > 11) { m -= 12; y++; }
    return MONTH_NAMES[m] + ' ' + y;
  }

  function calculateIEP() {
    clearErrors();
    var mVal = parseInt(($id('m65-month') || {}).value);
    var dVal = parseInt(($id('m65-day')   || {}).value);
    var yVal = parseInt(($id('m65-year')  || {}).value);

    var ssStatus  = getRadio('m65-ss');
    var empStatus = getRadio('m65-emp');
    var hsaStatus = getRadio('m65-hsa');

    var valid = true;
    if (!mVal || isNaN(mVal)) {
      showError('m65-date-err', 'Please select your birth month.');
      valid = false;
    }
    if (!yVal || isNaN(yVal) || yVal < 1930 || yVal > 2040) {
      showError('m65-date-err', 'Please enter a valid 4-digit birth year.');
      valid = false;
    }
    if (!ssStatus) {
      showError('m65-ss-err', 'Please indicate whether you are collecting Social Security.');
      valid = false;
    }
    if (!empStatus) {
      showError('m65-emp-err', 'Please indicate your employer coverage status.');
      valid = false;
    }
    if (!hsaStatus) {
      showError('m65-hsa-err', 'Please indicate your HSA contribution status.');
      valid = false;
    }
    if (!valid) return;

    var bMonthIndex = mVal - 1;
    var isFirstDay = (dVal === 1);

    // If born on the 1st of the month, Medicare considers your turning-65 month to be the prior month
    var effBirthMonthIndex = isFirstDay ? bMonthIndex - 1 : bMonthIndex;
    var effBirthYear = yVal;
    if (effBirthMonthIndex < 0) {
      effBirthMonthIndex = 11;
      effBirthYear--;
    }

    var startMonth = effBirthMonthIndex - 3;
    var startYear = effBirthYear;
    var endMonth = effBirthMonthIndex + 3;
    var endYear = effBirthYear;

    $id('m65-res-start').textContent = formatMonthYear(startMonth, startYear);
    $id('m65-res-bday').textContent  = formatMonthYear(effBirthMonthIndex, effBirthYear);
    $id('m65-res-end').textContent    = formatMonthYear(endMonth, endYear);

    $id('m65-first-day-note').style.display = isFirstDay ? 'block' : 'none';

    // Status Callout Box
    var calloutEl = $id('m65-status-callout');
    if (empStatus === 'yes_large') {
      calloutEl.className = 'm65-status-callout m65-status-delay';
      calloutEl.innerHTML = '<strong>🛡️ Active Large-Employer Coverage Detected (20+ Staff)</strong>You qualify for a Special Enrollment Period (SEP) to delay Medicare Part B safely without penalties until your employment or coverage ends. You still have the option to enroll in Part A at 65 if you do not contribute to an HSA.';
    } else if (ssStatus === 'yes') {
      calloutEl.className = 'm65-status-callout m65-status-auto';
      calloutEl.innerHTML = '<strong>✅ Automatic Enrollment Active</strong>Because you already collect Social Security, CMS automatically enrolls you in Medicare Part A & Part B. Your Medicare card will be mailed to you ~3 months before your birthday month. No separate application needed unless you choose to decline Part B.';
    } else {
      calloutEl.className = 'm65-status-callout m65-status-manual';
      calloutEl.innerHTML = '<strong>⚠️ Manual Online Application Required</strong>Because you are not yet drawing Social Security and do not have large-group active employer coverage, you MUST manually enroll online at SSA.gov during your 7-month window to avoid lifetime late penalties.';
    }

    // Dynamic Checklist Items
    var itemsEl = $id('m65-checklist-items');
    itemsEl.innerHTML = '';
    var chkList = [];

    if (ssStatus === 'no' && empStatus !== 'yes_large') {
      chkList.push({
        title: 'Apply Online at SSA.gov (3 Months Before Birthday Month)',
        desc: 'Log in to <a href="https://www.ssa.gov/medicare/sign-up" target="_blank" rel="noopener noreferrer">ssa.gov/medicare/sign-up</a> starting ' + formatMonthYear(startMonth, startYear) + ' to ensure coverage begins on the 1st of your birthday month.'
      });
    }

    if (hsaStatus === 'yes') {
      chkList.push({
        title: 'Stop HSA Contributions to Avoid IRS Excise Taxes',
        desc: 'Stop all personal and employer HSA payroll contributions before your Medicare effective date. If enrolling after 65, stop contributions 6 months prior to avoid retroactive tax penalties (<a href="https://www.irs.gov/publications/p969" target="_blank" rel="noopener noreferrer">IRS Pub 969</a>).'
      });
    }

    if (empStatus === 'yes_large') {
      chkList.push({
        title: 'Request Annual Written Creditable Coverage Notice from HR',
        desc: 'Confirm your employer drug and medical benefits remain "creditable." Save this documentation every year for when you eventually sign up via an SEP (Form CMS-L564).'
      });
    }

    chkList.push({
      title: 'Decide Between Original Medicare + Medigap vs Medicare Advantage',
      desc: 'Use our <a href="/tools/medicare-advantage-vs-original-medicare-decision-helper/" target="_blank" rel="noopener noreferrer">Decision Helper Quiz</a> to evaluate network restrictions, prior authorization, and monthly premiums.'
    });

    chkList.push({
      title: 'Select a Part D Prescription Drug Plan',
      desc: 'Even if taking few medications, enroll in a low-cost Part D plan on <a href="https://www.medicare.gov/plan-compare" target="_blank" rel="noopener noreferrer">medicare.gov/plan-compare</a> to protect against permanent late penalties.'
    });

    chkList.push({
      title: 'Take Advantage of Your 6-Month Medigap Open Enrollment Window',
      desc: 'If choosing Original Medicare, your guaranteed right to purchase Medigap Plan G or Plan N without health underwriting begins the month your Part B takes effect.'
    });

    chkList.forEach(function(item, idx) {
      var div = document.createElement('div');
      div.className = 'm65-chk-item';
      div.innerHTML = '<span class="m65-chk-num">' + (idx + 1) + '</span><div class="m65-chk-text"><strong>' + item.title + '</strong>' + item.desc + '</div>';
      itemsEl.appendChild(div);
    });

    var resEl = $id('m65-results');
    if (resEl) {
      resEl.style.display = 'block';
      resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function resetCalculator() {
    var form = $id('m65-form');
    if (form) form.reset();
    var res = $id('m65-results');
    if (res) res.style.display = 'none';
    clearErrors();
    var tool = $id('m65-tool');
    if (tool) tool.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var calcBtn = $id('m65-calc-btn');
    var resetBtn = $id('m65-reset-btn');
    if (calcBtn)  calcBtn.addEventListener('click', calculateIEP);
    if (resetBtn) resetBtn.addEventListener('click', resetCalculator);
  });
</script>
