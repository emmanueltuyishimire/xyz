  .rlc-tip-label { font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0; }
  .rlc-tip-text { font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6; }
