  .rlc-ref-table th, .rlc-scenario-table th, .rlc-sources-table th { background: #0A3D3A; color: #fff; padding: 0.6rem 0.75rem; text-align: left; font-weight: 700; }
  .rlc-ref-table td, .rlc-scenario-table td, .rlc-sources-table td { padding: 0.6rem 0.75rem; color: #0D2137; border-bottom: 1px solid #DDE3EA; line-height: 1.5; vertical-align: top; }
