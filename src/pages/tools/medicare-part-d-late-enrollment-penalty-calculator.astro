  .pd-section { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid #DDE3EA; }
  .pd-section h2 { font-size: 24px; font-weight: 700; color: #0D2137; margin-bottom: 20px; }
  .pd-section h3 { font-size: 20px; font-weight: 700; color: #0D2137; margin: 24px 0 12px; }
