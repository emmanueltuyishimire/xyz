  .cp14-scenario-table td { padding: 0.5rem 0.75rem; color: #0D2137; border-bottom: 1px solid #DDE3EA; }
  .cp14-scenario-result { background: #f0fdf4; border-left: 4px solid #1A7A4E; border-radius: 0 0.4rem 0.4rem 0; padding: 0.75rem 1rem; margin-bottom: var(--space-3); font-size: 0.95rem; line-height: 1.6; }
  .cp14-result-highlight { display: block; font-weight: 700; color: #0D2137; }
  .cp14-scenario-action { font-size: 0.9rem; color: #4B5A6E; font-style: italic; margin: 0; }
  .cp14-scenario-disclaimer { font-size: 0.8rem; color: #4B5A6E; margin-top: var(--space-6); line-height: 1.6; }

  /* Sources Table */
  .cp14-table-wrap { overflow-x: auto; margin-top: var(--space-5); }
  .cp14-sources-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .cp14-sources-table thead tr { background: #0A3D3A; }
  .cp14-sources-table th { padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700; }
  .cp14-sources-table td { padding: 0.75rem 1rem; color: #0D2137; vertical-align: top; border-bottom: 1px solid #DDE3EA; }
  .cp14-sources-table a { color: #0A3D3A; text-decoration: underline; }
  .cp14-row-alt { background: #f6f8fa; }
  .cp14-independence { font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6; max-width: 70ch; }

