---
/**
 * tools/index.astro
 * Tools hub — calculator.net-style layout for seniors 60+.
 * Sticky sidebar + "Start Here" spotlight + compact 2-column link lists.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { startHereTools, categories, allTools } from '@data/toolsList';

const breadcrumbItems = [{ label: 'Tools & Calculators' }];
const siteUrl = 'https://www.seniorsaudit.com';

const toolsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/tools/#collectionpage`,
      "url": `${siteUrl}/tools/`,
      "name": "Free Senior Benefits Calculators & Tools 2026",
      "description": `${allTools.length} free, instant calculators and tools for Social Security, Medicare, IRS notices, scam prevention, and retirement planning. Built for U.S. seniors. No account required.`,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
          { "@type": "ListItem", "position": 2, "name": "Free Tools & Calculators", "item": `${siteUrl}/tools/` }
        ]
      }
    },
    {
      "@type": "ItemList",
      "name": "Free Senior Benefits Calculators and Tools 2026",
      "numberOfItems": allTools.length,
      "itemListElement": allTools.map((tool, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "WebApplication",
          "@id": `${siteUrl}${tool.href}#tool`,
          "name": tool.title,
          "url": `${siteUrl}${tool.href}`,
          "description": tool.desc,
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "All",
          "isAccessibleForFree": true,
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "creator": { "@id": `${siteUrl}/#organization` }
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Free Senior Benefit Tools & Calculators"
  description="Free instant calculators for Social Security benefits, Medicare costs, IRS notices, scam prevention, and retirement planning. No signup or account needed."
  schema={toolsSchema}
>
  <div class="tools-page">
    <div class="tools-page-inner">

      <Breadcrumb items={breadcrumbItems} />

      <!-- PAGE HEADER -->
      <header class="tools-header">
        <div class="trust-bar" role="banner" aria-label="Site trust signals">
          <span>✓ 100% Free</span>
          <span>✓ No Signup Required</span>
          <span>✓ No Data Sold</span>
          <span>✓ Official Government Sources</span>
          <span>✓ Independent — Not Affiliated with SSA, CMS, or IRS</span>
        </div>
        <h1 class="tools-h1">Free Senior Benefits Calculators &amp; Tools <span class="year-tag">2026</span></h1>
        <p class="tools-subtitle">
          {allTools.length} free tools — pick a category from the left menu or start with the most popular tools below.
        </p>
      </header>

      <!-- START HERE SPOTLIGHT -->
      <section class="start-here" aria-labelledby="start-here-heading">
        <h2 id="start-here-heading" class="start-here-heading">
          <span aria-hidden="true">⭐</span> Most Used — Start Here
        </h2>
        <div class="start-here-grid">
          {startHereTools.map(tool => (
            <a href={tool.href} class="start-card">
              <span class="start-card-icon" aria-hidden="true">{tool.icon}</span>
              <span class="start-card-body">
                <span class="start-card-title">{tool.title}</span>
                <span class="start-card-desc">{tool.desc}</span>
              </span>
              <svg class="start-card-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>
      </section>

      <!-- SIDEBAR + TOOL LISTS -->
      <div class="tools-layout">

        <!-- Sticky sidebar (desktop) / pill strip (mobile) -->
        <nav class="cat-nav" aria-label="Tool categories">
          <p class="cat-nav-label">Jump to category</p>
          <ul class="cat-nav-list">
            {categories.map(cat => (
              <li>
                <a href={`#${cat.id}`} class="cat-nav-link">
                  <span aria-hidden="true">{cat.icon}</span>
                  <span>{cat.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Tool link lists -->
        <main class="tools-main">
          {categories.map(cat => (
            <section class="cat-section" id={cat.id} aria-labelledby={`h-${cat.id}`}>
              <div class="cat-header">
                <h2 id={`h-${cat.id}`} class="cat-title">
                  <span class="cat-icon" aria-hidden="true">{cat.icon}</span>
                  {cat.name}
                </h2>
                <p class="cat-desc">{cat.desc}</p>
              </div>
              <ul class="tool-list" role="list">
                {cat.tools.map(tool => (
                  <li class="tool-item" role="listitem">
                    <a href={tool.href} class="tool-link">
                      <span class="tool-link-title">{tool.title}</span>
                      <span class="tool-link-sep" aria-hidden="true"> — </span>
                      <span class="tool-link-desc">{tool.desc}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </main>

      </div>

      <aside class="bottom-trust" aria-label="Privacy and trust statement">
        <p><strong>Your privacy is guaranteed.</strong> Every tool on SeniorsAudit.com runs entirely in your browser. We do not store, sell, or share any data you enter. No account, no email, no insurance referral. Not affiliated with Medicare, SSA, IRS, AARP, or any insurance company.</p>
      </aside>

    </div>
  </div>
</BaseLayout>

<script>
  const navLinks = document.querySelectorAll('.cat-nav-link');
  const catSections = document.querySelectorAll('.cat-section');
  const spy = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(l => l.classList.remove('is-active'));
          const active = document.querySelector(`.cat-nav-link[href="#${entry.target.id}"]`);
          if (active) active.classList.add('is-active');
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
  );
  catSections.forEach(s => spy.observe(s));
</script>

<style>
.tools-page { padding-block: var(--space-8); }
.tools-page-inner { max-width: 1200px; margin-inline: auto; padding-inline: var(--space-6); }

/* Trust bar */
.trust-bar { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; background: #0A3D3A; border-radius: 0.5rem; padding: 0.65rem 1.25rem; margin-bottom: var(--space-5); }
.trust-bar span { font-size: 0.8rem; font-weight: 700; color: #C9933A; white-space: nowrap; letter-spacing: 0.03em; }

/* Header */
.tools-header { margin-bottom: var(--space-8); }
.tools-h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: #0A3D3A; margin: 0 0 0.4rem; line-height: 1.2; }
.year-tag { display: inline-block; background: #C9933A; color: #fff; font-size: 0.65em; font-weight: 700; border-radius: 4px; padding: 0.1em 0.45em; vertical-align: middle; margin-left: 0.3rem; }
.tools-subtitle { font-size: 1.05rem; color: #4B5A6E; margin: 0; }

/* Start Here */
.start-here { background: #f0f7f6; border: 2px solid rgba(10,61,58,0.15); border-radius: 0.75rem; padding: 1.5rem 1.75rem; margin-bottom: var(--space-10); }
.start-here-heading { font-size: 1.1rem; font-weight: 700; color: #0A3D3A; margin: 0 0 1rem; display: flex; align-items: center; gap: 0.4rem; }
.start-here-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(275px, 1fr)); gap: 0.6rem; }
.start-card { display: flex; align-items: center; gap: 0.75rem; background: #fff; border: 1.5px solid rgba(10,61,58,0.2); border-radius: 0.5rem; padding: 0.8rem 1rem; text-decoration: none; transition: border-color 0.15s, background 0.15s; }
.start-card:hover, .start-card:focus-visible { border-color: #0A3D3A; background: #e6f2f0; outline: none; }
.start-card:focus-visible { outline: 3px solid #C9933A; outline-offset: 2px; }
.start-card-icon { font-size: 1.5rem; flex-shrink: 0; }
.start-card-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.start-card-title { font-size: 0.95rem; font-weight: 700; color: #0A3D3A; line-height: 1.25; }
.start-card-desc { font-size: 0.82rem; color: #4B5A6E; margin-top: 0.15rem; line-height: 1.3; }
.start-card-arrow { flex-shrink: 0; color: #C9933A; transition: transform 0.15s; }
.start-card:hover .start-card-arrow { transform: translateX(3px); }

/* Layout */
.tools-layout { display: grid; grid-template-columns: 215px 1fr; gap: 0 2.5rem; align-items: start; }

/* Sidebar */
.cat-nav { position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; overscroll-behavior: contain; padding-right: 0.5rem; scrollbar-width: thin; scrollbar-color: rgba(10,61,58,0.3) transparent; }
.cat-nav-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5A6E; margin: 0 0 0.6rem; padding-left: 0.6rem; }
.cat-nav-list { list-style: none; margin: 0; padding: 0; border-left: 2px solid #e2e8f0; }
.cat-nav-link { display: flex; align-items: center; gap: 0.45rem; padding: 0.55rem 0.75rem; font-size: 0.88rem; font-weight: 500; color: #4B5A6E; text-decoration: none; border-left: 3px solid transparent; margin-left: -2px; border-radius: 0 4px 4px 0; transition: color 0.12s, border-color 0.12s, background 0.12s; line-height: 1.3; }
.cat-nav-link:hover, .cat-nav-link:focus-visible { color: #0A3D3A; border-left-color: #0A3D3A; background: #f0f7f6; outline: none; }
.cat-nav-link:focus-visible { outline: 3px solid #C9933A; outline-offset: 1px; }
.cat-nav-link.is-active { color: #0A3D3A; font-weight: 700; border-left-color: #C9933A; background: #fdf6ec; }

/* Sections */
.cat-section { margin-bottom: 2.75rem; scroll-margin-top: 90px; }
.cat-header { border-bottom: 2px solid #e2e8f0; padding-bottom: 0.65rem; margin-bottom: 0.9rem; }
.cat-title { font-size: 1.25rem; color: #0A3D3A; margin: 0 0 0.2rem; display: flex; align-items: center; gap: 0.4rem; }
.cat-icon { font-size: 1.15rem; }
.cat-desc { font-size: 0.88rem; color: #4B5A6E; margin: 0; line-height: 1.5; }

/* Tool link list (2-column scannable) */
.tool-list { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 1.5rem; }
.tool-item { break-inside: avoid; margin-bottom: 0; }
.tool-link { display: block; padding: 0.45rem 0.55rem; border-radius: 0.3rem; text-decoration: none; font-size: 0.97rem; line-height: 1.45; transition: background 0.12s; }
.tool-link:hover, .tool-link:focus-visible { background: #f0f7f6; outline: none; }
.tool-link:focus-visible { outline: 3px solid #C9933A; outline-offset: 1px; }
.tool-link-title { font-weight: 700; color: #0A3D3A; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 2px; transition: text-decoration-color 0.12s; }
.tool-link:hover .tool-link-title, .tool-link:focus-visible .tool-link-title { text-decoration-color: #0A3D3A; }
.tool-link-sep { color: #94a3b8; }
.tool-link-desc { color: #4B5A6E; font-size: 0.88rem; }

/* Bottom trust */
.bottom-trust { margin-top: var(--space-12); background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem 1.5rem; font-size: 0.9rem; color: #4B5A6E; line-height: 1.65; }
.bottom-trust strong { color: #0A3D3A; }

/* Tablet */
@media (max-width: 960px) {
  .tool-list { columns: 1; }
}

/* Mobile */
@media (max-width: 860px) {
  .tools-layout { grid-template-columns: 1fr; }
  .cat-nav { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 2px solid #e2e8f0; max-height: none; overflow-y: visible; padding: 0.65rem 0 0.55rem; margin-bottom: 1.75rem; margin-inline: calc(var(--space-6) * -1); padding-inline: var(--space-6); }
  .cat-nav-label { display: none; }
  .cat-nav-list { display: flex; flex-wrap: nowrap; overflow-x: auto; border-left: none; gap: 0.4rem; padding-bottom: 2px; scrollbar-width: none; }
  .cat-nav-list::-webkit-scrollbar { display: none; }
  .cat-nav-link { white-space: nowrap; flex-shrink: 0; border-left: none; border: 1.5px solid #e2e8f0; border-radius: 2rem; padding: 0.4rem 0.85rem; font-size: 0.83rem; background: #f8fafc; margin-left: 0; }
  .cat-nav-link.is-active { background: #0A3D3A; color: #fff; border-color: #0A3D3A; }
  .cat-nav-link:hover { background: #e6f2f0; border-color: #0A3D3A; }
  .start-here-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .tools-h1 { font-size: 1.45rem; }
  .cat-title { font-size: 1.1rem; }
}
</style>
