<script is:inline>
  function $id(id) { return document.getElementById(id); }
  function formatMoney(num) { return '$' + Math.round(num).toLocaleString('en-US'); }

  function calculatePlanGN() {
    var visits = parseFloat(($id('pgn-visits') || {}).value) || 0;
    var erVisits = parseFloat(($id('pgn-er') || {}).value) || 0;
    var monthlyGap = parseFloat(($id('pgn-prem-gap') || {}).value) || 35;
    var isBanState = ($id('pgn-excess-state') || {}).value === 'yes';

    // Plan N Copays = (visits * $20) + (ER * $50)
    var annualCopays = (visits * 20) + (erVisits * 50);
    var annualSavings = monthlyGap * 12;
    var netAdvantage = annualSavings - annualCopays;

    // Break-even visit threshold (assuming ER = 0.3)
    var erCost = erVisits * 50;
    var remainingSavings = annualSavings - erCost;
    var breakEvenVisits = Math.max(0, Math.floor(remainingSavings / 20));

    $id('pgn-math-prem-savings').textContent = formatMoney(annualSavings);
    $id('pgn-math-gap-text').textContent = formatMoney(monthlyGap) + '/mo';
    $id('pgn-math-copay-total').textContent = formatMoney(annualCopays);
    $id('pgn-math-vis-count').textContent = visits;
    $id('pgn-math-er-count').textContent = erVisits;

    var netEl = $id('pgn-math-net-diff');
    var titleEl = $id('pgn-verdict-title');
    var descEl = $id('pgn-verdict-desc');
    var bannerEl = $id('pgn-verdict-banner');

    if (netAdvantage > 0) {
      netEl.textContent = '+' + formatMoney(netAdvantage) + ' with Plan N';
      netEl.style.color = '#276749';
      titleEl.textContent = 'Plan N Is the Lower-Cost Choice at Your Usage Level';
      descEl.textContent = 'At ' + visits + ' doctor visits per year, your estimated Plan N copays (' + formatMoney(annualCopays) + ') are significantly less than the ' + formatMoney(annualSavings) + ' in annual premium savings. You save approximately ' + formatMoney(netAdvantage) + ' net each year with Plan N.';
    } else if (netAdvantage < 0) {
      netEl.textContent = '+' + formatMoney(Math.abs(netAdvantage)) + ' with Plan G';
      netEl.style.color = '#0A3D3A';
      titleEl.textContent = 'Plan G Provides Better Value at Your Usage Level';
      descEl.textContent = 'Because of your high visit frequency (' + visits + ' visits/year), the accumulated $20 copays exceed the premium savings of Plan N. Plan G offers 100% copay coverage and simplifies your healthcare budgeting.';
    } else {
      netEl.textContent = '$0 (Exact Tie)';
      netEl.style.color = '#4A5568';
      titleEl.textContent = 'Plan G and Plan N Break Exactly Even at Your Usage Level';
      descEl.textContent = 'Your estimated copays exactly equal the premium savings. In this scenario, Plan G is often preferred because it eliminates copay paperwork.';
    }

    // Update break-even text
    var beText = 'You would need to visit the doctor more than <strong>' + breakEvenVisits + ' times per year</strong> before Plan G\'s higher premium equals your Plan N copays.';
    if (isBanState) {
      beText += ' <em>Note: Because you indicated you reside in an excess-charge ban state, your Part B excess charge risk on Plan N is 0%.</em>';
    } else {
      beText += ' <em>Note: In your state, doctors not accepting assignment can legally bill up to 15% excess charges on Plan N (~3% of providers).</em>';
    }
    $id('pgn-breakeven-text').innerHTML = beText;

    var resEl = $id('pgn-results');
    if (resEl) {
      resEl.style.display = 'block';
      resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function resetPlanGN() {
    var form = $id('pgn-form');
    if (form) form.reset();
    var res = $id('pgn-results');
    if (res) res.style.display = 'none';
    var tool = $id('pgn-tool');
    if (tool) tool.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var calcBtn = $id('pgn-calc-btn');
    var resetBtn = $id('pgn-reset-btn');
    if (calcBtn)  calcBtn.addEventListener('click', calculatePlanGN);
    if (resetBtn) resetBtn.addEventListener('click', resetPlanGN);
  });
</script>
