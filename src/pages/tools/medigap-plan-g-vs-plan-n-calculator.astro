---

<ToolLayout
  title="Medigap Plan G vs Plan N Calculator | Seniors Audit"
  description="Free Medigap Plan G vs Plan N cost calculator. Compare doctor copays, Part B excess charges, and annual premium savings for 2026 enrollees now."
  canonical={canonical}
  faqs={faqs}
  howToSteps={howToSteps}
>

<!-- BREADCRUMB -->
<nav class="pgn-bc" aria-label="Breadcrumb">
  <a href="/" class="pgn-bc-link">Home</a>
  <span aria-hidden="true"> &rsaquo; </span>
  <a href="/tools/" class="pgn-bc-link">Tools</a>
  <span aria-hidden="true"> &rsaquo; </span>
  <span>Medigap Plan G vs Plan N Calculator</span>
