const pageTitle = 'CP504 Notice Explained: Stop IRS Levy | Seniors Audit';
const metaDescription = 'Received an IRS CP504 notice? Find your pay-by date, protect your state refund, and compare payment plan, hardship (CNC) and appeal options.';
const lastReviewed = 'September 2026';

const faqs = [
  {
    question: 'What is a CP504 notice from the IRS?',
    answer: 'An IRS CP504 notice is a formal Notice of Intent to Levy. It is sent when previous balance due notices (like CP14) went unpaid. It informs you that the IRS intends to seize your state tax refund and may proceed to levy bank accounts or wages if the tax remains unresolved.',
  },
  {
    question: 'Is a CP504 IRS letter the final notice before levy?',
    answer: 'A CP504 letter is the final notice before seizure of state tax refunds. However, before the IRS can levy bank accounts, wages, or Social Security benefits, they must issue Notice LT11 / Letter 1058 (Final Notice of Intent to Levy with Collection Due Process Rights). Still, CP504 represents an urgent collection stage.',
  },
  {
    question: 'How long do I have to respond to a CP504 notice?',
    answer: 'The notice says the IRS can levy your state tax refund if you do not pay or call to arrange payment within 30 days of the notice date. Penalties and interest keep running, and the failure-to-pay penalty rises to 1% per month if you do not pay within 10 days of the notice.',
  },
  {
    question: 'How can I stop a CP504 levy immediately?',
    answer: 'You can stop a CP504 levy immediately by doing any of the following: (1) Pay the balance online at irs.gov/payments, (2) Set up an Online Payment Agreement at irs.gov/opa, (3) Request Currently Not Collectible (CNC) status if experiencing financial hardship, or (4) If you disagree with the collection action, ask for an appeal under the Collection Appeals Program using Form 9423, as your notice explains.',
  },
  {
    question: 'Can the IRS levy my Social Security benefits after a CP504 notice?',
    answer: 'Under the Federal Payment Levy Program (FPLP), the IRS can automatically levy up to 15% of your monthly Social Security benefits. While CP504 specifically targets state refunds, ignoring it leads to an LT11 notice, which enables 15% Social Security benefit garnishment.',
  },
  {
    question: 'What happens if I cannot afford to pay the balance on my CP504 notice?',
    answer: 'If paying your CP504 balance would prevent you from paying basic living expenses (housing, food, medical), call the IRS at 1-800-829-1040 immediately to request Currently Not Collectible (CNC) status. If approved, active collection demands and levies are temporarily paused.',
  },
  {
    question: 'What is the difference between Notice CP504 and Notice CP14?',
    answer: 'CP14 is the initial polite bill sent when a balance is due on a tax return. CP504 is an urgent Notice of Intent to Levy sent after CP14 goes unpaid, authorizing the IRS to seize state tax refunds.',
  },
];
---

