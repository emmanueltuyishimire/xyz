  .mat-mistake h3 { font-size: 17px; color: var(--navy); margin: 0 0 8px; }
  .mat-mistake p { font-size: 16px; line-height: 1.7; color: var(--navy); margin: 0 0 8px; }
  .mat-fix { font-size: 15px; color: var(--muted); line-height: 1.65; margin: 0; }
  .mat-fix a { color: var(--teal); font-weight: 600; }

  /* faq */
  .mat-faq { display: flex; flex-direction: column; }
  .mat-faq-item { border-bottom: 1px solid var(--silver); padding: 18px 0; }
  .mat-faq-item:last-child { border-bottom: none; }
  .mat-faq-q { font-size: 17px; font-weight: 700; color: var(--navy); margin: 0 0 8px; }
  .mat-faq-a { font-size: 16px; line-height: 1.7; color: var(--muted); margin: 0; }

  /* related */
  .mat-rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 14px; }
  .mat-rel-card { display: block; padding: 16px 18px; border: 2px solid rgba(10,61,58,.15); border-radius: 10px; text-decoration: none; transition: border-color .15s; }
  .mat-rel-card:hover { border-color: var(--teal); background: rgba(10,61,58,.03); }
  .mat-rel-card strong { display: block; font-size: 16px; color: var(--teal); margin-bottom: 6px; }
  .mat-rel-card p { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; }

  /* disclaimer */
  .mat-disclaimer { max-width: 860px; margin: 0 auto 40px; background: #08111F; color: #FFF; border-radius: 10px; padding: 20px 24px; font-size: 15px; line-height: 1.7; }
  .mat-disclaimer p:first-child strong { color: var(--gold); font-size: 16px; display: block; margin-bottom: 8px; }
  .mat-disclaimer p { margin: 0 0 8px; }
  .mat-disclaimer p:last-child { margin: 0; }
  .mat-disclaimer a { color: var(--gold); }
</style>

<script is:inline>
  /* 2026 Verified CMS figures */
  var PART_B_ANNUAL  = 202.90 * 12;   /* $2,434.80 — FACT */
  var MA_MOOP        = 9250;           /* in-network ceiling — FACT */
  var PART_D_OOP_CAP = 2100;           /* separate Part D cap — FACT */
  var WORST_TOTAL    = PART_B_ANNUAL + MA_MOOP + PART_D_OOP_CAP; /* $13,784.80 */

  /* Copay proxies — DECISION SUPPORT */
  var COPAY = { low:{lo:200,hi:500}, moderate:{lo:800,hi:2000}, high:{lo:3000,hi:6000} };
  /* Drug proxies — ESTIMATE */
  var DRUG  = { none:{lo:0,hi:0}, low:{lo:200,hi:500}, moderate:{lo:800,hi:1500}, high:{lo:PART_D_OOP_CAP,hi:PART_D_OOP_CAP} };

  /* State-specific MA market notes */
  var STATE_NOTES = {
    'Alaska':      'Alaska has very limited MA plan options. Original Medicare may have stronger coverage breadth in your county. Verify at medicare.gov/plan-compare.',
    'Wyoming':     'Wyoming has limited MA plan options in many counties. Verify what is actually available in your ZIP code.',
    'Montana':     'Rural Montana counties may have few or no MA plans available. Confirm availability at medicare.gov/plan-compare.',
    'North Dakota':'Rural North Dakota counties may have limited MA plan options.',
    'South Dakota':'Rural South Dakota counties may have limited MA plan options.',
    'Hawaii':      'Hawaii has a smaller MA market than most states. Plan networks are concentrated and options may be limited outside Honolulu.',
    'Florida':     'Florida has one of the most competitive MA markets — many $0 premium options, but network quality varies significantly by county.',
    'California':  'California has strong MA competition in urban counties; rural counties may have fewer options.',
  };

  function $i(id) { return document.getElementById(id); }
  function qr(n)  { var el = document.querySelector('input[name="' + n + '"]:checked'); return el ? el.value : null; }
  function fmt(n) { return '$' + Math.round(n).toLocaleString('en-US'); }
  function fmtR(lo, hi) { return lo === hi ? fmt(lo) : fmt(lo) + ' \u2013 ' + fmt(hi); }
  function showErr(id, msg) { var e = $i(id); if(e){ e.textContent = msg; e.style.display = 'block'; } }
  function clearErr() { document.querySelectorAll('.mat-err').forEach(function(e){ e.textContent=''; e.style.display='none'; }); }

  function fillDays() {
    var m = parseInt(($i('mat-m')||{}).value);
    var y = parseInt(($i('mat-y')||{}).value);
    var dd = $i('mat-d'); if(!dd) return;
    var cur = dd.value;
    dd.innerHTML = '<option value="">\u2014 DD \u2014</option>';
    if (!m) return;
    var days = new Date(y||2000, m, 0).getDate();
    for (var i = 1; i <= days; i++) {
      var o = document.createElement('option');
      o.value = i; o.textContent = i < 10 ? '0'+i : ''+i;
      if (i === parseInt(cur)) o.selected = true;
      dd.appendChild(o);
    }
  }

  function getAge() {
    var m = parseInt(($i('mat-m')||{}).value);
    var d = parseInt(($i('mat-d')||{}).value);
    var y = parseInt(($i('mat-y')||{}).value);
    if (!m || !d || !y || y < 1900) return null;
    var today = new Date(), dob = new Date(y, m-1, d);
    if (dob > today) return null;
    var age = today.getFullYear() - dob.getFullYear();
    var md  = today.getMonth() - dob.getMonth();
    if (md < 0 || (md === 0 && today.getDate() < dob.getDate())) age--;
    return age;
  }

  function updateAge() {
    fillDays();
    var age = getAge(), disp = $i('mat-age-disp');
    if (!disp) return;
    if (age !== null && age >= 60 && age <= 85) {
      disp.textContent = '\u2713 Your calculated age: ' + age + ' years old';
      disp.className = 'mat-age-disp mat-age-ok'; disp.style.display = 'block';
    } else if (age !== null) {
      disp.textContent = 'This tool is designed for ages 60\u201385. Your age: ' + age + '.';
      disp.className = 'mat-age-disp mat-age-warn'; disp.style.display = 'block';
    } else { disp.style.display = 'none'; }
  }

  function calculate() {
    clearErr();
    var age   = getAge();
    var usage = qr('mat-usage');
    var oon   = qr('mat-oon');
    var drug  = qr('mat-drug');
    var state = ($i('mat-state')||{}).value || '';
    var valid = true;

    var dm = ($i('mat-m')||{}).value, dd = ($i('mat-d')||{}).value, dy = ($i('mat-y')||{}).value;
    if (!dm || !dd || !dy)     { showErr('mat-dob-err', 'Please enter your complete date of birth.'); valid = false; }
    else if (age===null||age<60||age>85) { showErr('mat-dob-err', age===null?'Please enter a valid date of birth.':'This tool is for ages 60\u201385. Your age: '+age+'.'); valid=false; }
    if (!usage) { showErr('mat-usage-err','Please select your expected healthcare usage level.'); valid=false; }
    if (!oon)   { showErr('mat-oon-err',  'Please select your out-of-network care frequency.'); valid=false; }
    if (!drug)  { showErr('mat-drug-err', 'Please select your prescription drug usage level.'); valid=false; }
    if (!valid) return;

    var cop  = COPAY[usage] || COPAY.low;
    var drg  = DRUG[drug]   || DRUG.none;
    var typL = Math.round(PART_B_ANNUAL + cop.lo + drg.lo);
    var typH = Math.round(PART_B_ANNUAL + cop.hi + drg.hi);
    var wstMed = MA_MOOP + PART_B_ANNUAL;

    /* show results */
    var res = $i('mat-results'); if(res) res.style.display='block';

    /* OON warning */
    var oonW = $i('mat-oon-warn'); if(oonW) oonW.style.display = (oon==='often')?'block':'none';

    /* state note */
    var sn = $i('mat-state-note');
    if (sn) {
      if (state && STATE_NOTES[state]) {
        sn.innerHTML = '<strong>\uD83D\uDCCD '+state+' note:</strong> '+STATE_NOTES[state];
        sn.style.display = 'block';
      } else if (state) {
        sn.innerHTML = '\uD83D\uDCCD Estimate uses national typical MA plan structure. Verify real plans in <strong>'+state+'</strong> at <a href="https://www.medicare.gov/plan-compare" target="_blank" rel="noopener noreferrer">medicare.gov/plan-compare</a>.';
        sn.style.display = 'block';
      } else { sn.style.display='none'; }
    }

    /* typical year */
    $i('mat-typ-lo').textContent = fmt(typL);
    $i('mat-typ-hi').textContent = fmt(typH);
    $i('mat-typ-mo-lo').textContent = fmt(Math.round(typL/12));
    $i('mat-typ-mo-hi').textContent = fmt(Math.round(typH/12));

    /* worst case */
    $i('mat-wst').textContent    = fmt(wstMed)+' \u2013 '+fmt(WORST_TOTAL);
    $i('mat-wst-mo').textContent = fmt(Math.round(wstMed/12))+' \u2013 '+fmt(Math.round(WORST_TOTAL/12));

    /* breakdown */
    var lblMap = { low:'Low Usage Copay Proxy', moderate:'Moderate Usage Copay Proxy', high:'High Usage Copay Proxy' };
    $i('mat-bk-cop-lbl').textContent   = lblMap[usage]||'Medical Copays';
    $i('mat-bk-cop').textContent       = fmtR(cop.lo, cop.hi);
    $i('mat-bk-drug').textContent      = fmtR(drg.lo, drg.hi);
    $i('mat-bk-tot-typ').textContent   = fmtR(typL, typH);
    $i('mat-bk-tot-wst').textContent   = fmt(wstMed)+' \u2013 '+fmt(WORST_TOTAL);

    res.scrollIntoView({ behavior:'smooth', block:'start' });
  }

  function resetTool() {
    var form = $i('mat-form'); if(form) form.reset();
    var res = $i('mat-results'); if(res) res.style.display='none';
    var disp = $i('mat-age-disp'); if(disp) disp.style.display='none';
    clearErr();
    var tool = $i('mat-tool'); if(tool) tool.scrollIntoView({ behavior:'smooth', block:'start' });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var m=$i('mat-m'), d=$i('mat-d'), y=$i('mat-y');
    if(m){ m.addEventListener('change', updateAge); }
    if(d){ d.addEventListener('change', updateAge); }
    if(y){ y.addEventListener('input',  updateAge); }

    var calc=$i('mat-calc'), rst=$i('mat-reset'), rst2=$i('mat-reset2');
    if(calc)  calc.addEventListener('click',  calculate);
    if(rst)   rst.addEventListener('click',   resetTool);
    if(rst2)  rst2.addEventListener('click',  resetTool);

    document.querySelectorAll('#mat-form input, #mat-form select').forEach(function(el) {
      el.addEventListener('keydown', function(e){ if(e.key==='Enter'){e.preventDefault();calculate();} });
    });
  });
</script>