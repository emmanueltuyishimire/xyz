---
/**
 * rmd-calculator.astro
 * RMD Calculator (Current Year, Evergreen)
 * Category: IRS / RMD
 * Primary keyword: rmd calculator
 * Supporting keywords: rmd calculator 2026, ira minimum distribution calculator,
 *   required minimum distribution calculator, ira rmd calculator, how to calculate rmd
 *
 * IRS Publication 590-B Rules & SECURE 2.0 Act
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { RMDCalculatorEvergreen } from '@components/tools/RMDCalculatorEvergreen';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const lastReviewed = 'July 2026';
const currentYear = new Date().getFullYear();

const faqs = [
  {
    question: 'What is an rmd calculator and how does it calculate my mandatory IRA withdrawal?',
    answer: 'An rmd calculator determines the exact dollar amount you are legally required to withdraw from your tax-deferred retirement accounts (such as Traditional IRAs, 401(k)s, and SEP IRAs) each year. It divides your account balance as of December 31 of the prior year by your IRS life expectancy factor from the official IRS Uniform Lifetime Table.',
  },
  {
    question: 'What is the SECURE 2.0 RMD starting age for rmd calculator 2026?',
    answer: 'Under the SECURE 2.0 Act passed by Congress, the required minimum distribution starting age depends on your birth year. If you were born between 1951 and 1959, your RMD age is 73. If you were born in 1960 or later, your RMD starting age is 75. For the rmd calculator 2026, anyone turning 73 this year must calculate their distribution.',
  },
  {
    question: 'How to calculate rmd for a Traditional IRA or 401(k)?',
    answer: 'To learn how to calculate rmd, take your account balance from December 31 of the previous year and divide it by the distribution period (life expectancy factor) matching your age in the IRS Uniform Lifetime Table III. For example, if you are 74 years old with a $300,000 balance, your IRS factor is 25.5. Dividing $300,000 by 25.5 gives an annual RMD of $11,765.',
  },
  {
    question: 'Do I need an ira minimum distribution calculator for Roth IRAs?',
    answer: 'No. Original Roth IRAs are exempt from Required Minimum Distributions during the owner\'s lifetime. You do not need an ira minimum distribution calculator for a Roth IRA while you are alive. However, inherited Roth IRAs and former Roth 401(k) accounts may be subject to beneficiary withdrawal rules under the SECURE Act 10-year rule.',
  },
  {
    question: 'What is the IRS penalty if I miss my required minimum distribution deadline?',
    answer: 'Failing to withdraw your full RMD by the deadline results in a severe IRS tax penalty. The penalty is 25% of the amount not taken on time. However, under SECURE 2.0 rules, if you correct the missed distribution within two years and file IRS Form 5329, the penalty is reduced to 10%.',
  },
  {
    question: 'What is the deadline for taking my first RMD versus subsequent RMDs?',
    answer: 'For your very first RMD (the year you reach age 73 or 75), the IRS gives you a grace period until April 1 of the following year. For all subsequent years, your annual RMD must be taken by December 31. Note: If you delay your first RMD to April 1, you will have to take TWO distributions in that same tax year, which may push you into a higher tax bracket.',
  },
  {
    question: 'How does an ira rmd calculator handle a spouse who is more than 10 years younger?',
    answer: 'If your spouse is your sole primary beneficiary and is more than 10 years younger than you, an ira rmd calculator uses the IRS Joint Life and Last Survivor Table (Table II) instead of the Uniform Lifetime Table. This table provides a longer joint life expectancy factor, resulting in a lower required annual withdrawal.',
  },
];

// FAQPage JSON-LD schema
const faqSchemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': f.answer },
  })),
});
---

<ToolLayout
  title="RMD Calculator 2026 — Free Required Minim | Seniors Audit"
  description="Calculate your 2026 Required Minimum Distribution using the IRS Uniform Lifetime Table. Enter age and IRA balance. Free RMD calculator, no account."
  faqs={faqs}
>

  <!-- ═══════════════════════════════════════════════════════
       1. HERO HEADER (Primary Keyword in H1)
       ═══════════════════════════════════════════════════════ -->
  <div class="rmd-hero">
    <div class="rmd-breadcrumb">
      <a href="/retirement/" class="rmd-breadcrumb-link">Retirement</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="rmd-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>RMD Calculator</span>
