  var calcBtn     = document.getElementById('med-calc-btn');
  var resetBtn    = document.getElementById('med-reset-btn');
  var stateEl     = document.getElementById('med-state');
  var incomeEl    = document.getElementById('med-income');
  var assetsEl    = document.getElementById('med-assets');
  var resultsEl   = document.getElementById('med-results');
  var stateNoteBox = document.getElementById('med-state-note-box');
  var stateNoteTitle = document.getElementById('med-state-note-title');
  var stateNoteText = document.getElementById('med-state-note-text');
  var noAssetNotice = document.getElementById('med-no-asset-notice');
  var noAssetText = document.getElementById('med-no-asset-text');
  var assetField  = document.getElementById('med-asset-field');

  function getHousehold() {
    var els = document.querySelectorAll('input[name="med-household"]');
    for (var i = 0; i < els.length; i++) {
      if (els[i].checked) return els[i].value;
    }
    return 'individual';
  }

  function fmt(n) {
    return '$' + n.toLocaleString('en-US');
  }

  // Update UI when state changes
  stateEl.addEventListener('change', function () {
    var code = stateEl.value;
    if (!code) {
      stateNoteBox.hidden = true;
      noAssetNotice.hidden = true;
      if (assetField) assetField.style.opacity = '1';
      return;
    }
    var rule = STATE_RULES[code];
    if (rule) {
      stateNoteBox.hidden = false;
      stateNoteTitle.textContent = stateEl.options[stateEl.selectedIndex].text + ' — Special Rules Apply';
      stateNoteText.textContent = rule.note;
      if (rule.noAssetTest) {
        noAssetNotice.hidden = false;
        noAssetText.textContent = 'Your state (' + stateEl.options[stateEl.selectedIndex].text + ') does not apply an asset test for this Medicaid pathway. Only your monthly income is compared against the threshold.';
        if (assetField) assetField.style.opacity = '0.4';
      } else {
        noAssetNotice.hidden = true;
        if (assetField) assetField.style.opacity = '1';
      }
    } else {
      stateNoteBox.hidden = false;
      stateNoteTitle.textContent = stateEl.options[stateEl.selectedIndex].text + ' — Federal Baseline Applies';
      stateNoteText.textContent = 'This state appears to follow the federal SSI-based limits ($994/month income, $2,000 assets for an individual). Your state may have specific variations not reflected here — confirm your exact limit using the state Medicaid link in your result.';
      noAssetNotice.hidden = true;
      if (assetField) assetField.style.opacity = '1';
    }
  });

  calcBtn.addEventListener('click', function () {
    var state     = stateEl.value;
    var household = getHousehold();
    var income    = parseFloat(incomeEl.value) || 0;
    var assets    = parseFloat(assetsEl.value) || 0;

    if (!state) {
      alert('Please select your state first.');
      stateEl.focus();
      return;
    }

    var rule         = STATE_RULES[state] || null;
    var noAssetTest  = rule && rule.noAssetTest;
    var incomeLimit  = rule && rule.income ? rule.income[household] : LIMITS[household].income;
    var assetLimit   = rule && rule.assets ? rule.assets[household] : LIMITS[household].assets;
    var stateLabel   = stateEl.options[stateEl.selectedIndex].text;

    var incomePass  = income <= incomeLimit;
    var assetsPass  = noAssetTest || (assets <= assetLimit);
    var incomeClose = !incomePass && income <= (incomeLimit * 1.05);
    var assetsClose = !noAssetTest && !assetsPass && assets <= (assetLimit * 1.1);

    // Determine verdict
    var verdict, verdictClass, explanation, nextText;

    if (incomePass && assetsPass) {
      verdict      = 'Likely Eligible';
      verdictClass = 'med-verdict-eligible';
      explanation  = 'Based on the income and asset limits that apply in ' + stateLabel + ', your numbers fall at or below the 2026 thresholds for the Aged, Blind & Disabled Medicaid pathway. This does not guarantee approval — your state Medicaid office will make the official determination after reviewing your documentation — but your numbers are in the qualifying range.';
      nextText     = 'Apply through your state Medicaid office. Bring proof of income (Social Security award letter, pension statements) and proof of identity. Your state office can confirm all exemptions and disregards that apply to your specific situation.';
    } else if (incomeClose || assetsClose) {
      verdict      = 'Close to the Threshold — Worth Checking';
      verdictClass = 'med-verdict-check';
      explanation  = 'Your numbers are near the threshold for ' + stateLabel + '. Standard income disregards (such as the $20/month general exclusion applied in most states) could lower your countable income or assets below the official limit. Do not assume you do not qualify based on this calculator result alone.';
      nextText     = 'Contact a free SHIP counselor at shiphelp.org — they can verify exactly which income disregards and asset exclusions your state applies and whether a spend-down arrangement makes sense for your situation.';
    } else {
      verdict      = 'Likely Not Eligible Under This Pathway';
      verdictClass = 'med-verdict-not';
      explanation  = 'Based on the standard ' + stateLabel + ' thresholds for the Aged, Blind & Disabled pathway, your income or assets appear to exceed the 2026 limits. You may still want to check two things: (1) whether your state uses a different income threshold than the SSI rate, and (2) whether a Medicaid spend-down program applies in your state if you have high medical expenses.';
      nextText     = 'Check whether your state offers a Medicaid spend-down program, which allows people with higher income to qualify by "spending down" on medical expenses. A SHIP counselor at shiphelp.org can help you assess this at no cost.';
    }

    // Populate result
    document.getElementById('med-result-verdict').textContent = verdict;
    document.getElementById('med-result-badge').className = 'med-result-badge ' + verdictClass;
    document.getElementById('med-result-explanation').textContent = explanation;
    document.getElementById('med-next-text').textContent = nextText;

    // Result table rows
    var tbody = document.getElementById('med-result-rows');
    tbody.innerHTML = '';

    // Income row
    var iRow = document.createElement('tr');
    iRow.innerHTML = '<td>Monthly Income</td><td>' + fmt(income) + '</td><td>' + fmt(incomeLimit) + '</td><td class="' + (incomePass ? 'med-pass-cell' : 'med-fail-cell') + '">' + (incomePass ? '&#10003; Under limit' : '&#10005; Over limit') + '</td>';
    tbody.appendChild(iRow);

    // Asset row
    if (noAssetTest) {
      var aRow = document.createElement('tr');
      aRow.innerHTML = '<td>Countable Assets</td><td>' + fmt(assets) + '</td><td>No test in ' + stateLabel + '</td><td class="med-pass-cell">&#10003; Not counted</td>';
      tbody.appendChild(aRow);
    } else {
      var aRow2 = document.createElement('tr');
      aRow2.innerHTML = '<td>Countable Assets</td><td>' + fmt(assets) + '</td><td>' + fmt(assetLimit) + '</td><td class="' + (assetsPass ? 'med-pass-cell' : 'med-fail-cell') + '">' + (assetsPass ? '&#10003; Under limit' : '&#10005; Over limit') + '</td>';
      tbody.appendChild(aRow2);
    }

    // State note
    var stateNote = document.getElementById('med-result-state-note');
    var stateOfficeUrl = STATE_URLS[state] || 'https://www.usa.gov/medicaid-chip-insurance';
    if (rule) {
      stateNote.innerHTML = '<div class="med-state-flag"><strong>State-Specific Note for ' + stateLabel + ':</strong> ' + rule.note + '</div>';
    } else {
      stateNote.innerHTML = '<div class="med-state-flag">These figures represent the federal SSI-based baseline. <a href="' + stateOfficeUrl + '" target="_blank" rel="noopener noreferrer">' + stateLabel + '\'s state Medicaid office</a> will apply its own exact rules and disregards when processing your application.</div>';
    }

    // Update the "Find Your State Medicaid Office" button to point to THIS state's office
    var applyBtn = document.getElementById('med-apply-btn');
    if (applyBtn) {
      applyBtn.href = stateOfficeUrl;
      applyBtn.textContent = stateLabel + ' Medicaid Office \u2192';
    }

    // Contextual next-tool card based on verdict
    var nextToolCard = document.getElementById('med-next-tool-card');
    var nextToolLabel = document.getElementById('med-next-tool-label');
    var nextToolLink  = document.getElementById('med-next-tool-link');
    var nextToolName  = document.getElementById('med-next-tool-name');
    var nextToolDesc  = document.getElementById('med-next-tool-desc');
    var nextToolIcon  = document.getElementById('med-next-tool-icon');

    var toolMap = {
      'med-verdict-eligible': {
        label: 'People who qualify for Medicaid often qualify for this too',
        icon: '★',
        href: '/tools/medicare-savings-estimator/',
        name: 'Medicare Savings Program Estimator',
        desc: 'At your income level, you likely qualify for help paying Medicare Part B premiums. Run this free check to see your MSP tier.',
      },
      'med-verdict-check': {
        label: 'While you wait on your Medicaid result, check this',
        icon: '✓',
        href: '/tools/extra-help-eligibility-calculator/',
        name: 'Extra Help Eligibility Calculator',
        desc: 'Extra Help (LIS) cuts Medicare drug costs by an average of $6,000/year. It uses similar income thresholds and has a separate application.',
      },
      'med-verdict-not': {
        label: 'If Medicaid coverage is still years away, plan your runway',
        icon: '→',
        href: '/tools/long-term-care-savings-runway-calculator/',
        name: 'Long-Term Care Savings Runway Calculator',
        desc: 'Find out how many months your current savings could cover nursing home or assisted living costs before Medicaid would need to step in.',
      },
    };

    var toolData = toolMap[verdictClass];
    if (toolData && nextToolCard) {
      nextToolLabel.textContent = toolData.label;
      nextToolIcon.textContent  = toolData.icon;
      nextToolLink.href         = toolData.href;
      nextToolName.textContent  = toolData.name;
      nextToolDesc.textContent  = toolData.desc;
      nextToolCard.hidden = false;
    }

    // Show results, hide button
    resultsEl.hidden = false;
    calcBtn.style.display = 'none';
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  resetBtn.addEventListener('click', function () {
    resultsEl.hidden = true;
    calcBtn.style.display = 'block';
    incomeEl.value = '';
    assetsEl.value = '';
    stateEl.value = '';
    stateNoteBox.hidden = true;
    noAssetNotice.hidden = true;
    if (assetField) assetField.style.opacity = '1';
    var ntc = document.getElementById('med-next-tool-card');
    if (ntc) ntc.hidden = true;
    calcBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

})();
</script>

