---
import ToolLayout from '@layouts/ToolLayout.astro';
import { GiftCardScamChecklist } from '@components/tools/GiftCardScamChecklist';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const faqs = [
  { question: 'Why do scammers always ask for gift cards?', answer: 'Gift cards are like cash: once the numbers are given over the phone, the money is gone and nearly impossible to trace. Scammers demand them because they can easily drain the funds from anywhere in the world without using a traditional bank account.' },
  { question: 'Can I get my money back if I sent a gift card to a scammer?', answer: 'It is very rare, but occasionally possible if you contact the company that issued the card (like Amazon or Apple) immediately before the scammer drains it. You must call them right away, explain it was a scam, and give them the card numbers.' },
  { question: 'Can I get my money back if I sent a wire transfer to a scammer?', answer: 'Wire transfers are generally final, but if you act immediately, your bank might be able to stop or reverse it. Contact your bank’s fraud department right now, then file complaints with FinCEN and the FBI’s IC3.' },
  { question: 'Can I get my money back if I sent cryptocurrency to a scammer?', answer: 'Cryptocurrency transactions are almost always permanent and cannot be reversed. You should report the fraud to the platform you used to send the crypto and file a report at reportfraud.ftc.gov, but recovery is extremely unlikely.' },
  { question: 'What should I do in the next 24 hours if I just sent a gift card?', answer: 'Stop all contact with the person who asked for the card. Immediately call the company that issued the gift card to report the fraud. Then report the incident to reportfraud.ftc.gov and tell a trusted family member what happened.' },
  { question: 'What gift card brands does the FTC say are most commonly used in scams?', answer: 'The FTC reports that scammers most frequently demand Target, Google Play, Apple, eBay, and Walmart gift cards. However, scammers will take whatever brand of card you are able to buy. Any request to pay with a gift card is a scam.' },
  { question: 'Is it ever okay to pay a business or government agency with a gift card?', answer: 'No. The IRS, Social Security Administration, courts, utility companies, and legitimate businesses will never accept gift cards as payment. Gift cards are for gifts, not for paying bills, taxes, or resolving emergencies.' },
  { question: 'How do I report a gift card scam to the card issuer?', answer: 'Call the customer service number on the back of the gift card, or search for the company’s official fraud reporting number online. Tell them the card was used in a scam, and ask them to freeze the remaining balance if possible.' }
];
---

<ToolLayout
  title="Gift Card & Wire Transfer Scam Checklist | Seniors Audit"
  description="Free gift card and wire transfer scam checklist. Find out instantly if a payment request is a known scam method. No account needed. Verified against FTC fraud guidance."
  faqs={faqs}
>
  <!-- HERO SECTION -->
  <div style="margin-bottom: var(--space-8);">
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools & Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Gift Card & Wire Transfer Scam Checklist</span>
    </div>
    
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      Were You Asked to Pay by Gift Card or Wire Transfer? Check This First — Free
    </h1>
    
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>
    
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        No legitimate government agency, court, bank, or business will ever ask you to pay by gift card, wire transfer, cryptocurrency, or cash sent by mail. If anyone told you to pay this way — whether they claimed to be the IRS, Social Security, your grandchild, or a prize company — it is a scam. Do not send the payment. Report it to reportfraud.ftc.gov.
      </p>
    </div>
    
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      Gift cards, wire transfers, and cryptocurrency are the payment methods scammers overwhelmingly demand because they cannot be reversed. Once the money leaves, it is almost always gone permanently. We built this checklist because many people don't realize that a payment request in these forms is itself a near-certain fraud signal — regardless of how convincing the caller or letter seems.
    </p>
    
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Seniors who were told to buy gift cards or send a wire transfer as payment for anything.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Anyone who already sent a payment by gift card or wire and wants to know if recovery is possible.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Family members who want to help a loved one recognize this specific payment pattern before it's too late.
      </li>
    </ul>
  </div>

  <!-- THE INTERACTIVE TOOL -->
  <div style="margin-bottom: var(--space-8);">
    <GiftCardScamChecklist client:load />
  </div>

  <NoSignupStatement />

  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Tool — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li id="step-1" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Identify the method.</strong> Answer the first yes/no question about the payment method requested.</li>
      <li id="step-2" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Provide status.</strong> If you answered yes, continue through the checklist to identify what happened and what to do next.</li>
      <li id="step-3" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Act quickly.</strong> Follow the immediate action steps in the order shown — speed matters for any chance of reversal.</li>
      <li id="step-4" style="font-size: 1rem; color: #0D2137; line-height: 1.6;"><strong>Get local help.</strong> Select your state to get the local police report link alongside the federal reporting links.</li>
    </ol>
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">Scammers often stay on the phone with you while you go to the store to buy gift cards. Hang up immediately. Legitimate agencies never do this.</p>
    </div>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Real-Life Examples — How This Works in Practice
    </h2>
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">Helen, 74 — Told to Pay the IRS</h3>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
        Helen received a call from someone claiming to be an IRS agent. They told her she owed back taxes and would be arrested unless she paid immediately. The caller instructed her to buy $1,500 in Google Play cards and read the numbers over the phone.
      </p>
      <p style="font-size: 1rem; color: #0A3D3A; font-weight: 700; margin-bottom: 0.5rem;">Action Taken:</p>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0;">
        Helen used a checklist like this one and realized the IRS never asks for gift cards. She hung up the phone and reported the call to the FTC, protecting her $1,500.
      </p>
    </div>
    
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">George, 69 — Grandson Emergency</h3>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
        George was instructed by someone claiming to be his grandson's lawyer to wire $3,200 for bail money after a supposed accident. The caller begged George not to tell his son or daughter.
      </p>
      <p style="font-size: 1rem; color: #0A3D3A; font-weight: 700; margin-bottom: 0.5rem;">Action Taken:</p>
      <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0;">
        George checked the payment method. The demand for a wire transfer to a stranger was a huge red flag. He hung up and called his grandson directly, learning that he was perfectly safe at home.
      </p>
    </div>
    <p style="font-size: 0.825rem; color: #4B5A6E; margin-top: 0.75rem; line-height: 1.6;">
      These are representative examples. Individual results vary. Always verify with official agencies before making decisions.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Common Mistakes and How to Avoid Them
    </h2>
    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Waiting to Report</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      Every hour you wait reduces the chance of fund recovery. If you sent a wire or read gift card numbers, time is of the essence. The fix is to contact the card issuer or your bank immediately, even if it is late at night.
    </p>
    
    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Assuming the Bank or Card Issuer Will Detect It</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      Many people assume that because a transaction is unusual, the bank or store will stop it. They often don't unless you specifically contact them and report the fraud. The fix is to be proactive and call them to flag the transaction as a scam.
    </p>

    <h3 style="font-size: 1.25rem; color: #0A3D3A; margin: 1rem 0 0.5rem 0;">Not Telling Family Members</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: 1rem;">
      Embarrassment stops many people from telling their family, which leaves them vulnerable to the same scammers calling back and asking for more money. The fix is to share what happened with someone you trust so they can help you block future calls.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FTC Gift Card Scam Guidance</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #4B5A6E;">Why scammers demand gift cards and what to do</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://consumer.ftc.gov/articles/gift-card-scams" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">consumer.ftc.gov</a></td>
          </tr>
          <tr style="background: #ffffff;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FTC Report Fraud</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #4B5A6E;">Federal fraud reporting portal</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://reportfraud.ftc.gov" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">reportfraud.ftc.gov</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. Not affiliated with any government agency, insurance company, or financial services firm. We do not receive payment for referrals.
    </p>
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/scam-message-call-decoder/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Scam Message/Call Decoder →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Analyze texts, emails, and calls to see if they match known scam patterns.</p>
      </a>
      <a href="/tools/is-this-real-letter-checker/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Is This Real Letter Checker →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Verify if physical mail you received is legitimate or a potential scam.</p>
      </a>
      <a href="/tools/family-trusted-contact-setup-guide/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Family Trusted Contact Setup Guide →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Set up safe contacts to help protect against future financial fraud.</p>
      </a>
    </div>
  </section>

  <DisclaimerBlock type="calculator" />
</ToolLayout>
