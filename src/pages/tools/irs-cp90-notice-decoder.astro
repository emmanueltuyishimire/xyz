/**
 * irs-cp90-notice-decoder.astro
 * Category: IRS Notices
 * Primary Keyword: cp90 notice
 * Title: IRS CP90 Notice Decoder — Social Security Levy Calculator | Seniors Audit (70 chars)
 * Meta Description: Free IRS CP90 notice decoder — see how to stop 15% Social Security benefit levies, calculate your 30-day CDP deadline, and file Form 12153. Updated 2026. No account needed. (154 chars)
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { CP90NoticeDecoder } from '@components/tools/CP90NoticeDecoder';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const title = 'IRS CP90 Notice Decoder — Social Security Levy Calculator | Seniors Audit';
const description = 'Free IRS CP90 notice decoder — see how to stop 15% Social Security benefit levies, calculate your 30-day CDP deadline, and file Form 12153. Updated 2026. No account needed.';
const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is a CP90 notice from the IRS?',
    answer: 'A CP90 notice is the IRS\'s Final Notice of Intent to Levy — the last letter the IRS sends before it begins seizing assets to collect an unpaid tax debt. For seniors, the most critical threat in a CP90 is the Federal Payment Levy Program (FPLP), which allows the IRS to automatically deduct up to 15% of your gross Social Security benefit each month until the balance is paid.',
  },
  {
    question: 'What is the difference between an IRS CP90 and a CP504 notice?',
    answer: 'A CP504 (Notice of Intent to Levy) warns that the IRS may seize your state tax refund. The CP90 is a final notice that specifically triggers your statutory right to request a Collection Due Process hearing under IRC Section 6330 before any levy action occurs. A CP90 is generally the most serious pre-levy notice and must be responded to within 30 days.',
  },
  {
    question: 'How many days do I have to respond to a CP90 notice?',
    answer: 'You have exactly 30 calendar days from the Notice Date printed on your CP90 to file IRS Form 12153 (Request for a Collection Due Process Hearing). Filing within this window legally suspends all levy action — including Social Security benefit deductions — while your hearing is pending with the IRS Office of Appeals.',
  },
  {
    question: 'Can the IRS take my Social Security benefits if I receive a CP90 notice?',
    answer: 'Yes. Under the Federal Payment Levy Program (FPLP), the IRS may automatically levy up to 15% of your gross Social Security benefit each month. However, if you file Form 12153 to request a Collection Due Process (CDP) hearing within the 30-day window on your CP90, the IRS must suspend all levy action — including the Social Security levy — while your appeal is pending.',
  },
  {
    question: 'What is IRS Form 12153 and how do I use it to stop a CP90 levy?',
    answer: 'IRS Form 12153 is the Request for a Collection Due Process or Equivalent Hearing. By filing this form within 30 days of your CP90 notice date, you formally invoke your right to appeal the levy with the IRS Office of Appeals. This filing legally halts all collection — including Social Security benefit deductions — until the IRS Appeals Office issues a ruling.',
  },
  {
    question: 'What happens if I miss the 30-day deadline on my CP90 notice?',
    answer: 'If you miss the 30-day Collection Due Process (CDP) window, you can still file Form 12153 within one year of the CP90 notice date to request an Equivalent Hearing. An Equivalent Hearing does not suspend the levy while pending, but it does give you a chance to negotiate payment options, installment agreements, or hardship status with an IRS Appeals Officer.',
  },
  {
    question: 'Is a CP90 notice legitimate or could it be a tax scam?',
    answer: 'Verify your CP90 by confirming: (1) It shows "Notice: CP90" in the upper right corner with your SSN last 4 digits. (2) It directs payment only to irs.gov/payments or "United States Treasury." (3) You can verify your actual IRS balance independently at irs.gov/account. The real IRS never requests payment via gift cards, wire transfers, or cryptocurrency.',
  },
  {
    question: 'What if I cannot afford to pay the balance on my CP90 notice?',
    answer: 'Even if you cannot pay, you have options. File Form 12153 immediately to request a CDP hearing — this stops the Social Security levy while you discuss your situation. During the hearing, you can request hardship status (Currently Not Collectible), an Installment Agreement, an Offer in Compromise, or innocent spouse relief depending on your circumstances.',
  },
];
