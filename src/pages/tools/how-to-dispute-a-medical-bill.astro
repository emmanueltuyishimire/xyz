---
import ToolLayout from '@layouts/ToolLayout.astro';
import { MedicalBillDisputeWizard } from '@components/tools/MedicalBillDisputeWizard';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'Am I legally entitled to an itemized hospital bill?',
    answer: 'Yes. Under federal Hospital Price Transparency guidance and state consumer protection rules, patients have a right to an itemized statement showing every service, code, and individual charge.',
  },
  {
    question: 'What is an Explanation of Benefits (EOB) and where do I get one?',
    answer: 'An EOB is a statement sent by Medicare or your insurer showing what was billed, approved, and paid. Medicare beneficiaries can view EOBs at medicare.gov or in quarterly Medicare Summary Notices.',
  },
  {
    question: 'How do I write a medical bill dispute letter?',
    answer: 'Include patient name, account number, date of service, specific line items being disputed, and clear reasons (e.g. duplicate, unrendered service). State that you expect a response in writing within 30 days.',
  },
  {
    question: 'What if the hospital ignores my dispute letter?',
    answer: 'Follow up by phone, keep written proof of mailing (certified mail receipt), and file a complaint with your state Department of Insurance, state Attorney General, or CMS if applicable.',
  },
  {
    question: 'Who do I contact if my insurer denies my appeal?',
    answer: 'You can request an external review by an independent third party or contact your state Department of Insurance consumer protection division.',
  },
  {
    question: 'What is the No Surprises Act and does it protect me in this dispute?',
    answer: 'The No Surprises Act protects against surprise out-of-network bills for emergency services and certain non-emergency services at in-network facilities without prior written consent.',
  },
  {
    question: 'How long do I have to dispute a medical bill?',
    answer: 'Insurance appeal deadlines are often 180 days from the initial denial or EOB date, though hospital billing dispute windows vary. Act as quickly as possible.',
  },
  {
    question: 'Can a SHIP counselor help me with a medical bill dispute?',
    answer: 'Yes. State Health Insurance Assistance Program (SHIP) counselors provide free, unbiased help with Medicare billing questions and appeals. Find local help at shiphelp.org.',
  },
];

const howToSteps = [
  { name: 'Request itemized bill', text: 'Call the billing department and ask for a fully itemized statement with CPT codes.' },
  { name: 'Compare to EOB', text: 'Compare each line item to your insurance Explanation of Benefits to find discrepancies.' },
  { name: 'Send dispute letter', text: 'Write a formal dispute letter citing specific items. Send by certified mail with return receipt.' },
  { name: 'Escalate if needed', text: 'If unresolved in 30 days, file complaint with your state Department of Insurance or CMS.' },
];
---

<ToolLayout
  title="Dispute a Medical Bill — Free | Seniors Audit"
  description="Free medical bill dispute wizard. Walk through each step from itemized bill request to state insurance regulator escalation. No account. Verified against CMS and CFPB guidance."
  faqs={faqs}
  howToSteps={howToSteps}
  datePublished="2026-07-01"
  dateModified="2026-07-29"
  agency="CMS"
  canonical="https://www.seniorsaudit.com/tools/how-to-dispute-a-medical-bill/"
  keywords="dispute medical bill, how to dispute hospital bill, medical bill dispute letter, hospital billing complaint, no surprises act complaint"
>
  <div style="margin-bottom: var(--space-8);">
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem; display:flex; flex-wrap:wrap; gap:0.25rem; align-items:center;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Dispute Medical Bill Wizard</span>
    </div>

    <h1 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: #0D2137; line-height: 1.2; margin-bottom: 0.5rem;">
      How to Dispute a Medical Bill: Free Step-by-Step Wizard
    </h1>
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">Figures and guidance last verified against official sources in {lastReviewed}.</p>

    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 0.75rem 0 1rem;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        To dispute a medical bill: (1) Request the fully itemized bill from the billing department. (2) Compare it line-by-line to your insurance Explanation of Benefits. (3) Write a formal dispute letter citing the specific error. (4) If unresolved, escalate to your state Department of Insurance or CMS. Studies show about one-third of patients who disputed a bill got it corrected.
      </p>
    </div>
  </div>

  <div style="background: var(--color-surface); border: 2px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); margin-bottom: var(--space-10); box-shadow: var(--shadow-md);" id="wizard">
    <MedicalBillDisputeWizard client:load />
  </div>

  <NoSignupStatement />

  <section style="margin-block: var(--space-10); padding-bottom: var(--space-8); border-bottom: 1px solid var(--color-border);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; font-weight: 800; margin-bottom: 1rem;">Frequently Asked Questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- RELATED TOOLS -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-tools-heading">
    <h2 id="related-tools-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Medical Bill & Healthcare Cost Tools
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/hospital-bill-line-item-checker/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Hospital Bill Line-Item Checker →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Review each charge on your hospital bill against common billing errors and overcharge patterns.</p>
      </a>
      <a href="/tools/medicare-advantage-vs-original-medicare-cost-checker/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Medicare Advantage vs. Original Medicare Cost Checker →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Compare your expected total annual out-of-pocket costs between Medicare Advantage and Original Medicare.</p>
      </a>
      <a href="/tools/medicare-savings-estimator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Medicare Savings Programs Estimator →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">See if your income qualifies you for help paying Medicare premiums, deductibles, and copays.</p>
      </a>
    </div>
  </section>

  <DisclaimerBlock
    type="calculator"
    agencyName="Centers for Medicare & Medicaid Services (CMS)"
    agencyPhone="1-800-633-4227"
    agencyUrl="https://www.medicare.gov"
    lastReviewed={lastReviewed}
  />
</ToolLayout>
