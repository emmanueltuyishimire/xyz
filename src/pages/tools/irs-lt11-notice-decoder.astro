---
/**
 * irs-lt11-notice-decoder.astro
 * Category: IRS Notices
 * Primary Keyword: lt11 notice
 * Title: IRS LT11 / Letter 1058 Decoder — Final Levy Notice | Seniors Audit (67 chars)
 * Meta Description: Free IRS LT11 and Letter 1058 notice decoder — check your 30-day CDP appeal deadline, stop benefit levies, and file Form 12153. No account needed. (150 chars)
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { LT11NoticeDecoder } from '@components/tools/LT11NoticeDecoder';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const title = 'IRS LT11 / Letter 1058 Decoder — Final Levy Notice | Seniors Audit';
const description = 'Free IRS LT11 and Letter 1058 notice decoder — check your 30-day CDP appeal deadline, stop benefit levies, and file Form 12153. No account needed.';
const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is an LT11 notice from the IRS?',
    answer: 'An LT11 notice (also called Letter 1058) is the IRS\'s "Final Notice of Intent to Levy and Notice of Your Right to a Hearing." It is the last required notice before the IRS can legally seize your wages, bank accounts, Social Security benefits, or other assets. It also triggers your 30-day right to request a Collection Due Process (CDP) hearing.',
  },
  {
    question: 'What is Letter 1058 from the IRS and is it the same as an LT11?',
    answer: 'Yes — Letter 1058 IRS and LT11 are two versions of the same final levy notice. LT11 is typically sent to taxpayers at the service center level; Letter 1058 is sent by IRS revenue officers in the field. Both carry identical legal weight and both trigger the 30-day CDP appeal window.',
  },
  {
    question: 'How long do I have to respond to an LT11 / Letter 1058?',
    answer: 'You have exactly 30 calendar days from the Notice Date on your LT11 or Letter 1058 to file IRS Form 12153 and request a Collection Due Process (CDP) hearing. Filing within this window legally suspends all IRS levy enforcement while your case is reviewed by the IRS Office of Appeals.',
  },
  {
    question: 'What is a Collection Due Process (CDP) hearing and will it stop a levy?',
    answer: 'A Collection Due Process (CDP) hearing is a formal appeal before the IRS Office of Appeals. When you timely file Form 12153 within the 30-day window, the IRS is legally required to pause all levy enforcement until Appeals issues a determination. At the hearing, you can dispute the tax amount, propose an installment plan, offer in compromise, or argue financial hardship.',
  },
  {
    question: 'What happens if I miss the 30-day CDP deadline on my LT11 notice?',
    answer: 'If you miss the 30-day deadline, you lose your right to a CDP hearing that stops levy action. You may still request an Equivalent Hearing (also using Form 12153) within one year of the LT11 date, but an Equivalent Hearing does NOT suspend levy enforcement. The IRS can proceed with levies while your Equivalent Hearing is pending.',
  },
  {
    question: 'Can the IRS levy my Social Security after sending an LT11?',
    answer: 'Yes. After issuing an LT11 / Letter 1058 without a timely CDP response, the IRS can levy up to 15% of your monthly Social Security retirement or disability benefit under the Federal Payment Levy Program (FPLP). This is continuous — 15% is withheld every month until the debt is paid or resolved.',
  },
  {
    question: 'What is IRS Form 12153 and how do I file it for an LT11?',
    answer: 'IRS Form 12153 is the "Request for a Collection Due Process or Equivalent Hearing." To file it for an LT11: download the form at irs.gov/forms, complete it with your name, SSN, the tax years shown on the LT11, and your reason for requesting a hearing. Mail it via USPS Certified Mail with Return Receipt to the IRS address printed on your LT11 before the 30-day deadline.',
  },
];
---

<ToolLayout
  title={title}
  description={description}
  schema="HowTo"
  howToSteps={[
    { name: "Step 1 — Locate your LT11 / Letter 1058 Notice Date", text: "Find the Notice Date printed at the top right corner of page 1 of your LT11 or Letter 1058." },
    { name: "Step 2 — Calculate your 30-day CDP appeal deadline", text: "Add 30 calendar days to establish your deadline to file IRS Form 12153." },
    { name: "Step 3 — Complete Form 12153 requesting a CDP hearing", text: "Fill out Form 12153 to invoke your statutory right under IRC §6330 and halt all IRS levy actions." },
    { name: "Step 4 — Mail Form 12153 via Certified Mail with Return Receipt", text: "Send your completed appeal form to the specific IRS return address on your notice via USPS Certified Mail." }
  ]}
>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 2 — PAGE HERO SECTION
       ═══════════════════════════════════════════════════════ -->
