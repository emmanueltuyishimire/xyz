  /* Sources Table */
  .sp-table-wrap { overflow-x: auto; margin-top: var(--space-5); }
  .sp-sources-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .sp-sources-table thead tr { background: #0A3D3A; }
  .sp-sources-table th { padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700; }
