            <td>Pension plan administrator / HR department</td>
          </tr>
          <tr>
            <td><strong>Nonperiodic IRA / 401(k) Withdrawals</strong></td>
            <td>Form W-4R</td>
            <td>0% to 100% (default is 10%)</td>
            <td>IRA custodian / Brokerage firm</td>
          </tr>
