import ToolLayout from '@layouts/ToolLayout.astro';
import { ExtraHelpEligibilityCalculator as LISTool } from '@components/tools/ExtraHelpEligibilityCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is the Medicare Extra Help (LIS) program?',
    answer: 'Medicare Extra Help — officially known as the Low Income Subsidy (LIS) — is a federal program administered by Social Security that helps Medicare beneficiaries with limited income and resources pay for Medicare Part D prescription drug costs, including plan premiums, deductibles, and copayments. In 2026, it is worth an estimated $5,900 per year per beneficiary.',
  },
  {
    question: 'What are the 2026 income and asset limits for Medicare Extra Help?',
    answer: 'In 2026, to qualify for Full Extra Help: A single individual must have gross monthly income under ~$1,985 ($23,820/year) and countable assets under $17,220 (or $18,720 including burial funds). A married couple living together must have monthly income under ~$2,685 ($32,220/year) and countable assets under $34,360 (or $37,360 including burial funds).',
  },
  {
    question: 'What assets count toward the Medicare Extra Help resource limit?',
    answer: 'Countable assets include cash, bank checking and savings accounts, stocks, bonds, mutual funds, and IRAs/401(k)s. The IRS and SSA do NOT count your primary home, one vehicle, household items, personal effects, or up to $1,500 per person set aside for burial expenses.',
  },
  {
    question: 'How much does Extra Help save on Medicare prescription drugs?',
    answer: 'If you qualify for Full Extra Help in 2026: Your monthly Part D plan premium is reduced to $0 (for benchmark plans), your annual drug deductible is $0, and your prescription copays are capped at no more than $4.90 for generic drugs and $12.15 for brand-name drugs. Once your out-of-pocket costs reach the catastrophic phase, your copays drop to $0 for the rest of the year.',
  },
  {
    question: 'Do I automatically qualify for Extra Help if I have Medicaid or MSP?',
    answer: 'Yes. If you are enrolled in Full Medicaid, a Medicare Savings Program (QMB, SLMB, or QI), or receive Supplemental Security Income (SSI), you automatically qualify for Medicare Extra Help without needing to file a separate application.',
  },
  {
    question: 'How do I apply for Medicare Extra Help?',
    answer: 'You can apply for Extra Help online at ssa.gov/extrahelp, call Social Security at 1-800-772-1213 (TTY 1-800-325-0778), or visit your local Social Security field office. The application is completely free and takes about 15 minutes to complete.',
  },
  {
    question: 'Does Extra Help eliminate Part D late enrollment penalties?',
    answer: 'Yes. If you delayed enrolling in Medicare Part D and accrued a late enrollment penalty, qualifying for Extra Help permanently waives your Part D penalty for as long as you maintain Extra Help status.',
  },
  {
    question: 'Can I switch Medicare Part D plans if I have Extra Help?',
    answer: 'Yes. Beneficiaries with Extra Help receive a Special Enrollment Period (SEP) that allows them to switch Medicare Part D prescription drug plans or Medicare Advantage plans once per calendar quarter during the first nine months of the year (Jan–March, April–June, July–Sept).',
  },
];
---

<ToolLayout
  title="Extra Help (LIS) Eligibility Calculator — Free 2026 | Seniors Audit"
  description="Free Medicare Extra Help (LIS) eligibility calculator — 2026 income & asset limits for Part D drug cost savings up to $5,900/year. No account needed."
  faqs={faqs}
  schema="HowTo"
  howToSteps={[
    { name: "Step 1 — Enter your household size and monthly income", text: "Select whether you are single or married and enter your total monthly gross income from all sources including Social Security, pensions, wages, and investment income." },
    { name: "Step 2 — Enter your countable assets", text: "Enter the total value of bank accounts, stocks, bonds, and retirement accounts. Do NOT include your primary home, one vehicle, or personal belongings." },
    { name: "Step 3 — Review your eligibility result and tier", text: "The calculator shows whether you qualify for Full Extra Help and compares your income and assets to the official 2026 SSA thresholds." },
    { name: "Step 4 — Apply through SSA if eligible", text: "Apply at ssa.gov/extrahelp, call 1-800-772-1213, or visit your local Social Security office. The application is free and takes about 15 minutes." }
  ]}
>

  <!-- ELEMENT 2 — HERO -->
  <div class="ehc-hero">
    <div class="ehc-breadcrumb">
      <a href="/medicare/" class="ehc-breadcrumb-link">Medicare</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="ehc-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Extra Help Eligibility Calculator</span>
    </div>

    <h1 class="ehc-h1">
      Extra Help (LIS) Eligibility Calculator — Lower Medicare Drug Costs Up to $5,900/Year
    </h1>
    <p class="ehc-date">Figures last verified against SSA and Medicare.gov sources in {lastReviewed}.</p>

    <div class="ehc-aeo-block" role="note" aria-label="Quick Answer">
      <p class="ehc-aeo-label">Quick Answer</p>
      <p class="ehc-aeo-text">
        Medicare Extra Help (officially the Low Income Subsidy or LIS) pays your <a href="/tools/medicare-part-d-late-enrollment-penalty-calculator/" class="ehc-aeo-link">Part D</a> plan premium, eliminates the drug deductible, and caps copays at <strong class="ehc-gold">$4.90 generics / $12.15 brand-name</strong> drugs in 2026. Single filer income limit: <strong class="ehc-gold">~$1,985/month</strong>. Married couple limit: <strong class="ehc-gold">~$2,685/month</strong>. If you have Medicaid, SSI, or a <a href="/tools/medicare-savings-estimator/" class="ehc-aeo-link">Medicare Savings Program</a>, you qualify automatically — no application needed.
      </p>
    </div>

    <p class="ehc-problem">
      Millions of Medicare beneficiaries who qualify for Extra Help never apply — either because they don't know the program exists, or because they assume their income or assets are too high. The asset rules exclude your home, one car, and personal belongings. Even if you were previously denied, limits increase annually and a re-application takes 15 minutes. This free calculator applies the official 2026 SSA thresholds to your specific situation in seconds.
    </p>

    <ul class="ehc-who-list" aria-label="Who this tool is for">
      <li class="ehc-who-item"><span class="ehc-arrow" aria-hidden="true">→</span> Medicare beneficiaries spending more than $50/month on Part D prescriptions who want to check whether they qualify for <a href="/tools/medicare-donut-hole-calculator/" class="ehc-inline-link">drug cost reductions</a>.</li>
      <li class="ehc-who-item"><span class="ehc-arrow" aria-hidden="true">→</span> Seniors who previously received a denial letter from SSA for Extra Help and want to re-check eligibility under updated 2026 income and asset thresholds.</li>
      <li class="ehc-who-item"><span class="ehc-arrow" aria-hidden="true">→</span> Caregivers helping a parent who has Medicaid or an <a href="/tools/medicare-savings-estimator/" class="ehc-inline-link">MSP (Medicare Savings Program)</a> and may already qualify automatically without knowing it.</li>
    </ul>
  </div>

  <!-- ELEMENT 3 — INTERACTIVE TOOL -->
  <div class="ehc-tool-block" id="calculator">
    <LISTool client:load />
  </div>

  <NoSignupStatement />

  <!-- ELEMENT 4 — HOW TO USE -->
  <section class="ehc-section" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading">How to Use This Extra Help Eligibility Calculator</h2>
    <ol class="ehc-steps">
      <li><strong>Step 1 — Enter your household size and total monthly income.</strong> Select single or married. Enter your combined gross monthly income from all sources: Social Security benefits (full amount before Medicare deductions), any pension, wages, interest, dividends, and rental income. Do not subtract Medicare premiums — enter gross figures.</li>
      <li><strong>Step 2 — Enter your countable assets.</strong> Add up cash, checking and savings balances, CDs, stocks, bonds, mutual funds, and IRA/401(k) values. Do <em>not</em> count your primary home, one vehicle, household furniture, personal belongings, or up to $1,500 per person designated for burial. These are excluded by SSA regulation.</li>
      <li><strong>Step 3 — Read your eligibility result.</strong> The calculator compares your inputs to the official 2026 SSA income and asset thresholds and tells you whether you likely qualify for Full Extra Help, Partial Extra Help, or neither — along with the specific threshold you're above or below.</li>
      <li><strong>Step 4 — Apply immediately if eligible.</strong> Apply online at <a href="https://www.ssa.gov/extrahelp" target="_blank" rel="noopener noreferrer">ssa.gov/extrahelp</a>, call 1-800-772-1213, or walk into any Social Security field office. The application is free, takes roughly 15 minutes, and requires no documents at the time of filing — SSA verifies income with the IRS directly.</li>
    </ol>

    <div class="ehc-pro-tip">
      <p class="ehc-tip-label">💡 Pro Tip</p>
      <p class="ehc-tip-text">If you have Medicaid, SSI, or a <a href="/tools/medicare-savings-estimator/" class="ehc-tip-link">Medicare Savings Program (QMB, SLMB, or QI)</a>, you already qualify for Extra Help automatically — SSA is notified by your state and enrolls you without a separate application. Check your Medicare plan documents or call 1-800-MEDICARE to confirm your current LIS status before applying.</p>
    </div>

