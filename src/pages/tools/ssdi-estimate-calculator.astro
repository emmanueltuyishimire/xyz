---
/**
 * ssdi-estimate-calculator.astro
 * Tool: SSDI Benefit Estimate Calculator
 * Category: Social Security
 * Primary keyword: ssdi estimate calculator
 * Supporting keywords: ssdi benefit calculator, social security disability estimate 2026, ssdi monthly check amount
 *
 * URL: /tools/ssdi-estimate-calculator/
 * Title: SSDI Benefit Estimate Calculator 2026 — Free | Seniors Audit (63 chars ✓)
 * Description: Estimate your Social Security Disability Insurance (SSDI) monthly benefit using your work history. 2026 average check: $1,580/mo. Free, no account. (150 chars ✓)
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { SSDIEstimateCalculator as SSDITool } from '@components/tools/SSDIEstimateCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const faqs = [
  {
    question: 'What is the average SSDI monthly benefit in 2026?',
    answer: 'The average monthly Social Security Disability Insurance (SSDI) benefit for all disabled workers in 2026 is approximately $1,580. However, individual benefit amounts vary significantly based on each person\'s Average Indexed Monthly Earnings (AIME) from their work history.',
  },
  {
    question: 'How is the SSDI benefit amount calculated?',
    answer: 'SSDI benefits are calculated the same way as regular Social Security retirement benefits: SSA computes your Average Indexed Monthly Earnings (AIME) from your covered work history and applies the progressive Primary Insurance Amount (PIA) bend point formula to determine your monthly benefit.',
  },
  {
    question: 'How many work credits do I need to qualify for SSDI?',
    answer: 'You generally need 40 Social Security work credits, 20 of which must have been earned in the 10 years immediately before your disability began. Younger workers may qualify with fewer credits. You earn up to 4 credits per year ($1,810 per credit in 2026).',
  },
  {
    question: 'When does Medicare coverage begin after receiving SSDI?',
    answer: 'Medicare eligibility begins after a mandatory 24-month waiting period following your first SSDI benefit payment. During the waiting period, explore your state\'s Medicaid program for coverage through healthcare.gov.',
  },
  {
    question: 'What is the 2026 Substantial Gainful Activity (SGA) limit for SSDI?',
    answer: 'In 2026, the Substantial Gainful Activity (SGA) limit for non-blind individuals is $1,620 per month gross earned income. Earning above this threshold may result in suspension or termination of SSDI benefits. The SGA limit for blind recipients is $2,700/month in 2026.',
  },
];
---

<ToolLayout
  title="SSDI Benefit Estimate Calculator 2026 — Free | Seniors Audit"
  description="Estimate your Social Security Disability Insurance (SSDI) monthly benefit using your work history. 2026 average check: $1,580/mo. Free, no account."
  faqs={faqs}
>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 2 — HERO SECTION
       ═══════════════════════════════════════════════════════ -->
  <div class="ssdi-hero" style="margin-bottom: var(--space-8);">
    <!-- Breadcrumb -->
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/social-security/" style="color: #0A3D3A; text-decoration: underline;">Social Security</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>SSDI Estimate Calculator</span>
    </div>

    <!-- H1 — Primary Keyword -->
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      SSDI Benefit Estimate Calculator 2026: How Much Will I Receive?
    </h1>

    <!-- Last Verified Date -->
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>

    <!-- AEO Quick Answer Block -->
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        The 2026 average SSDI monthly benefit is <strong style="color: #C9933A;">$1,580/month</strong>. Your personal benefit is calculated using the same PIA bend-point formula as retirement benefits, based on your average indexed monthly earnings (AIME). SSDI is paid at your <strong style="color: #C9933A;">full PIA with no age reduction</strong>. Medicare coverage begins 24 months after your first SSDI payment.
      </p>
    </div>

    <!-- Problem Statement -->
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      Adults facing a disability need to quickly understand their projected SSDI monthly check before applying, so they can plan financially. The SSA's online calculator requires a <em>my Social Security</em> account login. We built this independent estimator to give you an instant, private estimate without any registration requirement.
    </p>

    <!-- Who This Tool Is For -->
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Adults considering an SSDI application who want to estimate their monthly income replacement.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Spouses and family members planning for dependent auxiliary benefit eligibility.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Anyone wanting to understand when Medicare coverage begins during the 24-month waiting period.
      </li>
    </ul>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 3 — THE INTERACTIVE TOOL
       ═══════════════════════════════════════════════════════ -->
  <div style="margin-bottom: var(--space-8);">
    <SSDITool client:load />
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — NO SIGNUP COMPETITIVE POSITIONING
       ═══════════════════════════════════════════════════════ -->
  <NoSignupStatement />

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 4 — HOW TO USE THIS TOOL
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Calculator — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enter your average annual earnings.</strong> Input your typical annual wages from employment during your working years (before the disability).
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Select years of covered work.</strong> Choose the approximate number of years you paid into Social Security through FICA payroll taxes.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enter your current age.</strong> Age helps confirm work credit eligibility thresholds.
      </li>
      <li style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Check dependent children if applicable.</strong> Indicate qualifying children under 18 to see auxiliary benefit estimates.
      </li>
    </ol>

    <!-- Pro Tip -->
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">
        Get your personalized official SSDI benefit estimate by logging into <em>my Social Security</em> at <a href="https://www.ssa.gov/myaccount" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A;">ssa.gov/myaccount</a> and viewing your Social Security Statement. Your statement includes your exact AIME and PIA calculated from your actual earnings record.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 6 — COMMON PITFALLS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Common SSDI Application Mistakes to Avoid
    </h2>

    <h3 style="font-size: 1.1rem; color: #0D2137; margin: 1.25rem 0 0.5rem 0;">Filing Too Late After the Disability Begins</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0 0 0.75rem 0;">
      SSDI retroactive benefits are limited to 12 months before the filing date. Waiting years to apply forfeits months of back pay you are legally owed from your established onset date.
    </p>

    <h3 style="font-size: 1.1rem; color: #0D2137; margin: 1.25rem 0 0.5rem 0;">Assuming One Denial Is Final</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0 0 0.75rem 0;">
      Approximately 64% of initial SSDI applications are denied. Most approvals happen at the ALJ (Administrative Law Judge) hearing level after 2 or 3 appeals. File your Request for Reconsideration within 60 days of any denial — never miss this deadline.
    </p>

    <h3 style="font-size: 1.1rem; color: #0D2137; margin: 1.25rem 0 0.5rem 0;">Earning Above the Substantial Gainful Activity Limit While Applying</h3>
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 0;">
      Earning more than $1,620/month (2026 SGA limit) while your application is pending signals to SSA that you are not disabled and will result in automatic denial. Track income carefully during the application process.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 7 — OFFICIAL SOURCES TABLE
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">SSA — Understanding the Benefits (Publication No. 05-10029)</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">2026 SSDI PIA bend points ($1,226 / $7,391), work credit requirements, and 24-month Medicare waiting period rules</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.ssa.gov/pubs/EN-05-10029.pdf" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">SSA Pub 05-10029</a></td>
          </tr>
          <tr style="background: #fff;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">SSA 2026 SGA Amounts</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">2026 Substantial Gainful Activity limits ($1,620/mo non-blind, $2,700/mo blind)</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.ssa.gov/oact/cola/sga.html" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">ssa.gov/oact/cola/sga.html</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. We are not affiliated with, endorsed by, or connected to the Social Security Administration.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 8 — FAQ SECTION WITH SCHEMA
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions About SSDI Benefits
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 9 — RELATED TOOLS
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Social Security Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/social-security-benefits-estimator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Social Security Retirement Benefit Estimator &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Compare your monthly check amounts at age 62, 67, or 70.</p>
      </a>
      <a href="/tools/extra-help-eligibility-calculator/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Extra Help (LIS) Eligibility Calculator &rarr;</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Check if you qualify for low-income drug subsidy during the SSDI waiting period.</p>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 10 — EDUCATIONAL DISCLAIMER
       ═══════════════════════════════════════════════════════ -->
  <DisclaimerBlock type="calculator" />

</ToolLayout>
