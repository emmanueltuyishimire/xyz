---
/**
 * irs-cp2000-response-guide.astro
 * CP2000 Notice Decoder & Response Guide
 * Category: IRS Notices
 * Primary keyword: what is a cp2000 notice
 * Supporting keywords: cp2000 letter, irs cp2000, cp2000 notice,
 *   irs cp2000 response, cp2000 response letter sample, notice cp2000
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { CP2000NoticeDecoder } from '@components/tools/CP2000NoticeDecoder';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is a cp2000 notice from the IRS?',
    answer: 'What is a cp2000 notice? A CP2000 notice is an automated proposal letter issued by the IRS when their Automated Underreporter (AUR) computer finds a mismatch between the income reported on your tax return and the income reported by banks, employers, or financial institutions on 1099 or W-2 forms. It is NOT a formal bill or tax audit.',
  },
  {
    question: 'Is an irs cp2000 notice a tax audit or tax bill?',
    answer: 'No. An irs cp2000 is not a tax audit, nor is it a final tax bill. It is an initial notice of proposed adjustment. The IRS is informing you of a potential discrepancy and giving you 30 days to agree, disagree, or provide additional documentation before any tax is formally assessed.',
  },
  {
    question: 'How do I submit an irs cp2000 response before the deadline?',
    answer: 'To submit an irs cp2000 response, complete and sign the Response Form attached to page 1 of your CP2000 letter. Check Option 1 if you agree, or Option 2 if you disagree. If disputing, attach supporting documentation (such as Form 5498 or bank records) and mail your response package via Certified Mail within 30 days of the Notice Date.',
  },
  {
    question: 'Where can I find a cp2000 response letter sample to dispute the notice?',
    answer: 'You can use our free tool above to generate a cp2000 response letter sample customized to your missing income type (such as 1099-R IRA rollovers, 1099-B stock sales, or 1099-SSA benefits). A good dispute letter states your disagreement, explains the non-taxable reason, and lists your attached proof.',
  },
  {
    question: 'What happens if I ignore a notice cp2000 or miss the 30-day deadline?',
    answer: 'If you ignore a notice cp2000 or fail to respond within 30 days, the IRS will automatically assess the proposed tax, interest, and penalties, and issue a formal Statutory Notice of Deficiency (CP3219A). At that point, your only remaining dispute option is filing a petition with the U.S. Tax Court within 90 days.',
  },
  {
    question: 'Why did I get a cp2000 letter for a non-taxable IRA rollover?',
    answer: 'A cp2000 letter for an IRA rollover usually occurs because the financial institution reported the withdrawal on Form 1099-R, but your tax preparer failed to properly record the rollover on Line 4a/4b of Form 1040, or your Form 5498 showing the deposit was processed after your return.',
  },
  {
    question: 'Why did the IRS issue a CP2000 for a stock or mutual fund sale (Form 1099-B)?',
    answer: 'When a broker sends Form 1099-B to the IRS, they report your gross proceeds from stock sales. If you forgot to report the sale on Schedule D/Form 8949, the IRS computer assumes your cost basis was $0 and treats the entire sale proceeds as taxable profit. Providing your original purchase cost basis resolves the CP2000.',
  },
];

// FAQPage JSON-LD schema
const faqSchemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': f.answer },
  })),
});
