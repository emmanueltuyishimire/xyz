          <span class="surv-related-btn">Use This Free Tool</span>
          <span class="surv-no-acct">No account needed</span>
        </div>
      </a>

      <a href="/tools/social-security-full-retirement-age-calculator/" class="surv-related-card">
        <span class="surv-related-icon">📅</span>
        <div>
