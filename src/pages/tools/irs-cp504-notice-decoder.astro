  .cp504-scenario-disclaimer { font-size: 0.8rem; color: #4B5A6E; margin-top: var(--space-6); line-height: 1.6; }

  /* Sources Table */
  .cp504-table-wrap { overflow-x: auto; margin-top: var(--space-5); }
  .cp504-sources-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .cp504-sources-table thead tr { background: #0A3D3A; }
  .cp504-sources-table th { padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700; }
  .cp504-sources-table td { padding: 0.75rem 1rem; color: #0D2137; vertical-align: top; border-bottom: 1px solid #DDE3EA; }
  .cp504-sources-table a { color: #0A3D3A; text-decoration: underline; }
  .cp504-row-alt { background: #f6f8fa; }
  .cp504-independence { font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6; max-width: 70ch; }

