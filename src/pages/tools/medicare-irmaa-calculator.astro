---
/**
 * medicare-irmaa-calculator.astro
 * IRMAA Calculator (Multi-Year)
 * Category: Medicare
 * Primary keyword: irmaa calculator
 * Supporting keywords: medicare irmaa calculator, how to calculate irmaa, irmaa calculation 2025, medicare part b irmaa calculator
 *
 * 2026 Official Figures — verify annually from:
 *   https://www.cms.gov/newsroom/fact-sheets/2026-medicare-parts-b-premiums-and-deductibles
 *   Standard Part B Premium 2026: $202.90
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { IRMAACalculatorMultiYear } from '@components/tools/IRMAACalculatorMultiYear';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const lastReviewed = 'July 2026';
const STANDARD_PART_B_2026 = '$202.90';

const faqs = [
  {
    question: 'What is an IRMAA calculator and how does it work?',
    answer: 'An irmaa calculator determines whether your income triggers an Income-Related Monthly Adjustment Amount (IRMAA) surcharge on your Medicare Part B and Part D premiums. It takes your Modified Adjusted Gross Income (MAGI) from two years prior and your tax filing status, compares your income to official CMS brackets, and calculates your exact monthly surcharge.',
  },
  {
    question: 'How do I use this medicare irmaa calculator?',
    answer: 'To use this medicare irmaa calculator, select your tax filing status (Single, Married Filing Jointly, or Married Filing Separately) and enter your MAGI from two years ago (e.g. 2024 tax return for 2026 Medicare premiums). You can also toggle the multi-year option to enter a projected income for next year to compare surcharges side-by-side.',
  },
  {
    question: 'How to calculate irmaa for my Medicare premiums?',
    answer: 'To learn how to calculate irmaa, look at Line 11 (AGI) on your IRS Form 1040 from two years prior and add any tax-exempt interest (Line 2a) to get your MAGI. Locate your income in the official CMS bracket table for your filing status. If your MAGI exceeds $106,000 (Single) or $212,000 (Joint) in 2026, add the corresponding Tier 1 through Tier 5 monthly surcharge to your standard Part B premium.',
  },
  {
    question: 'What is the difference between irmaa calculation 2025 and 2026 rules?',
    answer: 'The core mechanics of the irmaa calculation 2025 and 2026 remain the same, but CMS updates the income threshold brackets and standard premium amounts annually for inflation. For 2026, the standard Part B premium is $202.90, and the initial IRMAA threshold begins at $106,000 for single filers and $212,000 for joint filers.',
  },
  {
    question: 'How does the medicare part b irmaa calculator compute Part B surcharges?',
    answer: 'The medicare part b irmaa calculator matches your income to one of five CMS tiers above the standard rate. In 2026, Tier 1 adds $81.20/month, Tier 2 adds $202.90/month, Tier 3 adds $324.60/month, Tier 4 adds $446.30/month, and Tier 5 adds $486.90/month on top of the $202.90 standard Part B premium.',
  },
  {
    question: 'What tax return year determines my 2026 IRMAA surcharge?',
    answer: 'Social Security uses your tax return from two years prior to determine your current benefit year\'s IRMAA. For your 2026 Medicare premiums, Social Security uses your 2024 tax return (filed in 2025). If you experience a life-changing event in 2025 or 2026 that lowers your income, you can appeal using Form SSA-44.',
  },
  {
    question: 'How can I appeal or lower my IRMAA surcharge using Form SSA-44?',
    answer: 'If your income dropped due to a qualifying life-changing event — such as retirement, work reduction, marriage, divorce, or loss of income-producing property — you can file Form SSA-44 (Medicare Income-Related Monthly Adjustment Amount - Life-Changing Event) with Social Security. Provide proof of your event and new estimated income to request a lower bracket.',
  },
];

// FAQPage JSON-LD schema
const faqSchemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': f.answer },
  })),
});
---

<ToolLayout
  title="IRMAA Calculator 2026 — Medicare Surcharg | Seniors Audit"
  description="See your Medicare IRMAA surcharge for 2026: from $81.20/mo (Tier 1) up to $443.90/mo (Tier 5). Enter your income — no account, no signup required."
  faqs={faqs}
>

  <!-- ═══════════════════════════════════════════════════════
       1. HERO HEADER (Primary Keyword in H1)
       ═══════════════════════════════════════════════════════ -->
  <div class="irmaa-hero">
    <div class="irmaa-breadcrumb">
      <a href="/medicare/" class="irmaa-breadcrumb-link">Medicare</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="irmaa-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>IRMAA Calculator</span>
    </div>

