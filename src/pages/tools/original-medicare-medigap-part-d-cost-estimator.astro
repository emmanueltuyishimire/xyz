        deductible = PART_B_DEDUCTIBLE;  /* $283 — FACT */
        var officeV = parseInt(($('omm-office-visits') || {}).value) || 6;
        var erV     = parseFloat(($('omm-er-visits')     || {}).value) || 0.3;
        copayExp = Math.round(officeV * 20 + erV * 50);  /* ESTIMATE */
      }

      /* ── Part D ──────────────────────────────────── */
      var partDBaseAnnual  = PART_D_BASE_MONTHLY * 12;      /* $467.88 — ESTIMATE (varies by plan) */
      var partDIrmaaAnnual = irmaaPartDMonthly   * 12;      /* FACT if irmaa=yes */
      var drugRange        = DRUG_COST[drug] || DRUG_COST.none;
      var partDLow  = Math.round(partDBaseAnnual + partDIrmaaAnnual + drugRange.low);
      var partDHigh = Math.round(partDBaseAnnual + partDIrmaaAnnual + drugRange.high);

      /* ── Totals ───────────────────────────────────── */
      var totalLow  = Math.round(partBAnnual + partBIrmaaAnnual + mgLow  + deductible + copayExp + partDLow);
      var totalHigh = Math.round(partBAnnual + partBIrmaaAnnual + mgHigh + deductible + copayExp + partDHigh);

      /* ── Render results ─────────────────────────── */
      var res = $('omm-results');
      res.style.display = 'block';

      /* ── State-specific note ────────────────────── */
      var stateNoteEl = $('omm-state-note');
      if (stateNoteEl) {
        if (stateRule && stateRule.note) {
          var regTag = stateRule.regulated ? '<strong>\u26a0\ufe0f ' + state + ' has special Medigap pricing rules.</strong> ' : '<strong>\ud83d\udccd ' + state + ' note:</strong> ';
          stateNoteEl.innerHTML = regTag + stateRule.note;
          stateNoteEl.style.display = 'block';
        } else if (state) {
          stateNoteEl.innerHTML = '\ud83d\udccd Medigap estimate adjusted for <strong>' + state + '</strong> market pricing. Verify real quotes at <a href="https://www.medicare.gov/plan-compare" target="_blank" rel="noopener noreferrer">medicare.gov/plan-compare</a>.';
          stateNoteEl.style.display = 'block';
        } else {
          stateNoteEl.style.display = 'none';
        }
      }

      $('omm-total-low').textContent  = fmt(totalLow);
      $('omm-total-high').textContent = fmt(totalHigh);
      $('omm-monthly-low').textContent  = fmt(Math.round(totalLow  / 12));
      $('omm-monthly-high').textContent = fmt(Math.round(totalHigh / 12));

      /* Part B rows */
      $('omm-partb-base').textContent = fmt(partBAnnual);
      var irmaaBRow = $('omm-partb-irmaa-row');
      if (partBIrmaaAnnual > 0) {
        $('omm-partb-irmaa').textContent = fmt(partBIrmaaAnnual);
        irmaaBRow.style.display = '';
      } else {
        irmaaBRow.style.display = 'none';
      }

      /* Medigap row */
      var planLabels = { g: 'Plan G', n: 'Plan N', unsure: 'Plan G or N (range)' };
      $('omm-medigap-plan-label').textContent = 'Medigap ' + (planLabels[plan] || '') + ' Premium';
      $('omm-medigap-range').textContent = fmtRange(mgLow, mgHigh);

      /* Plan N specific rows */
      $('omm-deductible-row').style.display = (plan === 'n') ? '' : 'none';
      $('omm-copay-row').style.display      = (plan === 'n') ? '' : 'none';
      if (plan === 'n') {
        $('omm-deductible').textContent = fmt(deductible);
        $('omm-copay').textContent      = fmt(copayExp) + ' (estimated)';
      }

      /* Part D rows */
      $('omm-partd-base').textContent = fmtRange(partDLow, partDHigh);
      var irmaaDRow = $('omm-partd-irmaa-row');
      if (partDIrmaaAnnual > 0) {
        $('omm-partd-irmaa').textContent = fmt(partDIrmaaAnnual);
        irmaaDRow.style.display = '';
      } else {
        irmaaDRow.style.display = 'none';
      }

      /* Drug costs */
      var drugLabel;
      if (drug === 'none')     drugLabel = '$0';
      else if (drug === 'high') drugLabel = fmt(PART_D_OOP_CAP) + ' (2026 annual cap)';
      else                      drugLabel = fmtRange(drugRange.low, drugRange.high);
      $('omm-drug-costs').textContent = drugLabel;

      /* Plan fit note — informational, never a directive recommendation */
      var fitNote = $('omm-plan-fit-note');
      if (plan === 'n' && copayExp > 0) {
        fitNote.textContent = 'Based on your visit estimates, your Plan N copay exposure is approximately '
          + fmt(copayExp) + '/year. If your actual visits are lower, Plan N may fit better based on what you selected. If visits are higher, Plan G\u2019s no-copay structure may result in lower net cost.';
      } else if (plan === 'unsure') {
        fitNote.textContent = 'This range shows the span from a lower-premium Plan N scenario to a fully comprehensive Plan G scenario. A SHIP counselor can help you decide which fits your health usage patterns.';
      } else {
        fitNote.textContent = '';
      }

      /* Scroll to results */
      res.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ─── Reset ──────────────────────────────────── */
    function resetTool() {
      var form = $('omm-form');
      if (form) form.reset();
      var res = $('omm-results');
      if (res) res.style.display = 'none';
      var irmaaSection = $('omm-irmaa-section');
      if (irmaaSection) irmaaSection.style.display = 'none';
      var planNSection = $('omm-plann-visits');
      if (planNSection) planNSection.style.display = 'none';
      var ageDisp = $('omm-age-display');
      if (ageDisp) ageDisp.style.display = 'none';
      clearErrors();
      var container = $('omm-tool-container');
      if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ─── Init ───────────────────────────────────── */
    document.addEventListener('DOMContentLoaded', function () {
      /* DOB live age update */
      var dobMonth = $('omm-dob-month');
      var dobDay   = $('omm-dob-day');
      var dobYear  = $('omm-dob-year');
      if (dobMonth) dobMonth.addEventListener('change', updateAgeDisplay);
      if (dobDay)   dobDay.addEventListener('change',   updateAgeDisplay);
      if (dobYear)  dobYear.addEventListener('input',   updateAgeDisplay);
      /* Populate days immediately when month changes */
      if (dobMonth) dobMonth.addEventListener('change', populateDays);
      if (dobYear)  dobYear.addEventListener('input',   populateDays);

      /* Radio toggles */
      $$('input[name="omm-irmaa"]').forEach(function(r) {
        r.addEventListener('change', toggleIrmaa);
      });
      $$('input[name="omm-plan"]').forEach(function(r) {
        r.addEventListener('change', togglePlanN);
      });

      /* Filing status change re-populates bracket dropdown */
      var filingStatus = $('omm-filing-status');
      if (filingStatus) filingStatus.addEventListener('change', populateBrackets);

      /* Buttons */
      var calcBtn  = $('omm-calc-btn');
      var resetBtn = $('omm-reset-btn');
      if (calcBtn)  calcBtn.addEventListener('click', calculate);
      if (resetBtn) resetBtn.addEventListener('click', resetTool);

      /* Keyboard accessibility */
      $$('#omm-form input, #omm-form select').forEach(function(el) {
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); calculate(); }
        });
      });
    });

  })();
  </script>

</ToolLayout>
