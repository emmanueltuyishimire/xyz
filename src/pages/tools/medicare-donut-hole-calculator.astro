const howToSteps = [
  {
    name: 'Find your current out-of-pocket drug spending',
    text: 'Check your most recent monthly Explanation of Benefits (EOB) statement sent by your Medicare Part D plan or Medicare Advantage plan. Look for the section labeled "True Out-of-Pocket" (TrOOP) balance to see your exact year-to-date total.',
  },
  {
    name: 'Enter your year-to-date spending into the calculator',
    text: 'Type your current year-to-date out-of-pocket drug spend in dollars into the designated field. If you are starting fresh in January, enter 0.',
  },
  {
    name: 'Enter your estimated monthly prescription costs',
    text: 'Input the total amount you currently spend each month out-of-pocket for your routine pharmacy refills. You can estimate this by adding up the copays on your pill bottles.',
  },
  {
    name: 'Click "Calculate My Coverage Status"',
    text: 'The calculator analyzes your numbers using official CMS rules to display your exact progress toward the $2,000 cap, how many months remain until you hit $0 copays, and your total estimated drug spend for 2026.',
