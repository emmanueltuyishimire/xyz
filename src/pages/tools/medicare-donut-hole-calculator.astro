 * Title: Medicare Donut Hole Calculator 2026 — Free | Seniors Audit
 * Description: Free Medicare donut hole calculator — track your 2026 Part D $2,000 out-of-pocket cap in seconds. Updated for Inflation Reduction Act. No account.
 *
 * 2026 Official Figures — verify annually from CMS:
 *   Part D Out-of-Pocket Cap: $2,000 (Inflation Reduction Act of 2022)
 *   Catastrophic Coverage: $0 copay after $2,000 TrOOP reached
 *   Medicare Prescription Payment Plan (M3P): Monthly payment smoothing option
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { MedicareDonutHoleCalculator as DonutHoleTool } from '@components/tools/MedicareDonutHoleCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
