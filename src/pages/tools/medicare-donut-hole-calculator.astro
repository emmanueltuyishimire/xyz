---
/**
 * medicare-donut-hole-calculator.astro
 * Page: Medicare Donut Hole Calculator (Part D out-of-pocket cap, 2026 and 2027)
 * Category: Medicare
 *
 * Figures (Medicare.gov "How much does Medicare drug coverage cost?"):
 *   2026: cap $2,100, maximum deductible $615.   2027: cap $2,400, maximum deductible $700.
 *   After the deductible: 25% coinsurance until the cap; then $0 for covered Part D drugs.
 * Earlier years (CMS standard benefit): 2022 $480 / $4,430 / $7,050; 2023 $505 / $4,660 / $7,400;
 *   2024 $545 / $5,030 / $8,000 (deductible / initial coverage limit / out-of-pocket threshold).
 * Worked examples below are computed with src/lib/partDCost.ts, the same model the calculator uses.
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { MedicareDonutHoleCalculator as DonutHoleTool } from '@components/tools/MedicareDonutHoleCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import { simulatePartD, PART_D_FIGURES, MONTH_NAMES } from '../../lib/partDCost';

const lastReviewed = 'October 2026';
const pageTitle = 'Medicare Donut Hole Calculator: 2026 & 2027 Part D Costs';
const metaDescription = 'The Medicare donut hole is gone. See the month you reach the Part D cap ($2,100 in 2026, $2,400 in 2027) and what you pay each month until then.';

const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
const usd0 = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

// Worked examples, computed with the same model as the calculator
const exA = simulatePartD({ year: 2026, startMonth: 0, ytdSpent: 0, mode: 'copay', monthlyAmount: 250 });
const exB26 = simulatePartD({ year: 2026, startMonth: 0, ytdSpent: 0, mode: 'fullPrice', monthlyAmount: 1500 });
const exB27 = simulatePartD({ year: 2027, startMonth: 0, ytdSpent: 0, mode: 'fullPrice', monthlyAmount: 1500 });

// Full yearly drug price at which a standard 25% plan reaches the cap
const reach = (y: 2026 | 2027) => {
  const { cap, maxDeductible } = PART_D_FIGURES[y];
  return maxDeductible + (cap - maxDeductible) / 0.25;
};
const reach26 = reach(2026);
const reach27 = reach(2027);

const faqs = [
  {
    question: 'What is the donut hole in Medicare?',
    answer: 'The donut hole, officially the Part D coverage gap, was a stretch of the year when you paid a larger share of your drug costs. In 2024, for example, it began once you and your plan had spent $5,030 on drugs, and you paid 25% of the cost until your own spending reached $8,000. That gap no longer exists. Since 2025 you pay a deductible, then 25%, until a yearly cap, and after that nothing.',
  },
  {
    question: 'Does Medicare still have a donut hole in 2026?',
    answer: 'No. The coverage gap ended on January 1, 2025 under the Inflation Reduction Act. In 2026 your out-of-pocket spending on covered Part D drugs stops at $2,100. In 2027 the cap is $2,400. After you reach it, covered drugs cost $0 for the rest of the calendar year.',
  },
  {
    question: 'How does the Medicare Part D out-of-pocket cap work?',
    answer: 'There are three stages. First you pay your plan deductible (no more than $615 in 2026, $700 in 2027, and some plans charge less). Then you pay 25% of the cost of covered drugs. Once your own spending reaches the cap, you pay nothing for covered Part D drugs until the year ends. The count restarts on January 1.',
  },
  {
    question: 'What counts toward the Part D cap?',
    answer: 'Your deductible, copayments and coinsurance for covered drugs on your plan\'s formulary count, and so do the manufacturer discounts on brand-name drugs and certain payments made on your behalf, such as through Extra Help. Your monthly premium, drugs your plan does not cover, and Part B drugs given in a clinic do not count.',
  },
  {
    question: 'Do Medicare Advantage plans cover the donut hole?',
    answer: 'There is no donut hole to cover any more, and Medicare Advantage plans with drug coverage follow the same rules as stand-alone Part D plans: the same cap, $2,100 in 2026 and $2,400 in 2027. What can differ between plans is the deductible, the copays by drug tier, the formulary and the pharmacy network, so compare those when you choose.',
  },
  {
    question: 'Is there any insurance that covers the donut hole?',
    answer: 'You do not need extra insurance for it because the gap is gone. Medigap supplement plans do not cover outpatient prescription drugs. If your income is limited, Extra Help (the Part D low-income subsidy) lowers your premiums and copays, and your state may run its own pharmacy assistance program.',
  },
  {
    question: 'How do I get out of the donut hole or avoid it?',
    answer: 'You do not have to. Nothing special is required to reach the cap: it counts automatically as you pay for covered drugs. What you can control is when the bills arrive. The Medicare Prescription Payment Plan spreads your costs across the year, and a plan with a lower deductible or flat copays can make early-year bills smaller.',
  },
  {
    question: 'What is the Medicare Prescription Payment Plan, and does it save money?',
    answer: 'It is a free option that turns your pharmacy costs into monthly bills from your drug plan, spread from January through December. Medicare.gov is clear that it does not lower your drug costs; it only helps you manage when you pay. It can be useful if one expensive prescription would otherwise cost hundreds of dollars at the counter in a single month.',
  },
  {
    question: 'Why is the Part D cap higher in 2027?',
    answer: 'The cap is adjusted each year rather than fixed. It rises from $2,100 in 2026 to $2,400 in 2027, and the maximum deductible rises from $615 to $700. If you take expensive drugs, plan for a higher yearly maximum next year and check your 2027 plan\'s deductible during Open Enrollment, which runs October 15 through December 7.',
  },
  {
    question: 'Does the cap apply to drugs my doctor gives me, like infusions?',
    answer: 'No. Drugs given in a doctor\'s office or clinic are usually covered by Part B, which has its own 20% coinsurance and no yearly cap on that coinsurance. Only outpatient prescriptions covered by Part D count toward the Part D cap.',
  },
];

const howToSteps = [
  { name: 'Choose the plan year', text: 'Pick 2026 or 2027. The cap is $2,100 in 2026 and $2,400 in 2027.' },
  { name: 'Enter where you are now', text: 'Choose the month you are starting from and enter your year-to-date out-of-pocket (TrOOP) total from your plan statement.' },
  { name: 'Enter your drug costs', text: 'Type what you pay at the pharmacy in a typical month, or switch to the full drug price if you take an expensive brand or specialty drug.' },
  { name: 'Read the month-by-month result', text: 'See the month you reach the cap, how much you pay each month until then, and the highest monthly bill under the payment plan.' },
];
---

<ToolLayout
  title={pageTitle}
  description={metaDescription}
  faqs={faqs}
  howToSteps={howToSteps}
  datePublished="2026-07-01"
  dateModified="2026-10-24"
  agency="CMS"
  canonical="https://www.seniorsaudit.com/tools/medicare-donut-hole-calculator/"
  keywords="medicare donut hole, medicare donut hole calculator, part d out of pocket cap, coverage gap medicare, prescription payment plan"
>
  <div class="dh-hero">
    <div class="dh-breadcrumb" aria-label="Breadcrumb navigation">
      <a href="/medicare/" class="dh-breadcrumb-link">Medicare</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="dh-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Donut Hole Calculator</span>
    </div>
    <h1 class="dh-h1">Medicare Donut Hole Calculator: When Do You Hit the Part D Cap?</h1>
    <p class="dh-date">Figures checked against Medicare.gov in {lastReviewed}.</p>

    <div class="dh-aeo-block" role="note" aria-label="Quick Answer">
      <p class="dh-aeo-label">Quick Answer</p>
      <p class="dh-aeo-text">
        The Medicare donut hole ended in 2025. Now you pay your plan deductible, then <strong class="dh-gold">25%</strong> of covered drug costs, until your own spending reaches a yearly cap: <strong class="dh-gold">$2,100 in 2026</strong> and <strong class="dh-gold">$2,400 in 2027</strong>. After that, covered Part D drugs cost $0 until December 31. This applies to stand-alone Part D plans and Medicare Advantage plans with drug coverage.
      </p>
    </div>
  </div>

  <div class="dh-tool-container" id="calculator">
    <DonutHoleTool client:load />
  </div>

  <p class="dh-problem">
    If you searched for the donut hole, you probably remember the old coverage gap, or someone told you it is coming for you. It is not. What is left is a hard limit on your yearly drug spending, and the question that matters now is <em>when in the year you reach it</em>. The first months can still be expensive because of the deductible, and the cap rises next year. The calculator above shows both.
  </p>

  <NoSignupStatement />

  <section class="dh-section" aria-labelledby="what-happened-heading">
    <h2 id="what-happened-heading">What happened to the Medicare donut hole?</h2>
    <p>
      Part D started in 2006 with a gap built in: after you and your plan had spent a set amount on drugs, you paid a much larger share until your own spending reached a catastrophic threshold. The Affordable Care Act shrank your share of the gap to 25% by 2020. The Inflation Reduction Act then removed the gap, starting with the 5% catastrophic coinsurance in 2024 and the gap itself in 2025.
    </p>
    <div class="dh-table-wrap">
      <table class="dh-data-table">
        <caption>Part D standard benefit by year</caption>
        <thead>
          <tr><th scope="col">Year</th><th scope="col">Deductible (max)</th><th scope="col">Where the gap began</th><th scope="col">Your yearly out-of-pocket limit</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">2022</th><td>$480</td><td>$4,430 total drug cost</td><td>$7,050 spent by you</td></tr>
          <tr><th scope="row">2023</th><td>$505</td><td>$4,660 total drug cost</td><td>$7,400 spent by you</td></tr>
          <tr><th scope="row">2024</th><td>$545</td><td>$5,030 total drug cost</td><td>$8,000 spent by you</td></tr>
          <tr class="dh-hl"><th scope="row">2025</th><td>$590</td><td>No gap</td><td>$2,000</td></tr>
          <tr class="dh-hl"><th scope="row">2026</th><td>$615</td><td>No gap</td><td>$2,100</td></tr>
          <tr class="dh-hl"><th scope="row">2027</th><td>$700</td><td>No gap</td><td>$2,400</td></tr>
        </tbody>
      </table>
    </div>
    <p class="dh-note">Sources: CMS standard Part D parameters (2022–2024); Medicare.gov for 2026 and 2027. The 2025 row follows the Inflation Reduction Act cap of $2,000 and the 2025 maximum deductible.</p>
    <p>
      So the biggest change is not just the end of the gap. In 2024 you could pay up to $8,000 in a year. In 2026 you cannot pay more than $2,100 for covered drugs, whatever they cost.
    </p>
  </section>

  <section class="dh-section" aria-labelledby="how-it-works-heading">
    <h2 id="how-it-works-heading">How Part D costs work now</h2>
    <p>Every Part D plan, including the drug part of a <a href="/medicare/medicare-vs-medicare-advantage/">Medicare Advantage plan</a>, has to give you the same three stages (the official description is on <a href="https://www.medicare.gov/health-drug-plans/part-d/basics/costs" target="_blank" rel="noopener noreferrer">Medicare.gov</a>). New to Part D? Start with <a href="/medicare/what-is-medicare-part-d/">what Medicare Part D is and covers</a>:</p>
    <ol class="dh-steps-list">
      <li><strong>Deductible.</strong> You pay the full price of covered drugs until you reach the plan's deductible. It cannot exceed {usd0(PART_D_FIGURES[2026].maxDeductible)} in 2026 or {usd0(PART_D_FIGURES[2027].maxDeductible)} in 2027, and some plans charge less or none.</li>
      <li><strong>Initial coverage.</strong> You pay 25% of the cost of generic and brand-name drugs, or the plan's flat copay for the drug tier, until your own spending hits the cap.</li>
      <li><strong>Catastrophic coverage.</strong> You pay $0 for covered Part D drugs for the rest of the calendar year.</li>
    </ol>
    <div class="dh-callout">
      <p>
        <strong>Will you reach the cap?</strong> On a standard plan with the maximum deductible and 25% coinsurance, you reach the cap only when your drugs' full price for the year is about <strong>{usd0(reach26)} in 2026</strong> and <strong>{usd0(reach27)} in 2027</strong>. If your drugs cost less, you simply pay your deductible plus 25% and the cap never matters. It protects people who take one or two very expensive medicines.
      </p>
    </div>
  </section>

  <section class="dh-section dh-section-tinted" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading">Three worked examples (hypothetical, same model as the calculator)</h2>
    <p class="dh-note">These are made-up situations, not real people, calculated with the same rules as the tool above. Your plan's own prices and tiers will differ.</p>

    <div class="dh-scenario-card">
      <div class="dh-scenario-header">
        <span class="dh-scenario-tag">Example 1</span>
        <strong class="dh-scenario-title">Pays $250 a month at the pharmacy, 2026</strong>
      </div>
      <p class="dh-scenario-intro">A retiree with a blood thinner and a diabetes drug pays about $250 in copays every month starting in January.</p>
      <p class="dh-scenario-result">
        Eight months of $250 is $2,000, so the cap arrives in <strong>{MONTH_NAMES[exA.capMonth ?? 0]}</strong> with a final payment of {usd(exA.rows[exA.capMonth ?? 0].pays)}. For the last <span class="dh-amber-highlight">{exA.monthsAtZero} months</span> the same drugs cost $0, and the year ends at {usd(exA.projectedYearTotal)} instead of $3,000.
      </p>
    </div>

    <div class="dh-scenario-card">
      <div class="dh-scenario-header">
        <span class="dh-scenario-tag">Example 2</span>
        <strong class="dh-scenario-title">One $1,500-a-month brand drug, 2026</strong>
      </div>
      <p class="dh-scenario-intro">The plan's price for a specialty medicine is $1,500 a month. The plan has the maximum $615 deductible and 25% coinsurance.</p>
      <div class="dh-table-wrap">
        <table class="dh-data-table">
          <thead><tr><th scope="col">Month</th><th scope="col">You pay</th><th scope="col">Year total</th></tr></thead>
          <tbody>
            {exB26.rows.slice(0, (exB26.capMonth ?? 0) + 1).map((r) => (
              <tr><th scope="row">{r.name}</th><td>{usd(r.pays)}</td><td>{usd(r.cumulative)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dh-scenario-result">
        January is the hardest month at {usd(exB26.rows[0].pays)}, because the deductible is paid at full price. The cap arrives in <strong>{MONTH_NAMES[exB26.capMonth ?? 0]}</strong>, and {MONTH_NAMES[(exB26.capMonth ?? 0) + 1]} through December cost <span class="dh-amber-highlight">$0</span>. Without a cap the same drug would have cost about {usd(exB26.uncappedRemaining)} for the year.
      </p>
      <p class="dh-scenario-action">Someone in this position might ask their plan about the Medicare Prescription Payment Plan so January is not a {usd0(exB26.rows[0].pays)} counter bill.</p>
    </div>

    <div class="dh-scenario-card">
      <div class="dh-scenario-header">
        <span class="dh-scenario-tag">Example 3</span>
        <strong class="dh-scenario-title">The same drug in 2027</strong>
      </div>
      <p class="dh-scenario-intro">Same $1,500 monthly price, with the 2027 maximum deductible of $700 and the $2,400 cap.</p>
      <p class="dh-scenario-result">
        January costs {usd(exB27.rows[0].pays)} and the cap arrives in <strong>{MONTH_NAMES[exB27.capMonth ?? 0]}</strong> again, but the yearly total is <span class="dh-amber-highlight">{usd(exB27.projectedYearTotal)}</span> instead of {usd(exB26.projectedYearTotal)}, which is {usd(exB27.projectedYearTotal - exB26.projectedYearTotal)} more.
      </p>
      <p class="dh-scenario-action">Takeaway for Open Enrollment: for expensive drugs, the 2027 cap sets your worst-case year. For cheaper drugs, the deductible and tier copays decide your cost.</p>
    </div>
  </section>

  <section class="dh-section" aria-labelledby="surprises-heading">
    <h2 id="surprises-heading">What still catches people out</h2>
    <h3>The first month of the year costs the most</h3>
    <p>The deductible is paid at full price, so January and February bills are often the biggest even though the cap is far away. Check your plan's deductible before you rely on "$2,100 maximum": it caps the year, not each month.</p>
    <h3>Premiums and uncovered drugs do not count</h3>
    <p>Your monthly plan premium does not move you toward the cap. Neither does anything your plan does not cover, such as a drug that is off its formulary. If a prescription is not covered, ask your doctor about a covered alternative, or ask the plan for a <a href="https://www.medicare.gov/coverage/prescription-drug-coverage-exceptions" target="_blank" rel="noopener noreferrer">formulary exception</a>. To estimate a full year of drug costs across several medicines, try the <a href="/tools/medicare-prescription-drug-cost-estimator/">prescription drug cost estimator</a>.</p>
    <h3>Drugs given in a clinic are a different system</h3>
    <p>Infusions and injections given in a doctor's office usually fall under Part B, which has 20% coinsurance and no Part D cap. A <a href="/medicare/medicare-supplement-plans-explained/">Medigap plan</a> can cover that 20%, but it does not cover your pharmacy prescriptions. The official list of what Part B covers is on <a href="https://www.medicare.gov/what-medicare-covers/part-b-covered-medications" target="_blank" rel="noopener noreferrer">Medicare.gov</a>.</p>
    <h3>The payment plan changes timing, not the total</h3>
    <p>The Medicare Prescription Payment Plan spreads your costs from January to December. In January the highest monthly bill is about the cap divided by 12, which is {usd(PART_D_FIGURES[2026].cap / 12)} in 2026 and {usd(PART_D_FIGURES[2027].cap / 12)} in 2027, though your plan sets the exact amount. <a href="https://www.medicare.gov/prescription-payment-plan" target="_blank" rel="noopener noreferrer">Medicare.gov</a> says it does not lower what you owe, and you can ask your plan to enroll you.</p>
    <h3>Extra Help can beat the cap</h3>
    <p>If your income and savings are limited, Extra Help lowers copays long before you reach the cap. In 2026 the lowest-income group pays $1.60 or $4.90 per prescription (the lower amount for generics, the higher for brand-name drugs), and others pay up to $5.10 or $12.65. See the <a href="/tools/extra-help-eligibility-calculator/">Extra Help eligibility calculator</a> to check, or apply through <a href="https://www.ssa.gov/medicare/part-d-extra-help" target="_blank" rel="noopener noreferrer">Social Security</a>. If your income is a little too high, the <a href="/medicare/medicare-savings-programs/">Medicare Savings Programs</a> may still help with other costs.</p>
  </section>

  <section class="dh-section" aria-labelledby="open-enrollment-heading">
    <h2 id="open-enrollment-heading">If you are choosing a 2027 plan now</h2>
    <p>Medicare's Open Enrollment runs from October 15 to December 7 (see our guide to <a href="/medicare/medicare-enrollment-periods/">Medicare enrollment periods</a> for the other windows). This is the one time of year most people can switch drug plans, and the drug cap is the same for every plan, so the differences are elsewhere:</p>
    <ol class="dh-steps-list">
      <li>Enter your real monthly pharmacy costs above and choose 2027 to see your worst-case year.</li>
      <li>On the official <a href="https://www.medicare.gov/plan-compare/" target="_blank" rel="noopener noreferrer">Medicare Plan Finder</a>, enter your exact drugs and pharmacy, then compare each plan's deductible, tier copays and yearly total.</li>
      <li>Check that every drug you take is on the plan's formulary, so each dollar you spend counts toward the cap.</li>
      <li>If you have a plan with a $0 deductible, check whether its premium is higher. Our <a href="/tools/medicare-premium-calculator/">Medicare premium calculator</a> shows the whole monthly picture, and the <a href="/tools/medicare-advantage-vs-original-medicare-cost-checker/">Medicare Advantage vs Original Medicare cost checker</a> compares plan types.</li>
      <li>Pay attention to your income: a higher income can add an <a href="/tools/medicare-irmaa-calculator/">IRMAA surcharge</a> to your Part D premium.</li>
      <li>Did you go without drug coverage in the past? Check the <a href="/tools/medicare-part-d-late-enrollment-penalty-calculator/">Part D late enrollment penalty</a> before you choose.</li>
    </ol>
  </section>

  <section class="dh-section" aria-labelledby="help-heading">
    <h2 id="help-heading">Where to get free, official help</h2>
    <ul class="dh-steps-list">
      <li><strong>State Health Insurance Assistance Program (SHIP).</strong> Trained counselors help you compare drug plans for free and do not sell insurance. Find yours at <a href="https://www.shiphelp.org/" target="_blank" rel="noopener noreferrer">shiphelp.org</a>.</li>
      <li><strong>1-800-MEDICARE (1-800-633-4227).</strong> Ask about your cap, the payment plan, or a drug your plan refuses to cover. Official site: <a href="https://www.medicare.gov/" target="_blank" rel="noopener noreferrer">Medicare.gov</a>.</li>
      <li><strong>Your plan.</strong> Call the number on your member card to join the Medicare Prescription Payment Plan, request a formulary exception, or ask where you stand against the cap.</li>
      <li><strong>Social Security (1-800-772-1213).</strong> For Extra Help questions and applications: <a href="https://www.ssa.gov/medicare/part-d-extra-help" target="_blank" rel="noopener noreferrer">ssa.gov/medicare/part-d-extra-help</a>.</li>
    </ul>
  </section>

  <section class="dh-section" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Official sources used on this page</h2>
    <div class="dh-table-container">
      <table class="dh-sources-table">
        <thead><tr><th scope="col">Source</th><th scope="col">What we used it for</th><th scope="col">Link</th></tr></thead>
        <tbody>
          <tr>
            <td>Medicare.gov: How much does Medicare drug coverage cost?</td>
            <td>2026 and 2027 cap, deductible limits, the 25% coinsurance stage, the $0 stage and the payment plan</td>
            <td><a href="https://www.medicare.gov/health-drug-plans/part-d/basics/costs" target="_blank" rel="noopener noreferrer">Part D costs</a></td>
          </tr>
          <tr>
            <td>CMS: standard Part D drug costs, 2024</td>
            <td>The last year of the coverage gap: $545 deductible, $5,030 gap start, $8,000 limit</td>
            <td><a href="https://cmsnationaltrainingprogram.cms.gov/sites/default/files/shared/2024%20Standard%20Drug%20Costs_FINAL508_2.pdf" target="_blank" rel="noopener noreferrer">2024 standard drug costs (CMS)</a></td>
          </tr>
          <tr>
            <td>Medicare.gov: Medicare Prescription Payment Plan</td>
            <td>How the monthly payment option works and that it does not lower drug costs</td>
            <td><a href="https://www.medicare.gov/prescription-payment-plan" target="_blank" rel="noopener noreferrer">Prescription payment plan</a></td>
          </tr>
          <tr>
            <td>CMS: Final CY 2026 Part D Redesign Program Instructions</td>
            <td>The 2026 benefit design after the Inflation Reduction Act</td>
            <td><a href="https://www.cms.gov/newsroom/fact-sheets/final-cy-2026-part-d-redesign-program-instructions" target="_blank" rel="noopener noreferrer">CMS fact sheet</a></td>
          </tr>
          <tr>
            <td>Medicare Interactive (Medicare Rights Center): drug costs under Extra Help</td>
            <td>2026 Extra Help copay amounts ($1.60 and $4.90; $5.10 and $12.65)</td>
            <td><a href="https://www.medicareinteractive.org/understanding-medicare/cost-saving-programs/the-extra-help-low-income-subsidy-lis-program/drug-costs-under-extra-help" target="_blank" rel="noopener noreferrer">Extra Help drug costs</a></td>
          </tr>
          <tr>
            <td>Social Security: Extra Help with Medicare drug costs</td>
            <td>Who can get lower premiums and copays</td>
            <td><a href="https://www.ssa.gov/medicare/part-d-extra-help" target="_blank" rel="noopener noreferrer">SSA Extra Help</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="dh-independence-statement">
      <strong>Method:</strong> the calculator applies the deductible, then the coinsurance you enter (25% by default), then stops your spending at the cap, one month at a time. It assumes a steady monthly amount and does not model changing drug prices, tier copays or pharmacy differences. Seniors Audit is independent and is not affiliated with Medicare or any insurance company.
    </p>
  </section>

  <section class="dh-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently asked questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <section class="dh-section" aria-labelledby="terms-heading">
    <h2 id="terms-heading">Terms used on this page</h2>
    <div class="dh-terms-grid">
      <div class="dh-term-item"><strong>Donut hole (coverage gap)</strong><p>The old stretch of the year when you paid a larger share of drug costs. It ended in 2025.</p></div>
      <div class="dh-term-item"><strong>TrOOP (true out-of-pocket)</strong><p>The spending that counts toward the cap. Your plan's monthly statement shows the year-to-date total.</p></div>
      <div class="dh-term-item"><strong>Formulary</strong><p>The list of drugs your plan covers. Only covered drugs count toward the cap.</p></div>
      <div class="dh-term-item"><strong>Part D / MAPD</strong><p>Part D is Medicare's prescription drug coverage. An MAPD is a Medicare Advantage plan that includes it.</p></div>
      <div class="dh-term-item"><strong>Extra Help (LIS)</strong><p>A Social Security program that lowers Part D premiums, deductibles and copays for people with limited income and savings.</p></div>
      <div class="dh-term-item"><strong>Medicare Prescription Payment Plan</strong><p>A free option that spreads your drug costs into monthly bills. It does not lower your total.</p></div>
    </div>
  </section>

