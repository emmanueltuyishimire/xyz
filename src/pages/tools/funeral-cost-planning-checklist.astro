const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is the average cost of a funeral in the United States in 2026?',
    answer: 'According to the National Funeral Directors Association (NFDA), the national median cost of a traditional burial funeral with a viewing and funeral service was approximately $8,300 in 2023, the most recent year of official data. When cemetery costs (burial plot, opening/closing, grave marker) are added, total costs commonly reach $10,000 to $14,000 or more depending on the geographic region and funeral home pricing.',
  },
  {
    question: 'What is the difference between a burial funeral and cremation?',
    answer: 'A traditional burial funeral includes embalming, a viewing or visitation period, a formal funeral service, and placement of the body in a casket that is interred in a cemetery plot. Cremation is an alternative disposition that reduces the body to ashes using high-heat incineration. A direct cremation (without any formal funeral service or viewing) is typically the lowest-cost option, averaging $1,000 to $2,500 nationally.',
  },
  {
    question: 'Am I required to purchase a casket from the funeral home?',
    answer: 'No. Under the Federal Trade Commission (FTC) Funeral Rule (16 CFR Part 453), funeral homes are legally required to accept third-party purchased caskets without charging a handling fee. You can purchase a casket from Costco, Amazon, or a direct casket retailer at significantly lower prices than the average funeral home markup of 200% to 500%.',
  },
  {
    question: 'What is a prepaid funeral contract or preneed agreement?',
    answer: 'A preneed funeral contract (also called a pre-arranged or prepaid funeral plan) is a legal agreement in which you pay a funeral home in advance for specified funeral goods and services that will be provided upon your death. All states regulate preneed contracts, requiring funeral homes to deposit paid funds into a state-supervised trust or purchase a life insurance policy to ensure your money is protected.',
  },
  {
    question: 'What are the risks of purchasing a prepaid funeral contract?',
    answer: 'The primary risks include the funeral home going out of business or being purchased by a chain that changes service terms; choosing an irrevocable contract (common for Medicaid spend-down) that locks in specific services without flexibility; and discovering that inflation has increased costs beyond your locked-in price for items not fully guaranteed in writing.',
  },
  {
    question: 'What does Social Security pay toward funeral costs?',
    answer: 'Social Security pays a one-time, lump-sum death benefit of $255 to the surviving spouse of a deceased worker if they were living together at the time of death, or to an eligible surviving child. This $255 benefit has not been adjusted for inflation since 1954 and covers a negligible fraction of actual funeral costs. It is not a funeral benefit — it is a survivor payment.',
  },
  {
    question: 'What is the FTC Funeral Rule and how does it protect me?',
    answer: 'The FTC Funeral Rule (16 CFR Part 453) is a federal consumer protection regulation that requires funeral homes to provide itemized written price lists for all funeral goods and services. It prohibits funeral homes from requiring package purchases, mandating embalming without consent, or charging handling fees for third-party caskets. You can request a General Price List (GPL) from any funeral home at any time without obligation.',
  },
  {
    question: 'Can I donate my body to medical science instead of paying for a funeral?',
    answer: 'Yes. Whole body donation to an accredited medical school or research institution (through organizations such as ScienceCare or university programs) is typically completely free to the donor and their family. The institution covers all handling costs and often returns cremated remains to the family within 4 to 8 weeks after research concludes.',
  },
];
