---
import ToolLayout from '@layouts/ToolLayout.astro';
import { FuneralCostChecklist } from '@components/tools/FuneralCostChecklist';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'What is the FTC Funeral Rule and what rights does it give me?',
    answer: 'Enforced by the Federal Trade Commission, the Funeral Rule gives consumers the right to obtain itemized General Price Lists, select individual items, and purchase caskets from third parties without extra fees.',
  },
  {
    question: 'What is typically included in a funeral home’s basic services fee?',
    answer: 'The basic services fee covers administrative overhead, securing death certificates, housing the remains temporarily, and coordinating with cemeteries or crematoriums.',
  },
  {
    question: 'Can a funeral home require me to buy a casket from them?',
    answer: 'No. Federal law prohibits funeral homes from requiring you to buy a casket from them or charging a fee to handle a third-party casket.',
  },
  {
    question: 'What is the difference between a burial and direct cremation?',
    answer: 'Direct cremation involves cremating the body shortly after death without embalming, viewing, or a formal visitation ceremony, making it significantly less expensive.',
  },
  {
    question: 'What is a pre-need funeral arrangement and is it safe?',
    answer: 'Pre-need arrangements allow you to pay for funeral services in advance. Ensure pre-paid funds are held in a state-regulated trust or funeral insurance policy.',
  },
  {
    question: 'What should I bring when comparing funeral homes?',
    answer: 'Bring a notepad, a friend or family member for emotional support, and insist on receiving a copy of the General Price List (GPL) before discussing services.',
  },
  {
    question: 'What questions should I ask a funeral director?',
    answer: 'Ask for the GPL, whether embalming is mandatory for your chosen service, itemized costs for facility use, and all cemetery/third-party cash advance fees.',
  },
];

const howToSteps = [
  { name: 'Request General Price List', text: 'Ask for itemized GPL sheets from at least two local funeral homes.' },
  { name: 'Select necessary items', text: 'Choose individual services instead of bundled package deals.' },
  { name: 'Estimate total cost', text: 'Use the interactive calculator to compare funeral service line items.' },
  { name: 'Review FTC rights', text: 'Verify that third-party caskets or non-embalming options are honored.' },
];
---

<ToolLayout
  title="Funeral Cost Planning Checklist — Know Yo | Seniors Audit"
  description="Free funeral cost planning checklist. Your FTC Funeral Rule consumer rights explained. What to compare, what to avoid, and cost category ranges. No account."
  faqs={faqs}
  howToSteps={howToSteps}
  datePublished="2026-07-01"
  dateModified="2026-07-29"
  agency="CMS"
  canonical="https://www.seniorsaudit.com/tools/funeral-cost-planning-checklist/"
  keywords="funeral cost planning checklist, FTC Funeral Rule consumer rights, average cost of funeral burial cremation, funeral price comparison guide"
>
  <div style="margin-bottom: var(--space-8);">
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem; display:flex; flex-wrap:wrap; gap:0.25rem; align-items:center;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Funeral Cost Planning Checklist</span>
    </div>

    <h1 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: #0D2137; line-height: 1.2; margin-bottom: 0.5rem;">
      Funeral Cost Planning Checklist: Know Your Rights and What to Compare — Free
    </h1>
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">Figures and guidance last verified against official sources in {lastReviewed}.</p>

    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 0.75rem 0 1rem;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        The FTC Funeral Rule gives you the right to: receive an itemized price list when you call or visit any funeral home, buy only the items you want separately (no mandatory package), use a casket purchased elsewhere without extra fee, and receive a written itemized statement before any services begin.
      </p>
    </div>
  </div>

  <div style="background: var(--color-surface); border: 2px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); margin-bottom: var(--space-10); box-shadow: var(--shadow-md);" id="checklist">
    <FuneralCostChecklist client:load />
  </div>

  <NoSignupStatement />

  <section style="margin-block: var(--space-10); padding-bottom: var(--space-8); border-bottom: 1px solid var(--color-border);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; font-weight: 800; margin-bottom: 1rem;">Frequently Asked Questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- RELATED TOOLS -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-tools-heading">
    <h2 id="related-tools-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Estate & End-of-Life Planning Tools
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/simple-will-estate-basics-explainer/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Simple Will & Estate Basics Explainer →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Plain-English overview of wills, beneficiaries, and what happens to your estate without one.</p>
      </a>
      <a href="/tools/advance-directive-healthcare-poa-guide/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Advance Directive & Healthcare POA Guide →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Document your healthcare wishes with a living will and name a healthcare proxy.</p>
      </a>
      <a href="/tools/probate-timeline-explainer/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Probate Timeline Explainer →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Understand the typical steps and duration for settling an estate through probate court.</p>
      </a>
    </div>
  </section>

  <DisclaimerBlock
    type="calculator"
    agencyName="Federal Trade Commission (FTC)"
    agencyPhone="1-877-382-4357"
    agencyUrl="https://www.ftc.gov"
    lastReviewed={lastReviewed}
  />
</ToolLayout>
