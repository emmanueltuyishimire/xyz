       ACTIONABLE CHECKLIST SECTION (Teal Callout Box)
       ═══════════════════════════════════════════════════════ -->
  <section class="sstc-section" id="action-checklist">
    <div class="sstc-checklist-card">
      <div class="sstc-checklist-header">
        <span class="sstc-checklist-icon">📋</span>
        <div>
          <h2>Your Social Security Tax Action Checklist</h2>
          <p class="sstc-checklist-sub">Follow these 6 practical steps to manage your taxes smoothly and avoid penalties:</p>
        </div>
