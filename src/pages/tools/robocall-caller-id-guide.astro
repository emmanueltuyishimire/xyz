  .rcg-steps li { font-size: 18px; line-height: 1.7; color: #0D2137; }
  .rcg-pro-tip { background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1.25rem; }
  .rcg-tip-label { font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0; }
  .rcg-tip-text { font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6; }
  .rcg-table-section { margin-top: var(--space-8); }
  .rcg-table-wrap { overflow-x: auto; margin-top: var(--space-4); }
  .rcg-ref-table, .rcg-scenario-table, .rcg-sources-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .rcg-ref-table th, .rcg-scenario-table th, .rcg-sources-table th { background: #0A3D3A; color: #fff; padding: 0.6rem 0.75rem; text-align: left; font-weight: 700; }
  .rcg-ref-table td, .rcg-scenario-table td, .rcg-sources-table td { padding: 0.6rem 0.75rem; color: #0D2137; border-bottom: 1px solid #DDE3EA; line-height: 1.5; vertical-align: top; }
  .rcg-sources-table a { color: #0A3D3A; text-decoration: underline; }
  .rcg-row-alt { background: #f6f8fa; }
  .rcg-yes { color: #0A6B3A; font-weight: 700; }
  .rcg-scenario-card { background: #fff; border: 1px solid #DDE3EA; border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-6); }
  .rcg-scenario-header { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); flex-wrap: wrap; }
  .rcg-tag { background: #0A3D3A; color: #fff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.2rem 0.6rem; border-radius: 9999px; }
  .rcg-scenario-name { font-size: 1.05rem; color: #0D2137; }
  .rcg-scenario-desc { font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin-bottom: var(--space-4); }
  .rcg-result-block { background: #f0fff4; border-left: 4px solid #0A6B3A; border-radius: 0 0.4rem 0.4rem 0; padding: 0.75rem 1rem; margin: var(--space-3) 0; font-size: 0.95rem; line-height: 1.6; color: #0D2137; }
  .rcg-result-highlight { display: block; font-weight: 700; color: #0A6B3A; font-size: 1.05rem; margin-bottom: 0.25rem; }
  .rcg-action { font-size: 0.9rem; color: #4B5A6E; font-style: italic; margin: 0; }
  .rcg-disclaimer { font-size: 0.8rem; color: #4B5A6E; margin-top: var(--space-6); line-height: 1.6; }
  .rcg-independence { font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6; max-width: 70ch; }
  .rcg-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); margin-top: var(--space-5); }
  .rcg-related-card { display: flex; gap: var(--space-4); align-items: flex-start; background: #fff; border: 1.5px solid #DDE3EA; border-radius: var(--radius-lg); padding: var(--space-5); text-decoration: none; color: inherit; transition: border-color 0.2s, box-shadow 0.2s; }
  .rcg-related-card:hover { border-color: #0A3D3A; box-shadow: 0 2px 8px rgba(10,61,58,0.1); }
  .rcg-related-icon { font-size: 1.75rem; flex-shrink: 0; }
  .rcg-related-card strong { display: block; color: #0D2137; font-size: 1rem; margin-bottom: 0.35rem; font-weight: 700; }
  .rcg-related-card p { font-size: 0.875rem; color: #4B5A6E; line-height: 1.5; margin: 0 0 0.5rem 0; }
  .rcg-related-btn { display: inline-block; background: #0A3D3A; color: #fff; font-size: 0.8rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 0.4rem; margin-bottom: 0.25rem; }
  .rcg-no-acct { display: block; font-size: 0.75rem; color: #4B5A6E; }
  @media (max-width: 640px) { .rcg-tool-block { padding: 1rem; } .rcg-ref-table { font-size: 0.78rem; } }
</style>
