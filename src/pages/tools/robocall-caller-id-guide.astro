---
import ToolLayout from '@layouts/ToolLayout.astro';
import { RobocallGuide } from '@components/tools/RobocallGuide';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';

const faqs = [
  {
    question: 'Why do I keep getting calls from numbers that look local?',
    answer: 'This is called "neighbor spoofing." Scammers use technology to disguise their real phone number and display one with your area code. They know you are much more likely to answer a call that appears to be from a neighbor or local business.'
  },
  {
    question: 'Does the Do Not Call Registry stop all robocalls?',
    answer: 'No. The National Do Not Call Registry only stops sales calls from legitimate companies that follow the law. Scammers and criminals ignore the registry. However, being registered helps because it means any unexpected sales call you receive is likely a scam.'
  },
  {
    question: 'How do I block calls on an iPhone?',
    answer: 'You can block unknown callers by going to Settings > Phone > Silence Unknown Callers and turning it on. This sends calls from numbers not in your contacts straight to voicemail. You can also block specific numbers from your recent calls list.'
  },
  {
    question: 'How do I block calls on an Android phone?',
    answer: 'Open the Phone app, tap the three-dot menu, select Settings, and then Blocked Numbers. Turn on "Block calls from unidentified callers." Some Android phones, like Google Pixels, also have built-in Call Screen features to filter out spam.'
  },
  {
    question: 'What is caller ID spoofing and is it illegal?',
    answer: 'Caller ID spoofing is when a caller falsifies the information transmitted to your caller ID display to disguise their identity. It is illegal under the Truth in Caller ID Act if it is done with the intent to defraud, cause harm, or wrongly obtain anything of value.'
  },
  {
    question: 'How do I file a complaint with the FCC about robocalls?',
    answer: 'You can file a complaint online at consumercomplaints.fcc.gov or by calling 1-888-CALL-FCC. Provide the exact date, time, and the number that appeared on your caller ID. This data helps the FCC track down and fine illegal robocall operations.'
  },
  {
    question: 'What is STIR/SHAKEN and does it protect me?',
    answer: 'STIR/SHAKEN is a set of technical standards that phone companies use to verify that a caller ID is accurate before connecting the call. It helps block illegally spoofed calls on modern networks, meaning fewer fake local numbers reach your phone.'
  },
  {
    question: 'Can I stop robocalls on a landline phone?',
    answer: 'Yes, but options depend on your phone service provider. Contact them to ask about free call-blocking services (like Anonymous Call Rejection). You can also purchase a separate call-blocking device that plugs into your landline phone.'
  }
];
---

<ToolLayout
  title="Stop Robocalls: Free Block & Report Guide | Seniors Audit"
  description="Free robocall and spoofed caller ID guide for seniors. Learn how spoofing works, how to block calls on iPhone and Android, and how to file an FCC complaint. No account needed."
  faqs={faqs}
>
  <!-- HERO SECTION -->
  <div style="margin-bottom: var(--space-8);">
    <!-- Breadcrumb -->
    <div style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 0.75rem;">
      <a href="/tools/" style="color: #0A3D3A; text-decoration: underline;">Tools & Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Robocall/Caller-ID Lookup Guide</span>
    </div>
    
    <!-- H1 -->
    <h1 style="font-size: var(--text-3xl); color: #0D2137; font-weight: 800; line-height: 1.25; margin-bottom: 0.5rem;">
      Stop Unwanted Robocalls: Free Step-by-Step Guide to Block, Report, and Protect Yourself
    </h1>
    
    <!-- Last verified date -->
    <p style="font-size: var(--text-sm); color: #4B5A6E; margin-bottom: 1rem;">
      Figures last verified against official sources in July 2026.
    </p>
    
    <!-- AEO Quick Answer Block -->
    <div style="background: #0A3D3A; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin: 1rem 0;">
      <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #C9933A; margin: 0 0 0.5rem 0;">Quick Answer</p>
      <p style="font-size: 1rem; color: #ffffff; line-height: 1.6; margin: 0;">
        To stop robocalls: register your number at donotcall.gov (takes 2 minutes, free). On iPhone, go to Settings → Phone → Silence Unknown Callers. On Android, open Phone app → Settings → Blocked Numbers. File an FCC complaint at consumercomplaints.fcc.gov. Caller ID spoofing is legal for scammers to use — even a real-looking number can be fake.
      </p>
    </div>
    
    <!-- Problem statement paragraph -->
    <p style="font-size: 1rem; color: #4B5A6E; line-height: 1.6; margin: 1rem 0;">
      Seniors receive more robocalls per day than almost any other age group, and many answer out of fear of missing an important call. Caller ID spoofing makes the problem worse because a familiar area code or even a real company name can appear on screen while a scammer is on the line. We put together this plain-English guide because you deserve to know exactly how to block these calls on your specific type of phone.
    </p>
    
    <!-- Who this tool is for -->
    <ul style="list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 0.5rem;">
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Seniors receiving multiple robocalls per week who want to reduce the volume.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Anyone who received a spoofed call that appeared to come from a government agency or local number.
      </li>
      <li style="display: flex; gap: 0.5rem; font-size: 1rem; color: #4B5A6E;">
        <span aria-hidden="true" style="color: #0A3D3A; font-weight: 700; flex-shrink: 0;">→</span>
        Caregivers helping a parent set up call-blocking on their phone.
      </li>
    </ul>
  </div>

  <!-- THE INTERACTIVE TOOL -->
  <div style="margin-bottom: var(--space-8);">
    <RobocallGuide client:load />
  </div>

  <!-- NO SIGNUP STATEMENT -->
  <NoSignupStatement />

  <!-- HOW TO USE THIS TOOL -->
  <section style="margin-block: var(--space-10);" aria-labelledby="how-to-heading">
    <h2 id="how-to-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      How to Use This Tool — Step by Step
    </h2>
    <ol style="margin: 1rem 0 1.5rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <li id="step-1" style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Select your phone type.</strong> Choose iPhone, Android, or Landline to get exact steps for your device.
      </li>
      <li id="step-2" style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Register your number.</strong> Visit the National Do Not Call Registry if you haven't already. It's free and takes just a minute.
      </li>
      <li id="step-3" style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Enable call-blocking.</strong> Follow the specific settings path shown for your phone to block unidentified callers.
      </li>
      <li id="step-4" style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Report persistent calls.</strong> Use the provided links to file complaints with the FCC and FTC if the calls continue.
      </li>
      <li id="step-5" style="font-size: 1rem; color: #0D2137; line-height: 1.6;">
        <strong>Consider carrier services.</strong> Ask your phone carrier about their free call-screening or spam-blocking apps.
      </li>
    </ol>
    <!-- Pro tip callout -->
    <div style="background: #fff8f0; border-left: 4px solid #E8761A; border-radius: 0 0.5rem 0.5rem 0; padding: 1rem 1.25rem; margin-top: 1rem;">
      <p style="font-size: 0.875rem; font-weight: 700; color: #E8761A; margin: 0 0 0.25rem 0;">💡 Pro Tip</p>
      <p style="font-size: 1rem; color: #0D2137; margin: 0; line-height: 1.6;">If you answer a call and hear silence followed by a click or a recorded voice saying "Hello?", hang up immediately. It's an automated system verifying your number is active.</p>
    </div>
  </section>

  <!-- REAL-LIFE SCENARIOS -->
  <section style="margin-block: var(--space-10);" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Real-Life Examples — How This Works in Practice
    </h2>
    
    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">Patricia, 74 — Retired Librarian</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0 0 1rem 0;">
        <strong>Situation:</strong> Getting 8-10 robocalls per day from numbers starting with her own area code, making her anxious to answer the phone.
      </p>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0 0 1rem 0;">
        <strong>Action Taken:</strong> She followed our guide to enable "Silence Unknown Callers" on her iPhone. The calls stopped ringing instantly, going to voicemail where she could safely review them later.
      </p>
    </div>

    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.5rem 0;">James, 70 — Retired Electrician</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0 0 1rem 0;">
        <strong>Situation:</strong> Received a call that appeared on caller ID to come from his bank's real customer service number, warning him of fraud.
      </p>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0 0 1rem 0;">
        <strong>Action Taken:</strong> He remembered our advice about caller ID spoofing, hung up, and dialed the number on the back of his debit card. The real bank confirmed there was no issue.
      </p>
    </div>
    
    <p style="font-size: 0.825rem; color: #4B5A6E; margin-top: 0.75rem; line-height: 1.6;">
      These are representative examples. Individual results vary. Always verify suspicious calls by hanging up and contacting the organization directly.
    </p>
  </section>

  <!-- COMMON MISTAKES -->
  <section style="margin-block: var(--space-10);" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Common Mistakes and How to Avoid Them
    </h2>
    <div style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.25rem 0;">1. Calling back an unknown number</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0;">
        Many people call back missed calls from unfamiliar numbers to see if it was important. The fix is to let unknown calls go to voicemail; if it's genuinely important, they will leave a message or contact you another way. Calling back verifies your number is active for scammers.
      </p>
    </div>
    <div style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.25rem 0;">2. Pressing 1 to be removed from a list</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0;">
        Robocalls often tell you to "Press 1 to speak to an agent" or "Press 2 to be removed from our list." The fix is to simply hang up. Pressing any button signals to the automated system that a real person answered, and they will call you more often.
      </p>
    </div>
    <div style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.1rem; color: #0A3D3A; margin: 0 0 0.25rem 0;">3. Assuming the Do Not Call Registry fixes everything</h3>
      <p style="font-size: 1rem; color: #0D2137; line-height: 1.6; margin: 0;">
        While registering is important, it only stops law-abiding companies. The fix is to combine registration with active call-blocking settings on your phone or carrier to handle the scammers who ignore the rules.
      </p>
    </div>
  </section>

  <!-- OFFICIAL SOURCES TABLE -->
  <section style="margin-block: var(--space-10);" aria-labelledby="official-sources-heading">
    <h2 id="official-sources-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Official Government Sources Used in This Tool
    </h2>
    <div style="overflow-x: auto; margin-top: 1rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
        <thead>
          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FCC Spoofed Robocalls Guide</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">How spoofing works and consumer protections</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://www.fcc.gov/consumers/guides/spoofed-robocalls" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">fcc.gov</a></td>
          </tr>
          <tr style="background: #fff;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FTC National Do Not Call Registry</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">Free registration to reduce telemarketing calls</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://www.donotcall.gov" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">donotcall.gov</a></td>
          </tr>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">FCC Consumer Complaint Portal</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA; color: #0D2137;">File complaints about unwanted calls</td>
            <td style="padding: 0.75rem 1rem; border-bottom: 1px solid #DDE3EA;"><a href="https://consumercomplaints.fcc.gov" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">fcc.gov</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. Not affiliated with any government agency, insurance company, or financial services firm. We do not receive payment for referrals.
    </p>
  </section>

  <!-- FAQ SECTION -->
  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- RELATED TOOLS -->
  <section style="margin-block: var(--space-10);" aria-labelledby="related-heading">
    <h2 id="related-heading" style="font-size: var(--text-xl); color: #0D2137; margin-bottom: 1rem;">
      Other Free Tools You May Find Useful
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
      <a href="/tools/scam-message-call-decoder/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Scam Message/Call Decoder →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Analyze suspicious voicemails, texts, or emails to see if they follow known scam patterns.</p>
      </a>
      <a href="/tools/family-trusted-contact-setup-guide/" style="display: block; background: #fff; border: 1.5px solid #cbd5e1; border-radius: 0.5rem; padding: 1.25rem; text-decoration: none; color: inherit;">
        <h3 style="font-size: 1.05rem; color: #0A3D3A; margin: 0 0 0.35rem 0; font-weight: 700;">Family Trusted Contact Setup →</h3>
        <p style="font-size: 0.875rem; color: #4B5A6E; margin: 0;">Learn how to designate trusted contacts for financial accounts to protect against exploitation.</p>
      </a>
    </div>
  </section>

  <!-- EDUCATIONAL DISCLAIMER -->
  <DisclaimerBlock type="guide" />
</ToolLayout>
