          <tr style="background: #0A3D3A;">
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Source Name</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">What We Used It For</th>
            <th style="padding: 0.75rem 1rem; text-align: left; color: #fff; font-weight: 700;">Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f6f8fa;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">CMS 2026 Medicare Parts A &amp; B Premiums Fact Sheet</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">Standard Part B premium ($202.90), Part A work-quarter rates ($0 / $278 / $505), and IRMAA tier tables</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.medicare.gov/basics/costs/medicare-costs/part-b-costs" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">medicare.gov Part B Costs</a></td>
          </tr>
          <tr style="background: #fff;">
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">Social Security Administration — Medicare IRMAA Rules</td>
            <td style="padding: 0.75rem 1rem; color: #0D2137; vertical-align: top;">SSA procedure for determining MAGI using 2-year-prior IRS tax returns</td>
            <td style="padding: 0.75rem 1rem; vertical-align: top;"><a href="https://www.ssa.gov/benefits/medicare/irmaa.html" target="_blank" rel="noopener noreferrer" style="color: #0A3D3A; text-decoration: underline;">ssa.gov IRMAA Page</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.875rem; color: #4B5A6E; margin-top: 1rem; line-height: 1.6;">
      Seniors Audit is an independent educational platform. We are not affiliated with, endorsed by, or connected to CMS or the Social Security Administration. All calculations use official government rates and published rules.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 8 — FAQ SECTION WITH SCHEMA
       ═══════════════════════════════════════════════════════ -->
  <section style="margin-block: var(--space-10);" aria-labelledby="faq-heading">
    <h2 id="faq-heading" style="font-size: var(--text-2xl); color: #0D2137; margin-bottom: 1rem;">
      Frequently Asked Questions About Medicare Premiums
    </h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 9 — RELATED TOOLS
       ═══════════════════════════════════════════════════════ -->
