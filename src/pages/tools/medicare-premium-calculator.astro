---
/**
 * medicare-premium-calculator.astro
 * Tool: Medicare Part A & B Premium Calculator 2026
 * Category: Medicare
 * Primary keyword: medicare premium calculator
 * Supporting keywords: medicare part b premiums 2026, medicare premiums by income,
 *   medicare part a cost 40 quarters, irmaa calculator 2026, total medicare monthly cost
 *
 * URL: /tools/medicare-premium-calculator/
 * Title: Medicare Premium Calculator 2026 — Free | Seniors Audit
 * Description: Free Medicare premium calculator — see your exact Part A, B, and IRMAA monthly cost for 2026. Updated for official CMS figures. No account needed.
 *
 * 2026 Official Figures — verify annually from CMS:
 *   Part B Standard Base Premium: $202.90/month
 *   Part A Premium-Free: 40+ Social Security work quarters
 *   Part A 30–39 quarters: $278/month
 *   Part A <30 quarters: $505/month
 *   IRMAA Brackets (2024 tax return MAGI): Single >$106,000 / Joint >$212,000
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { MedicarePremiumCalculator as PremiumTool } from '@components/tools/MedicarePremiumCalculator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';

const lastReviewed = 'July 2026';

const faqs = [
  {
    question: 'How much is the standard Medicare Part B monthly premium in 2026?',
    answer: 'The standard Medicare Part B monthly premium in 2026 is $202.90. This base rate is paid by all Medicare beneficiaries whose Modified Adjusted Gross Income (MAGI) from two years prior (2024) was at or below $106,000 for single tax filers or $212,000 for married couples filing jointly.',
  },
  {
    question: 'Who qualifies for premium-free Medicare Part A?',
    answer: 'You qualify for premium-free Medicare Part A (Hospital Insurance) if you or your spouse worked and paid Medicare payroll taxes for at least 40 quarters (10 years) in covered employment. If you have 30–39 quarters, Part A costs $278 per month in 2026. If you have fewer than 30 quarters, Part A costs $505 per month.',
  },
  {
    question: 'How does income affect my Medicare Part B monthly premium?',
    answer: 'Social Security uses your Modified Adjusted Gross Income (MAGI) from your tax return two years prior (2024 taxes determine 2026 premiums) to place you in an IRMAA (Income Related Monthly Adjustment Amount) bracket. In 2026, IRMAA surcharges add between $81.20 and $443.90 per month to your base Part B premium of $202.90.',
  },
  {
    question: 'How is my Medicare Part B premium deducted from Social Security?',
    answer: 'If you are currently receiving Social Security benefits, Railroad Retirement benefits, or Civil Service Annuity benefits, your monthly Medicare Part B premium (plus any IRMAA surcharge) is automatically deducted from your monthly benefit check. If you do not yet receive Social Security, CMS sends you a quarterly invoice via Medicare Easy Pay or paper bill.',
  },
  {
    question: 'What is the "Hold Harmless" rule for Medicare Part B premiums?',
    answer: 'The statutory Hold Harmless provision prevents your net Social Security check from decreasing from one year to the next due to a Medicare Part B premium increase. However, this protection does NOT apply if you pay an IRMAA income surcharge, if you are newly enrolled in Part B, or if state Medicaid pays your Part B premium.',
  },
  {
    question: 'What tax return line determines my Medicare IRMAA calculation?',
    answer: 'Social Security calculates Medicare MAGI using your IRS Form 1040 Adjusted Gross Income (AGI) plus tax-exempt interest income (Line 2a). For 2026 premiums, Social Security pulls this data from your 2024 tax return filed with the Internal Revenue Service (IRS).',
  },
  {
    question: 'How can I appeal a high Medicare Part B income surcharge if my income dropped?',
    answer: 'If your income dropped significantly due to a qualifying life-changing event (such as retirement, work reduction, marriage, divorce, or death of a spouse), you can appeal your IRMAA tier by submitting SSA Form SSA-44 to the Social Security Administration along with documentation of your reduced income.',
  },
  {
    question: 'Does Medigap or Medicare Advantage pay my Medicare Part B premium?',
    answer: 'No. Neither Medigap nor Medicare Advantage pays your Part B premium. Even if you choose a $0-premium Medicare Advantage plan, you are still legally required to pay your monthly Medicare Part B premium of $202.90 (plus any IRMAA surcharge) every month.',
  },
];

const howToSteps = [
  {
    name: 'Select your Social Security work quarters',
    text: 'Indicate how many Social Security work quarters you or your spouse earned during your working years. You can check your quarter total by logging into your official ssa.gov account statement. 40 quarters (10 years) grants premium-free Part A.',
  },
  {
    name: 'Select your tax filing status',
    text: 'Choose your tax filing status from two years prior (2024 tax return): Single, Married Filing Jointly, or Married Filing Separately. Social Security uses this status to determine your IRMAA threshold.',
  },
  {
    name: 'Enter your Modified Adjusted Gross Income (MAGI)',
    text: 'Input your 2024 Modified Adjusted Gross Income (IRS Form 1040 AGI plus tax-exempt interest). You can find this on your tax return from two years ago.',
  },
  {
    name: 'Click "Calculate My Medicare Premium"',
    text: 'The tool immediately calculates your Part A premium, base Part B premium ($202.90), IRMAA surcharge tier, and total combined monthly payment owed to Medicare for 2026.',
  },
];
---

<ToolLayout
  title="Medicare Premium Calculator 2026 — Free | Seniors Audit"
  description="Free Medicare premium calculator — see your exact Part A, B, and IRMAA monthly cost for 2026. Updated for official CMS figures. No account needed."
  faqs={faqs}
  howToSteps={howToSteps}
  datePublished="2026-07-01"
  dateModified="2026-07-29"
  agency="CMS"
  canonical="https://www.seniorsaudit.com/tools/medicare-premium-calculator/"
  keywords="medicare premium calculator, medicare part b premiums 2026, medicare premiums by income, medicare part a cost 40 quarters, irmaa calculator 2026"
>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 2 — HERO SECTION
       ═══════════════════════════════════════════════════════ -->
  <div class="mp-hero">
    <div class="mp-breadcrumb" aria-label="Breadcrumb navigation">
      <a href="/medicare/" class="mp-breadcrumb-link">Medicare</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="mp-breadcrumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>Medicare Premium Calculator</span>
    </div>

    <h1 class="mp-h1">Medicare Premium Calculator 2026: Your Exact Monthly Cost</h1>
    <p class="mp-date">Figures last verified against official sources in {lastReviewed}.</p>

    <!-- AEO Direct Answer Block -->
    <div class="mp-aeo-block" role="note" aria-label="Quick Answer">
      <p class="mp-aeo-label">Quick Answer</p>
      <p class="mp-aeo-text">
        In 2026, the standard Medicare Part B monthly premium is <strong class="mp-gold">$202.90</strong>. Medicare Part A is <strong class="mp-gold">$0/month</strong> for individuals with 40 or more Social Security work quarters. Beneficiaries with 2-year prior MAGI above $106,000 (single) or $212,000 (married filing jointly) pay an additional IRMAA surcharge ranging from $81.20 to $443.90 per month on Part B.
      </p>
    </div>

    <!-- Problem Statement -->
    <p class="mp-problem">
      We noticed that budgeting for Medicare is confusing because Part A costs depend on your lifelong Social Security work quarters, while Part B costs depend on tax returns from two years ago. We built this free tool because seniors deserve a fast, clear calculation of their exact monthly Medicare bill without insurance broker spam, sales calls, or account signups.
    </p>

    <!-- Who This Tool Is For -->
    <ul class="mp-who-list" aria-label="Who this tool is for">
      <li class="mp-who-item">
        <span aria-hidden="true" class="mp-who-arrow">→</span>
        Adults turning 65 planning their retirement budget and calculating their exact monthly Medicare premium bill.
      </li>
      <li class="mp-who-item">
        <span aria-hidden="true" class="mp-who-arrow">→</span>
        Seniors wanting to check if their recent income level triggers an IRMAA (Income Related Monthly Adjustment Amount) surcharge.
      </li>
      <li class="mp-who-item">
        <span aria-hidden="true" class="mp-who-arrow">→</span>
        Individuals with fewer than 40 Social Security work quarters verifying their Part A monthly cost tier.
      </li>
    </ul>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 3 — THE TOOL INTERFACE
       ═══════════════════════════════════════════════════════ -->
  <div class="mp-tool-container" id="calculator">
    <PremiumTool client:load />
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — NO SIGNUP COMPETITIVE POSITIONING
       ═══════════════════════════════════════════════════════ -->
  <NoSignupStatement />

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 4 — HOW TO USE SECTION
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="how-to-use-heading">
    <h2 id="how-to-use-heading">How to Use This Tool — Step by Step</h2>
    <ol class="mp-steps-list">
      <li>
        <strong>Step 1 — Select your Social Security work quarters.</strong> Indicate how many Social Security work quarters you or your spouse accumulated. You can log into your personal <a href="https://www.ssa.gov/myaccount/" target="_blank" rel="noopener noreferrer">my Social Security account</a> to view your official quarters statement. 40 quarters (10 years) yields premium-free Part A.
      </li>
      <li>
        <strong>Step 2 — Select your tax filing status.</strong> Choose your filing status from your tax return two years prior (2024 return for 2026 premiums). Social Security uses this status to apply the correct IRMAA income brackets.
      </li>
      <li>
        <strong>Step 3 — Enter your Modified Adjusted Gross Income (MAGI).</strong> Type your 2024 MAGI (IRS Form 1040 AGI plus tax-exempt interest). You can find this on Line 11 of your 2024 Form 1040.
      </li>
      <li>
        <strong>Step 4 — Click "Calculate My Medicare Premium."</strong> The tool instantly produces your complete monthly cost breakdown, showing Part A, Part B base rate, and any IRMAA surcharges.
      </li>
    </ol>

    <!-- Pro Tip -->
    <div class="mp-pro-tip-box">
      <p class="mp-pro-tip-title">💡 Pro Tip — Appeal IRMAA Surcharges After Retirement</p>
      <p class="mp-pro-tip-text">
        If your 2024 tax income was high because you were still working, but you retired or reduced work hours in 2025 or 2026, you do NOT have to pay the higher IRMAA rate! File Form SSA-44 (Medicare Income-Related Monthly Adjustment Amount — Life-Changing Event) with Social Security to lower your premium immediately. Download our complete step-by-step guide at <a href="/tools/should-i-appeal-my-irmaa/">our IRMAA appeal wizard tool</a>.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 5 — REAL-LIFE SCENARIOS
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section mp-section-tinted" aria-labelledby="scenarios-heading">
    <h2 id="scenarios-heading">Real-Life Examples — How Premium Calculations Work in Practice</h2>

    <!-- Scenario 1 -->
    <div class="mp-scenario-card">
      <div class="mp-scenario-header">
        <span class="mp-scenario-tag">Example 1</span>
        <strong class="mp-scenario-title">Arthur &amp; Martha, 66 — Average Income Retirees</strong>
      </div>
      <p class="mp-scenario-intro">Arthur worked 42 quarters as a postal worker; Martha worked 40 quarters as a teacher. Their joint 2024 MAGI was $140,000.</p>
      <table class="mp-scenario-table">
        <thead>
          <tr>
            <th>Category</th>
            <th>Arthur</th>
            <th>Martha</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Part A Premium (40+ Quarters)</td>
            <td>$0.00</td>
            <td>$0.00</td>
          </tr>
          <tr>
            <td>Part B Base Premium (2026)</td>
            <td>$202.90</td>
            <td>$202.90</td>
          </tr>
          <tr>
            <td>IRMAA Surcharge (MAGI &lt; $212,000 Joint)</td>
            <td>$0.00</td>
            <td>$0.00</td>
          </tr>
        </tbody>
      </table>
      <p class="mp-scenario-result">
        Arthur and Martha each pay <span class="mp-amber-highlight">$202.90 per month</span> for Medicare Part B ($405.80 combined monthly bill), automatically deducted from their Social Security checks.
      </p>
      <p class="mp-scenario-action">They verified that their joint income fell below the $212,000 IRMAA threshold, so no income surcharges applied.</p>
    </div>

    <!-- Scenario 2 -->
    <div class="mp-scenario-card">
      <div class="mp-scenario-header">
        <span class="mp-scenario-tag">Example 2</span>
        <strong class="mp-scenario-title">Eleanor, 67 — Recent Executive Retiree (Tier 2 IRMAA)</strong>
      </div>
      <p class="mp-scenario-intro">Eleanor filed single in 2024 with a MAGI of $145,000 prior to retiring in late 2025.</p>
      <table class="mp-scenario-table">
        <thead>
          <tr>
            <th>Input</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Part A Quarters (40+)</td>
            <td>$0.00</td>
          </tr>
          <tr>
            <td>Part B Base Premium</td>
            <td>$202.90</td>
          </tr>
          <tr>
            <td>Tier 2 IRMAA Part B Surcharge ($133k–$167k Single)</td>
            <td>$115.90</td>
          </tr>
        </tbody>
      </table>
      <p class="mp-scenario-result">
        Eleanor's initial Part B bill is <span class="mp-amber-highlight">$318.80 per month</span> ($202.90 base + $115.90 IRMAA).
      </p>
      <p class="mp-scenario-action">Because Eleanor retired in late 2025, she filed Form SSA-44 for a work reduction life-changing event, reducing her premium back to the $202.90 base rate.</p>
    </div>

    <p class="mp-scenario-disclaimer">These are representative examples based on official 2026 CMS rates. Individual premiums vary based on actual tax filings and Social Security quarter records. Always verify your official determination with the <a href="https://www.ssa.gov" target="_blank" rel="noopener noreferrer">Social Security Administration</a>.</p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 6 — COMMON PITFALLS
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="pitfalls-heading">
    <h2 id="pitfalls-heading">Common Mistakes and How to Avoid Them</h2>

    <h3>Assuming a One-Time Income Spike (Roth Conversion, House Sale) Won't Affect Medicare</h3>
    <p>A single year of high income — such as a Roth IRA conversion, capital gains from selling a home, or taking a large 401(k) withdrawal — raises your MAGI two years later, triggering a temporary 1-year IRMAA surcharge.</p>
    <p><strong>The fix is</strong> to plan major financial transactions in years prior to age 63 or consult a financial planner. Read official rules at <a href="https://www.ssa.gov/benefits/medicare/medicare-premiums.html" target="_blank" rel="noopener noreferrer">Social Security Medicare premiums guide</a>.</p>

    <h3>Failing to File Form SSA-44 After Retirement</h3>
    <p>Social Security automatically looks at your 2-year-old tax return. If you retired since then, they will overcharge you based on your old salary unless you notify them.</p>
    <p><strong>The fix is</strong> to submit SSA Form SSA-44 as soon as your work status changes. Access the form directly at <a href="https://www.ssa.gov/forms/ssa-44.pdf" target="_blank" rel="noopener noreferrer">SSA Form SSA-44 Official PDF</a> or use our <a href="/tools/should-i-appeal-my-irmaa/">IRMAA appeal walkthrough tool</a>.</p>

    <h3>Not Counting a Spouse's Work Quarters for Part A</h3>
    <p>Seniors who did not work 40 quarters often mistakenly pay $278 or $505 monthly for Part A, unaware they qualify for $0 Part A based on their spouse's (or deceased spouse's) 40 work quarters.</p>
    <p><strong>The fix is</strong> to contact Social Security to claim Part A entitlement under your spouse's work record. Check details at <a href="https://www.ssa.gov/medicare" target="_blank" rel="noopener noreferrer">ssa.gov Medicare services</a>.</p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 7 — OFFICIAL SOURCES TABLE
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Official Government Sources Used in This Tool</h2>
    <div class="mp-table-container">
      <table class="mp-sources-table">
        <thead>
          <tr>
            <th>Source Name</th>
            <th>What We Used It For</th>
            <th>Direct Link</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>CMS 2026 Medicare Parts A &amp; B Premiums and Deductibles Fact Sheet</td>
            <td>Official base Part B rate ($202.90) and Part A quarter cost thresholds ($278 &amp; $505)</td>
            <td><a href="https://www.cms.gov/newsroom/fact-sheets/2026-medicare-parts-b-premiums-and-deductibles" target="_blank" rel="noopener noreferrer">CMS 2026 Medicare Fact Sheet</a></td>
          </tr>
          <tr>
            <td>Social Security Administration — Medicare Premiums &amp; IRMAA Brackets</td>
            <td>Official 2026 IRMAA income tier thresholds and surcharge rates</td>
            <td><a href="https://www.ssa.gov/benefits/medicare/medicare-premiums.html" target="_blank" rel="noopener noreferrer">SSA Official Medicare Premiums</a></td>
          </tr>
          <tr>
            <td>SSA Form SSA-44 (Life-Changing Event Appeal)</td>
            <td>Official form and guidelines for appealing Medicare income surcharges</td>
            <td><a href="https://www.ssa.gov/forms/ssa-44.pdf" target="_blank" rel="noopener noreferrer">SSA-44 Appeal Form</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mp-independence-statement">
      Seniors Audit is an independent educational platform. We are not affiliated with, endorsed by, or connected to any government agency, insurance company, or financial services firm. All calculations use the official formulas and current figures published by the agencies listed above. We do not receive payment for referrals, leads, or any action taken by visitors to this site.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 8 — FAQ SECTION
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently Asked Questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       TERMINOLOGIES / ABBREVIATIONS GLOSSARY (Rule 21)
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="terms-heading">
    <h2 id="terms-heading">Important Terminologies &amp; Abbreviations Explained</h2>
    <div class="mp-terms-grid">
      <div class="mp-term-item">
        <strong>Part A (Hospital Insurance)</strong>
        <p>Covers inpatient hospital care, skilled nursing facility stays, hospice, and home health care. Premium-free for most seniors with 40+ work quarters.</p>
      </div>
      <div class="mp-term-item">
        <strong>Part B (Medical Insurance)</strong>
        <p>Covers doctor visits, outpatient services, preventive care, and medical equipment. Base monthly premium is $202.90 in 2026.</p>
      </div>
      <div class="mp-term-item">
        <strong>MAGI (Modified Adjusted Gross Income)</strong>
        <p>Your tax return Adjusted Gross Income plus tax-exempt interest income. Used by Social Security to calculate IRMAA surcharges.</p>
      </div>
      <div class="mp-term-item">
        <strong>IRMAA (Income Related Monthly Adjustment Amount)</strong>
        <p>A higher monthly premium surcharge charged to Medicare beneficiaries with higher incomes based on tax returns from two years prior.</p>
      </div>
      <div class="mp-term-item">
        <strong>Work Quarters</strong>
        <p>Credit units earned by paying Medicare payroll taxes. 40 quarters (10 years of work) entitles you to $0 Part A premiums.</p>
      </div>
      <div class="mp-term-item">
        <strong>SSA (Social Security Administration)</strong>
        <p>The federal government agency responsible for determining Medicare eligibility, calculating IRMAA, and deducting premiums from checks.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       ELEMENT 9 — RELATED TOOLS
       ═══════════════════════════════════════════════════════ -->
  <section class="mp-section" aria-labelledby="related-heading">
