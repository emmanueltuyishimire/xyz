        <a href="/tools/medicare-irmaa-calculator/" class="mp-related-btn">Use This Free Tool</a>
        <span class="mp-no-acct-text">No account needed</span>
      </div>

      <div class="mp-related-card">
        <h3>IRMAA Appeal Letter Generator</h3>
