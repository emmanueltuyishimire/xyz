<script is:inline>
  var answers = {
    q1: null, // travel: 'yes' | 'no'
    q2: null, // doctor: 'yes' | 'no' | 'unsure'
    q3: null, // budget: 'low_premium' | 'predictable' | 'unsure'
    q4: null, // coverage: 'none' | 'employer' | 'va_tricare' | 'medicaid'
    q5: null  // chronic: 'yes' | 'no'
  };

  var currentStep = 1;
  var totalSteps = 5;

  function showQuestion(step) {
    for (var i = 1; i <= totalSteps; i++) {
      var card = document.getElementById('mdh-q' + i);
      if (card) card.style.display = (i === step) ? 'block' : 'none';
    }
    var progressFill = document.getElementById('mdh-progress-fill');
    var stepInd = document.getElementById('mdh-step-indicator');
    if (progressFill) progressFill.style.width = (step / totalSteps * 100) + '%';
    if (stepInd) stepInd.textContent = 'Question ' + step + ' of ' + totalSteps;
  }

  function handleChoice(qNum, value) {
    answers['q' + qNum] = value;
    if (qNum < totalSteps) {
      currentStep = qNum + 1;
      showQuestion(currentStep);
    } else {
      showResults();
    }
  }

  function showResults() {
    document.getElementById('mdh-quiz-body').style.display = 'none';
    var resEl = document.getElementById('mdh-results');
    if (resEl) resEl.style.display = 'block';

    var progressFill = document.getElementById('mdh-progress-fill');
    var stepInd = document.getElementById('mdh-step-indicator');
    if (progressFill) progressFill.style.width = '100%';
    if (stepInd) stepInd.textContent = 'Evaluation Complete';

    // Special Coverage Check
    var specialBanner = document.getElementById('mdh-special-banner');
    if (answers.q4 === 'employer') {
      specialBanner.innerHTML = '<strong>⚠️ Important: Active Employer Coverage Detected</strong>You indicated you or your spouse work for an employer with 20+ staff. You may be able to safely delay Medicare Part B without penalty. Confirm your plan is "creditable" with your HR department before making changes.';
      specialBanner.style.display = 'block';
    } else if (answers.q4 === 'va_tricare') {
      specialBanner.innerHTML = '<strong>ℹ️ Military / Veteran Coverage Detected</strong>TRICARE For Life acts as a wraparound supplement to Original Medicare (Parts A & B required). VA Health Care is separate from Medicare. Read our military healthcare coordination guide before choosing private Medicare Advantage.';
      specialBanner.style.display = 'block';
    } else if (answers.q4 === 'medicaid') {
      specialBanner.innerHTML = '<strong>ℹ️ Dual Eligibility / Medicaid Detected</strong>If you qualify for Medicaid, look into Dual-Eligible Special Needs Plans (D-SNPs) or Medicare Savings Programs (QMB/SLMB), which cover your Part B premium and cost-sharing.';
      specialBanner.style.display = 'block';
    } else {
      specialBanner.style.display = 'none';
    }

    // Evaluation Logic
    var titleEl = document.getElementById('mdh-verdict-title');
    var descEl = document.getElementById('mdh-verdict-desc');
    var factorsList = document.getElementById('mdh-factors-list');
    factorsList.innerHTML = '';

    var omScore = 0;
    var maScore = 0;

    // Rule 1: Travel
    if (answers.q1 === 'yes') {
      omScore += 2;
      addFactor('FACT: Nationwide Provider Access', 'Because you travel or live in multiple states, Original Medicare lets you visit any participating provider across all 50 states without out-of-network penalties.');
    } else {
      maScore += 1;
      addFactor('FACT: Local Care Suitability', 'Because you receive medical care locally, a regional HMO or PPO Medicare Advantage network can accommodate your primary medical needs.');
    }

    // Rule 2: Doctor Loyalty
    if (answers.q2 === 'yes') {
      omScore += 2;
      addFactor('FACT: Doctor & Hospital Independence', 'Because keeping your specific doctors is essential, Original Medicare prevents network dropouts and referral barriers.');
    } else if (answers.q2 === 'no') {
      maScore += 1;
      addFactor('DECISION SUPPORT: Network Flexibility', 'Willingness to use an in-network provider list allows you to capitalize on $0 premium Medicare Advantage plans.');
    }

    // Rule 3: Budget
    if (answers.q3 === 'predictable') {
      omScore += 2;
      addFactor('DECISION SUPPORT: Financial Predictability', 'You prefer knowing your costs will not spike during serious illness. Original Medicare + Medigap Plan G provides complete copay protection after the small $283 Part B deductible.');
    } else if (answers.q3 === 'low_premium') {
      maScore += 2;
      addFactor('DECISION SUPPORT: Premium Minimization', 'You prefer lower monthly overhead. Medicare Advantage plans offer $0 or low plan premiums, paying copays only as medical care is received.');
    }

    // Rule 5: Chronic Condition
    if (answers.q5 === 'yes') {
      omScore += 2;
      addFactor('FACT: No Prior Authorization Hurdles', 'Frequent specialist visits on Original Medicare avoid commercial insurer prior authorization delays and step therapy restrictions.');
    } else {
      maScore += 1;
      addFactor('DECISION SUPPORT: Healthy Utilization Profile', 'Routine care only means you are less likely to accumulate high specialist copays on a Medicare Advantage plan.');
    }

    // Determine Verdict
    if (omScore >= maScore + 2) {
      titleEl.textContent = 'Your Profile Leans Strongly Toward Original Medicare + Medigap';
      descEl.textContent = 'Based on your priorities for doctor freedom, travel flexibility, and predictable out-of-pocket costs, Original Medicare with a Medigap supplement appears to be the stronger match for your lifestyle.';
    } else if (maScore >= omScore + 2) {
      titleEl.textContent = 'Your Profile Leans Strongly Toward Medicare Advantage';
      descEl.textContent = 'Based on your preference for low monthly premiums and local routine healthcare usage, a Medicare Advantage plan could provide significant premium savings and extra bundled benefits.';
    } else {
      titleEl.textContent = 'Your Answers Point in Different Directions — This Is a Close Call';
      descEl.textContent = 'You have competing priorities (such as wanting lower monthly premiums while also valuing travel flexibility or doctor choice). This is a genuinely close decision — compare the exact dollar estimates for both paths below.';
    }

    resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function addFactor(tag, text) {
    var list = document.getElementById('mdh-factors-list');
    var div = document.createElement('div');
    div.className = 'mdh-factor-item';
    div.innerHTML = '<strong>' + tag + '</strong>' + text;
    list.appendChild(div);
  }

  function resetQuiz() {
    answers = { q1: null, q2: null, q3: null, q4: null, q5: null };
    currentStep = 1;
    document.getElementById('mdh-results').style.display = 'none';
    document.getElementById('mdh-quiz-body').style.display = 'block';
    showQuestion(1);
    document.getElementById('mdh-tool').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.mdh-choice-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var qNum = parseInt(this.getAttribute('data-q'));
        var val = this.getAttribute('data-val');
        handleChoice(qNum, val);
      });
    });

    var retakeBtn = document.getElementById('mdh-retake-btn');
    if (retakeBtn) retakeBtn.addEventListener('click', resetQuiz);
  });
</script>
