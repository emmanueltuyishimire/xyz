---
/**
 * social-security-cola-calculator.astro
 * Canonical URL: /tools/social-security-cola-calculator/
 * Primary Keyword: social security cola 2027
 * Secondary Keywords: social security cola calculator, social security 2027 cola increase, when does social security cola take effect
 * Title (<= 60 chars): Social Security COLA 2027 Calculator: Your 3.6% Increase
 * Meta Description (<= 155 chars): Social Security COLA 2027 is 3.6% (SSA, Oct 14, 2026). Enter your monthly benefit to see your new check and yearly increase. Free, no signup.
 * H1: Social Security COLA 2027 Calculator: 3.6% Increase
 * Last Reviewed: October 2026
 */
import ToolLayout from '@layouts/ToolLayout.astro';
import { SocialSecurityCOLACalculator as COLATool } from '@components/tools/SocialSecurityCOLAEstimator';
import DisclaimerBlock from '@components/content/DisclaimerBlock.astro';
import FAQBlock from '@components/content/FAQBlock.astro';
import NoSignupStatement from '@components/common/NoSignupStatement.astro';
import RelatedToolButtons from '@components/tools/RelatedToolButtons.astro';
import { OFFICIAL_2027_COLA } from '../../data/constants';

const pageTitle = 'Social Security COLA 2027 Calculator: Your 3.6% Increase';
const metaDescription = 'Social Security COLA 2027 is 3.6% (SSA, Oct 14, 2026). Enter your monthly benefit to see your new check and yearly increase. Free, no signup.';
const lastReviewed = 'October 2026';
const dateModified = '2026-10-14';

// 7 Focused FAQs strictly sourced from SSA announcements and official facts
const faqs = [
  {
    question: 'What is the 2027 Social Security COLA?',
    answer: `The 2027 Social Security Cost-of-Living Adjustment (COLA) is officially ${OFFICIAL_2027_COLA.rateFormatted}. The Social Security Administration announced this rate on ${OFFICIAL_2027_COLA.announcedDate}, based on third-quarter 2026 CPI-W inflation figures released by the Bureau of Labor Statistics.`,
  },
  {
    question: 'When do I see the 2027 COLA increase?',
    answer: `Social Security retirement, disability (SSDI), and survivor beneficiaries will see their 3.6% increase starting with their ${OFFICIAL_2027_COLA.effectiveDateSS} payments. Supplemental Security Income (SSI) recipients will see the adjustment paid on ${OFFICIAL_2027_COLA.effectiveDateSSI}, because January 1 is a federal holiday.`,
  },
  {
    question: 'How much more will I get with the 2027 COLA?',
    answer: `Your exact dollar increase is 3.6% of your gross monthly benefit. For example, a $1,500 monthly check rises by $54.00 to $1,554.00, and a $2,000 benefit rises by $72.00 to $2,072.00. SSA estimates the average retired worker benefit rises about ${OFFICIAL_2027_COLA.averageMonthlyIncreaseFormatted} a month.`,
  },
  {
    question: 'Is the 2027 COLA the same in every state?',
    answer: 'Yes. The 3.6% COLA is a uniform federal percentage established under federal statute (42 U.S.C. § 415(i)). It applies equally to all eligible beneficiaries across all 50 states, the District of Columbia, and U.S. territories.',
  },
  {
    question: 'Will Medicare take part of my 2027 COLA increase?',
    answer: 'It may. If you have Medicare Part B premiums deducted directly from your Social Security payment and Part B premiums rise for 2027, the premium increase reduces your net monthly check. CMS announces 2027 Medicare Part B premiums separately in mid-November. The statutory Hold Harmless rule protects eligible recipients from seeing their net check decline.',
  },
  {
    question: 'Do SSDI and SSI recipients get the 2027 COLA?',
    answer: `Yes. Both Social Security Disability Insurance (SSDI) and Supplemental Security Income (SSI) receive the 3.6% COLA. Social Security benefits (${OFFICIAL_2027_COLA.ssBeneficiaries} beneficiaries) adjust in January 2027, while SSI payments (${OFFICIAL_2027_COLA.ssiRecipients} recipients) adjust on December 31, 2026.`,
  },
  {
    question: 'Why is my dollar increase different from the $75 average?',
    answer: `The $75 figure reported by SSA is the average increase across all retired workers, based on an average monthly benefit of approximately $2,074 before COLA ($2,074 × 3.6% ≈ $74.66). If your current benefit is higher than $2,074, your dollar gain is larger; if your benefit is lower, your gain is smaller.`,
  },
];

const relatedColaTools = [
  {
    "title": "Social Security Benefits Calculator",
    "href": "/tools/social-security-benefits-calculator/"
  },
  {
    "title": "Social Security Tax Calculator",
    "href": "/tools/social-security-tax-calculator/"
  },
  {
    "title": "Full Retirement Age Calculator",
    "href": "/tools/social-security-full-retirement-age-calculator/"
  },
  {
    "title": "Medicare Premium Calculator",
    "href": "/tools/medicare-premium-calculator/"
  }
];
---

<ToolLayout
  title={pageTitle}
  description={metaDescription}
  faqs={faqs}
  dateModified={dateModified}
  datePublished="2026-06-15"
  agency="SSA"
  canonical="https://www.seniorsaudit.com/tools/social-security-cola-calculator/"
  schema="SoftwareApplication"
>

  <!-- ═══════════════════════════════════════════════════════
       HERO: ORDER H1 -> QUICK ANSWER -> CALCULATOR
       ═══════════════════════════════════════════════════════ -->
  <div class="cc-hero">
    <div class="cc-breadcrumb">
      <a href="/social-security/" class="cc-crumb-link">Social Security</a>
      <span aria-hidden="true"> › </span>
      <a href="/tools/" class="cc-crumb-link">Tools &amp; Calculators</a>
      <span aria-hidden="true"> › </span>
      <span>COLA Calculator</span>
    </div>

    <!-- H1 -->
    <h1 class="cc-h1">Social Security COLA 2027 Calculator: 3.6% Increase</h1>

    <!-- Quick Answer Block -->
    <div class="cc-quick-answer" role="note" aria-label="Quick Answer">
      <p class="cc-qa-label">Quick Answer</p>
      <p class="cc-qa-text">
        Social Security COLA 2027 is {OFFICIAL_2027_COLA.rateFormatted}: SSA announced on {OFFICIAL_2027_COLA.announcedDate} that benefits rise with {OFFICIAL_2027_COLA.effectiveDateSS} payments (SSI on {OFFICIAL_2027_COLA.effectiveDateSSI}). Enter your gross monthly benefit below to see your new amount; SSA says the average retirement benefit rises {OFFICIAL_2027_COLA.averageMonthlyIncreaseFormatted} a month.
      </p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       CALCULATOR (immediately following Quick Answer)
       ═══════════════════════════════════════════════════════ -->
  <div class="cc-tool-block" id="calculator">
    <COLATool client:load />
  </div>

  <RelatedToolButtons heading="Related Benefit &amp; Tax Calculators" tools={relatedColaTools} />

  <NoSignupStatement />

  <!-- ═══════════════════════════════════════════════════════
       WHEN YOU WILL SEE IT — OFFICIAL SSA TIMELINE
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading">When You Will See Your 2027 Social Security COLA Increase</h2>
    <p>
      The Social Security Administration has announced the official schedule for when {OFFICIAL_2027_COLA.totalRecipients} beneficiaries will receive their adjusted payments and notices:
    </p>

    <div class="cc-callout">
      <ul class="cc-list" style="margin: 0; padding-left: 1.25rem;">
        <li>
          <strong>December 31, 2026:</strong> First adjusted payment date for Supplemental Security Income (SSI) recipients ({OFFICIAL_2027_COLA.ssiRecipients} individuals), because January 1, 2027 is a federal holiday.
        </li>
        <li>
          <strong>January 2027:</strong> First adjusted payment date for Social Security retirement, survivor, and SSDI beneficiaries ({OFFICIAL_2027_COLA.ssBeneficiaries} people), paid on your normal second, third, or fourth Wednesday schedule.
        </li>
        <li>
          <strong>Late November 2026:</strong> Official COLA notices become available online in the Message Center of personal <em>my Social Security</em> accounts. To receive your notice online in late November, your account must be created by <strong>{OFFICIAL_2027_COLA.onlineNoticeDeadline}</strong>.
        </li>
        <li>
          <strong>December 2026:</strong> SSA mails paper COLA notices throughout the month to beneficiaries who have not opted for digital-only notifications.
        </li>
      </ul>
    </div>

    <p>
      You can review or set up your online account securely at <a href="https://www.ssa.gov/myaccount" target="_blank" rel="noopener noreferrer" class="cc-link">ssa.gov/myaccount ↗</a> before the November 18 deadline to see your official 2027 notice weeks before paper copies arrive.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       2027 COLA DOLLAR IMPACT TABLE
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="cola-2027-impact">
    <h2 id="cola-2027-impact">2027 COLA Dollar Impact by Monthly Benefit Amount</h2>
    <p>
      The 3.6% COLA applies directly to your Primary Insurance Amount. The table below shows the gross monthly and annual increases across typical benefit amounts before any deductions:
    </p>

    <div class="cc-table-wrap">
      <table class="cc-table">
        <caption class="cc-table-caption">2027 COLA (3.6%) Dollar Increase Examples</caption>
        <thead>
          <tr>
            <th>Current Monthly Benefit</th>
            <th>Monthly Gross Increase (3.6%)</th>
            <th>New Gross Monthly Benefit</th>
            <th>Annual Gross Increase</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>$800</td>
            <td>+$28.80</td>
            <td>$828.80</td>
            <td>+$345.60</td>
          </tr>
          <tr class="cc-row-alt">
            <td>$1,200</td>
            <td>+$43.20</td>
            <td>$1,243.20</td>
            <td>+$518.40</td>
          </tr>
          <tr>
            <td>$1,500</td>
            <td>+$54.00</td>
            <td>$1,554.00</td>
            <td>+$648.00</td>
          </tr>
          <tr class="cc-row-alt">
            <td>$2,000</td>
            <td>+$72.00</td>
            <td>$2,072.00</td>
            <td>+$864.00</td>
          </tr>
          <tr>
            <td>$2,500</td>
            <td>+$90.00</td>
            <td>$2,590.00</td>
            <td>+$1,080.00</td>
          </tr>
          <tr class="cc-row-alt">
            <td>$3,000</td>
            <td>+$108.00</td>
            <td>$3,108.00</td>
            <td>+$1,296.00</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="cc-table-note">
      Figures reflect gross mathematical calculations before statutory dime-rounding (POMS RS 00601.120) and dollar-rounding on payment checks (POMS RS 00601.020). For complete analysis of the CPI-W formula, wage base changes, and historical comparisons, read our in-depth <a href="/social-security/social-security-cola-2027/" class="cc-link">Social Security COLA 2027 Official Guide</a>.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       WHY YOUR DEPOSIT MAY RISE LESS (MEDICARE PART B & HOLD HARMLESS)
       ═══════════════════════════════════════════════════════ -->
  <!-- CMS PART B 2027 UPDATE PENDING: Revise when CMS releases official 2027 Part B standard premium in mid-November 2026 -->
  <section class="cc-section" aria-labelledby="why-deposit-rises-less">
    <h2 id="why-deposit-rises-less">Why Your Deposit May Rise Less: Medicare Part B &amp; Hold Harmless</h2>
    <p>
      The 3.6% COLA is a <strong>gross benefit increase</strong>. The actual dollar amount deposited into your bank account may be smaller if your Medicare Part B premium increases, because Part B premiums are automatically deducted from Social Security checks for most beneficiaries.
    </p>

    <div class="cc-callout" style="background: #fffbeb; border-left-color: #d97706;">
      <p style="margin: 0; color: #92400e;">
        <strong>2027 Medicare Part B Status:</strong> The Centers for Medicare &amp; Medicaid Services (CMS) has <strong>not yet announced</strong> the official 2027 Medicare Part B premium and deductible. CMS typically releases these figures in mid-November. We do not publish speculative premium estimates; this section will be updated with verified CMS figures as soon as they are announced.
      </p>
    </div>

    <p>
      <strong>How the Statutory Hold Harmless Rule Works:</strong><br />
      Under Section 1839(f) of the Social Security Act (42 U.S.C. § 1395r(f)), a special statutory protection known as the "Hold Harmless" provision prevents a beneficiary's net Social Security payment from decreasing from one year to the next as a result of an increase in the Medicare Part B standard monthly premium.
    </p>

    <p>
      <strong>Who Hold Harmless Protects:</strong>
    </p>
    <ul class="cc-list">
      <li>Beneficiaries who have their Part B premium automatically deducted from their monthly Social Security benefit check for both November and December of the prior year.</li>
    </ul>

    <p>
      <strong>Who Hold Harmless Does NOT Protect:</strong>
    </p>
    <ul class="cc-list">
      <li><strong>New enrollees in 2027:</strong> Beneficiaries who enroll in Medicare Part B for the first time in 2027 have no 2026 benefit baseline to protect.</li>
      <li><strong>Direct-billed beneficiaries:</strong> Individuals who pay their Medicare Part B premiums directly by quarterly bill or credit card rather than having them withheld from a monthly Social Security check.</li>
      <li><strong>High-income beneficiaries subject to IRMAA:</strong> Beneficiaries whose modified adjusted gross income exceeds statutory thresholds ($109,000 for single filers or $218,000 for married couples in 2026) pay Income-Related Monthly Adjustment Amounts and are explicitly excluded from Hold Harmless protection under 42 U.S.C. § 1395r(f).</li>
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       TAXES: PROVISIONAL INCOME (IRS PUB 915)
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="tax-impact">
    <h2 id="tax-impact">Taxes: Why a Higher COLA Benefit Can Increase Taxable Social Security</h2>
    <p>
      A higher gross benefit increases your total cash flow, but it may also push more of your Social Security benefits into federally taxable territory. Under Internal Revenue Code § 86 and IRS Publication 915, federal taxation of benefits is governed by your <em>Provisional Income</em> (Adjusted Gross Income + tax-exempt interest + 50% of your annual Social Security benefits).
    </p>
    <p>
      The statutory provisional income thresholds are fixed by law and are <strong>unindexed for inflation</strong> (they have never changed since enacted in 1983):
    </p>
    <ul class="cc-list">
      <li><strong>Single, Head of Household, or Qualifying Surviving Spouse:</strong> Up to 50% of benefits become taxable between $25,000 and $34,000; up to 85% becomes taxable above $34,000.</li>
      <li><strong>Married Filing Jointly:</strong> Up to 50% becomes taxable between $32,000 and $44,000; up to 85% becomes taxable above $44,000.</li>
    </ul>
    <p>
      Because these thresholds never adjust upward, annual COLA increases steadily push more retirees over the limits. Use our free <a href="/tools/social-security-tax-calculator/" class="cc-link">Social Security Tax Calculator</a> to determine exactly how much of your increased benefit will be taxable.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SSDI AND SSI RECIPIENTS
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="ssdi-ssi-section">
    <h2 id="ssdi-ssi-section">SSDI and SSI: How the 2027 COLA Applies</h2>
    <p>
      The 3.6% COLA is not restricted to retirees. It applies automatically across all Social Security programs:
    </p>
    <ul class="cc-list">
      <li><strong>Social Security Disability Insurance (SSDI):</strong> Disabled workers and their eligible auxiliary beneficiaries receive the full 3.6% increase starting with their January 2027 payments.</li>
      <li><strong>Supplemental Security Income (SSI):</strong> Approximately 7.3 million SSI recipients receive the 3.6% adjustment, with payments taking effect early on <strong>December 31, 2026</strong>.</li>
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       2026 COLA ARCHIVE REFERENCE
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="cola-2026-ref">
    <h2 id="cola-2026-ref">Looking for the 2026 COLA (2.8%)?</h2>
    <p>
      The 2026 COLA of 2.8% took effect with payments in January 2026 (announced October 24, 2025). You can calculate your historical 2026 benefit using the secondary tab in the calculator above. For complete background on the 2026 rate and prior-year comparisons, review our <a href="/social-security/social-security-cola-2026/" class="cc-link">Social Security COLA 2026 Guide</a>.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       FAQS (7 SPECIFIC QUESTIONS)
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently Asked Questions</h2>
    <FAQBlock items={faqs} />
  </section>

  <!-- ═══════════════════════════════════════════════════════
       OFFICIAL SOURCES TABLE
       ═══════════════════════════════════════════════════════ -->
  <section class="cc-section" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Official Sources Used in This Calculator</h2>
    <div class="cc-table-wrap">
      <table class="cc-table">
        <thead>
          <tr>
            <th>Official Authority</th>
            <th>Document / Resource</th>
            <th>Official URL</th>
          </tr>
        </thead>
        <tbody>
