  .cc-related-card:hover { border-color: #0A3D3A; box-shadow: 0 2px 8px rgba(10,61,58,0.1); }
  .cc-related-icon { font-size: 1.75rem; flex-shrink: 0; }
  .cc-related-card strong { display: block; color: #0D2137; font-size: 1rem; margin-bottom: 0.35rem; font-weight: 700; }
  .cc-related-card p { font-size: 0.875rem; color: #4B5A6E; line-height: 1.5; margin: 0 0 0.5rem 0; }
  .cc-related-btn { display: inline-block; background: #0A3D3A; color: #fff; font-size: 0.8rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 0.4rem; margin-bottom: 0.25rem; }
  .cc-no-acct { display: block; font-size: 0.75rem; color: #4B5A6E; }

  @media (max-width: 640px) {
    .cc-tool-block { padding: 1rem; }
  }
</style>
