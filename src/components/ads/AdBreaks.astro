---
/**
 * AdBreaks — places a small number of ads at natural reading breaks (between sections), never inside
 * calculators, forms, tables or the first screen. It renders NOTHING until ads are switched on:
 *   PUBLIC_ADS_ENABLED=true  and  PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX  (Netlify environment variables)
 *   PUBLIC_ADSENSE_SLOT=<ad unit id>  (a responsive display unit created in AdSense)
 * Rules (Google publisher policies + advertiser expectations):
 *   - ads are labelled "Advertisement" and visually separated from content
 *   - at most 3 ads per page, at least ~1,100px apart, none before the first ~1,000px of content
 *   - never adjacent to a button, form control or navigation, so they cannot be mistaken for page controls
 *   - skipped entirely on legal/contact/search pages and short pages
 */
const enabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT ?? '';
const on = enabled && /^ca-pub-\d+$/.test(client) && /^\d+$/.test(slot);
---
{on && (
  <>
    <style is:global>
      .ad-break { margin: 40px auto; padding: 12px 0; max-width: 100%; text-align: center; clear: both; border-top: 1px solid var(--color-border, #DDE3EA); border-bottom: 1px solid var(--color-border, #DDE3EA); }
      .ad-break__label { display: block; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: #5B6770; margin-bottom: 6px; }
      .ad-break ins.adsbygoogle { display: block; min-height: 250px; }
      @media print { .ad-break { display: none; } }
    </style>
    <script is:inline define:vars={{ client, slot }}>
      (function () {
        var path = location.pathname;
        if (/^\/(privacy-policy|terms-of-use|disclaimer|contact|search|404|about)(\/|$)/.test(path) || path === '/') return;
        var root = document.querySelector('.article-body') || document.querySelector('.tool-layout-container');
        if (!root || root.innerText.length < 4000) return;
        var heads = Array.prototype.slice.call(root.querySelectorAll('h2'));
        var placed = [], lastY = 0, top = root.getBoundingClientRect().top + window.scrollY;
        heads.forEach(function (h) {
          if (placed.length >= 3) return;
          var y = h.getBoundingClientRect().top + window.scrollY - top;
          if (y < 1000 || y - lastY < 1100) return;
          var prev = h.previousElementSibling;
          if (prev && /^(FORM|TABLE|BUTTON|NAV)$/.test(prev.tagName)) return;
          if (h.closest('details, [role="dialog"], form')) return;
          var box = document.createElement('aside');
          box.className = 'ad-break';
          box.setAttribute('aria-label', 'Advertisement');
          box.innerHTML = '<span class="ad-break__label">Advertisement</span><ins class="adsbygoogle" data-ad-client="' + client + '" data-ad-slot="' + slot + '" data-ad-format="auto" data-full-width-responsive="true"></ins>';
          h.parentNode.insertBefore(box, h);
          placed.push(box); lastY = y;
        });
        if (!placed.length) return;
        function load() {
          if (window.__adsLoaded) return; window.__adsLoaded = true;
          var s = document.createElement('script');
          s.async = true; s.crossOrigin = 'anonymous';
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
          s.onload = function () { placed.forEach(function () { try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {} }); };
          document.head.appendChild(s);
        }
        ['scroll', 'pointerdown', 'keydown'].forEach(function (e) { window.addEventListener(e, load, { once: true, passive: true }); });
        setTimeout(load, 6000);
      })();
    </script>
  </>
)}
