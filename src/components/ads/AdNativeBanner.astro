---
/**
 * AdNativeBanner.astro
 * Reusable Adsterra Native Banner component.
 *
 * Renders the Adsterra Native Banner ad unit (NativeBanner_1, ID 31953944).
 * Native Banners display contextually relevant content recommendations
 * styled as a grid of images — by default 4 in a row (configurable in Adsterra dashboard).
 *
 * Props:
 *   class   — Optional additional CSS class for positioning
 *   label   — Screen-reader and visual label (default: 'Sponsored Content')
 *
 * Usage:
 *   <AdNativeBanner />
 *   <AdNativeBanner label="Advertisement" class="my-custom-class" />
 *
 * Notes:
 *   - This uses the NATIVE ASYNC format (different from iframe-sync banners).
 *   - The script creates a <div> container and populates it dynamically.
 *   - If the script fails to load, the container remains empty and collapses.
 *   - Do NOT render this component multiple times on the same page.
 */

interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Sponsored Content' } = Astro.props;

/**
 * Adsterra Native Banner configuration — sourced verbatim from the Adsterra
 * publisher dashboard (seniorsaudit.com, NativeBanner_1, NATIVE ASYNC format).
 * Script source: https://bauval.org/21/{key}
 * Container ID: container-{key}
 *
 * Injected via Fragment set:html to preserve async and data-cfasync="false"
 * attributes exactly as supplied, without Astro stripping or transforming them.
 */
const NATIVE_KEY = 'fbb784f2d88e5e7009bec78985ccf6c9';
const nativeContainerId = `container-${NATIVE_KEY}`;

/**
 * Exact Adsterra NATIVE ASYNC code — verbatim from publisher dashboard.
 * data-cfasync="false" prevents Cloudflare Rocket Loader from deferring the script,
 * which would break the native banner's container population.
 */
const nativeAdCode =
  `<script async="async" data-cfasync="false" src="https://bauval.org/21/${NATIVE_KEY}"><\/script>` +
  `<div id="${nativeContainerId}"></div>`;
---

<aside
  class={`ad-native-container ${className}`.trim()}
  aria-label={label}
  role="complementary"
>
  <p class="ad-native-label">{label}</p>
  <div class="ad-native-slot">
    <Fragment set:html={nativeAdCode} />
  </div>
</aside>

<style>
  .ad-native-container {
    margin-block: var(--space-8, 2rem);
    max-width: 100%;
    overflow: hidden;
  }

  .ad-native-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #999);
    margin: 0 0 8px 0;
  }

  .ad-native-slot {
    max-width: 100%;
    overflow: hidden;
  }

  /* Collapse if native banner fails to populate */
  .ad-native-slot:empty {
    display: none;
  }

  /* Dark theme label contrast */
  :global([data-theme="dark"]) .ad-native-label {
    color: var(--color-text-muted, #888);
  }
</style>
