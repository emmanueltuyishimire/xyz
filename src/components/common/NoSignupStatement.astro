---
/**
 * NoSignupStatement.astro
 * Spec Section 5 — The No Signup Competitive Positioning Statement
 * Required on EVERY tool page, between the tool interface and the how-to section.
 * Content never changes. Identical across all pages.
 */
---

<div class="no-signup-statement" role="region" aria-label="Privacy and independence statement">
  <div class="no-signup-grid">

    <div class="no-signup-col">
      <!-- Open padlock icon -->
      <svg class="no-signup-icon" aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
      </svg>
      <p class="no-signup-label">No Account. No Sign Up.</p>
      <p class="no-signup-text">Use the tool instantly — no email, no password, nothing to create.</p>
    </div>

    <div class="no-signup-col">
      <!-- Shield with crossed dollar sign icon -->
      <svg class="no-signup-icon" aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <line x1="8" y1="12" x2="16" y2="12" stroke-width="2"></line>
        <line x1="12" y1="8" x2="12" y2="16" stroke-width="2" opacity="0.4"></line>
      </svg>
      <p class="no-signup-label">We Never Sell Your Data.</p>
      <p class="no-signup-text">Your inputs are used only to generate your result. We do not share, store, or sell any information you enter.</p>
    </div>

    <div class="no-signup-col">
      <!-- Magnifying glass over document icon -->
      <svg class="no-signup-icon" aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <circle cx="10" cy="15" r="2"></circle>
        <line x1="11.5" y1="16.5" x2="14" y2="19"></line>
      </svg>
      <p class="no-signup-label">Fully Independent.</p>
      <p class="no-signup-text">Seniors Audit is not affiliated with any insurance company, government agency, or data broker. We have no financial interest in your coverage choices.</p>
    </div>

  </div>
</div>

<style>
  .no-signup-statement {
    background: var(--color-surface-alt, #f6f8fa);
    border: 1px solid var(--color-border, #dde3ea);
    border-radius: var(--radius-xl, 1rem);
    padding: var(--space-8, 2rem);
    margin-bottom: var(--space-10, 2.5rem);
  }

  .no-signup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6, 1.5rem);
    text-align: center;
  }

  .no-signup-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  .no-signup-icon {
    color: #0A3D3A;
    flex-shrink: 0;
  }

  .no-signup-label {
    font-size: var(--text-base, 1rem);
    font-weight: 700;
    color: var(--color-primary, #0D2137);
    margin: 0;
    line-height: 1.3;
  }

  .no-signup-text {
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-text-muted, #4B5A6E);
    margin: 0;
    line-height: 1.5;
    max-width: 24ch;
  }

  @media (max-width: 640px) {
    .no-signup-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5, 1.25rem);
    }
    .no-signup-text {
      max-width: 100%;
    }
    .no-signup-statement {
      padding: var(--space-5, 1.25rem);
    }
  }
</style>
