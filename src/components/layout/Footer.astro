---
/**
 * Footer.astro
 * seniorsaudit.com site footer.
 *
 * Clean, balanced 4-column architecture:
 * - Col 1: Brand, mission, author attribution, social links, Google Preferred Source button
 * - Col 2: Decision Calculators & Tools (generous width, no awkward wrapping)
 * - Col 3: Educational Learning Hubs
 * - Col 4: About & Legal
 *
 * Includes:
 * - Compact, reassuring educational disclaimer (not alarming)
 * - White Google Preferred Source button with Google 4-color logo
 * - Responsive 2-col on tablet, 1-col on mobile
 */

const currentYear = new Date().getFullYear();


const footerNavColumns = [
  {
    title: 'Calculators & Tools',
    links: [
      { label: 'Full Retirement Age Calculator', href: '/tools/social-security-full-retirement-age-calculator/' },
      { label: 'Social Security Benefits Calculator', href: '/tools/social-security-benefits-calculator/' },
      { label: 'Medicare Premium Calculator', href: '/tools/medicare-premium-calculator/' },
      { label: 'Medicare IRMAA Surcharge', href: '/tools/medicare-irmaa-calculator/' },
      { label: 'Part B Late Penalty Calculator', href: '/tools/medicare-late-enrollment-penalty-calculator/' },
      { label: 'RMD Mandatory Withdrawal Tool', href: '/tools/rmd-calculator/' },
      { label: 'View All 78 Free Tools →', href: '/tools/' },
    ]
  },
  {
    title: 'Learning Hubs',
    links: [
      { label: 'Medicare Guidance & Plans', href: '/medicare/' },
      { label: 'Social Security & COLA', href: '/social-security/' },
      { label: 'Medicaid & Savings Programs', href: '/medicaid/' },
      { label: 'IRS Notice Response Decoders', href: '/irs/' },
      { label: 'Retirement & Taxes', href: '/retirement/' },
      { label: 'Educational Video Library', href: '/educational-videos/' },
    ]
  },
  {
    title: 'About & Help',
    links: [
      { label: 'About Seniors Audit', href: '/about/' },
      { label: 'Emmanuel Tuyishimire (Founder)', href: '/about/emmanuel-tuyishimire/' },
      { label: 'Contact Us', href: '/contact/' },
      { label: 'Learning Center (Articles)', href: '/blog/' },
      { label: 'General Disclaimer', href: '/disclaimer/' },
      { label: 'Privacy Policy', href: '/privacy-policy/' },
      { label: 'Terms of Use', href: '/terms-of-use/' },
    ]
  }
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      
      <!-- Column 1: Mission, Core Info & Google Preferred Source -->
      <div class="footer-info">
        <a href="/" class="footer-logo" aria-label="Seniors Audit — Home">
          <span class="logo-name">Seniors <strong>Audit</strong></span>
        </a>
        <p class="footer-mission">
          Providing clear, plain-language education on Social Security, Medicare, taxes, and retirement benefits to help seniors and caregivers make confident, informed decisions.
        </p>
        <p class="footer-attribution">
          Founded and researched by <a href="/about/emmanuel-tuyishimire/">Emmanuel Tuyishimire</a>
        </p>
        
        <!-- Social Media Links -->
        <div class="footer-social" aria-label="Follow us on social media">
          <p class="footer-social-label">Follow Us</p>
          <div class="footer-social-icons">
            <a href="https://www.youtube.com/@SeniorsAudit" class="social-icon-link" target="_blank" rel="noopener noreferrer" aria-label="Seniors Audit on YouTube" title="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://web.facebook.com/SeniorsAudit" class="social-icon-link" target="_blank" rel="noopener noreferrer" aria-label="Seniors Audit on Facebook" title="Facebook Page">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/emmanueltuyishimire" class="social-icon-link" target="_blank" rel="noopener noreferrer" aria-label="Emmanuel Tuyishimire on LinkedIn" title="Founder LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://www.reddit.com/user/Emmanuel_Tuyishimire/" class="social-icon-link" target="_blank" rel="noopener noreferrer" aria-label="Emmanuel Tuyishimire on Reddit" title="Reddit">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Columns 2-4: Navigation Lists -->
      {footerNavColumns.map(column => (
        <div class="footer-nav-col">
          <p class="footer-title" role="presentation">{column.title}</p>
          <ul class="footer-list" role="list">
            {column.links.map(link => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      
    </div>

    <!-- Site-wide Disclaimer (Compact, reassuring, legally compliant) -->
    <div class="footer-disclaimer">
      <p>
        <strong>Educational Information Only:</strong> seniorsaudit.com is an independent educational website and is not affiliated with, endorsed by, or connected to the Social Security Administration, Centers for Medicare &amp; Medicaid Services, the Internal Revenue Service, or any government agency. Information on this website is for educational purposes only and does not constitute legal, tax, financial, or medical advice. Always consult a licensed professional (such as a CPA, attorney, or financial advisor) before making decisions based on this information.
      </p>
    </div>

    <!-- Copyright and Policies -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Seniors Audit. All rights reserved. 100% Free Educational Resource &bull; We Never Sell Your Information.
      </p>
      <p class="footer-meta-links">
        <a href="/disclaimer/">General Disclaimer</a> &bull;
        <a href="/privacy-policy/">Privacy Policy</a> &bull;
        <a href="/terms-of-use/">Terms of Use</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: #e2e8f0;
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    border-top: 4px solid var(--color-secondary);
    font-size: var(--text-sm);
  }

  .site-footer a {
    color: #cbd5e1;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .site-footer a:hover {
    color: #ffffff;
    text-decoration-thickness: 2px;
  }

  /* 4-Column Balanced Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1.2fr 1.1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    align-items: start;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer-info {
    max-width: 340px;
  }

  .footer-logo {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .footer-logo .logo-name {
    font-size: 1.45rem;
    font-weight: var(--font-normal);
    color: #ffffff;
  }

  .footer-logo .logo-name strong {
    font-weight: var(--font-bold);
    color: var(--color-accent-light);
  }

  .footer-mission {
    line-height: var(--leading-normal);
    margin-bottom: var(--space-3);
    font-size: 0.925rem;
    color: #cbd5e1;
  }

  .footer-attribution {
    font-size: var(--text-xs);
    color: #94a3b8;
    margin-bottom: var(--space-4);
  }

  .footer-title {
    font-size: 1rem;
    font-weight: var(--font-bold);
    color: #ffffff;
    margin-bottom: var(--space-3);
    margin-top: 0;
    letter-spacing: 0.01em;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-list li {
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .footer-link {
    display: inline-block;
    padding: 2px 0;
    font-size: 0.925rem;
    color: #cbd5e1;
    transition: color var(--transition-fast);
    line-height: 1.4;
  }

  /* Educational Disclaimer Box: Compact, sleek, non-alarming */
  .footer-disclaimer {
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .footer-disclaimer p {
    color: #94a3b8;
    font-size: 0.8125rem;
    line-height: 1.5;
    margin-bottom: 0;
    max-width: 100%;
  }

  .footer-disclaimer strong {
    color: #f1f5f9;
    font-weight: 600;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #94a3b8;
    font-size: var(--text-xs);
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .copyright {
    margin-bottom: 0;
  }

  .footer-meta-links {
    margin-bottom: 0;
  }

  .footer-meta-links a {
    margin: 0 var(--space-1);
    color: #94a3b8;
  }

  /* Social Media Links */
  .footer-social {
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-social-icons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: center;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: hsl(216, 70%, 18%);
    border-radius: 50%;
    color: #cbd5e1;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .social-icon-link:hover {
    background-color: var(--color-secondary);
    color: #ffffff;
    transform: translateY(-2px);
    text-decoration: none;
  }

  .footer-social-label {
    font-size: var(--text-xs);
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
    font-weight: var(--font-semibold);
  }

  :global([data-theme="dark"]) .site-footer {
    background-color: #0A0F1A;
  }
</style>
