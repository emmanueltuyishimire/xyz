  }

  :global([data-theme="dark"]) .dropdown-link--active {
    background: rgba(29, 184, 168, 0.1);
    border-left-color: #1DB8A8;
  }

  .dropdown-link-title {
    font-size: 1.0625rem; /* 17px */
    font-weight: 700;
    color: #0A3D3A;
    display: flex;
    align-items: center;
