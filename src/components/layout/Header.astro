    text-decoration: none;
    padding: 10px 24px;
    border-radius: 8px;
    transition: background-color 150ms ease;
  }

  .mega-view-all-btn:hover,
  .mega-view-all-btn:focus-visible {
    background: #0D4F4B;
    outline: 3px solid #C9933A;
    outline-offset: 2px;
  }

  :global([data-theme="dark"]) .mega-view-all-btn {
    background: #1DB8A8;
    color: #0A0F1A;
  }

  :global([data-theme="dark"]) .mega-view-all-btn:hover {
    background: #22D4C2;
  }

  /* ========================================================
     STANDARD DROPDOWNS (5 Sections)
     ======================================================== */
  .nav-dropdown-panel {
    position: absolute;
    top: calc(100% + 4px);
    background: #FFFFFF;
    border: 2px solid var(--color-border, #DDE3EA);
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
    padding: 18px;
    z-index: 1000;
    display: none;
    max-height: calc(88vh - 72px);
    overflow-y: auto;
  }

  /* Invisible hover bridge */
  .nav-dropdown-panel::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
    background: transparent;
  }

  :global([data-theme="dark"]) .nav-dropdown-panel {
    background: #111827;
    border-color: #243348;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .nav-dropdown-panel.is-open {
    display: block;
    animation: fadeInDown 180ms ease forwards;
  }

  /* Specific Panel Alignments & Sizes to prevent any off-screen clipping */
  .nav-dropdown-panel--social-security {
    left: 0;
    right: auto;
    width: min(540px, calc(100vw - 32px));
  }
  .nav-dropdown-panel--social-security .dropdown-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .nav-dropdown-panel--medicare-medicaid {
    left: 0;
    right: auto;
    width: min(580px, calc(100vw - 32px));
  }
  .nav-dropdown-panel--medicare-medicaid .dropdown-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .nav-dropdown-panel--irs-notices {
    right: 0;
    left: auto;
    width: min(380px, calc(100vw - 32px));
  }

  .nav-dropdown-panel--retirement-taxes {
    right: 0;
    left: auto;
    width: min(420px, calc(100vw - 32px));
  }

  .nav-dropdown-panel--learn {
    right: 0;
    left: auto;
    width: min(340px, calc(100vw - 32px));
  }

  /* Pure CSS Hover & Focus-within fallback */
  @media (hover: hover) and (min-width: 1081px) {
    .nav-item:hover > .nav-dropdown-panel,
    .nav-item:hover > .nav-mega-panel,
    .nav-item:focus-within > .nav-dropdown-panel,
    .nav-item:focus-within > .nav-mega-panel {
      display: block;
      animation: fadeInDown 140ms ease forwards;
    }
    .nav-item:hover > .nav-trigger .nav-chevron,
    .nav-item:focus-within > .nav-trigger .nav-chevron,
    .nav-item:hover > .nav-trigger--split .nav-chevron,
    .nav-item:focus-within > .nav-trigger--split .nav-chevron {
      transform: rotate(180deg);
      color: #C9933A;
    }
  .dropdown-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .dropdown-group-heading {
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C9933A;
    margin: 0 0 8px 4px;
  }

  :global([data-theme="dark"]) .dropdown-group-heading {
    color: #E8B04A;
  }

  .dropdown-group-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    background: #F0F4F8;
    outline: none;
  }

  :global([data-theme="dark"]) .dropdown-link:hover,
