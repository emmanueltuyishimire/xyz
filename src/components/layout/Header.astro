  /* Theme Toggle Button */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-border, #DDE3EA);
    background: #FFFFFF;
    cursor: pointer;
    color: #0A3D3A;
    transition: background-color 150ms ease, border-color 150ms ease, transform 150ms ease;
    flex-shrink: 0;
  }

  :global([data-theme="dark"]) .theme-toggle {
    background: #1A2640;
    border-color: #243348;
    color: #1DB8A8;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background-color: #F0F4F8;
    border-color: #0A3D3A;
    transform: scale(1.06);
    outline: none;
  }

  .theme-toggle:focus-visible {
    outline: 3px solid #C9933A;
    outline-offset: 2px;
  }

  .theme-toggle .icon-sun  { display: none; }
  .theme-toggle .icon-moon { display: block; }
  :global([data-theme="dark"]) .theme-toggle .icon-sun  { display: block; }
  :global([data-theme="dark"]) .theme-toggle .icon-moon { display: none; }

