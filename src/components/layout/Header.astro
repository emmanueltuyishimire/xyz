---
/**
 * Header.astro — Redesigned for Seniors Audit
 * Purpose-built for Americans 65+ and caregivers:
 * - High contrast (WCAG AA 4.5:1+), legible typography (17px+ top-level text)
 * - Click, hover, and full keyboard navigation (Enter, Space, Esc, Arrow keys)
 * - Mega-menu for "Tools & Calculators" featuring all 11 category anchors + most used tools
 * - 5 section dropdowns with grouped subheadings (max 14 links each)
 * - Mobile full-height drawer with "Menu" text + icon, Search at top, 6 accordions, Contact at bottom
 * - Active section highlighting (aria-current="page")
 * - Shared data source from @data/navigation
 */

import {
  mainNavigation,
  mostUsedTools,
  toolCategoryAnchors,
  totalToolsCount
} from '@data/navigation';

const currentPath = Astro.url.pathname;

function isCurrentSection(itemHref: string, itemId: string): boolean {
  if (itemHref === currentPath) return true;
  if (itemId === 'tools' && currentPath.startsWith('/tools/')) return true;
  if (itemId === 'social-security' && currentPath.startsWith('/social-security/')) return true;
  if (itemId === 'medicare-medicaid' && (currentPath.startsWith('/medicare/') || currentPath.startsWith('/medicaid/'))) return true;
  if (itemId === 'irs-notices' && currentPath.startsWith('/irs/')) return true;
  if (itemId === 'retirement-taxes' && (currentPath.startsWith('/retirement/') || currentPath.startsWith('/taxes/'))) return true;
  if (itemId === 'learn' && (currentPath.startsWith('/blog/') || currentPath.startsWith('/educational-videos/'))) return true;
  return false;
}
---

<header class="site-header" role="banner" id="site-header">
  <div class="header-container">
    <div class="header-inner">
      
      <!-- Logo -->
      <a href="/" class="logo" aria-label="Seniors Audit — Return to Homepage">
        <picture>
          <source srcset="/logo.avif" type="image/avif" />
          <source srcset="/logo.webp" type="image/webp" />
          <img
            src="/logo.png"
            alt=""
            class="logo-icon"
            width="44"
            height="44"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <div class="logo-text">
          <span class="logo-name">Seniors <strong>Audit</strong></span>
          <span class="logo-tagline">Benefits &amp; Tax Education</span>
        </div>
      </a>

      <!-- Desktop Primary Navigation -->
      <nav class="nav-desktop" aria-label="Main navigation" id="desktop-main-nav">
        <ul class="nav-list" role="menubar">
          {mainNavigation.map((item) => {
            const isActive = isCurrentSection(item.href, item.id);
            const isMega = item.type === 'mega';
            
            return (
              <li class={`nav-item nav-item--${item.id} ${isMega ? 'nav-item--mega' : ''}`} role="none">
                {isMega ? (
                  /* Split trigger: label-link → /tools/, chevron btn → panel toggle */
                  <div class={`nav-trigger nav-trigger--split ${isActive ? 'nav-trigger--active' : ''}`} role="none">
                    <a href={item.href} class="nav-trigger-link" aria-current={isActive ? 'page' : undefined}>
                      <span class="nav-trigger-label">{item.label}</span>
                    </a>
                    <button
                      type="button"
                      class="nav-trigger-chevron-btn"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls={`nav-panel-${item.id}`}
                      aria-label={`Open ${item.label} menu`}
                      role="menuitem"
                    >
                      <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </button>
                  </div>
                ) : (
                  <button
                    type="button"
                    class={`nav-trigger ${isActive ? 'nav-trigger--active' : ''}`}
                    id={`nav-trigger-${item.id}`}
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={`nav-panel-${item.id}`}
                    role="menuitem"
                  >
                    <span class="nav-trigger-label">{item.label}</span>
                    <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                )}

                {/* MEGA MENU: Tools & Calculators */}
                {isMega && item.megaData && (
                  <div
                    class="nav-mega-panel"
                    id={`nav-panel-${item.id}`}
                    role="menu"
                    aria-labelledby={`nav-trigger-${item.id}`}
                    aria-hidden="true"
                  >
                    <div class="mega-inner">
                      {/* Top Strip: Most Used Tools */}
                      <div class="mega-strip">
                        <div class="mega-strip-header">
                          <span class="mega-strip-badge">Popular</span>
                          <span class="mega-strip-title">Most-Used Free Calculators</span>
                        </div>
                        <div class="mega-strip-grid">
                          {item.megaData.featured.map((tool) => (
                            <a href={tool.href} class="mega-featured-card" role="menuitem">
                              <span class="mega-featured-title">{tool.label}</span>
                              <span class="mega-featured-desc">{tool.desc}</span>
                            </a>
                          ))}
                        </div>
                      </div>

                      {/* Main Section: 11 Categories */}
                      <div class="mega-categories-section">
                        <div class="mega-categories-header">
                          <p class="mega-cat-heading" role="presentation">All 11 Calculator Categories</p>
                          <span class="mega-cat-subtext">Click any category to jump directly to its tools on the calculators page</span>
                        </div>
                        <div class="mega-categories-grid">
                          {item.megaData.categories.map((cat) => (
                            <a href={cat.href} class="mega-category-card" role="menuitem">
                              <span class="mega-category-title">
                                {cat.title}
                                <svg class="cat-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                  <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                              </span>
                              <span class="mega-category-desc">{cat.desc}</span>
                            </a>
                          ))}
                        </div>
                      </div>

                      {/* Bottom Footer Bar */}
                      <div class="mega-bottom-bar">
                        <a href={item.megaData.viewAllLink.href} class="mega-view-all-btn" role="menuitem">
                          <span>{item.megaData.viewAllLink.label}</span>
                        </a>
                      </div>
                    </div>
                  </div>
                )}

                {/* STANDARD DROPDOWN (5 Sections) */}
                {!isMega && item.groups && (
                  <div
                    class={`nav-dropdown-panel nav-dropdown-panel--${item.id}`}
                    id={`nav-panel-${item.id}`}
                    role="menu"
                    aria-labelledby={`nav-trigger-${item.id}`}
                    aria-hidden="true"
                  >
                    <div class="dropdown-inner">
                      {item.groups.map((group) => (
                        <div class="dropdown-group">
                          <p class="dropdown-group-heading" role="presentation">{group.heading}</p>
                          <ul class="dropdown-group-list" role="none">
                            {group.links.map((link) => (
                              <li role="none">
                                <a
                                  href={link.href}
                                  class={`dropdown-link ${currentPath === link.href ? 'dropdown-link--active' : ''}`}
                                  role="menuitem"
                                  aria-current={currentPath === link.href ? 'page' : undefined}
                                >
                                  <span class="dropdown-link-title">
                                    {link.label}
                                    {link.isPaid && <span class="paid-badge">Paid</span>}
                                  </span>
                                  {link.desc && <span class="dropdown-link-desc">{link.desc}</span>}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Header Right: Theme Toggle + Mobile Menu -->
      <div class="header-actions">
        <!-- Dark / Light Theme Toggle -->
        <button
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Switch to dark mode"
          aria-pressed="false"
          title="Toggle dark / light mode"
        >
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
          </svg>
        </button>

        <!-- Mobile Menu Toggle Button (Icon + "Menu" Text) -->
        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-menu-toggle"
          aria-controls="mobile-nav-drawer"
          aria-expanded="false"
          aria-label="Open main navigation menu"
        >
          <div class="hamburger-box" aria-hidden="true">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </div>
          <span class="mobile-toggle-text">Menu</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================================
       MOBILE FULL-HEIGHT DRAWER PANEL
       ======================================================== -->
  <div
    class="mobile-nav-drawer"
    id="mobile-nav-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Site Navigation Menu"
    aria-hidden="true"
  >
    <div class="mobile-drawer-header">
      <a href="/" class="mobile-logo" aria-label="Seniors Audit — Home">
        <span class="logo-name">Seniors <strong>Audit</strong></span>
      </a>
      <button
        type="button"
        class="mobile-close-btn"
        id="mobile-close-btn"
        aria-label="Close navigation menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span class="close-btn-text">Close</span>
      </button>
    </div>

    <!-- Mobile Search Quick Link at Top -->
    <div class="mobile-search-wrapper">
      <a href="/search/" class="mobile-search-card">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <div class="mobile-search-text">
          <span class="mobile-search-title">Search Seniors Audit</span>
          <span class="mobile-search-subtitle">Look up any Medicare, Social Security, or Tax topic</span>
        </div>
      </a>
    </div>

    <!-- Mobile Accordion Menu -->
    <div class="mobile-accordions" id="mobile-accordions">
      {mainNavigation.map((item, index) => {
        const isMega = item.type === 'mega';
        const accId = `mobile-acc-${item.id}`;
        const panelId = `mobile-panel-${item.id}`;

        return (
          <div class="mobile-acc-item">
            <button
              type="button"
              class="mobile-acc-trigger"
              id={accId}
              aria-expanded="false"
              aria-controls={panelId}
            >
              <span class="acc-trigger-title">{item.label}</span>
              <span class="acc-trigger-icon" aria-hidden="true">
                <svg class="acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>

            <div
              class="mobile-acc-panel"
              id={panelId}
              role="region"
              aria-labelledby={accId}
              hidden
            >
              {/* For Tools: Show Hub Link, Categories & Popular */}
              {isMega && item.megaData && (
                <div class="mobile-acc-content">
                  <a href="/tools/" class="mobile-sublink mobile-sublink--hub">
                    <span class="mobile-sublink-title">Browse All {totalToolsCount} Tools &amp; Calculators →</span>
                    <span class="mobile-sublink-desc">Complete index of confidential financial tools</span>
                  </a>

                  <p class="mobile-group-title">11 Calculator Categories</p>
                  <ul class="mobile-links-list">
                    {item.megaData.categories.map((cat) => (
                      <li>
                        <a href={cat.href} class="mobile-sublink">
                          <span class="mobile-sublink-title">{cat.title}</span>
                          <span class="mobile-sublink-desc">{cat.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>

                  <p class="mobile-group-title">Most-Used Tools</p>
                  <ul class="mobile-links-list">
                    {item.megaData.featured.map((tool) => (
                      <li>
                        <a href={tool.href} class="mobile-sublink">
                          <span class="mobile-sublink-title">{tool.label}</span>
                          <span class="mobile-sublink-desc">{tool.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {/* For Standard Dropdowns */}
              {!isMega && item.groups && (
                <div class="mobile-acc-content">
                  {item.groups.map((group) => (
                    <div class="mobile-acc-group">
                      <p class="mobile-group-title">{group.heading}</p>
                      <ul class="mobile-links-list">
                        {group.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              class={`mobile-sublink ${currentPath === link.href ? 'mobile-sublink--active' : ''}`}
                              aria-current={currentPath === link.href ? 'page' : undefined}
                            >
                              <span class="mobile-sublink-title">
                                {link.label}
                                {link.isPaid && <span class="paid-badge">Paid</span>}
                              </span>
                              {link.desc && <span class="mobile-sublink-desc">{link.desc}</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Mobile Drawer Footer Utility Links -->
    <div class="mobile-drawer-footer">
      <a href="/contact/" class="mobile-footer-contact-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Contact Us &amp; Ask Questions</span>
      </a>

      <div class="mobile-footer-trust">
        <span>✓ 100% Free Educational Guides</span>
        <span>✓ No Login Required</span>
      </div>
    </div>
  </div>
</header>

<style>
  /* ========================================================
     HEADER BASE SHELL
     ======================================================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 100);
    background-color: #FFFFFF;
    border-bottom: 2px solid var(--color-border, #DDE3EA);
    height: 72px;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  :global([data-theme="dark"]) .site-header {
    background-color: #111827;
    border-bottom-color: #243348;
  }

  .header-container {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 16px;
    height: 100%;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 8px;
    flex-wrap: nowrap;
  }

  /* ========================================================
     LOGO
     ======================================================== */
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0A3D3A;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  :global([data-theme="dark"]) .logo-name {
    color: #F9FAFB;
  }

  .logo-name strong {
    color: #8A5B14;
  }

  :global([data-theme="dark"]) .logo-name strong {
    color: #E8B04A;
  }

  .logo-tagline {
    font-size: 0.6875rem;
    color: #4B5A6E;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
  }

  :global([data-theme="dark"]) .logo-tagline {
    color: #9CA3AF;
  }

  /* ========================================================
     DESKTOP NAVIGATION
     ======================================================== */
  .nav-desktop {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
  }

  .nav-item {
    position: relative;
  }

  /* Nav Trigger Button */
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    font-size: 0.95rem; /* ~15.2px on 1081-1280px */
    font-weight: 700;
    color: #0A3D3A;
    background: transparent;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    transition: background-color 150ms ease, color 150ms ease;
  }

  /* Split trigger (mega-menu: label=link + chevron=button) */
  .nav-trigger--split {
    display: inline-flex;
    align-items: center;
    gap: 0;
    border-radius: 8px;
    min-height: 44px;
    transition: background-color 150ms ease;
  }
  .nav-trigger--split:hover,
  .nav-trigger--split:focus-within {
    background-color: #F0F4F8;
  }
  :global([data-theme="dark"]) .nav-trigger--split:hover,
  :global([data-theme="dark"]) .nav-trigger--split:focus-within {
    background-color: rgba(255, 255, 255, 0.08);
  }
  .nav-trigger-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 6px 8px 10px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0A3D3A;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    border-radius: 8px 0 0 8px;
  }
  :global([data-theme="dark"]) .nav-trigger-link {
    color: #F3F4F6;
  }
  .nav-trigger-link:hover,
  .nav-trigger-link:focus-visible {
    color: #0A3D3A;
    text-decoration: underline;
    outline: none;
  }
  :global([data-theme="dark"]) .nav-trigger-link:hover,
  :global([data-theme="dark"]) .nav-trigger-link:focus-visible {
    color: #FFFFFF;
  }
  .nav-trigger-chevron-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    min-height: 44px;
    min-width: 32px;
    border-radius: 0 8px 8px 0;
    color: #4B5A6E;
    transition: color 150ms ease;
  }
  :global([data-theme="dark"]) .nav-trigger-chevron-btn {
    color: #9CA3AF;
  }
  .nav-trigger-chevron-btn:hover,
  .nav-trigger-chevron-btn:focus-visible {
    color: #C9933A;
    outline: 2px solid #C9933A;
    outline-offset: -2px;
  }
  .nav-trigger--split.nav-trigger--active .nav-trigger-link {
    color: #0A3D3A;
  }
  :global([data-theme="dark"]) .nav-trigger--split.nav-trigger--active .nav-trigger-link {
    color: #E8B04A;
  }
  .nav-trigger-chevron-btn[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
    color: #C9933A;
  }


  :global([data-theme="dark"]) .nav-trigger {
    color: #F3F4F6;
  }

  .nav-trigger:hover,
  .nav-trigger:focus-visible,
  .nav-trigger[aria-expanded="true"] {
    background-color: #F0F4F8;
    color: #0A3D3A;
  }

  :global([data-theme="dark"]) .nav-trigger:hover,
  :global([data-theme="dark"]) .nav-trigger:focus-visible,
  :global([data-theme="dark"]) .nav-trigger[aria-expanded="true"] {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
  }

  .nav-trigger--active {
    color: #0A3D3A;
    background-color: rgba(10, 61, 58, 0.08);
    border-bottom: 3px solid #0A3D3A;
    border-radius: 8px 8px 0 0;
  }

  :global([data-theme="dark"]) .nav-trigger--active {
    color: #E8B04A;
    background-color: rgba(201, 147, 58, 0.12);
    border-bottom-color: #E8B04A;
  }

  .nav-chevron {
    transition: transform 200ms ease;
    flex-shrink: 0;
    color: #4B5A6E;
  }

  :global([data-theme="dark"]) .nav-chevron {
    color: #9CA3AF;
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
    color: #C9933A;
  }

  @media (min-width: 1281px) {
    .header-inner {
      gap: 16px;
    }
    .nav-list {
      gap: 4px;
    }
    .nav-trigger {
      font-size: 1rem;
      padding: 8px 12px;
      gap: 6px;
    }
    .logo-icon {
      width: 42px;
      height: 42px;
    }
    .logo-name {
      font-size: 1.28rem;
    }
    .logo-tagline {
      font-size: 0.72rem;
    }
  }

  /* ========================================================
     MEGA MENU (Tools & Calculators)
     ======================================================== */
  .nav-mega-panel {
    position: fixed;
    top: calc(var(--header-height, 72px) + 4px);
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, calc(100vw - 32px));
    max-height: calc(88vh - 72px);
    overflow-y: auto;
    background: #FFFFFF;
    border: 2px solid var(--color-border, #DDE3EA);
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
    padding: 24px;
    z-index: 1000;
    display: none;
  }

  /* Invisible hover bridge */
