  }

  :global([data-theme="dark"]) .mega-categories-header {
    border-bottom-color: #243348;
  }

  .mega-cat-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0A3D3A;
    margin: 0;
  }

  :global([data-theme="dark"]) .mega-cat-heading {
    color: #F9FAFB;
  }

  .mega-cat-subtext {
    font-size: 0.875rem;
    color: #4B5A6E;
  }

  :global([data-theme="dark"]) .mega-cat-subtext {
    color: #9CA3AF;
