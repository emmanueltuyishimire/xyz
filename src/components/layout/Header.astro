  }

  /* Mega Categories Grid (11 Anchors) */
  .mega-categories-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--color-border, #DDE3EA);
    padding-bottom: 8px;
