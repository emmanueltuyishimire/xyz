  .mega-category-desc {
    font-size: 0.875rem;
    color: #4B5A6E;
    line-height: 1.35;
  }

  :global([data-theme="dark"]) .mega-category-desc {
    color: #9CA3AF;
  }

  /* Bottom bar of mega menu */
  .mega-bottom-bar {
    display: flex;
    justify-content: center;
    border-top: 1.5px solid var(--color-border, #DDE3EA);
