    margin-top: auto;
    padding-top: 16px;
    border-top: 2px solid var(--color-border, #DDE3EA);
  }

  :global([data-theme="dark"]) .mobile-drawer-footer {
    border-top-color: #243348;
  }

  .mobile-footer-contact-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    background: #0A3D3A;
    color: #FFFFFF;
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
  }

  :global([data-theme="dark"]) .mobile-footer-contact-btn {
    background: #1DB8A8;
    color: #0A0F1A;
  }

  .mobile-footer-trust {
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 0.8125rem;
    color: #4B5A6E;
    font-weight: 600;
    flex-wrap: wrap;
  }

  :global([data-theme="dark"]) .mobile-footer-trust {
    color: #9CA3AF;
  }

  /* ========================================================
     ANIMATIONS & RESPONSIVE BREAKPOINTS
     ======================================================== */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Between 1081px and 1240px: compact utility icon buttons so desktop items never overflow */
  @media (min-width: 1081px) and (max-width: 1240px) {
    .utility-text {
      display: none;
    }
    .utility-link {
      padding: 8px;
      width: 40px;
      height: 40px;
      justify-content: center;
    }
  }

  /* Breakpoint 1080px: Switch cleanly to mobile hamburger */
  @media (max-width: 1080px) {
    .nav-desktop {
      display: none;
    }
    .mobile-menu-toggle {
      display: inline-flex;
    }
    .utility-text {
      display: none;
    }
    .utility-link {
      padding: 8px;
      width: 40px;
      height: 40px;
      justify-content: center;
    }
  }

  /* Breakpoint 640px: Compact header */
  @media (max-width: 640px) {
    .site-header {
      height: 64px;
    }
    .logo-tagline {
      display: none;
    }
    .logo-icon {
      width: 36px;
      height: 36px;
    }
    .logo-name {
      font-size: 1.15rem;
    }
    .header-actions {
      gap: 6px;
    }
    .utility-link--contact {
      display: none; /* Contact is prominent inside the mobile menu drawer */
    }
  }
</style>

<script is:inline>
  // ==========================================================
  // DESKTOP DROPDOWN & MEGA-MENU INTERACTIVITY
  // Supports Click, Tap, Hover, and WCAG Keyboard Navigation
  // ==========================================================
  (function initDesktopNav() {
    var navItems = document.querySelectorAll('.nav-item');
    var activeItem = null;
    var hoverTimeout = null;

    // Get the toggle button for an item (either .nav-trigger or .nav-trigger-chevron-btn for split)
    function getTriggerBtn(item) {
      return item.querySelector('.nav-trigger-chevron-btn') || item.querySelector('.nav-trigger');
    }

    function closeAllPanels() {
      navItems.forEach(function(item) {
        var triggerBtn = getTriggerBtn(item);
        var panel = item.querySelector('.nav-mega-panel, .nav-dropdown-panel');
        if (triggerBtn && panel) {
          triggerBtn.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
          panel.setAttribute('aria-hidden', 'true');
          panel.style.transform = '';
        }
      });
      activeItem = null;
    }

    function positionPanel(panel) {
      if (panel.classList.contains('nav-mega-panel')) {
        return; // Mega panel is fixed in CSS
      }

      // Dropdown collision avoidance: ensure 16px padding from viewport edges
      panel.style.transform = '';
      var rect = panel.getBoundingClientRect();
      var viewportWidth = window.innerWidth;
      var margin = 16;

      if (rect.right > viewportWidth - margin) {
        var overflow = Math.ceil(rect.right - (viewportWidth - margin));
        panel.style.transform = 'translateX(-' + overflow + 'px)';
      } else if (rect.left < margin) {
        var underflow = Math.ceil(margin - rect.left);
        panel.style.transform = 'translateX(' + underflow + 'px)';
      }
    }

    function openPanel(item) {
      if (activeItem && activeItem !== item) {
        closeAllPanels();
      }
      var triggerBtn = getTriggerBtn(item);
      var panel = item.querySelector('.nav-mega-panel, .nav-dropdown-panel');
      if (triggerBtn && panel) {
        triggerBtn.setAttribute('aria-expanded', 'true');
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        positionPanel(panel);
        activeItem = item;
      }
    }

    function togglePanel(item) {
      var triggerBtn = getTriggerBtn(item);
      if (triggerBtn && triggerBtn.getAttribute('aria-expanded') === 'true') {
        closeAllPanels();
      } else {
        openPanel(item);
      }
    }

    navItems.forEach(function(item) {
      var triggerBtn = getTriggerBtn(item);
      var panel = item.querySelector('.nav-mega-panel, .nav-dropdown-panel');
      if (!triggerBtn || !panel) return;

      // Click / Tap toggle (only on the chevron button, not the label link)
      triggerBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        togglePanel(item);
      });

      // Desktop Hover with Intent Timeout
      item.addEventListener('mouseenter', function() {
        if (window.innerWidth > 1080) {
          clearTimeout(hoverTimeout);
          hoverTimeout = setTimeout(function() { openPanel(item); }, 60);
        }
      });

      item.addEventListener('mouseleave', function() {
        if (window.innerWidth > 1080) {
          clearTimeout(hoverTimeout);
          hoverTimeout = setTimeout(function() {
            if (activeItem === item) closeAllPanels();
          }, 150);
        }
      });

      // Keyboard support: Enter/Space/ArrowDown on trigger button
      triggerBtn.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openPanel(item);
          var firstLink = panel.querySelector('a');
          if (firstLink) firstLink.focus();
        } else if (e.key === 'Escape') {
          closeAllPanels();
        }
      });

      // Keyboard navigation inside panel
      panel.addEventListener('keydown', function(e) {
        var links = Array.from(panel.querySelectorAll('a'));
        var currentIndex = links.indexOf(document.activeElement);

        if (e.key === 'Escape') {
          e.preventDefault();
          closeAllPanels();
          triggerBtn.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          var nextIndex = (currentIndex + 1) % links.length;
          if (links[nextIndex]) links[nextIndex].focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          var prevIndex = (currentIndex - 1 + links.length) % links.length;
          if (links[prevIndex]) links[prevIndex].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          if (links[0]) links[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          if (links[links.length - 1]) links[links.length - 1].focus();
        }
      });
    });

    // Close on outside click
    document.addEventListener('click', function(e) {
      if (e.target && !e.target.closest('.site-header')) {
        closeAllPanels();
      }
    });

    // Close on global Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && activeItem) {
        closeAllPanels();
      }
    });

    // Reposition open panel on window resize
    window.addEventListener('resize', function() {
      if (activeItem) {
        var panel = activeItem.querySelector('.nav-mega-panel, .nav-dropdown-panel');
        if (panel && panel.classList.contains('is-open')) {
          positionPanel(panel);
        }
      }
    });
  })();

  // ==========================================================
  // MOBILE FULL-HEIGHT DRAWER & ACCORDION SYSTEM
  // ==========================================================
  (function initMobileDrawer() {
    var toggleBtn = document.getElementById('mobile-menu-toggle');
    var closeBtn = document.getElementById('mobile-close-btn');
    var drawer = document.getElementById('mobile-nav-drawer');

    if (!toggleBtn || !drawer) return;

    function openMobileMenu() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function closeMobileMenu() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      toggleBtn.focus();
    }

    toggleBtn.addEventListener('click', function() {
      var isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMobileMenu();
      else openMobileMenu();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeMobileMenu);
    }

    // Escape closes mobile drawer
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeMobileMenu();
      }
    });

    // Mobile Accordions: Only ONE open at a time
    var accButtons = drawer.querySelectorAll('.mobile-acc-trigger');
    accButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var isExpanded = btn.getAttribute('aria-expanded') === 'true';
        var panelId = btn.getAttribute('aria-controls');
        var targetPanel = panelId ? document.getElementById(panelId) : null;

        // Close all other accordions first
        accButtons.forEach(function(otherBtn) {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            var otherPanelId = otherBtn.getAttribute('aria-controls');
            if (otherPanelId) {
              var otherPanel = document.getElementById(otherPanelId);
              if (otherPanel) otherPanel.hidden = true;
            }
          }
        });

        // Toggle clicked accordion
        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (targetPanel) targetPanel.hidden = true;
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (targetPanel) targetPanel.hidden = false;
        }
      });
    });

    // Close mobile drawer when clicking any link inside
    var mobileLinks = drawer.querySelectorAll('a');
    mobileLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        closeMobileMenu();
      });
    });
  })();

  // ==========================================================
  // THEME TOGGLE SYNCHRONIZATION
  // ==========================================================
  (function initThemeToggle() {
    var themeBtn = document.getElementById('theme-toggle');
    var root = document.documentElement;
    var STORAGE_KEY = 'sa-theme';

    if (themeBtn) {
      themeBtn.addEventListener('click', function() {
        var isDark = root.getAttribute('data-theme') === 'dark';
        if (isDark) {
          root.removeAttribute('data-theme');
          try { localStorage.setItem(STORAGE_KEY, 'light'); } catch(e) {}
          themeBtn.setAttribute('aria-pressed', 'false');
          themeBtn.setAttribute('aria-label', 'Switch to dark mode');
        } else {
          root.setAttribute('data-theme', 'dark');
          try { localStorage.setItem(STORAGE_KEY, 'dark'); } catch(e) {}
          themeBtn.setAttribute('aria-pressed', 'true');
          themeBtn.setAttribute('aria-label', 'Switch to light mode');
        }
      });
    }
  })();
</script>
