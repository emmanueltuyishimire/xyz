---
/**
 * YouTubeSubscribeCTA.astro
 * Reusable, senior-friendly YouTube Subscription Callout.
 *
 * Styled directly after Seniors Audit's authoritative "Calculate" button
 * using authentic YouTube brand red (#E62117) with large touch targets,
 * high contrast, and keyboard accessibility.
 */

import { SENIORS_AUDIT_YOUTUBE_SUBSCRIBE_URL } from '@data/educationalVideos';

interface Props {
  variant?: 'card' | 'banner' | 'inline';
  title?: string;
  description?: string;
  buttonText?: string;
  class?: string;
}

const {
  variant = 'card',
  title = 'Subscribe to Seniors Audit on YouTube',
  description = 'Watch new, plain-English educational video walkthroughs on Social Security, Medicare, retirement taxes, and senior benefits. Always free, official-source verified, and no sales pitches.',
  buttonText = 'Subscribe on YouTube',
  class: customClass = '',
} = Astro.props;
---

{variant === 'inline' ? (
  <a
    href={SENIORS_AUDIT_YOUTUBE_SUBSCRIBE_URL}
    class={`yt-calc-btn yt-calc-btn--inline ${customClass}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Subscribe to Seniors Audit channel on YouTube (opens in new window)"
    data-tracking="youtube_channel_click"
  >
    <svg class="yt-calc-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>
    <span>{buttonText}</span>
    <svg class="yt-calc-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </a>
) : (
  <aside class={`yt-sub-card yt-sub-card--${variant} ${customClass}`} aria-label="YouTube Channel Subscription">
    <div class="yt-sub-content">
      <div class="yt-sub-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#E62117" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>Official Seniors Audit Channel</span>
      </div>
      <h3 class="yt-sub-title">{title}</h3>
      <p class="yt-sub-desc">{description}</p>
    </div>
    <div class="yt-sub-action">
      <a
        href={SENIORS_AUDIT_YOUTUBE_SUBSCRIBE_URL}
        class="yt-calc-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Subscribe to Seniors Audit channel on YouTube (opens in new window)"
        data-tracking="youtube_channel_click"
      >
        <svg class="yt-calc-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>{buttonText}</span>
        <svg class="yt-calc-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <span class="yt-sub-note">Free on YouTube • Instant updates on new rules</span>
    </div>
  </aside>
)}

<style>
  /* Standalone Card */
  .yt-sub-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    padding: 1.75rem;
    background: #FFFFFF;
    border: 2px solid #DDE3EA;
    border-left: 6px solid #E62117;
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 16px rgba(13, 33, 55, 0.06);
    margin-block: 2rem;
  }

  .yt-sub-card--banner {
    background: #F8FAFC;
    border-color: #CBD5E1;
    border-left-width: 6px;
    border-left-color: #E62117;
  }

  .yt-sub-content {
    flex: 1;
    min-width: 0;
  }

  .yt-sub-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0A3D3A;
    margin-bottom: 0.5rem;
  }

  .yt-sub-title {
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 800;
    color: #0D2137;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .yt-sub-desc {
    font-size: 1rem;
    color: #3E4E60;
    line-height: 1.6;
    margin: 0;
  }

  .yt-sub-action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  /* ──────────────────────────────────────────────────────────
     CALCULATE-STYLE YOUTUBE SUBMIT BUTTON
     Mirrors the site's primary .calc-submit-button structure
     with authentic YouTube red (#E62117)
     ────────────────────────────────────────────────────────── */
  .yt-calc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 1.85rem;
    min-height: 52px; /* Mirrors .calc-submit-button */
    background-color: #E62117 !important; /* Official YouTube Brand Red */
    color: #FFFFFF !important;
    font-family: var(--font-primary, inherit);
    font-size: var(--text-lg, 1.15rem);
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none !important;
    border-radius: var(--radius-md, 8px); /* Calculate button curvature */
    border: 2px solid #E62117;
    box-shadow: 0 4px 14px rgba(230, 33, 23, 0.35);
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    white-space: nowrap;
    cursor: pointer;
    text-align: center;
  }

  .yt-calc-btn:hover {
    background-color: #CC0000 !important;
    border-color: #CC0000;
    box-shadow: 0 6px 20px rgba(204, 0, 0, 0.45);
    transform: translateY(-2px);
  }

  .yt-calc-btn:active {
    background-color: #990000 !important;
    border-color: #990000;
    transform: translateY(0);
  }

  .yt-calc-btn:focus-visible {
    outline: 3px solid #C9933A; /* Senior Gold Focus Ring */
    outline-offset: 3px;
  }

  .yt-calc-icon {
    flex-shrink: 0;
  }

  .yt-calc-arrow {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .yt-calc-btn:hover .yt-calc-arrow {
    transform: translateX(3px);
  }

  .yt-sub-note {
    font-size: 0.82rem;
    color: #64748B;
    text-align: right;
  }

  /* Responsive for mobile */
  @media (max-width: 768px) {
    .yt-sub-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1.35rem;
      padding: 1.35rem;
    }

    .yt-sub-action {
      align-items: stretch;
      width: 100%;
    }

    .yt-calc-btn {
      width: 100%;
    }

    .yt-sub-note {
      text-align: center;
    }
  }
</style>
