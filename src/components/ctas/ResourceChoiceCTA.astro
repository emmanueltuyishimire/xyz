---
/**
 * ResourceChoiceCTA.astro — 3-option choice architecture.
 * Shows: Individual → Bundle → Complete Library
 * Used on high-value hub or summary pages.
 */
interface Option {
  label: string;
  name: string;
  price: number;
  url: string;
  isHighlighted?: boolean;
  trackingEvent?: string;
  includes?: string[];
}

interface Props {
  heading?: string;
  intro?: string;
  options: Option[];
}

const {
  heading = 'Choose the Resource That Fits Your Situation',
  intro,
  options,
} = Astro.props;
---

<aside class="resource-choice" aria-label="Optional planning resources">
  <div class="rc-inner">
    <div class="rc-label">Optional Planning Resources</div>
    <h3 class="rc-heading">{heading}</h3>
    {intro && <p class="rc-intro">{intro}</p>}
    <div class="rc-options">
      {options.map((opt) => (
        <div class={`rc-option${opt.isHighlighted ? ' rc-option--highlighted' : ''}`}>
          {opt.isHighlighted && <div class="rc-badge">Most Popular</div>}
          <span class="rc-opt-label">{opt.label}</span>
          <span class="rc-opt-name">{opt.name}</span>
          <span class="rc-opt-price"><span class="rc-price-sym">$</span>{opt.price}</span>
          {opt.includes && opt.includes.length > 0 && (
            <ul class="rc-includes" aria-label="Includes">
              {opt.includes.map((inc) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          )}
          <a
            href={opt.url}
            class="rc-btn"
            aria-label={`${opt.name} — $${opt.price}`}
            data-tracking={opt.trackingEvent}
          >
            {opt.isHighlighted ? 'Get Bundle' : 'Explore Resource →'}
          </a>
        </div>
      ))}
    </div>
    <p class="rc-free-reminder">Every Seniors Audit calculator and educational guide remains 100% free — no account, no signup required.</p>
  </div>
</aside>

<style>
  .resource-choice {
    margin-block: 2.5rem;
    border-radius: 12px;
    border: 2px solid #DDE3EA;
    background: #F6F8FA;
  }
  .rc-inner {
    padding: 1.75rem 2rem;
  }
  .rc-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0A3D3A;
    background: #D6EFEC;
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    margin-bottom: 0.75rem;
  }
  .rc-heading {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 700;
    color: #0D2137;
    margin: 0 0 0.5rem;
  }
  .rc-intro {
    font-size: 0.95rem;
    color: #3E4E60;
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }
  .rc-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .rc-option {
    background: #FFFFFF;
    border: 2px solid #DDE3EA;
    border-radius: 10px;
    padding: 1.35rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: relative;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
  }
  .rc-option--highlighted {
    border-color: #0A3D3A;
    background: #F4FAF9;
    box-shadow: 0 4px 14px rgba(10,61,58,0.1);
  }
  .rc-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #0A3D3A;
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }
  .rc-opt-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #6B7E91;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rc-opt-name {
    font-size: 1rem;
    font-weight: 700;
    color: #0D2137;
    line-height: 1.3;
  }
  .rc-includes {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .rc-includes li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.85rem;
    line-height: 1.35;
    color: #3E4E60;
  }
  .rc-includes svg {
    color: #0A3D3A;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .rc-opt-price {
    font-size: 1.6rem;
    font-weight: 900;
    color: #0A3D3A;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .rc-price-sym {
    font-size: 0.95rem;
    vertical-align: top;
    margin-top: 0.2rem;
    display: inline-block;
  }
  .rc-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    background: #0A3D3A;
    color: #FFFFFF !important;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 1rem;
    border-radius: 7px;
    text-decoration: none !important;
    min-height: 44px;
    transition: background 0.15s;
  }
  .rc-option--highlighted .rc-btn {
    background: #C9933A;
    color: #071C1A !important;
  }
  .rc-btn:hover {
    background: #C9933A;
  }
  .rc-option--highlighted .rc-btn:hover {
    background: #A6771F;
    color: #FFFFFF !important;
  }
  .rc-btn:focus-visible {
    outline: 3px solid #C9933A;
    outline-offset: 3px;
  }
  .rc-free-reminder {
    font-size: 0.85rem;
    color: #4F5E72;
    margin: 0;
    font-style: italic;
    text-align: center;
  }
  @media (max-width: 640px) {
    .rc-inner { padding: 1.25rem; }
    .rc-options { grid-template-columns: 1fr; }
  }
</style>
