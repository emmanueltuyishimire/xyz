---
/**
 * GooglePreferredSourceCTA.astro
 *
 * Official Google Preferred Sources integration for seniorsaudit.com.
 * Custom button implementation:
 * - Pure White background (#FFFFFF)
 * - Official Google 4-color "G" logo
 * - Prominent 2px brand outline with subtle ring glow (NOT boring, highly defined)
 * - Clear 14px spacing between Google logo, text, and action arrow
 * - Brand Deep Authority Teal text (#0A3D3A)
 * - Gold outline in dark footer contexts for maximum senior readability and contrast
 *
 * Variants:
 * - 'banner': Sleek horizontal callout (article top/bottom, homepage hero)
 * - 'sidebar': Compact card for article & hub sidebars
 * - 'card': Standalone callout box for post-article / tool completion
 * - 'footer': Compact, non-intrusive integration for the site footer
 * - 'button-only': Standalone pill button
 */

interface Props {
  variant?: 'banner' | 'sidebar' | 'card' | 'footer' | 'button-only';
  theme?: 'light' | 'dark';
  title?: string;
  description?: string;
  buttonLabel?: string;
  class?: string;
}

const {
  variant = 'banner',
  title,
  description,
  buttonLabel = 'Add as Preferred Source',
  class: className = '',
} = Astro.props;

const defaultTitle = variant === 'sidebar'
  ? 'Prefer Us on Google Search'
  : variant === 'footer'
  ? 'Google Search Preferred Source'
  : 'Make Seniors Audit Your Preferred Source in Google Search';

const defaultDesc = variant === 'sidebar'
  ? 'Get verified Medicare, Social Security & tax guides highlighted in Google Top Stories & AI Overviews.'
  : variant === 'footer'
  ? 'Follow our verified, plain-English guides in Google Top Stories and AI Overviews.'
  : 'When you choose Seniors Audit as a preferred source, our independent, verified guides and calculators are highlighted with a preferred badge in Google Top Stories and AI Overviews.';

const displayTitle = title ?? defaultTitle;
const displayDesc = description ?? defaultDesc;
const deeplinkUrl = 'https://www.google.com/preferences/source?q=https://www.seniorsaudit.com';
---

{variant === 'button-only' && (
  <a
    href={deeplinkUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`google-preferred-btn ${className}`}
    aria-label="Add Seniors Audit as a Preferred Source in Google Search"
  >
    <svg class="google-logo" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.88c2.28-2.09 3.665-5.17 3.665-9.14z"/>
      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.04c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.94H1.26v3.13C3.26 21.36 7.33 24 12 24z"/>
      <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.6H1.26C.46 8.22 0 10.06 0 12s.46 3.78 1.26 5.4l4.02-3.13z"/>
      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.26 6.6l4.02 3.13c.95-2.84 3.6-4.98 6.72-4.98z"/>
    </svg>
    <span class="btn-text">{buttonLabel}</span>
    <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14"></path>
      <path d="M12 5l7 7-7 7"></path>
    </svg>
  </a>
)}

{variant === 'banner' && (
  <aside class={`google-pref-banner ${className}`} aria-label="Google Search preferred source preference">
    <div class="gpb-icon-col" aria-hidden="true">
      <svg class="gpb-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <polygon points="11 8 12.5 11 16 11.5 13.5 14 14 17.5 11 15.8 8 17.5 8.5 14 6 11.5 9.5 11 11 8" fill="#C9933A" stroke="#C9933A" stroke-width="1"></polygon>
      </svg>
    </div>
    <div class="gpb-content">
      <div class="gpb-header">
        <span class="gpb-badge">Google Search Preference</span>
        <p class="gpb-title">{displayTitle}</p>
      </div>
      <p class="gpb-desc">{displayDesc}</p>
      <div class="gpb-actions">
        <a
          href={deeplinkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="google-preferred-btn"
          aria-label="Add Seniors Audit as a Preferred Source in Google Search"
        >
          <svg class="google-logo" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.88c2.28-2.09 3.665-5.17 3.665-9.14z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.04c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.94H1.26v3.13C3.26 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.6H1.26C.46 8.22 0 10.06 0 12s.46 3.78 1.26 5.4l4.02-3.13z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.26 6.6l4.02 3.13c.95-2.84 3.6-4.98 6.72-4.98z"/>
          </svg>
          <span class="btn-text">{buttonLabel}</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </aside>
)}

{variant === 'card' && (
  <aside class={`google-pref-card ${className}`} aria-label="Google Search preferred source preference">
    <div class="gpc-inner">
      <div class="gpc-badge-row">
        <span class="gpc-badge">Google Search</span>
        <span class="gpc-trust-pill">Verified Senior Education</span>
      </div>
      <p class="gpc-title">{displayTitle}</p>
      <p class="gpc-desc">{displayDesc}</p>
