---
/**
 * ToolResultCTA.astro — Compact inline CTA for immediate post-result placement.
 * Lighter than ProductCTA — used directly after a calculator result, before
 * the educational body. Single product, minimal footprint, no bundle.
 * ALWAYS appears AFTER the user has received their free answer.
 */
interface Props {
  productName: string;
  price: number;
  tagline: string;
  slug: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  buttonText?: string;
  trackingEvent?: string;
}

const {
  productName,
  price,
  tagline,
  slug,
  thumbnail,
  thumbnailAlt,
  buttonText = 'See What\'s Included →',
  trackingEvent,
} = Astro.props;

const productUrl = `/resources/${slug}/`;
const altText = thumbnailAlt ?? `${productName} — Seniors Audit optional planning resource`;
---

<div class="trc-wrap" role="complementary" aria-label={`Optional next step: ${productName}`}>
  <div class="trc-inner">
    {thumbnail && (
      <a
        href={productUrl}
        class="trc-thumb-link"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={thumbnail}
          alt={altText}
          loading="lazy"
          decoding="async"
          width="100"
          height="70"
          class="trc-thumb"
        />
      </a>
    )}
    <div class="trc-body">
      <span class="trc-eyebrow">Optional Next Step</span>
      <p class="trc-tagline">{tagline}</p>
      <div class="trc-product-row">
        <span class="trc-name">{productName}</span>
        <span class="trc-price"><span class="trc-sym">$</span>{price}</span>
      </div>
    </div>
    <a
      href={productUrl}
      class="trc-btn"
      aria-label={`${buttonText} — ${productName}, $${price}`}
      data-tracking={trackingEvent}
    >
      {buttonText}
    </a>
  </div>
</div>

<style>
  .trc-wrap {
    margin-block: 1.75rem;
    border-radius: 10px;
    border: 1.5px solid #D6EFEC;
    background: #F4FAF9;
    overflow: hidden;
  }
  .trc-inner {
    padding: 1rem 1.35rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Thumbnail */
  .trc-thumb-link {
    flex-shrink: 0;
    display: block;
    line-height: 0;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    border: 1px solid #DDE3EA;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .trc-thumb-link:hover {
    box-shadow: 0 4px 14px rgba(10,61,58,0.15);
    transform: translateY(-1px);
  }
  .trc-thumb {
    display: block;
    width: 100px;
    height: 70px;
    object-fit: cover;
    object-position: top center;
  }

  /* Body */
  .trc-body {
    flex: 1;
    min-width: 160px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .trc-eyebrow {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0A3D3A;
  }
  .trc-tagline {
    font-size: 0.95rem;
    color: #3E4E60;
    line-height: 1.5;
    margin: 0;
  }
  .trc-product-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-top: 0.1rem;
  }
  .trc-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0D2137;
  }
  .trc-price {
    font-size: 1.25rem;
    font-weight: 900;
    color: #0A3D3A;
    line-height: 1;
  }
  .trc-sym {
    font-size: 0.8rem;
    font-weight: 700;
    vertical-align: top;
    margin-top: 0.15rem;
    display: inline-block;
  }

  /* Button */
  .trc-btn {
    display: inline-flex;
    align-items: center;
    background: #0A3D3A;
    color: #FFFFFF !important;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.7rem 1.2rem;
    border-radius: 7px;
    text-decoration: none !important;
    white-space: nowrap;
    min-height: 44px;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 2px 6px rgba(10,61,58,0.12);
  }
  .trc-btn:hover {
    background: #C9933A;
    color: #071C1A !important;
    transform: translateY(-1px);
  }
  .trc-btn:focus-visible {
    outline: 3px solid #C9933A;
    outline-offset: 3px;
  }

  /* Mobile */
  @media (max-width: 560px) {
    .trc-inner {
      flex-direction: column;
      align-items: stretch;
      padding: 1rem;
    }
    .trc-thumb-link { width: 100%; border-radius: 5px; }
    .trc-thumb { width: 100%; height: 80px; }
    .trc-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
