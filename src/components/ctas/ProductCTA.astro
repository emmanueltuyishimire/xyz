---
/**
 * ProductCTA.astro — Optional paid planning resource callout (single product).
 * Always appears AFTER free value has been delivered.
 * "Optional Planning Resource" label reinforces free-first philosophy.
 */
interface Props {
  heading?: string;
  context?: string;
  productName: string;
  price: number;
  productDesc: string;
  slug: string;
  buttonText?: string;
  trackingEvent?: string;
  variant?: 'teal' | 'gold';
}

const {
  heading = 'Want a Structured Way to Plan This Decision?',
  context,
  productName,
  price,
  productDesc,
  slug,
  buttonText = 'Explore the Resource →',
  trackingEvent,
  variant = 'teal',
} = Astro.props;

const productUrl = `/resources/${slug}/`;
---

<aside class={`product-cta product-cta--${variant}`} aria-label={`Optional planning resource: ${productName}`}>
  <div class="product-cta-inner">
    <div class="product-cta-label">Optional Planning Resource</div>
    <h3 class="product-cta-heading">{heading}</h3>
    {context && <p class="product-cta-context">{context}</p>}
    <div class="product-cta-card">
      <div class="product-cta-info">
        <span class="product-cta-name">{productName}</span>
        <span class="product-cta-price"><span class="price-symbol">$</span>{price}</span>
        <p class="product-cta-desc">{productDesc}</p>
      </div>
      <a
        href={productUrl}
        class="product-cta-btn"
        aria-label={`${buttonText} — ${productName} for $${price}`}
        data-tracking={trackingEvent}
      >
        {buttonText}
      </a>
    </div>
  </div>
</aside>

<style>
  .product-cta {
    margin-block: 2.5rem;
    border-radius: 12px;
    border: 2px solid #0A3D3A;
    background: #F4FAF9;
    overflow: hidden;
  }
  .product-cta--gold {
    border-color: #C9933A;
    background: #FEFBF4;
  }
  .product-cta-inner {
    padding: 1.75rem 2rem;
  }
  .product-cta-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0A3D3A;
    background: #D6EFEC;
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    margin-bottom: 0.9rem;
  }
  .product-cta--gold .product-cta-label {
    color: #7A5210;
    background: #FEF0D3;
  }
  .product-cta-heading {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 800;
    color: #0D2137;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .product-cta-context {
    font-size: 1.02rem;
    color: #3E4E60;
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }
  .product-cta-card {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .product-cta-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 220px;
  }
  .product-cta-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0D2137;
  }
  .product-cta-price {
    font-size: 1.75rem;
    font-weight: 900;
    color: #0A3D3A;
    line-height: 1;
  }
  .price-symbol {
    font-size: 1.05rem;
    font-weight: 700;
    vertical-align: top;
    margin-top: 0.2rem;
    display: inline-block;
  }
  .product-cta-desc {
    font-size: 0.94rem;
    color: #4F5E72;
    margin: 0;
    line-height: 1.5;
  }
  .product-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #0A3D3A;
    color: #FFFFFF !important;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    min-height: 48px;
    box-shadow: 0 2px 6px rgba(10, 61, 58, 0.15);
  }
  .product-cta-btn:hover {
    background: #C9933A;
    color: #071C1A !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(201, 147, 58, 0.25);
  }
  .product-cta-btn:focus-visible {
    outline: 3px solid #C9933A;
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .product-cta-inner { padding: 1.25rem; }
    .product-cta-card { flex-direction: column; align-items: stretch; }
    .product-cta-btn { width: 100%; justify-content: center; }
  }
</style>
