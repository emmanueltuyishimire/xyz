---
/**
 * BundleCTA.astro — Thematic bundle callout.
 * Secondary escalation after the individual ProductCTA.
 * Never the first CTA on a page.
 * thumbnail: optional representative image (first product in bundle, lazy-loaded).
 */
interface Props {
  bundleName: string;
  price: number;
  standaloneValue: number;
  savings: number;
  discountPercent: number;
  permalink: string;
  includes: string[];
  heading?: string;
  trackingEvent?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
}

const {
  bundleName,
  price,
  standaloneValue,
  savings,
  discountPercent,
  permalink,
  includes,
  heading = 'Also Considering a Related Topic?',
  trackingEvent,
  thumbnail,
  thumbnailAlt,
} = Astro.props;

const bundleUrl = `https://resources.seniorsaudit.com/l/${permalink}`;
const altText = thumbnailAlt ?? `${bundleName} — optional planning bundle from Seniors Audit`;
---

<aside class="bundle-cta" aria-label={`Optional bundle: ${bundleName}`}>
  <div class="bundle-cta-inner">
    <div class="bundle-label">Also Available as a Bundle</div>
    <h3 class="bundle-heading">{heading}</h3>
    <div class="bundle-card">
      {thumbnail && (
        <a
          href={bundleUrl}
          class="bundle-thumb-link"
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={thumbnail}
            alt={altText}
            loading="lazy"
            decoding="async"
            width="120"
            height="84"
            class="bundle-thumb"
          />
        </a>
      )}
      <div class="bundle-info">
        <span class="bundle-name">{bundleName}</span>
        <div class="bundle-pricing">
          <span class="bundle-price"><span class="price-sym">$</span>{price}</span>
          <span class="bundle-strike">${standaloneValue} if purchased separately</span>
          <span class="bundle-save">Save ${savings} ({discountPercent}% off)</span>
        </div>
        <ul class="bundle-includes" aria-label="What's included">
          {includes.map((item) => (
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <a
        href={bundleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bundle-btn"
        aria-label={`Get ${bundleName} — $${price}`}
        data-tracking={trackingEvent}
      >
        Get the Bundle — ${price}
      </a>
    </div>
  </div>
</aside>

<style>
  .bundle-cta {
    margin-block: 2rem;
    border-radius: 12px;
    border: 2px solid #C9933A;
    background: #FEFBF4;
    overflow: hidden;
  }
  .bundle-cta-inner {
    padding: 1.5rem 2rem;
  }
  .bundle-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7A5210;
    background: #FEF0D3;
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    margin-bottom: 0.75rem;
  }
  .bundle-heading {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    color: #0D2137;
    margin: 0 0 1rem;
  }
  .bundle-card {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  /* ── Thumbnail frame ─────────────────────────────────── */
  .bundle-thumb-link {
    flex-shrink: 0;
    display: block;
    line-height: 0;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 3px 10px rgba(0,0,0,0.10);
    border: 1px solid #DDE3EA;
    align-self: center;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .bundle-thumb-link:hover {
    box-shadow: 0 5px 16px rgba(201,147,58,0.20);
    transform: translateY(-1px);
  }
  .bundle-thumb {
    display: block;
    width: 120px;
    height: 84px;
    object-fit: cover;
    object-position: top center;
  }

  .bundle-info {
    flex: 1;
    min-width: 200px;
  }
  .bundle-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0D2137;
    display: block;
    margin-bottom: 0.5rem;
  }
  .bundle-pricing {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }
  .bundle-price {
    font-size: 1.75rem;
    font-weight: 900;
    color: #0A3D3A;
    line-height: 1;
  }
  .price-sym {
    font-size: 1rem;
    font-weight: 700;
    vertical-align: top;
    margin-top: 0.2rem;
    display: inline-block;
  }
  .bundle-strike {
    font-size: 0.88rem;
    color: #7A8A99;
    text-decoration: line-through;
  }
  .bundle-save {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0A3D3A;
    background: #D6EFEC;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  .bundle-includes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .bundle-includes li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    color: #3E4E60;
  }
  .bundle-includes li svg {
    color: #0A3D3A;
    flex-shrink: 0;
  }
  .bundle-btn {
    display: inline-flex;
    align-items: center;
    background: #C9933A;
    color: #071C1A !important;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    min-height: 48px;
    align-self: flex-end;
    box-shadow: 0 2px 6px rgba(201, 147, 58, 0.2);
  }
  .bundle-btn:hover {
    background: #A6771F;
    color: #FFFFFF !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(166, 119, 31, 0.3);
  }
  .bundle-btn:focus-visible {
    outline: 3px solid #0A3D3A;
    outline-offset: 3px;
  }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .bundle-cta-inner { padding: 1.25rem; }
    .bundle-card { flex-direction: column; align-items: stretch; }
    .bundle-thumb-link {
      width: 100%;
      border-radius: 6px;
    }
    .bundle-thumb {
      width: 100%;
      height: 100px;
    }
    .bundle-btn { width: 100%; justify-content: center; }
  }
</style>
